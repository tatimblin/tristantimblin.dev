# build output
dist/

# built VS Code workbench page, copied from @tristimb/fleet-demo (bun run copy:fleet-demo)
public/fleet-demo/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

.playwright-mcp/

# Playwright test output (see tests/hero-fold.spec.ts)
test-results/
playwright-report/

# Raw media originals: kept locally as encoder inputs (the carousel's are
# tools/dotgrid/prepare-carousel.sh's), never committed, and kept OUT of public/
# so a local build never ships them.
media-src/

# The made-for-web renders (tools/dotgrid writes them here). They live in R2,
# not git: bun run media:push uploads them and rewrites src/data/media.json.
/media/

# Puppeteer persistent browser profile (lives on the self-hosted runner only).
tools/amc/.browser-profile/
