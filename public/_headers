# Cloudflare Pages custom headers (https://developers.cloudflare.com/pages/configuration/headers/)
#
# Videos and audio are static, permanent assets with stable filenames — cache them
# hard so repeat visits and the carousel's next-clip prefetch cost nothing. If a
# clip is ever re-encoded it keeps its name; bump the path or filename to bust.
/videos/*
  Cache-Control: public, max-age=31536000, immutable

/audio/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted web fonts (public/fonts, built by tools/fonts/build.sh). Content-
# addressed by hand: a re-subset of the same face keeps its filename, so bump the
# filename when a face is genuinely replaced.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The VS Code embed (public/fleet-demo, copied from @tristimb/fleet-demo). Vite
# content-addresses everything under assets/ — the 11 MB workbench chunk, the
# workers, the wasm, the service worker the webview host registers — so those are
# safe to cache forever. index.html is the one unhashed file and the only thing
# that names the current asset hashes, so it must never be served stale: a cached
# index pointing at a rebuilt bundle's old filenames is a demo that 404s on boot.
#
# The no-cache rule names the page itself, NOT /fleet-demo/*: Cloudflare applies
# every rule that matches a path and joins their values, so a wildcard here also
# matched assets/ and sent them `no-cache, public, max-age=31536000, immutable`.
# The embed requests /fleet-demo/index.html, which Pages redirects to the
# directory, so both spellings are listed.
/fleet-demo/
  Cache-Control: no-cache

/fleet-demo/index.html
  Cache-Control: no-cache

/fleet-demo/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Astro's build output (dist/_astro): every JS/CSS chunk and processed image is
# named by its content hash, so a changed file is a new URL — cache forever. No
# other rule here matches /_astro/*, and none may: Cloudflare joins the values of
# every matching rule (see /fleet-demo above).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
