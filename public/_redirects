# Cloudflare Pages redirects (https://developers.cloudflare.com/pages/configuration/redirects/)
#
# /txt/categories was the old categories index; /txt now lists every post with
# its category. Both spellings, with and without the slash.
/txt/categories /txt/ 301
/txt/categories/ /txt/ 301

# The gallery is gone; its pages go home.
/gallery / 301
/gallery/ / 301
/gallery/* / 301

# Sutro moved from a post to a full-screen demo.
/txt/painterly-sutro /demo/sutro/ 301
/txt/painterly-sutro/ /demo/sutro/ 301

# Per-category pages are gone; /txt lists every post with its category.
/txt/category/* /txt/ 301

# The design-system subpages were folded into one page.
/design-system/art /design-system/ 301
/design-system/art/ /design-system/ 301
/design-system/glyphs /design-system/ 301
/design-system/glyphs/ /design-system/ 301
