# Cloudflare Pages redirects (https://developers.cloudflare.com/pages/configuration/redirects/)
#
# /txt/categories was the old categories index; /txt now lists every post with
# its category. Both spellings, with and without the slash.
/txt/categories /txt/ 301
/txt/categories/ /txt/ 301

# The gallery is gone; its pages go home.
/gallery / 301
/gallery/ / 301
/gallery/* / 301
