---
// Strong — DS <Text as="strong" variant="primary" />: the emphasis is the
// louder ink. (Upstream also set weight 500; the body face has no cut above
// the Regular, so it never drew one.)
import Text from "./Text.astro";

interface Props {
	size?: number | string;
	class?: string;
	[key: string]: unknown;
}

const props = Astro.props;
---

<Text {...props} as="strong" variant="primary">
	<slot />
</Text>
