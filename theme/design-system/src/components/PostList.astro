---
// PostList — an archive of writing, grouped (styles/post-list.css). The list
// holds PostGroups; each group holds PostRows. No upstream: this is the site's
// reading UI, drawn in the UI face, and it is what /txt is built from.
//
//   <PostList aria-label="Posts by year">
//     <PostGroup label="2026">
//       <PostRow href="/txt/a-post">A post title<Fragment slot="meta">…</Fragment></PostRow>
//     </PostGroup>
//   </PostList>
import { cx } from "../lib/cx";

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<ol class={cx("ds-post-list", className)} {...rest}><slot /></ol>
