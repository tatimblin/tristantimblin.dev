---
// Widget — a standard cell in a <WidgetGrid>: a DS Card with the span classes
// for its size, so every widget gets the flat card chrome and the header —
// `title` (prop or slot) left, the `meta` slot right — for free; Card's other
// props (`variant`, `chrome`, `squeeze`) pass straight through. Body content
// goes in a <CardBody>, which fills the rest of the cell
// (styles/widget-grid.css):
//
//   <Widget size="1x1" title="github">
//     <Mono slot="meta" as="a" variant="text" href="…">@handle</Mono>
//     <CardBody>…</CardBody>
//   </Widget>
import { cx } from "../lib/cx";
import Card from "./Card.astro";

type Size = "1x1" | "2x1" | "1x2" | "2x2";

interface Props {
	size?: Size;
	title?: string;
	class?: string;
	[key: string]: unknown;
}

const { size = "1x1", title, class: className, ...rest } = Astro.props;

const cls = cx("ds-widget", `ds-widget--size-${size}`, className);

// See Card.astro: forwarded only when filled.
const hasTitle = Astro.slots.has("title");
const hasMeta = Astro.slots.has("meta");
---

<Card class={cls} title={title} {...rest}>
	{
		hasTitle ? (
			<Fragment slot="title">
				<slot name="title" />
			</Fragment>
		) : null
	}
	{
		hasMeta ? (
			<Fragment slot="meta">
				<slot name="meta" />
			</Fragment>
		) : null
	}
	<slot />
</Card>
