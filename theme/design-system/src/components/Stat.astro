---
// Stat — the stat pair of the reference dashboard: a value over a dim
// sentence-case label (`90%` / Allocated), both in the label voice — the
// value at the label's next step, in the ink (styles/stat.css). Several sit
// in a row: the bike tile's rides / hours.
//
// `variant="numeral"` is the spec sheet's pair instead: the value BIG (the
// display role, DM Sans Medium, at --font-size-8) with a small caps
// label BESIDE it, top-aligned to the numeral's cap line. The label wraps (a <br> or its width), where
// the default's stays on one line.
//
//   <Stat value="90%" label="Allocated" />
//   <Stat label="miles"><slot>…custom value markup…</slot></Stat>
//   <Stat value="3 min"><Fragment slot="label">read</Fragment></Stat>
//   <Stat variant="numeral" value="05" label="Posts" />
//   <Stat variant="numeral" value="05"><Fragment slot="label">Title<br />Feb 2026 · 554 w</Fragment></Stat>
import { cx } from "../lib/cx";
import Mono from "./Mono.astro";

interface Props {
	as?: string;
	value?: string | number;
	label?: string;
	/** `pair` (default): value over a dim label, in the mono. `numeral`: a big
	 *  thin numeral with a caps label beside it. */
	variant?: "pair" | "numeral";
	class?: string;
	[key: string]: unknown;
}

const { as = "div", value, label, variant = "pair", class: className, ...rest } = Astro.props;

const Tag = as as any;
const hasLabelSlot = Astro.slots.has("label");
const numeral = variant === "numeral";
const hasLabel = hasLabelSlot || !!label;
---

<Tag class={cx("ds-stat", numeral && "ds-stat--variant-numeral", className)} {...rest}>
	{
		numeral ? (
			<span class="ds-stat__numeral">{value ?? <slot />}</span>
		) : (
			<Mono variant="value" size={1} class="ds-stat__value">{value ?? <slot />}</Mono>
		)
	}
	{
		hasLabel && (
			<Mono variant={numeral ? "caps" : "text"} class="ds-stat__label">
				{hasLabelSlot ? <slot name="label" /> : label}
			</Mono>
		)
	}
</Tag>
