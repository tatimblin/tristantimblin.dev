---
// NumberStream — rows of digits, the synth panel's data texture (styles/
// number-stream.css): 2836478127 / 3547189911 in the label voice, tabular,
// the secondary ink. Drawn from a seed (lib/readouts, `numberStream`: the
// same seed, rows and digits give the same digits, never Math.random), so
// a build is stable.
//
//   <NumberStream />                                  two rows of ten, seed 7
//   <NumberStream seed={42} rows={4} digits={8} />
//   <NumberStream motion />                           steps a row up, looping
//   <NumberStream motion play label="Packet counter" />
//
// DECORATIVE unless labelled: without `label` it is aria-hidden (the digits
// mean nothing read aloud); with one it is role="img" named by it.
//
// `motion` STEPS the rows up one at a time — the stream advancing — on the
// art's clock and its gating (motion.css): paused at rest (the first rows
// are the poster), running under the pointer, inside a hovered or focused
// link, with `play` (data-art-play on itself) or under any ancestor that
// says data-art-play; a loop of --duration-loop per two rows, which is 0s
// under reduced motion, so nothing moves for that visitor. The rows are
// drawn twice for a seamless loop, so it holds `rows` lines' height.
//
// Site use: the micrographic migration's texture tiles and a widget's
// telemetry corner. `class` merges; everything else passes through.
import "../styles/number-stream.css";
import { cx } from "../lib/cx";
import { NUMBER_STREAM, numberStream } from "../lib/readouts";

interface Props {
	/** The seed (7). */
	seed?: number;
	/** Rows, 1–8 (2). */
	rows?: number;
	/** Digits per row, 1–16 (10). */
	digits?: number;
	/** Its accessible name; without one it is decorative. */
	label?: string;
	/** Step the rows up in a loop (paused at rest). */
	motion?: boolean;
	/** Run the motion from the start (data-art-play). */
	play?: boolean;
	class?: string;
	[key: string]: unknown;
}

const {
	seed = NUMBER_STREAM.seed,
	rows = NUMBER_STREAM.rows,
	digits = NUMBER_STREAM.digits,
	label,
	motion = false,
	play = false,
	class: className,
	...rest
} = Astro.props;

const lines = numberStream(seed, rows, digits);
const drawn = motion ? [...lines, ...lines] : lines;
---

<span
	class={cx("ds-number-stream", motion && "ds-number-stream--motion-true", className)}
	style={`--number-stream-rows: ${lines.length}`}
	data-art-play={play ? "" : undefined}
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
	{...rest}
><span class="ds-number-stream__rows">{drawn.map((row) => <span class="ds-number-stream__row">{row}</span>)}</span></span>
