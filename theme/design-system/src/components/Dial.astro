---
// Dial — a needle dial (the reference's FREQ dial), generated (lib/micro/
// gen/dial.ts) and rendered as a glyph through GlyphSvg: dashed hair
// ticks over the sweep, a needle from a hub dot. The needle is its own
// <g> (no motion unless a consumer adds one).
//
//   <Dial value={0.38} />                              five ticks, a blue needle
//   <Dial value={0.5} ticks={9} sweep={180} />
//   <Dial value={freq} label="Cutoff" paint="red" />   a labelled meter
//
// `value` 0–1; `ticks` 2–12 (5); `sweep` 90–330 degrees (270); `paint`
// the needle and hub (blue). With a `label` it is role="meter" with
// aria-value* as a percent, 0–100 (meterAria); without one it is
// aria-hidden. The host props are GlyphSvg's; data-gen="dial" on the root.
import GlyphSvg from "./GlyphSvg.astro";
import type { GlyphHostProps } from "../lib/glyph-host";
import { type GenPaint, dial, meterAria } from "../lib/micro/gen";

interface Props extends GlyphHostProps {
	/** 0–1, the needle's reading */
	value: number;
	/** 2–12 ticks; 5 unless said */
	ticks?: number;
	/** 90–330 degrees, the sweep; 270 unless said */
	sweep?: number;
	/** the needle and hub; blue unless said */
	paint?: GenPaint;
}

const { value, ticks, sweep, paint, ...rest } = Astro.props;
const meter = rest.label ? meterAria(value) : {};
---

<GlyphSvg svg={dial(value, { ticks, sweep, paint })} data-gen="dial" {...meter} {...rest} />
