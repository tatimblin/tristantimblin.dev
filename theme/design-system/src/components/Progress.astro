---
// Progress — a horizontal progress bar, generated (lib/micro/gen/
// progress.ts) and rendered as a glyph through GlyphSvg: the lit run a
// filled bar from the left, the remainder a dim hairline to an end tick.
//
//   <Progress value={0.62} />                          green, a dotted remainder
//   <Progress value={0.3} dotted={false} paint="blue" />
//   <Progress value={done / total} label="Upload" />   a labelled meter
//
// `value` 0–1; `dotted` the remainder dotted (true) or solid; `paint` the
// lit bar (green). With a `label` it is role="meter", aria-valuemin 0,
// aria-valuemax 100, aria-valuenow the whole percent and aria-valuetext
// "62%" (meterAria); without one it is aria-hidden. The host props are
// GlyphSvg's; data-gen="progress" on the root.
import GlyphSvg from "./GlyphSvg.astro";
import type { GlyphHostProps } from "../lib/glyph-host";
import { type GenPaint, meterAria, progress } from "../lib/micro/gen";

interface Props extends GlyphHostProps {
	/** 0–1, the fraction done */
	value: number;
	/** the remainder a dim dotted hairline (true) or a solid one */
	dotted?: boolean;
	/** the lit bar; green unless said */
	paint?: GenPaint;
}

const { value, dotted, paint, ...rest } = Astro.props;
const meter = rest.label ? meterAria(value) : {};
---

<GlyphSvg svg={progress(value, { dotted, paint })} data-gen="progress" {...meter} {...rest} />
