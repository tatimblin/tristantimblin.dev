---
// Anchor — DS styled('a', { …, variants: { discreet, external, arrow,
// underline } }), plus this site's `variant="ink"`.
//
// The DS Anchor.tsx computes an icon data-URI from the active variant and
// injects it via the `css` prop as `--icon: url(...)`. That is a real
// per-instance API, so it is rendered here as an inline
// `style="--anchor-icon: url(...)"` — allowed per CONVENTIONS.md (unlike an
// ad-hoc css prop). The two icons the site uses (the arrow, the external
// mark) are below; the upstream favicons (Twitter, GitHub, Bluesky) are gone
// with the `favicon` variant nothing set.
import { cx } from "../lib/cx";

export type ArrowPosition = "left" | "right";

// Base 64 of the ArrowIcon and the ExternalLink icon, width and height set
// to "var(--size, 1.05em)" inside the SVG (a separate document: the name is
// the upstream's, and no CSS variable reaches into a mask image anyway).
const ARROW =
	"data:image/svg+xml;base64,";
const EXTERNAL =
	"data:image/svg+xml;base64,";

interface Props {
	as?: string;
	href?: string;
	/** `ink`: the primary ink at rest, the accent under the pointer or focus,
	 *  no underline — a link that reads as text until it is pointed at (the
	 *  index's titles and tags, a handle). Default: the hyperlink colour. */
	variant?: "default" | "ink";
	/** Renders an arrow to the left or the right of the text */
	arrow?: ArrowPosition;
	/** An underline visible on hover; `"always"` draws it at rest too, in
	 *  the text's own colour (the accent under the pointer). */
	underline?: boolean | "always";
	/** Colors the Anchor typography tertiary to blend with the corpus */
	discreet?: boolean;
	/** Renders an external link icon */
	external?: boolean;
	class?: string;
	style?: string | Record<string, unknown>;
	[key: string]: unknown;
}

const {
	as = "a",
	href,
	variant = "default",
	arrow,
	underline,
	discreet,
	external,
	class: className,
	style,
	...rest
} = Astro.props;

const Tag = as as any;

// getIconString: an arrow wins; else the external mark; else none.
const icon = arrow ? ARROW : external ? EXTERNAL : null;

const cls = cx(
	"ds-anchor",
	// A link is a control (control.css): the pointer, the focus ring.
	"ds-control",
	variant !== "default" && `ds-anchor--variant-${variant}`,
	discreet && "ds-anchor--discreet-true",
	// external emits a rule only for the `true` case (the `false` key is empty).
	external && "ds-anchor--external-true",
	arrow && `ds-anchor--arrow-${arrow}`,
	underline && "ds-anchor--underline-true",
	underline === "always" && "ds-anchor--underline-always",
	className,
);

const iconStyle = icon ? `--anchor-icon: url(${icon})` : undefined;
const mergedStyle =
	typeof style === "string"
		? [iconStyle, style].filter(Boolean).join(";")
		: iconStyle || undefined;
---

<Tag class={cls} href={href} style={mergedStyle} {...rest}><slot /></Tag>
