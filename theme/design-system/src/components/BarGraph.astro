---
// BarGraph — vertical hairlines with data heights (styles/bar-graph.css).
//
//   <BarGraph values={[3, 5, 8, 13, 21]} />               scaled to the max
//   <BarGraph values={hours} max={24} mark="last" />      one bar in the accent
//   <BarGraph values={v} mark={2} height="var(--space-8)" />
//   <BarGraph values={v} label="Visitors per day, last month" />
//   <BarGraph values={v} mark={peak} interactive />       a script reads it back
//
// Accessibility: with a `label` the graph is an
// image with that name; without one it is decoration and hidden from the
// tree (a caller that upgrades it into a control — a slider over the bars —
// removes aria-hidden and sets its own role and name; both come after the
// defaults, so pass-through attributes win).
//
// `interactive` is for that caller: the graph composes `ds-control` (the
// focus ring, once — the caller's script gives it the role, the name and
// the tabindex, so a graph the script never reached stays a picture), takes
// a crosshair once it is a slider, and leaves vertical touch drags to the
// page. The bars are moved with `markBar(graph, i)` from `lib/bar-graph`,
// which owns the `data-mark` contract (bar-graph.css) — a script never
// selects the package's bar class itself.
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	values: number[];
	/** The value that fills the height; defaults to the largest value. */
	max?: number;
	/** Index of the bar to draw in the accent (the MARK — the peak, the
	 *  latest), or "last" / "max". */
	mark?: number | "last" | "max";
	/** CSS length: the graph's height (default --space-10). */
	height?: string;
	/** Accessible name; without one the graph is aria-hidden. */
	label?: string;
	/** A script will read it back (lib/bar-graph): the ring, the crosshair. */
	interactive?: boolean;
	class?: string;
	style?: string;
	[key: string]: unknown;
}

const {
	as = "div",
	values = [],
	max,
	mark,
	height,
	label,
	interactive = false,
	class: className,
	style,
	...rest
} = Astro.props;

const Tag = as as any;
const top = max ?? Math.max(0, ...values);
const markIndex =
	mark === "last"
		? values.length - 1
		: mark === "max"
			? values.indexOf(Math.max(...values))
			: typeof mark === "number"
				? mark
				: -1;

const vars = [height && `--bar-graph-height:${height}`, style].filter(Boolean).join(";");
---

<Tag
	class={cx(
		"ds-bar-graph",
		interactive && "ds-bar-graph--interactive-true",
		interactive && "ds-control",
		className,
	)}
	style={vars || undefined}
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
	{...rest}
>
	{
		values.map((v: number, i: number) => (
			<span
				class="ds-bar-graph__bar"
				style={`--bar-value:${top > 0 ? Math.min(Math.max(v / top, 0), 1) : 0}`}
				data-mark={i === markIndex ? "" : undefined}
			/>
		))
	}
</Tag>
