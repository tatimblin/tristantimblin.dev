---
// DimensionLabel — a label on a dimension line, the drawing's way of naming a
// span (styles/dimension-label.css): `|—•—•— ENTRIES —•—•—|`. An end tick at
// each edge, a hairline across the width with dots on an even pitch, and the
// caps label centred on it with a gap either side. A section's label on the
// spec sheet: it spans the section it names.
//
//   <DimensionLabel>Signal chain</DimensionLabel>
//   <DimensionLabel as="h2">Entries</DimensionLabel>
//
// The line is drawn by the box's ::before / ::after, so it is never read out;
// the label is the only text, in the caps Mono's voice on its own span (so
// the caps' trailing-tracking pull keeps it centred). Polymorphic `as` (a
// heading when it heads a section: the label's span sets its own type, so a
// heading's size does not reach it); `class` merges; everything else passes
// through.
import "../styles/dimension-label.css";
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	class?: string;
	[key: string]: unknown;
}

const { as = "div", class: className, ...rest } = Astro.props;
const Tag = as as any;
---

<Tag class={cx("ds-dimension-label", className)} {...rest}>
	<span class="ds-dimension-label__text ds-mono ds-caps"><slot /></span>
</Tag>
