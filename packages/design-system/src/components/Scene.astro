---
// Scene — the L4 host (styles/scene.css): a baked scene from the registry
// (src/scenes/<name>.svg, `bun run scenes:bake` from tools/scenes/<name>/)
// on an ArtFrame, with a layer of HTML READOUTS over it — the console's
// labels, tags and numerals, real text sized by the scene's width — and the
// file's credit under it.
//
//   <Scene name="globe" label="The Earth over the Atlantic, tracked" tone="green" play glow>
//     <SceneLabel at="tl">300.733 MHz</SceneLabel>
//     <SceneLabel x={12} y={13}><Chip tone="accent">Earth 001</Chip></SceneLabel>
//     <SceneLabel at="br" variant="numeral" size="xl">06</SceneLabel>
//   </Scene>
//   <Scene name="globe" decorative credit={false} />       no readouts, no credit line
//
// IT IS AN ARTFRAME. The gate's first rung: the window on the plate, the
// edge and corner, the clip, the line weights and the motion contract are
// ArtFrame's, and a scene takes them as they are (`variant` bare / corners
// too; not `mark`, which retunes the ink for a title's margin). What a
// scene adds is the readout layer, and that is the reason it is not the
// frame's own slot: a labelled frame is `role="img"`, whose children are
// presentational, so text inside it would be lost to a reader. The layer
// is the frame's SIBLING in one grid cell, over it, and the scene (not the
// frame) is what hovering plays (motion.css). Readouts are decorative HUD
// text as far as the DRAWING's name goes — `label` names the picture, the
// readouts say what they say — but they are real text: selectable, read.
//
// `ratio` is the box's aspect ratio; the file's viewBox unless said
// (`"1"` for the 400×400 panel, `"16 / 9"` for the plate), and the frame
// clips as it always does. `tone` colours the whole readout layer — the
// console's phosphor (`green`), one of the four colours or the dimmed ink —
// where a label's own `tone` overrides. `credit` is the line under the frame: the
// file's header's unless said, `false` for none — a licensed source (a
// map, a scan) is credited on the page that shows it. `glow` is the CRT's
// bloom, dark page only. `play` runs the motion from the start. `class`
// merges; everything else passes through to the root, which carries
// `data-scene="<name>"`.
import { cx } from "../lib/cx";
import { viewBoxOf } from "../lib/inline-svg";
import { type SceneName, sceneCredit, sceneSvg } from "../scenes/scenes";
import ArtFrame from "./ArtFrame.astro";
import Mono from "./Mono.astro";

interface Props {
	name: SceneName;
	/** Accessible name of the drawing: the frame is role="img" aria-label. Without one it is aria-hidden. */
	label?: string;
	/** Explicitly decorative (aria-hidden); the default when there is no label. */
	decorative?: boolean;
	/** Motion running from the start, not only under the pointer. */
	play?: boolean;
	/** The CRT's bloom on the line work and the readouts: the dark page only. */
	glow?: boolean;
	/** The box's ratio (`--art-ratio`); the file's viewBox unless said. */
	ratio?: string;
	/** The readout layer's colour: the ink (default), dim, or one of the four colours. */
	tone?: "ink" | "dim" | "green" | "red" | "blue" | "lavender";
	/** The credit under the frame; the file's unless said, `false` for none. */
	credit?: string | false;
	/** ArtFrame's window (default), or bare / corners: no plate, edge or corner. */
	variant?: "frame" | "bare" | "corners";
	class?: string;
	[key: string]: unknown;
}

const {
	name,
	label,
	decorative = false,
	play = false,
	glow = false,
	ratio,
	tone,
	credit: creditProp,
	variant = "frame",
	class: className,
	...rest
} = Astro.props;

const svg = sceneSvg(name);
const vb = viewBoxOf(svg);
const box = ratio ?? (vb ? `${vb[2]} / ${vb[3]}` : "1");
const credit = creditProp === false ? undefined : (creditProp ?? sceneCredit(name));
const hasReadouts = Astro.slots.has("default");
---

<div
	class={cx(
		"ds-scene",
		glow && "ds-scene--glow-true",
		tone && tone !== "ink" && `ds-scene--tone-${tone}`,
		variant !== "frame" && `ds-scene--variant-${variant}`,
		className,
	)}
	data-scene={name}
	{...rest}
>
	<ArtFrame
		svg={svg}
		class="ds-scene__frame"
		style={`--art-ratio: ${box}`}
		label={label}
		decorative={decorative}
		play={play}
		variant={variant}
	/>
	{hasReadouts && (
		<div class="ds-scene__readouts">
			<slot />
		</div>
	)}
	{credit && <Mono variant="text" class="ds-scene__credit">{credit}</Mono>}
</div>
