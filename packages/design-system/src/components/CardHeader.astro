---
// Card.Header — DS styled('div', {...}). No variants.
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	class?: string;
	[key: string]: unknown;
}

const { as = "div", class: className, ...rest } = Astro.props;
const Tag = as as any;
---

<Tag class={cx("ds-card-header", className)} {...rest}><slot /></Tag>
