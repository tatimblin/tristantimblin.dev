---
// ReadoutStack — a column of values with ONE emphasised (styles/
// readout-stack.css): the synth panel's sample-rate tile, 32.0k / 44.1k /
// 96.0k with 44.1k lit. The emphasised value is the spec sheet's thin
// numeral (the display role, Mondwest Thin); the others sit above and
// below it in the label voice, a step back in the tertiary ink.
//
//   <ReadoutStack values={["32.0k", "44.1k", "96.0k"]} active={1} />
//   <GlyphTile label="Rate"><ReadoutStack values={…} active={1} /></GlyphTile>
//
// It is a list: each value an <li>, the emphasised one `aria-current="true"`
// — the drawing is read off that attribute, as a Chip's selection is, so
// what a reader is told and what is drawn cannot part. `active` is an index,
// clamped into the list (0 when it is not a number). Give it an
// `aria-label` ("Sample rate") when nothing beside it names it. Centred, so
// it sits in a GlyphTile's cap (default slot) as a glyph would.
//
// Site use: the micrographic migration's readout tiles — a setting shown
// among its neighbours (a widget's range, a rate, a step). `class` merges;
// everything else passes through to the list.
import "../styles/readout-stack.css";
import { cx } from "../lib/cx";
import { activeIndex } from "../lib/readouts";

interface Props {
	/** The values, top to bottom. */
	values: readonly (string | number)[];
	/** The index of the emphasised value (clamped; 0 by default). */
	active?: number;
	class?: string;
	[key: string]: unknown;
}

const { values = [], active = 0, class: className, ...rest } = Astro.props;
const at = activeIndex(active, values.length);
---

<ul class={cx("ds-readout-stack", className)} role="list" {...rest}>
	{values.map((v, i) => (
		<li class="ds-readout-stack__value" aria-current={i === at ? "true" : undefined}>{v}</li>
	))}
</ul>
