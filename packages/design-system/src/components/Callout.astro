---
// Callout — DS styled('aside', { …, variants: { variant } }) + icon/label badge.
// Exact port of the variant API. `variant` is a required prop (no defaultVariants).
//
// Icon handling (NO React, Icon component ported separately):
//   The DS `getVariantIcon(variant)` renders <Icon.Info size={4} /> for `info`
//   and <Icon.Alert size={4} /> for `danger`; `warning` falls through and gets
//   NO icon. size={4} → 20x20, stroke="currentColor" (the wrapper sets
//   `color: var(--background)`), so we inline those exact SVGs at 20x20.
//   An icon is only rendered when there is no `label` (matching the source).
//   We ALSO expose a named `icon` slot: when provided it overrides the default
//   inline SVG, so callers can pass their own markup once the Icon port lands.
import { cx } from "../lib/cx";

type CalloutVariant = "info" | "danger" | "warning";

interface Props {
	as?: string;
	variant?: CalloutVariant;
	label?: string;
	class?: string;
	[key: string]: unknown;
}

const {
	as = "aside",
	variant,
	label,
	class: className,
	...rest
} = Astro.props;

const Tag = as as any;

const hasIconSlot = Astro.slots.has("icon");
// Match the source: icon only shows when there is no label. warning has no
// default icon, but a caller-provided `icon` slot still renders.
const showDefaultIcon = !label && (variant === "info" || variant === "danger");
const showIcon = !label && (hasIconSlot || showDefaultIcon);

const cls = cx(
	"ds-callout",
	variant && `ds-callout--variant-${variant}`,
	className,
);

const iconWrapperCls = cx(
	"ds-callout__icon",
	variant && `ds-callout__icon--variant-${variant}`,
);

const labelWrapperCls = cx(
	"ds-callout__label",
	variant && `ds-callout__label--variant-${variant}`,
);
---

<Tag class={cls} {...rest}>
	{
		showIcon && (
			<div class={iconWrapperCls} data-testid={`callout-icon-${variant}`}>
				{hasIconSlot ? (
					<slot name="icon" />
				) : variant === "info" ? (
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						role="img"
					>
						<circle cx="12" cy="12" r="10" />
						<path d="M12 16V11.5" />
						<path d="M12 8.01172V8.00172" />
					</svg>
				) : (
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						role="img"
					>
						<path d="M21.5 12.6863V11.3137C21.5 9.67871 21.5 8.8612 21.1955 8.12612C20.891 7.39104 20.313 6.81297 19.1569 5.65685L18.3431 4.84315C17.187 3.68702 16.609 3.10896 15.8739 2.80448C15.1388 2.5 14.3213 2.5 12.6863 2.5H11.3137C9.67871 2.5 8.8612 2.5 8.12612 2.80448C7.39104 3.10896 6.81297 3.68702 5.65685 4.84315L4.84315 5.65685C3.68702 6.81298 3.10896 7.39104 2.80448 8.12612C2.5 8.8612 2.5 9.67871 2.5 11.3137V12.6863C2.5 14.3213 2.5 15.1388 2.80448 15.8739C3.10896 16.609 3.68702 17.187 4.84315 18.3431L5.65685 19.1569C6.81297 20.313 7.39104 20.891 8.12612 21.1955C8.8612 21.5 9.67871 21.5 11.3137 21.5H12.6863C14.3213 21.5 15.1388 21.5 15.8739 21.1955C16.609 20.891 17.187 20.313 18.3431 19.1569L19.1569 18.3431C20.313 17.187 20.891 16.609 21.1955 15.8739C21.5 15.1388 21.5 14.3213 21.5 12.6863Z" />
						<path d="M12 8L12 12.5" />
						<path d="M12 15.9883V15.9983" />
					</svg>
				)}
			</div>
		)
	}
	{
		label && (
			<div class={labelWrapperCls} data-testid={`callout-label-${variant}`}>
				{label}
			</div>
		)
	}
	<slot />
</Tag>
