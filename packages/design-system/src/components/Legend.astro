---
// Legend — dot · label · value rows, ranked by position (styles/legend.css).
//
//   <Legend items={[{ label: "rust", value: "46%" }, { label: "typescript", value: "29%" }]} />
//   <Legend>
//     <LegendItem label="home" value="3" color="var(--tone-2)" />
//     <LegendItem label="away"><Fragment slot="value">…</Fragment></LegendItem>
//   </Legend>
//
// Pass `items` for the plain case; use LegendItem children when a row needs
// its own markup or attributes. The first row's dot is the accent unless a
// `color` says otherwise.
import { cx } from "../lib/cx";
import LegendItem from "./LegendItem.astro";

interface Item {
	label: string;
	value?: string | number;
	color?: string;
}

interface Props {
	as?: string;
	items?: Item[];
	class?: string;
	[key: string]: unknown;
}

const { as = "ul", items, class: className, ...rest } = Astro.props;
const Tag = as as any;
---

<Tag class={cx("ds-legend", className)} {...rest}>
	{items?.map((it) => <LegendItem label={it.label} value={it.value} color={it.color} />)}
	<slot />
</Tag>
