---
// Card.Body — the card's content box (styles/card.css); inside a Widget it
// fills the rest of the cell as a flex column.
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	class?: string;
	[key: string]: unknown;
}

const { as = "div", class: className, ...rest } = Astro.props;
const Tag = as as any;
---

<Tag class={cx("ds-card-body", className)} {...rest}><slot /></Tag>
