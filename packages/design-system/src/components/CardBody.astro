---
// Card.Body — DS styled('div', { variants: { dotMatrix } }).
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	dotMatrix?: boolean;
	class?: string;
	[key: string]: unknown;
}

const { as = "div", dotMatrix, class: className, ...rest } = Astro.props;
const Tag = as as any;

const cls = cx(
	"ds-card-body",
	dotMatrix && "ds-card-body--dot-matrix-true",
	className,
);
---

<Tag class={cls} {...rest}><slot /></Tag>
