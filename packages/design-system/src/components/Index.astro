---
// Index — a ruled index table (styles/index-table.css):
// rows on the page's column template, cut by hairlines, opened by an
// INVERTED head row (the ink with the page colour on it). A `nav` by
// default — it is a list of places to go — named by the caller.
//
//   <Index aria-label="Index">
//     <IndexRow head><Mono>index</Mono><Mono>no.</Mono><Mono>title</Mono><Mono class="ds-index__fold">filed</Mono></IndexRow>
//     <IndexRow><Mono>tags</Mono><Mono tone="primary">005</Mono><Mono tone="primary" class="ds-index__span">…</Mono></IndexRow>
//     <IndexRow><Mono>← previous</Mono><Mono tone="primary">004</Mono><Anchor variant="ink" class="ds-index__title" href="…">…</Anchor><Mono class="ds-index__fold">jun 2025</Mono></IndexRow>
//     <IndexRow dim><Mono>next →</Mono><Mono>—</Mono><Text class="ds-index__title" variant="tertiary">Nothing newer</Text><Mono class="ds-index__fold">—</Mono></IndexRow>
//   </Index>
//
// The columns are `--ruled-columns` / `--ruled-gap` (the tokens Prose and Fig
// read), or `columns` here. Every child of a row is a cell; three cell
// classes name the ones that behave: `ds-index__title` is the reading-size
// cell (a link, at the UI leading), `ds-index__span` takes the rest of the
// row, `ds-index__fold` is the fourth column, which FOLDS under the title
// below 1024, where the rows collapse to three columns (label, number, the
// rest) and a head or dim row drops it. `class` merges; the rest passes to
// the root.
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	/** A grid-template-columns value; default the page's `--ruled-columns`. */
	columns?: string;
	class?: string;
	style?: string;
	[key: string]: unknown;
}

const { as = "nav", columns, class: className, style, ...rest } = Astro.props;
const Tag = as as any;
const vars = [columns && `--index-columns:${columns}`, style].filter(Boolean).join(";");
---

<Tag class={cx("ds-index", className)} style={vars || undefined} {...rest}><slot /></Tag>
