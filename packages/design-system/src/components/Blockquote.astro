---
// Blockquote — the quote on the ruled page (styles/blockquote.css): no fill,
// a bar of the accent down the left edge (the one place the accent appears
// in a post's text), the words a step up — the body face at --font-size-5 in
// the primary ink, set by retuning the body role's tokens in scope (the Body
// inside reads them), not by restyling .ds-body. Markdown `>` maps here
// (src/components/mdx-components.ts), so the paragraphs inside arrive as
// Body. An attribution, when there is one, is a `footer` in the caps mono
// after the words — or, in a post, the sections plugin moves it out into a
// `figure.ds-prose-quote`'s caption.
//
//   <Blockquote><Body>…</Body></Blockquote>
//   <Blockquote cite="https://…">…</Blockquote>
//   <Blockquote>
//     <Body>…</Body>
//     <Mono as="footer">Brace Sproul / LangChain</Mono>     the attribution
//   </Blockquote>
import { cx } from "../lib/cx";

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<blockquote class={cx("ds-blockquote", className)} {...rest}><slot /></blockquote>
