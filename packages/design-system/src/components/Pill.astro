---
// Pill — a capsule of caps mono (styles/pill.css). No variant = `subtle`.
//
//   <Pill>low risk</Pill>                         subtle: the ink wash
//   <Pill variant="outline">0/360°</Pill>         a hairline, no fill
//   <Pill as="button" type="button">tap</Pill>    a pill button
//   <Pill as="a" href="…" variant="outline">home</Pill>
//
// An icon goes in the default slot ahead of the text; it is sized to the type.
// The voice is the `ds-mono ds-caps` classes composed here; as a button or a
// link it is a `ds-control` too.
import { cx } from "../lib/cx";

type Variant = "subtle" | "outline";

interface Props {
	as?: string;
	variant?: Variant;
	class?: string;
	[key: string]: unknown;
}

const { as = "span", variant = "subtle", class: className, ...rest } = Astro.props;

const Tag = as as any;

const cls = cx(
	"ds-pill",
	// The voice: the caps mono, declared once (mono.css, caps.css).
	"ds-mono",
	"ds-caps",
	// As a button or a link it is a control: the reset, the pointer, the ring
	// and the disabled state are control.css's.
	(as === "button" || as === "a") && "ds-control",
	`ds-pill--variant-${variant}`,
	className,
);
---

<Tag class={cls} {...rest}><slot /></Tag>
