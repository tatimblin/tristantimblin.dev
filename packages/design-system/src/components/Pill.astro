---
// Pill — a capsule of caps mono (styles/pill.css). No variant = `subtle`.
//
//   <Pill>low risk</Pill>                         subtle ink wash
//   <Pill variant="outline">0/360°</Pill>
//   <Pill variant="accent" as="a" href="…">next</Pill>   the CTA
//   <Pill as="button" type="button">tap</Pill>    a pill button
//   <Pill variant="success">live</Pill>           the DS tints still exist
//   <Pill as="a" size="lg" href="/txt?q=projects" aria-current="page">projects</Pill>   a tab
//
// An icon goes in the default slot ahead of the text; it is sized to the type.
// `size="lg"` is the tab step — the pill-button height of the instrument's
// tab row (--space-6), wider inside — for a row of pills that is the page's
// primary control rather than a badge; `aria-current` on one of them draws
// it as the selected tab (the subtle fill, no edge). This site's step, not
// upstream's, like IconButton's xs and xl.
import { cx } from "../lib/cx";

type Variant =
	| "subtle"
	| "outline"
	| "accent"
	| "info"
	| "success"
	| "warning"
	| "danger";

interface Props {
	as?: string;
	variant?: Variant;
	size?: "md" | "lg";
	// The DS `dark` variant exists but carries no rules, so no class.
	dark?: boolean;
	class?: string;
	[key: string]: unknown;
}

const {
	as = "span",
	variant = "subtle",
	size = "md",
	dark: _dark,
	class: className,
	...rest
} = Astro.props;

const Tag = as as any;

const cls = cx(
	"ds-pill",
	// The voice: the caps mono, declared once (mono.css, caps.css).
	"ds-mono",
	"ds-caps",
	`ds-pill--variant-${variant}`,
	size !== "md" && `ds-pill--size-${size}`,
	className,
);
---

<Tag class={cls} {...rest}><slot /></Tag>
