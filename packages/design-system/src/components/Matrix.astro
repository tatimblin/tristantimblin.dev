---
// Matrix — a grid of pips, generated (lib/micro/gen/matrix.ts) and
// rendered as a glyph through GlyphSvg: lit cells, hot cells in the
// accent, and the x/o grid with a square cursor. Past six columns it
// takes the wide 96 × 32 viewBox (so it renders twice as wide).
//
//   <Matrix hot={[2, 2]} />                                   4 × 5 blue pips, one red
//   <Matrix rows={6} cols={10} on="1011001110;0100110001" />  a lit pattern
//   <Matrix rows={3} cols={3} mark="x" on="100;010;001" cursor={[1, 1]} />
//
// `rows` 1–6, `cols` 1–10; `on` a pattern ("10110;01001") or row bitmasks
// (the most significant of `cols` bits leftmost); `hot` one [row, col] or
// a list; `mark` pip | dot | x; `cursor` one [row, col]; `paint` (blue);
// `accent` the hot cells and cursor (red). The host props are
// GlyphSvg's; data-gen="matrix" data-mark="<mark>" on the root.
import GlyphSvg from "./GlyphSvg.astro";
import type { GlyphHostProps } from "../lib/glyph-host";
import { type AccentPaint, type Cell, type GenPaint, type MatrixMark, matrix } from "../lib/micro/gen";

interface Props extends GlyphHostProps {
	/** 1–6; 4 unless said */
	rows?: number;
	/** 1–10; 5 unless said */
	cols?: number;
	/** the lit cells: a pattern or row bitmasks */
	on?: string | readonly number[];
	/** cells in the accent */
	hot?: Cell | readonly Cell[];
	/** pip, dot or x; pip unless said */
	mark?: MatrixMark;
	/** a square round one cell */
	cursor?: Cell;
	/** blue unless said */
	paint?: GenPaint;
	/** the hot cells and cursor; red unless said */
	accent?: AccentPaint;
}

const { rows, cols, on, hot, mark = "pip", cursor, paint, accent, ...rest } = Astro.props;
---

<GlyphSvg svg={matrix(rows, cols, { on, hot, mark, cursor, paint, accent })} data-gen="matrix" data-mark={mark} {...rest} />
