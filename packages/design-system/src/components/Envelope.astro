---
// Envelope — an ADSR envelope, generated (lib/micro/gen/envelope.ts) and
// rendered as a glyph through GlyphSvg. One path from the baseline and
// back to it.
//
//   <Envelope />                                         the reference ADSR
//   <Envelope a={0.1} d={0} s={1} h={0.2} r={0.4} />     an AR
//   <Envelope a={0.5} d={0.5} s={0} paint="red" />       an AD
//
// `a` `d` `h` `r` are relative times 0–1 (shared out in proportion), `s`
// the sustain level 0–1; a zero-width stage is left out rather than
// drawn as a hook. The host props are GlyphSvg's; data-gen="envelope"
// on the root.
import GlyphSvg from "./GlyphSvg.astro";
import type { GlyphHostProps } from "../lib/glyph-host";
import { type GenPaint, envelope } from "../lib/micro/gen";

interface Props extends GlyphHostProps {
	/** attack, 0–1 relative */
	a?: number;
	/** decay, 0–1 relative */
	d?: number;
	/** sustain level, 0–1 of the peak */
	s?: number;
	/** hold, 0–1 relative */
	h?: number;
	/** release, 0–1 relative */
	r?: number;
	/** blue unless said */
	paint?: GenPaint;
}

const { a, d, s, h, r, paint, ...rest } = Astro.props;
---

<GlyphSvg svg={envelope({ a, d, s, h, r, paint })} data-gen="envelope" {...rest} />
