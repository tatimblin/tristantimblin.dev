---
// Ladder — a level ladder, generated (lib/micro/gen/ladder.ts) and
// rendered as a glyph through GlyphSvg: stacked hairline bars, the lit
// ones in the paint, the rest dim.
//
//   <Ladder value={0.66} />                               6 of 9 lit, blue, vertical
//   <Ladder lit={4} steps={6} />
//   <Ladder value={0.5} axis="horizontal" paint="green" label="Signal" />
//
// `value` 0–1 (lit to the nearest step) or `lit` 0–steps (wins); `steps`
// 2–12 (9); `axis` vertical | horizontal; `paint` the lit bars (blue).
// With a `label` it is role="meter", aria-value* as a percent 0–100 of
// the lit bars and aria-valuetext "6 of 9"; without one it is aria-hidden.
// The host props are GlyphSvg's; data-gen="ladder" data-axis on the root.
import GlyphSvg from "./GlyphSvg.astro";
import type { GlyphHostProps } from "../lib/glyph-host";
import { type GenPaint, type LadderAxis, ladder, ladderLevel, meterAria } from "../lib/micro/gen";

interface Props extends GlyphHostProps {
	/** 0–1, lit to the nearest whole step */
	value?: number;
	/** 0–steps, the lit count; wins over `value` */
	lit?: number;
	/** 2–12 bars; 9 unless said */
	steps?: number;
	axis?: LadderAxis;
	/** the lit bars; blue unless said */
	paint?: GenPaint;
}

const { value = 0, lit, steps, axis = "vertical", paint, ...rest } = Astro.props;
const level = ladderLevel(value, { steps, lit });
const meter = rest.label ? meterAria(level.lit / level.steps, `${level.lit} of ${level.steps}`) : {};
---

<GlyphSvg svg={ladder(value, { steps, lit, axis, paint })} data-gen="ladder" data-axis={axis} {...meter} {...rest} />
