---
// Wave — a waveform, generated (lib/micro/gen/wave.ts) and rendered as a
// glyph through GlyphSvg: the same sizing, dimming, motion gating and ARIA
// as <Glyph>. One path in the wave's paint; a burst sits on a dim guide.
//
//   <Wave shape="sine" />                            two blue cycles
//   <Wave shape="saw" cycles={3} paint="red" size={8} />
//   <Wave shape="noise" seed={11} label="white noise" />
//
// `shape` sine | saw | square | triangle | noise | burst; `cycles` 1–6;
// `amp` 1–12; `seed` for noise and burst; `paint` the line (the sheet's
// per-shape default). The host props (size, label, play, class, rest)
// are GlyphSvg's; data-gen="wave" data-shape="<shape>" on the root.
import GlyphSvg from "./GlyphSvg.astro";
import type { GlyphHostProps } from "../lib/glyph-host";
import { type GenPaint, type WaveShape, wave } from "../lib/micro/gen";

interface Props extends GlyphHostProps {
	shape?: WaveShape;
	/** 1–6 whole cycles across the tile; 2 unless said */
	cycles?: number;
	/** 1–12 units either side of the midline; 8 unless said */
	amp?: number;
	/** the noise's or burst's seed; 7 unless said */
	seed?: number;
	/** the line's paint; the reference's per shape unless said */
	paint?: GenPaint;
}

const { shape = "sine", cycles, amp, seed, paint, ...rest } = Astro.props;
---

<GlyphSvg svg={wave(shape, { cycles, amp, seed, paint })} data-gen="wave" data-shape={shape} {...rest} />
