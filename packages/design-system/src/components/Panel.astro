---
// Panel — one flat surface of a Panels screen (styles/panels.css): the card
// colour, a few percent off the page, with no edge of its own — the gutter
// between panels is the edge. `pad` is the inset step: none, sm (--space-3),
// md (--space-4, the default) or lg (--space-5); lay the inside out in your
// own CSS. `class` merges; the rest passes to the root.
//
//   <Panel>…</Panel>
//   <Panel pad="none" class="controls__count">…</Panel>
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	pad?: "none" | "sm" | "md" | "lg";
	class?: string;
	[key: string]: unknown;
}

const { as = "div", pad = "md", class: className, ...rest } = Astro.props;
const Tag = as as any;
---

<Tag class={cx("ds-panel", pad !== "none" && `ds-panel--pad-${pad}`, className)} {...rest}>
	<slot />
</Tag>
