---
// Widget — a standard cell in a <WidgetGrid>: a DS Card with the span classes
// for its size, so every widget gets the flat card chrome and the header —
// `title` left, the `meta` slot right — for free. Body content goes in a
// <CardBody>, which fills the rest of the cell (styles/widget-grid.css):
//
//   <Widget size="1x1" title="github">
//     <Mono slot="meta" as="a" variant="text" href="…">@handle</Mono>
//     <CardBody>…</CardBody>
//   </Widget>
import { cx } from "../lib/cx";
import Card from "./Card.astro";

type Size = "1x1" | "2x1" | "1x2" | "2x2";

interface Props {
	size?: Size;
	title?: string;
	variant?: "primary" | "secondary" | "tertiary";
	class?: string;
	[key: string]: unknown;
}

const { size = "1x1", title, variant, class: className, ...rest } = Astro.props;

const [w, h] = size.split("x").map(Number);
const cls = cx(
	"ds-widget",
	w === 2 && "ds-widget--w2",
	h === 2 && "ds-widget--h2",
	className,
);

// See Card.astro: forwarded only when filled.
const hasMeta = Astro.slots.has("meta");
---

<Card class={cls} variant={variant} title={title} {...rest}>
	{
		hasMeta ? (
			<Fragment slot="meta">
				<slot name="meta" />
			</Fragment>
		) : null
	}
	<slot />
</Card>
