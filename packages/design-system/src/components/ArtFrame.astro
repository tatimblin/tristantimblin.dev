---
// ArtFrame — the window every artwork renders through (styles/art-frame.css).
// Takes the raw text of an art file (one from the package's src/art/, or a
// baked scene) and inlines it on the plate: inline, because
// the file's colours are the --art-* tokens and its motion is this frame's
// CSS, neither of which reaches an <img>.
//
//   <ArtFrame svg={raw} label="The globe" />      role="img", standalone
//   <ArtFrame svg={raw} decorative />             aria-hidden: inside a link that names it
//   <ArtFrame svg={raw} label="…" play />         motion running from the start
//
// The art is decorative inside a link — the LINK carries the title — so a
// frame with no `label` is aria-hidden whether or not it says `decorative`;
// the prop is there to make the choice visible at the call site. Motion runs
// on hover and focus by itself; `play` sets data-art-play, the attribute a
// script may toggle too. `class` merges; everything else passes through.
//
// The box is the file's 16:9 (a caller may retune `--art-ratio` in scope)
// and it clips.
import { cx } from "../lib/cx";
import { inlineSvg } from "../lib/inline-svg";

interface Props {
	/** The raw SVG file text (import it with `?raw`). */
	svg: string;
	/** Accessible name: renders role="img" aria-label. Without one the frame is aria-hidden. */
	label?: string;
	/** Explicitly decorative (aria-hidden); the default when there is no label. */
	decorative?: boolean;
	/** Motion running from the start, not only under the pointer. */
	play?: boolean;
	as?: string;
	class?: string;
	[key: string]: unknown;
}

const {
	svg,
	label,
	decorative = false,
	play = false,
	as = "div",
	class: className,
	...rest
} = Astro.props;

const Tag = as as any;

// The file, made an inline fragment (lib/inline-svg: prolog, doctype and
// comments dropped). The root takes aria-hidden/focusable (the frame, not
// the svg, carries the name) and the slice fit, so a box of another ratio
// crops rather than letterboxes; a file that sets its own fit keeps it.
const inner = inlineSvg(svg, {
	host: "ArtFrame",
	attrs: { "aria-hidden": "true", focusable: "false", preserveAspectRatio: "xMidYMid slice" },
});

const cls = cx("ds-art-frame", className);

const a11y = label && !decorative
	? { role: "img", "aria-label": label }
	: { "aria-hidden": "true" };
---

<Tag class={cls} data-art-play={play ? "" : undefined} {...a11y} {...rest}>
	<Fragment set:html={inner} />
</Tag>
