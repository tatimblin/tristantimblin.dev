---
// ArtFrame — the window every artwork renders through (styles/art-frame.css).
// Takes the raw text of an art file (src/content/txt/<slug>.svg, or a filler
// from the package's src/art/) and inlines it on the plate: inline, because
// the file's colours are the --art-* tokens and its motion is this frame's
// CSS, neither of which reaches an <img>.
//
//   <ArtFrame svg={raw} label="The Mega Desk" />        role="img", standalone (a hero, the catalogue)
//   <ArtFrame svg={raw} decorative />                   aria-hidden: inside a link that names the post, or a filler
//   <ArtFrame svg={raw} label="…" play />               motion running (the open post)
//   <ArtFrame svg={raw} label="…" ratio="2 / 1" chrome={false} />   another crop, no plate or edge
//
// The art is decorative inside a link — the LINK carries the title — so a
// frame with no `label` is aria-hidden whether or not it says `decorative`;
// the prop is there to make the choice visible at the call site. Motion runs
// on hover and focus by itself; `play` sets data-art-play, the attribute a
// script may toggle too. `class` merges; everything else passes through.
import { cx } from "../lib/cx";

interface Props {
	/** The raw SVG file text (import it with `?raw`). */
	svg: string;
	/** Accessible name: renders role="img" aria-label. Without one the frame is aria-hidden. */
	label?: string;
	/** Explicitly decorative (aria-hidden); the default when there is no label. */
	decorative?: boolean;
	/** Motion running from the start, not only under the pointer. */
	play?: boolean;
	/** A CSS aspect-ratio; the drawing is cropped to it. Default 16 / 9, the file's own. */
	ratio?: string;
	/** false: no plate, edge or corner — the drawing straight on the page. */
	chrome?: boolean;
	as?: string;
	class?: string;
	style?: string;
	[key: string]: unknown;
}

const {
	svg,
	label,
	decorative = false,
	play = false,
	ratio,
	chrome = true,
	as = "div",
	class: className,
	style,
	...rest
} = Astro.props;

const Tag = as as any;

// The file, made an inline fragment: drop the XML prolog and any doctype (an
// editor's, not the language's), and the comments — the template's grid and
// safe-area notes are for the author, not the page. Then the root takes
// aria-hidden/focusable (the frame, not the svg, carries the name) and the
// slice fit that lets a `ratio` crop instead of letterbox.
const body = svg
	.replace(/^\s*<\?xml[^>]*\?>/i, "")
	.replace(/^\s*<!DOCTYPE[^>]*>/i, "")
	.replace(/<!--[\s\S]*?-->/g, "")
	.trim();
if (!/^<svg[\s>]/i.test(body)) {
	throw new Error(
		"ArtFrame: `svg` must be the raw text of an SVG file (import it with `?raw`).",
	);
}
const root = body.match(/^<svg[^>]*>/i)![0];
const fit = /preserveAspectRatio=/i.test(root)
	? ""
	: ' preserveAspectRatio="xMidYMid slice"';
const inner = body.replace(
	/^<svg/i,
	`<svg aria-hidden="true" focusable="false"${fit}`,
);

const cls = cx("ds-art", !chrome && "ds-art--chrome-false", className);
const vars = [ratio && `--art-ratio:${ratio}`, style].filter(Boolean).join(";");

const a11y = label && !decorative
	? { role: "img", "aria-label": label }
	: { "aria-hidden": "true" };
---

<Tag
	class={cls}
	style={vars || undefined}
	data-art-play={play ? "" : undefined}
	{...a11y}
	{...rest}
>
	<Fragment set:html={inner} />
</Tag>
