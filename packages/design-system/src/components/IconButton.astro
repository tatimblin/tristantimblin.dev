---
// IconButton — the flat icon button (styles/icon-button.css); `rounded` for
// the round buttons of the instrument UI.
//   variant: secondary | outline     (default: secondary — an ink wash in a
//            hairline; outline is the hairline alone, the ruled screen's)
//   size:    xs | sm | lg | xl       (default: lg; xs is the pill-height
//            button that fits a card header's meta slot, xl the one big
//            control a screen has)
//   rounded: boolean     the round button
// The single icon child is wrapped in .ds-icon-button__content, as the DS's
// IconButton.tsx wraps it in a Flex. A `ds-control` (control.css); give it
// its name (`aria-label="Next season"`).
//
// `variant="outline"` is a hairline with no fill (the wash comes up under the
// pointer): with `rounded` it is the ruled screen's CIRCLED control.
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	variant?: "secondary" | "outline";
	size?: "xs" | "sm" | "lg" | "xl";
	rounded?: boolean;
	class?: string;
	[key: string]: unknown;
}

const {
	as = "button",
	variant = "secondary",
	size = "lg",
	rounded,
	class: className,
	...rest
} = Astro.props;

const Tag = as as any;

const cls = cx(
	"ds-icon-button",
	"ds-control",
	`ds-icon-button--variant-${variant}`,
	`ds-icon-button--size-${size}`,
	rounded && "ds-icon-button--rounded-true",
	className,
);
---

<Tag class={cls} {...rest}>
	<span class="ds-icon-button__content">
		<slot />
	</span>
</Tag>
