---
// IconButton — the flat icon button (styles/icon-button.css); `rounded` for
// the round buttons of the instrument UI.
//   variant: primary | secondary | tertiary   (default: secondary)
//   size:    xs | small | large | xl           (default: large; xs is the
//            pill-height button that fits a card header's meta slot)
//   rounded: boolean
// The single icon child is wrapped in .ds-icon-button__content, as the DS's
// IconButton.tsx wraps it in a Flex.
//
// `glyph` draws a text character instead of an icon — the metronome's − and
// + — in the UI face, sized to the button and aria-hidden; the caller gives
// the button its name (`aria-label="Next post"`).
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	variant?: "primary" | "secondary" | "tertiary";
	size?: "xs" | "small" | "large" | "xl";
	rounded?: boolean;
	/** A character in place of an icon (`−`, `+`); aria-hidden. */
	glyph?: string;
	class?: string;
	[key: string]: unknown;
}

const {
	as = "button",
	variant = "secondary",
	size = "large",
	rounded,
	glyph,
	class: className,
	...rest
} = Astro.props;

const Tag = as as any;

const cls = cx(
	"ds-icon-button",
	`ds-icon-button--variant-${variant}`,
	`ds-icon-button--size-${size}`,
	rounded && "ds-icon-button--rounded-true",
	className,
);
---

<Tag class={cls} {...rest}>
	<span class="ds-icon-button__content">
		{glyph ? <span class="ds-icon-button__glyph" aria-hidden="true">{glyph}</span> : null}
		<slot />
	</span>
</Tag>
