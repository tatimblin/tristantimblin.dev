---
// IconButton — the flat icon button (styles/icon-button.css); `rounded` for
// the round buttons of the instrument UI.
//   variant: primary | secondary | tertiary   (default: secondary)
//   size:    small | large | xl                (default: large)
//   rounded: boolean
// The single icon child is wrapped in .ds-icon-button__content, as the DS's
// IconButton.tsx wraps it in a Flex.
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	variant?: "primary" | "secondary" | "tertiary";
	size?: "small" | "large" | "xl";
	rounded?: boolean;
	class?: string;
	[key: string]: unknown;
}

const {
	as = "button",
	variant = "secondary",
	size = "large",
	rounded,
	class: className,
	...rest
} = Astro.props;

const Tag = as as any;

const cls = cx(
	"ds-icon-button",
	`ds-icon-button--variant-${variant}`,
	`ds-icon-button--size-${size}`,
	rounded && "ds-icon-button--rounded-true",
	className,
);
---

<Tag class={cls} {...rest}>
	<span class="ds-icon-button__content"><slot /></span>
</Tag>
