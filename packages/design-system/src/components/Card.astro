---
// Card — the flat card (styles/card.css). Renders via Box (polymorphic `as`).
// With a `title` and/or something in the `meta` slot, a CardHeader carrying
// them is rendered first and the body content follows as children.
//
// `depth` is accepted but ignored: the DS's shadow scale has no place on a flat
// surface (card.css explains), and dropping the prop would break every call
// site that set it for nothing. `glass` likewise.
import { cx } from "../lib/cx";
import Box from "./Box.astro";
import CardHeader from "./CardHeader.astro";

interface Props {
	as?: string;
	depth?: 0 | 1 | 2 | 3;
	variant?: "primary" | "secondary" | "tertiary";
	glass?: boolean;
	title?: string;
	class?: string;
	[key: string]: unknown;
}

const {
	as,
	depth: _depth,
	variant,
	glass: _glass,
	title,
	class: className,
	...rest
} = Astro.props;

const cls = cx(
	"ds-card",
	variant && `ds-card--variant-${variant}`,
	className,
);

// Forwarded only when filled: a forwarded-but-empty slot would still count as
// present in CardHeader and take its place in the row.
const hasMeta = Astro.slots.has("meta");
---

<Box as={as} class={cls} {...rest}>
	{
		title || hasMeta ? (
			<CardHeader title={title}>
				{hasMeta ? (
					<Fragment slot="meta">
						<slot name="meta" />
					</Fragment>
				) : null}
			</CardHeader>
		) : null
	}
	<slot />
</Box>
