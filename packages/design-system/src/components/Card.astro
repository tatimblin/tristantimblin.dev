---
// Card — the flat card (styles/card.css). Renders via Box (polymorphic `as`).
// When a `title` prop is passed, a CardHeader carrying it in the caps mono voice
// is rendered first and the body content follows as children.
//
// `depth` is accepted but ignored: the DS's shadow scale has no place on a flat
// surface (card.css explains), and dropping the prop would break every call
// site that set it for nothing. `glass` likewise.
import { cx } from "../lib/cx";
import Box from "./Box.astro";
import CardHeader from "./CardHeader.astro";

interface Props {
	as?: string;
	depth?: 0 | 1 | 2 | 3;
	variant?: "primary" | "secondary" | "tertiary";
	glass?: boolean;
	title?: string;
	class?: string;
	[key: string]: unknown;
}

const {
	as,
	depth: _depth,
	variant,
	glass: _glass,
	title,
	class: className,
	...rest
} = Astro.props;

const cls = cx(
	"ds-card",
	variant && `ds-card--variant-${variant}`,
	className,
);
---

<Box as={as} class={cls} {...rest}>
	{
		title ? (
			<CardHeader>
				<span class="ds-card-header__title">{title}</span>
			</CardHeader>
		) : null
	}
	<slot />
</Box>
