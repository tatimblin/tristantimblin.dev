---
// Card — the flat card (styles/card.css). Renders via Box (polymorphic `as`).
// With a `title` (prop or slot) and/or something in the `meta` slot, a
// CardHeader carrying them is rendered first and the body content follows as
// children; `squeeze` is CardHeader's, and `headerClass` puts a class of the
// caller's on the header row (a container to query, say) so no one has to
// select the DS's own. `chrome={false}` drops the frame, the fill and the clip
// for content that sits straight on the page (a halftone filling its cell)
// while keeping the card's radius and its place in a grid.
//
// `depth` is accepted but ignored: the DS's shadow scale has no place on a flat
// surface (card.css explains), and dropping the prop would break every call
// site that set it for nothing. `glass` likewise.
import { cx } from "../lib/cx";
import Box from "./Box.astro";
import CardHeader from "./CardHeader.astro";

interface Props {
	as?: string;
	depth?: 0 | 1 | 2 | 3;
	variant?: "primary" | "secondary" | "tertiary";
	glass?: boolean;
	chrome?: boolean;
	title?: string;
	squeeze?: "meta" | "title";
	headerClass?: string;
	class?: string;
	[key: string]: unknown;
}

const {
	as,
	depth: _depth,
	variant,
	glass: _glass,
	chrome = true,
	title,
	squeeze,
	headerClass,
	class: className,
	...rest
} = Astro.props;

const cls = cx(
	"ds-card",
	variant && `ds-card--variant-${variant}`,
	!chrome && "ds-card--chrome-false",
	className,
);

// A slot counts only if it RENDERS something. Astro.slots.has() alone is not
// enough: a wrapper that forwards a slot conditionally (Widget does) still
// registers it, so has() was true for an empty title and every titleless Widget
// drew an empty header — 52px of dead band with a hairline above the carousel.
const filled = async (name: string) =>
	Astro.slots.has(name) && (await Astro.slots.render(name)).trim() !== "";
const hasTitle = await filled("title");
const hasMeta = await filled("meta");
---

<Box as={as} class={cls} {...rest}>
	{
		title || hasTitle || hasMeta ? (
			<CardHeader title={title} squeeze={squeeze} class={headerClass}>
				{hasTitle ? (
					<Fragment slot="title">
						<slot name="title" />
					</Fragment>
				) : null}
				{hasMeta ? (
					<Fragment slot="meta">
						<slot name="meta" />
					</Fragment>
				) : null}
			</CardHeader>
		) : null
	}
	<slot />
</Box>
