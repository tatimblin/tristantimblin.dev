---
// TickRuler — hairline ticks on a pitch, optionally split into share
// segments (styles/tick-ruler.css).
//
//   <TickRuler />                                          one plain stretch
//   <TickRuler segments={[{ share: 46 }, { share: 29, color: "var(--tone-2)" }]} />
//
// Segments without a `color` take the rank ramp in order (--tone-1..5), which
// is what a share bar wants: the leader in the accent, the rest stepping down.
// The github tile's language ruler.
import { cx } from "../lib/cx";

interface Segment {
	share: number;
	color?: string;
}

interface Props {
	as?: string;
	segments?: Segment[];
	class?: string;
	[key: string]: unknown;
}

const { as = "div", segments, class: className, ...rest } = Astro.props;

const Tag = as as any;
const segs: Segment[] = segments?.length ? segments : [{ share: 1 }];

const segStyle = (s: Segment, i: number) =>
	[`--tick-share:${s.share}`, `color:${s.color ?? `var(--tone-${Math.min(i + 1, 5)})`}`].join(";");
---

<Tag class={cx("ds-ticks", className)} aria-hidden="true" {...rest}>
	{
		segs.map((s, i) => (
			<span class="ds-ticks__seg" style={segments?.length ? segStyle(s, i) : undefined} />
		))
	}
</Tag>
