---
// Anchor — DS styled('a', { …, variants: { discreet, external, arrow, favicon,
// underline } }). Exact port of the variant API + defaults.
//
// The DS Anchor.tsx computes an icon data-URI from `href` + the active variant
// (getIconString) and injects it via the `css` prop as `--icon: url(...)`. That
// is a real per-instance API (icon depends on href/variant), so we port the
// logic and render it as an inline `style="--icon: url(...)"` — allowed per
// CONVENTIONS.md (unlike an ad-hoc css prop).
import { cx } from "../lib/cx";
import { getIconString, type ArrowPosition } from "../lib/anchor-icons";

interface Props {
	as?: string;
	href?: string;
	/** Renders an arrow to the left or the right of the text */
	arrow?: ArrowPosition;
	/** Renders an underline only visible on hover */
	underline?: boolean;
	/** Renders a favicon for the domain in href (Twitter, Github, Bluesky) */
	favicon?: boolean;
	/** Colors the Anchor typography tertiary to blend with the corpus */
	discreet?: boolean;
	/** Renders an external link icon */
	external?: boolean;
	class?: string;
	style?: string | Record<string, unknown>;
	[key: string]: unknown;
}

const {
	as = "a",
	href,
	arrow,
	underline,
	favicon,
	discreet,
	external,
	class: className,
	style,
	...rest
} = Astro.props;

const Tag = as as any;

const icon = href && getIconString(href, { arrow, external, favicon });

const cls = cx(
	"ds-anchor",
	discreet && "ds-anchor--discreet-true",
	// external emits a rule only for the `true` case (the `false` key is empty).
	external && "ds-anchor--external-true",
	arrow && `ds-anchor--arrow-${arrow}`,
	favicon && "ds-anchor--favicon-true",
	underline && "ds-anchor--underline-true",
	className,
);

// Port of the DS css prop: '--icon': `url(${icon})`.
const iconStyle = icon ? `--icon: url(${icon})` : undefined;
const mergedStyle =
	typeof style === "string"
		? [iconStyle, style].filter(Boolean).join(";")
		: iconStyle || undefined;
---

<Tag class={cls} href={href} style={mergedStyle} {...rest}><slot /></Tag>
