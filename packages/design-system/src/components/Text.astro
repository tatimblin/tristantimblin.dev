---
// Text — the DS styled('span', { margin:0, padding:0, textRendering, variants }),
// with the scale and the faces made this site's, and pruned to what the site
// sets:
//
//   size     0–9, each `--font-size-N` (there is no 2: the generated scale
//            has no such token, and the upstream quirk that mapped 2 onto 1
//            is gone). Default 3, the reading size.
//   family   default (inherit) | ui | heading | body | hero | code — the
//            site's faces by ROLE (tokens.overrides.css), each with its
//            weight, as a face on this site always travels. `heading` is the
//            heading face at its Bold on something that is not a heading — the
//            hero lede's caps statement.
//   variant  the ink: default (currentColor) | primary | secondary | tertiary.
//   caps     the caps role (caps.css): uppercase, tracked, the trailing
//            tracking pulled back.
//   spaced   OFF by default. On, the body role's leading and tracking
//            (`--line-height-body`, `--font-body-letter-spacing`): for a run
//            of text that should sit like a paragraph without being one.
//   responsive  steps the size DOWN one on a phone (below 640): for a lead or
//            a display line whose desktop size a 343px column can't carry.
//            Heading's `responsive` is the heading counterpart.
//   truncate; polymorphic `as`.
//
// No `weight`: the body face has one cut above the Light and the roles carry
// their own, so a weight step on Text landed on the same file whatever it
// asked for. No `outline`, and no status inks: nothing on the site sets them.
import { cx } from "../lib/cx";

type Family = "default" | "ui" | "heading" | "body" | "hero" | "code";
type Size = 0 | 1 | 3 | 4 | 5 | 6 | 7 | 8 | 9;
type Variant = "default" | "primary" | "secondary" | "tertiary";

interface Props {
	as?: string;
	spaced?: boolean;
	caps?: boolean;
	family?: Family;
	size?: Size | string;
	responsive?: boolean;
	truncate?: boolean;
	variant?: Variant;
	class?: string;
	[key: string]: unknown;
}

const {
	as = "span",
	spaced = false,
	caps = false,
	family = "default",
	size = 3,
	responsive = false,
	truncate,
	variant = "default",
	class: className,
	...rest
} = Astro.props;

const Tag = as as any;

const cls = cx(
	"ds-text",
	spaced && "ds-text--spaced-true",
	caps && "ds-caps",
	family !== "default" && `ds-text--family-${family}`,
	`ds-text--size-${size}`,
	responsive && "ds-text--responsive-true",
	truncate && "ds-text--truncate-true",
	variant !== "default" && `ds-text--variant-${variant}`,
	className,
);
---

<Tag class={cls} {...rest}><slot /></Tag>
