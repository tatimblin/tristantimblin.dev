---
// Text — the DS styled('span', { margin:0, padding:0, textRendering, variants }),
// with the scale and the faces made this site's:
//
//   size     0–9, each `--font-size-N` (there is no 2: the generated scale
//            has no such token, and the upstream quirk that mapped 2 onto 1
//            is gone). Default 3, the reading size.
//   family   default (inherit) | ui | subheading | hero | mono — the site's
//            faces by ROLE (tokens.overrides.css). hero and subheading carry
//            their weight, as a face on this site always does.
//   caps     the caps role (caps.css): uppercase, tracked, the trailing
//            tracking pulled back.
//   spaced   OFF by default. On, the body role's leading and tracking
//            (`--line-height-body`, `--font-body-letter-spacing`): for a run
//            of text that should sit like a paragraph without being one.
//   variant  the ink; truncate; polymorphic `as`.
import { cx } from "../lib/cx";

type Family = "default" | "ui" | "subheading" | "hero" | "mono";
type Size = 0 | 1 | 3 | 4 | 5 | 6 | 7 | 8 | 9;
type Variant =
	| "default"
	| "primary"
	| "secondary"
	| "tertiary"
	| "info"
	| "success"
	| "warning"
	| "danger";
type Weight = 2 | 3 | 4;

interface Props {
	as?: string;
	outline?: boolean;
	spaced?: boolean;
	caps?: boolean;
	family?: Family;
	size?: Size | string;
	truncate?: boolean;
	variant?: Variant;
	weight?: Weight | string;
	class?: string;
	[key: string]: unknown;
}

const {
	as = "span",
	outline,
	spaced = false,
	caps = false,
	family = "default",
	size = 3,
	truncate,
	variant = "default",
	weight = 2,
	class: className,
	...rest
} = Astro.props;

const Tag = as as any;

const cls = cx(
	"ds-text",
	outline && "ds-text--outline-true",
	spaced && "ds-text--spaced-true",
	caps && "ds-caps",
	family !== "default" && `ds-text--family-${family}`,
	`ds-text--size-${size}`,
	truncate && "ds-text--truncate-true",
	variant && `ds-text--variant-${variant}`,
	weight && `ds-text--weight-${weight}`,
	className,
);
---

<Tag class={cls} {...rest}><slot /></Tag>
