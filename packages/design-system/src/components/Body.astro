---
// Body — the reading role. Heading's counterpart: where Heading is the voice that
// announces, this is the voice that says something at length.
//
// Renders through Text (so every Text prop — variant, truncate, family, as —
// still works) and adds .ds-body, which carries the whole setting from the
// --font-body-* tokens. Deliberately takes NO `size` prop: the point of the role
// is that reading text is one decision, not a step picked off the scale at each
// call site. Something that needs a different size is not body text — it is a
// heading, a label, or a Text.
import { cx } from "../lib/cx";
import Text from "./Text.astro";

interface Props {
	as?: string;
	class?: string;
	[key: string]: unknown;
}

const {
	as = "p", // body text is a paragraph unless told otherwise
	// The reading colour: the primary ink. Reading text is a light mono, whose
	// thin stems need the full ink to hold up; the headings are set apart by
	// face and size rather than by colour. Overridable per call site.
	variant = "primary",
	class: className,
	...rest
} = Astro.props;
---

<Text {...rest} as={as} variant={variant} class={cx("ds-body", className)}>
	<slot />
</Text>
