---
// GlyphSvg — the one host every micrographic renders through (styles/
// glyph.css, class ds-glyph): Glyph hands it a file from the registry, a
// generator component (Wave, Envelope, Filter, Curve, …) hands it the
// Drawing its function returned, and both get the same <svg> on the page —
// the same sizing, the same --glyph-dim, the same motion gating, the same
// ARIA. It is the internal seam; a page uses Glyph or a generator, not
// this. A new generator component is three lines on it:
//
//   <GlyphSvg svg={wave(shape, opts)} data-gen="wave" {size} {label} {play} class={className} {...rest} />
//
// `svg` is the raw text of an SVG file (a glyph) or a Drawing
// ({ viewBox, children }, a generator's output, baked here through the
// glyph kit). `size` (6 | 8 | 10 | 12) is the height on the space scale;
// without it the mark is 1em tall in text. `label` makes it an image
// (role="img" aria-label); without one it is aria-hidden + focusable=
// "false". `play` is data-art-play, the art's attribute. `class` merges;
// everything else lands on the root — BEFORE the ARIA, so a meter passes
// role="meter" and its aria-value* in the rest and the role it gave is the
// one the label keeps (the label's aria-label is added to it). Without a
// label a meter is still hidden: a value that matters needs a name.
import "../styles/glyph.css";
import "../styles/motion.css";
import { cx } from "../lib/cx";
import { inlineSvg } from "../lib/inline-svg";
import { type Drawing, toSvg } from "../lib/micro/gen/base";
import type { GlyphHostProps } from "../lib/glyph-host";

interface Props extends GlyphHostProps {
	/** The raw SVG text (a file from the registry) or a generator's Drawing. */
	svg: string | Drawing;
}

const { svg: source, size, label, play = false, class: className, ...rest } = Astro.props;

const cls = cx("ds-glyph", size && `ds-glyph--size-${size}`, className);

const a11y = label
	? { role: (rest.role as string | undefined) ?? "img", "aria-label": label }
	: { "aria-hidden": "true", focusable: "false" };

// The root carries everything (there is no wrapper): the class, the
// pass-through (a host's data-* hook first), the play attribute, the ARIA
// — which inlineSvg serialises and escapes, dropping null/false as Astro
// would.
const svg = inlineSvg(typeof source === "string" ? source : toSvg(source), {
	host: "GlyphSvg",
	attrs: {
		class: cls,
		...rest,
		"data-art-play": play ? "" : undefined,
		...a11y,
	},
});
---

<Fragment set:html={svg} />
