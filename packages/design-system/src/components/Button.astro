---
// Button — the DS StyledButton (styled('button', { … })), flat (button.css).
// Source: /tmp/mh-design-system/src/components/Button/{Button.tsx,Button.styles.tsx,Button.types.ts}
//
// The React component computes `hasIcon` from which of startIcon/endIcon are
// passed, and wraps the icons in a <Flex> with a margin. Here the icons come in
// as the named slots "start-icon" / "end-icon", and we mirror the margin
// wrappers. `hasIcon` is computed from slot presence. (Upstream's
// variant="icon", which rerouted to the icon button, is IconButton here.)
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	variant?: "primary" | "secondary" | "tertiary";
	inverted?: boolean;
	rounded?: boolean;
	class?: string;
	[key: string]: unknown;
}

const {
	as = "button",
	// Button.tsx default: variant = 'primary'.
	variant = "primary",
	inverted,
	rounded,
	class: className,
	...rest
} = Astro.props;

const Tag = as as any;

const hasStart = Astro.slots.has("start-icon");
const hasEnd = Astro.slots.has("end-icon");
// Mirror Button.tsx: hasIcon = startIcon ? 'startIcon' : endIcon ? 'endIcon' : 'none'.
const hasIcon = hasStart ? "startIcon" : hasEnd ? "endIcon" : "none";

const cls = cx(
	"ds-button",
	// The voice: the caps mono, declared once (mono.css, caps.css); and a
	// control (control.css).
	"ds-mono",
	"ds-caps",
	"ds-control",
	`ds-button--variant-${variant}`,
	`ds-button--has-icon-${hasIcon}`,
	inverted && "ds-button--inverted-true",
	rounded && "ds-button--rounded-true",
	className,
);
---

<Tag class={cls} {...rest}>
	{hasStart ? (
		<span class="ds-button__start-icon">
			<slot name="start-icon" />
		</span>
	) : null}
	<slot />
	{hasEnd ? (
		<span class="ds-button__end-icon">
			<slot name="end-icon" />
		</span>
	) : null}
</Tag>
