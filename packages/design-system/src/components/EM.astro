---
// EM — DS <Text as="em" variant="tertiary" weight="3" />. Delegates to Text
// with overrides. (Upstream also set a -0.3px letter-spacing inline; an
// absolute tracking is right at one size only, and the emphasis reads without
// it.)
import Text from "./Text.astro";

interface Props {
	size?: number | string;
	variant?: string;
	class?: string;
	[key: string]: unknown;
}

const props = Astro.props;
---

<Text {...props} as="em" variant="tertiary" weight={3}>
	<slot />
</Text>
