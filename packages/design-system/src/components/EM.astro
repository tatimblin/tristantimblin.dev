---
// EM — DS <Text as="em" variant="tertiary" />: the emphasis is the quieter
// ink and the element's own italic. (Upstream also set weight 500 and a
// -0.3px letter-spacing; the body face has no 500 cut, and an absolute
// tracking is right at one size only.)
import Text from "./Text.astro";

interface Props {
	size?: number | string;
	class?: string;
	[key: string]: unknown;
}

const props = Astro.props;
---

<Text {...props} as="em" variant="tertiary">
	<slot />
</Text>
