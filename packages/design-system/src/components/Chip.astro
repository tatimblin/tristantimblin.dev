---
// Chip — the boxed chip of the ruled screen (styles/chip.css): a small square
// box of caps mono, a hairline round it and no fill, where a Pill is a round
// capsule with a wash. The footer's sound and theme toggles.
//
//   <Chip>projects</Chip>                                   a tag
//   <Chip as="a" href="#chip">projects</Chip>               a chip link
//   <Chip as="a" href="#chip" aria-current="page">all</Chip> selected: the ink, filled
//   <Chip as="button" type="button" aria-pressed="true">…</Chip>
//
// SELECTED is a state the chip reads off its own ARIA — `aria-current` (a
// link that is the current page) or `aria-pressed="true"` (a toggle) — so
// a script sets the attribute a reader needs and the fill follows; there is
// no `selected` prop to fall out of step with it. As an <a> or <button> it
// is a chip BUTTON: pointer, the strong hairline on hover, the focus ring.
//
// Two TAGS for the micrographic readouts (the synth panel's): `tone="accent"`
// draws the box's edge and caps in the accent — TELEMATIC, the one flagged
// word on a panel — and `variant="arrow"` is a filled tag cut to a
// right-pointing chevron (clip-path; a border cannot follow the cut, so it
// is a fill): the ink with the page colour on it, or with `tone="accent"`
// the accent with --on-accent — REPLACE, a label that says where a thing
// goes. Both are static tags, not controls: the glyph sheet's readout
// panels.
//
//   <Chip tone="accent">telematic</Chip>
//   <Chip variant="arrow">replace</Chip>
//   <Chip variant="arrow" tone="accent">replace</Chip>
//
// `class` merges; everything else passes through.
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	/** box (default): the hairline box; arrow: a filled tag cut to a
	 *  right-pointing chevron. */
	variant?: "box" | "arrow";
	/** accent: the box's edge and caps, or the arrow's fill, in the accent. */
	tone?: "accent";
	class?: string;
	[key: string]: unknown;
}

const { as = "span", variant = "box", tone, class: className, ...rest } = Astro.props;
const Tag = as as any;
---

<Tag
	class={cx(
		"ds-chip",
		"ds-mono",
		"ds-caps",
		// As a button or a link it is a control (control.css).
		(as === "button" || as === "a") && "ds-control",
		variant !== "box" && `ds-chip--variant-${variant}`,
		tone && `ds-chip--tone-${tone}`,
		className,
	)}
	{...rest}><slot /></Tag>
