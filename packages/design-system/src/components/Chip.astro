---
// Chip — the boxed chip of the ruled screen (styles/chip.css): a small square
// box of caps mono, a hairline round it and no fill, where a Pill is a round
// capsule with a wash. The /txt search bar's quick filters, the card's
// category tag, the browse and none faces' links, the `/` key hint.
//
//   <Chip>projects</Chip>                                   a tag
//   <Chip as="a" href="/txt?q=projects">projects</Chip>     a chip link
//   <Chip as="a" href="/txt" aria-current="page">all</Chip> selected: the ink, filled
//   <Chip as="button" type="button" aria-pressed="true">…</Chip>
//   <Chip size="sm" aria-hidden="true">/</Chip>              the key hint, a step smaller
//
// SELECTED is a state the chip reads off its own ARIA — `aria-current` (a
// link that is the current filter) or `aria-pressed="true"` (a toggle) — so
// a script sets the attribute a reader needs and the fill follows; there is
// no `selected` prop to fall out of step with it. As an <a> or <button> it
// is a chip BUTTON: pointer, the strong hairline on hover, the focus ring.
//
// `variant="tab"` is the same caps voice with NO box: a text tab, the
// tertiary ink at rest, the ink under the pointer, and selected (the same
// ARIA) an accent underline instead of the fill — the /txt search bar's
// quick filters. `count` sets a small superscript figure after the label
// (the posts in a category; ALL's is the total).
//
//   <Chip variant="tab" as="a" href="/txt?q=projects" count={1}>projects</Chip>
//
// Two TAGS for the micrographic readouts (the synth panel's): `tone="accent"`
// draws the box's edge and caps in the accent — TELEMATIC, the one flagged
// word on a panel — and `variant="arrow"` is a filled tag cut to a
// right-pointing chevron (clip-path; a border cannot follow the cut, so it
// is a fill): the ink with the page colour on it, or with `tone="accent"`
// the accent with --on-accent — REPLACE, a label that says where a thing
// goes. Both are static tags, not controls. Site use: the micrographic
// migration's labelled tiles and readout panels.
//
//   <Chip tone="accent">telematic</Chip>
//   <Chip variant="arrow">replace</Chip>
//   <Chip variant="arrow" tone="accent">replace</Chip>
//
// `class` merges; everything else passes through.
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	/** md (default) is the control step, --space-5 tall; sm is the key hint's. */
	size?: "sm" | "md";
	/** box (default): the hairline box; tab: no box, an accent underline when
	 *  selected; arrow: a filled tag cut to a right-pointing chevron. */
	variant?: "box" | "tab" | "arrow";
	/** accent: the box's edge and caps, or the arrow's fill, in the accent. */
	tone?: "accent";
	/** A small superscript figure after the label. */
	count?: string | number;
	class?: string;
	[key: string]: unknown;
}

const { as = "span", size = "md", variant = "box", tone, count, class: className, ...rest } = Astro.props;
const Tag = as as any;
---

<Tag
	class={cx(
		"ds-chip",
		"ds-mono",
		"ds-caps",
		// As a button or a link it is a control (control.css).
		(as === "button" || as === "a") && "ds-control",
		size !== "md" && `ds-chip--size-${size}`,
		variant !== "box" && `ds-chip--variant-${variant}`,
		tone && `ds-chip--tone-${tone}`,
		className,
	)}
	{...rest}><slot />{count != null && <sup class="ds-chip__count">{count}</sup>}</Tag>
