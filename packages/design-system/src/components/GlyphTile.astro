---
// GlyphTile — the keycap a micrographic sits in (styles/glyph.css, class
// ds-glyph-tile): a 3:2 tile with a hairline rim (--art-edge) and the
// surface radius, a caps label under it, and an optional READOUT drawn
// over the mark — `34`, `44.1k` — in the spec sheet's thin numeral. The
// glyph (or, later, a generator) goes in the default slot and the tile
// sizes it; hovering the tile plays the glyph's motion.
//
//   <GlyphTile label="ring-in"><Glyph name="ring-in" /></GlyphTile>
//   <GlyphTile label="amount"><Glyph name="plus" /><span slot="readout">34</span></GlyphTile>
//   <GlyphTile><Mono slot="label" tone="primary">P.DEST</Mono><Glyph name="toggle" /></GlyphTile>
//
// The tile fills its column and keeps 3:2, so a row of them grids with
// `Grid`. `label` is a prop or a slot (a slot for a label that carries its
// own markup; it is set in the caps voice either way). The readout inherits
// the tile's colour; a readout in a data colour wraps itself. Polymorphic
// `as` (a `figure` when the label captions it); `class` merges; everything
// else — `id`, `name`, `data-*` — passes through to the root.
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	/** The caps label under the tile (or the `label` slot). */
	label?: string;
	class?: string;
	[key: string]: unknown;
}

const { as = "div", label, class: className, ...rest } = Astro.props;
const Tag = as as any;
const hasLabel = label != null || Astro.slots.has("label");
const hasReadout = Astro.slots.has("readout");
---

<Tag class={cx("ds-glyph-tile", className)} {...rest}>
	<span class="ds-glyph-tile__cap">
		<slot />
		{hasReadout && <span class="ds-glyph-tile__readout"><slot name="readout" /></span>}
	</span>
	{hasLabel && (
		<span class="ds-glyph-tile__label ds-mono ds-caps">
			<slot name="label">{label}</slot>
		</span>
	)}
</Tag>
