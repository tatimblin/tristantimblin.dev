---
// IndexRow — one row of an Index (Index.astro): its children are the cells,
// on the index's column template, baseline-aligned, a hairline under. `head`
// is the inverted header row (the ink, the page colour on it, no hairline);
// `dim` is a row with nothing in it — an end with nothing beyond it — in the
// tertiary ink.
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	head?: boolean;
	dim?: boolean;
	class?: string;
	[key: string]: unknown;
}

const { as = "div", head = false, dim = false, class: className, ...rest } = Astro.props;
const Tag = as as any;
const cls = cx(
	"ds-index__row",
	head && "ds-index__row--head",
	dim && "ds-index__row--dim",
	className,
);
---

<Tag class={cls} {...rest}><slot /></Tag>
