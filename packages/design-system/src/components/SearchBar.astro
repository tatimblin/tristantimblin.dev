---
// SearchBar — the full-width bar above the quilt (styles/search-bar.css): a
// caps Mono label, the native input in the UI face, a live count, and the
// key hint as an outline Pill (hidden where there is no keyboard). The bar's
// hairline takes the accent while the input has focus.
//
//   <SearchBar id="quilt-search" label="Search" placeholder="a title, a topic, a year…"
//              count="5 posts" hint="/" controls="quilt-panel-results" />
//
// The input is a combobox over the panel's results listbox (aria-controls
// names it); a script keeps aria-expanded in step with whether the panel
// shows, moves aria-activedescendant to the active option's id, and rewrites
// the count (data-search-count, aria-live="polite") — `2 of 5` while a query
// is typed, `5 posts` otherwise; without a `count` no count is rendered, for
// a bar whose count lives elsewhere (the instrument's count cell, which
// carries the live region instead). Hooks: data-search-bar on the root,
// data-search-input on the input. `name` defaults to `q` so the bar inside a
// GET form lands on `?q=` with scripting off. `expanded` and `value` render a
// state statically. `class` merges; everything else passes to the ROOT.
//
// `variant="cell"` is the bar with no frame of its own — no edge, fill,
// radius or height — for a bar that lives flush inside a Panel cell of an
// instrument screen, where the cell is the frame; the focus indication
// becomes an accent line along the cell's bottom edge. Same semantics.
import { cx } from "../lib/cx";
import Mono from "./Mono.astro";
import Pill from "./Pill.astro";

interface Props {
	id?: string;
	variant?: "bar" | "cell";
	label?: string;
	placeholder?: string;
	count?: string;
	/** The key that focuses the bar, shown as a pill; none hides it. */
	hint?: string;
	/** The id of the listbox the combobox controls (the panel's `<id>-results`). */
	controls?: string;
	name?: string;
	value?: string;
	expanded?: boolean;
	class?: string;
	[key: string]: unknown;
}

const {
	id = "search",
	variant = "bar",
	label = "search",
	placeholder = "a title, a topic, a year…",
	count,
	hint,
	controls,
	name = "q",
	value,
	expanded = false,
	class: className,
	...rest
} = Astro.props;
---

<div
	class={cx("ds-search-bar", variant === "cell" && "ds-search-bar--variant-cell", className)}
	role="search"
	data-search-bar
	{...rest}
>
	<Mono as="label" for={id} class="ds-search-bar__label">{label}</Mono>
	<input
		class="ds-search-bar__input"
		id={id}
		name={name}
		type="search"
		role="combobox"
		aria-autocomplete="list"
		aria-expanded={expanded ? "true" : "false"}
		aria-controls={controls}
		autocomplete="off"
		autocapitalize="off"
		autocorrect="off"
		spellcheck="false"
		placeholder={placeholder}
		value={value}
		data-search-input
	/>
	{count !== undefined && (
		<Mono class="ds-search-bar__count" aria-live="polite" data-search-count>{count}</Mono>
	)}
	{hint && (
		<Pill variant="outline" class="ds-search-bar__hint" aria-hidden="true">{hint}</Pill>
	)}
</div>
