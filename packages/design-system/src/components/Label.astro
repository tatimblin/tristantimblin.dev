---
// Label — DS <Text as="label" variant="secondary" size="1" weight="3"
//      css={{ display, cursor, userSelect, marginRight, letterSpacing,
//             verticalAlign }} />. The hardcoded css lives in .ds-label.
import { cx } from "../lib/cx";
import Text from "./Text.astro";

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<Text
	{...rest}
	as="label"
	variant="secondary"
	size={1}
	weight={3}
	class={cx("ds-label", className)}
>
	<slot />
</Text>
