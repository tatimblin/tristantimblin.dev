---
// Stat — the stat pair of the reference dashboard: a value over a dim
// sentence-case label (`90%` / Allocated), both in the mono — the value at
// the label's next step, in the ink (styles/stat.css). Several sit in a row:
// the bike tile's rides / hours, the /txt card's strip.
//
//   <Stat value="90%" label="Allocated" />
//   <Stat label="miles"><slot>…custom value markup…</slot></Stat>
//   <Stat value="3 min"><Fragment slot="label">read</Fragment></Stat>
import { cx } from "../lib/cx";
import Mono from "./Mono.astro";

interface Props {
	as?: string;
	value?: string | number;
	label?: string;
	class?: string;
	[key: string]: unknown;
}

const { as = "div", value, label, class: className, ...rest } = Astro.props;

const Tag = as as any;
const hasLabelSlot = Astro.slots.has("label");
---

<Tag class={cx("ds-stat", className)} {...rest}>
	<Mono variant="value" size={1} class="ds-stat__value">{value ?? <slot />}</Mono>
	{
		hasLabelSlot ? (
			<Mono variant="text" class="ds-stat__label">
				<slot name="label" />
			</Mono>
		) : label ? (
			<Mono variant="text" class="ds-stat__label">{label}</Mono>
		) : null
	}
</Tag>
