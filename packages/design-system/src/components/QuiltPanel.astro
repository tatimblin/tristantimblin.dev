---
// QuiltPanel — the text block that takes a 3×2 block of a Quilt's cells
// (styles/quilt-panel.css). Four faces, every one rendered, one showing, on
// the page colour inside the strong hairline — square, no fill, the ruled
// screen's language — filling the block:
//
//   card      the hovered, stepped or focused post, or the single search hit,
//             as the RULED CARD: a top strip (the category as a boxed Chip,
//             and `[INDEX] 000005 · LOG_005.TXT`) over a hairline; the body —
//             the big mono number (`005`) with three small mono readouts
//             under it (`STATUS: PUBLISHED`, `NODE: TXT/PROGRAMMING`,
//             `RATE: 180 WPM`), beside the title and the excerpt (and a "why
//             it matched" line when it is a search hit); and the bottom
//             STRIP, a StatStrip of hairline-cut cells — `3 MIN / read`,
//             `541 / words`, `FEB 2026 / published` — ending in the accent
//             `READ →` cell, which is the link to the post.
//   browse    the search bar focused with nothing typed: categories with
//             counts, years and the latest post, as real chip links to `?q=`.
//   results   two or more hits: a listbox of hairline-cut rows — the title
//             with the query marked, `MMM YYYY · CATEGORY`, `MATCHED TAG · …`
//             — the active one carrying the accent bar.
//   none      no hit: the sentence, what search covers, suggestions as chips.
//
//   <QuiltPanel id="quilt-panel" mode="hidden" col={3} row={2}
//               card={{ no, category, minutes, words, month, year, rate, title, blurb, why?, href }}
//               browse={{ categories: [{ label, count, href }], years: [{ label, href }], latest: { title, href } }}
//               results={{ label, items: [{ href, title | segments, meta, why? }], active: 0 }}
//               nothing={{ query, suggestions: [{ label, href }] }} />
//
// THE STATE CONTRACT — one attribute and two custom properties on the root:
//   data-mode="card | browse | results | none | hidden"   which face shows.
//                 The others are visibility: hidden, so they are out of the
//                 accessibility tree and the tab order without an aria-hidden
//                 of their own; `hidden` fades the whole panel out.
//   --panel-col / --panel-row   the block's top-left cell, 1-based; the
//                 block is --panel-cols × --panel-rows (3 × 2).
// The faces are filled through hooks, so a script updates text in place
// rather than rebuilding markup: data-card="no | index | category | node |
// rate | minutes | words | month | year | title | blurb | why | link" (the
// number is written as `005`; `index` is the whole top-strip line; `node`
// is the category after `TXT/`; `rate` the words a minute),
// data-results="label | list", data-none="query", and a <template
// data-result-template> holding one empty results row with
// data-result="title | meta | why" on its spans. Result rows are
// role="option" (ids `<id>-opt-<n>`) inside role="listbox" (id
// `<id>-results`), which is what the SearchBar's combobox points at with
// aria-controls and aria-activedescendant; the active row is
// aria-selected="true".
//
// Under 640px the panel is in flow, full width, above the tiles (the
// stylesheet); `flow` renders it that way at any width — the catalogue's
// demo of the faces. `class` merges; everything else passes to the root.
import { cx } from "../lib/cx";
import Mono from "./Mono.astro";
import Body from "./Body.astro";
import Chip from "./Chip.astro";
import Anchor from "./Anchor.astro";
import Stat from "./Stat.astro";
import StatStrip from "./StatStrip.astro";

type Mode = "card" | "browse" | "results" | "none" | "hidden";

interface Segment {
	text: string;
	hl: boolean;
}
interface Link {
	label: string;
	href: string;
}
interface Card {
	/** `005` — zero-padded; drawn big, and in the index line. */
	no: string;
	category?: string;
	minutes: number | string;
	words: number | string;
	/** `feb` (drawn in capitals) */
	month: string;
	year: string;
	/** Words a minute: words ÷ minutes. */
	rate: number | string;
	title: string;
	blurb: string;
	/** `MATCHED TAG · HOME OFFICE`, when the card is a single search hit. */
	why?: string;
	href: string;
}
interface Browse {
	label?: string;
	categories: Array<Link & { count: number }>;
	years: Link[];
	latest?: { title: string; href: string };
}
interface ResultItem {
	href: string;
	title: string | Segment[];
	meta: string;
	why?: string;
}
interface Results {
	label: string;
	items: ResultItem[];
	/** Index of the active row. */
	active?: number;
}
interface Nothing {
	query: string;
	coverage?: string;
	suggestions: Link[];
}

interface Props {
	id?: string;
	mode?: Mode;
	col?: number;
	row?: number;
	card?: Card;
	browse?: Browse;
	results?: Results;
	nothing?: Nothing;
	/** In flow at any width (the phone rendering) — the catalogue's face demos. */
	flow?: boolean;
	class?: string;
	style?: string;
	[key: string]: unknown;
}

const {
	id = "quilt-panel",
	mode = "hidden",
	col = 1,
	row = 1,
	card,
	browse,
	results,
	nothing,
	flow = false,
	class: className,
	style,
	...rest
} = Astro.props;

const vars = [`--panel-col:${col}`, `--panel-row:${row}`, style].filter(Boolean).join(";");
const segments = (t: string | Segment[]): Segment[] =>
	typeof t === "string" ? [{ text: t, hl: false }] : t;
const keys = (last: string) => `↑↓ move · ↵ open · esc ${last}`;
/** The top strip's line, as the script writes it: `[index] 000005 · log_005.txt`. */
const indexLine = (no: string) => `[index] 000${no} · log_${no}.txt`;
---

<div
	class={cx("ds-quilt-panel", flow && "ds-quilt-panel--flow-true", className)}
	id={id}
	data-quilt-panel
	data-mode={mode}
	style={vars}
	{...rest}
>
	<!-- card -->
	<div class="ds-quilt-panel__face ds-quilt-panel__card" data-face="card">
		<div class="ds-quilt-panel__strip">
			<Chip class="ds-quilt-panel__category" data-card="category">{card?.category}</Chip>
			<Mono tone="tertiary" class="ds-quilt-panel__index" data-card="index">{card && indexLine(card.no)}</Mono>
		</div>
		<div class="ds-quilt-panel__card-body">
			<div class="ds-quilt-panel__card-side">
				<Mono variant="value" class="ds-quilt-panel__no" data-card="no">{card?.no}</Mono>
				<Mono tone="tertiary" class="ds-quilt-panel__readouts">
					<span>status: published</span>
					<span>node: txt/<span data-card="node">{card?.category}</span></span>
					<span>rate: <span data-card="rate">{card?.rate}</span> wpm</span>
				</Mono>
			</div>
			<div class="ds-quilt-panel__card-main">
				<p class="ds-quilt-panel__title" data-card="title">{card?.title}</p>
				<Body class="ds-quilt-panel__blurb" data-card="blurb">{card?.blurb}</Body>
				<Mono tone="tertiary" class="ds-quilt-panel__why" data-card="why">{card?.why}</Mono>
			</div>
		</div>
		<StatStrip class="ds-quilt-panel__stats">
			<Stat label="read"><span data-card="minutes">{card?.minutes}</span> min</Stat>
			<Stat label="words"><span data-card="words">{card?.words}</span></Stat>
			<Stat label="published">
				<span data-card="month">{card?.month}</span> <span data-card="year">{card?.year}</span>
			</Stat>
			<a slot="action" class="ds-quilt-panel__read" href={card?.href} data-card="link">
				read <span aria-hidden="true">→</span>
			</a>
		</StatStrip>
	</div>

	<!-- browse -->
	<div class="ds-quilt-panel__face ds-quilt-panel__browse" data-face="browse">
		<div class="ds-quilt-panel__strip">
			<Mono tone="primary">{browse?.label ?? "browse"}</Mono>
			<Mono tone="tertiary">or type a word from a title or topic</Mono>
		</div>
		<div class="ds-quilt-panel__groups">
			<div class="ds-quilt-panel__group">
				<Mono tone="tertiary">categories</Mono>
				<div class="ds-quilt-panel__chips">
					{browse?.categories.map((c) => (
						<Chip as="a" href={c.href}>
							{c.label} <Mono variant="value">{c.count}</Mono>
						</Chip>
					))}
				</div>
			</div>
			<div class="ds-quilt-panel__group">
				<Mono tone="tertiary">years</Mono>
				<div class="ds-quilt-panel__chips">
					{browse?.years.map((y) => (
						<Chip as="a" href={y.href}>{y.label}</Chip>
					))}
				</div>
			</div>
			{browse?.latest && (
				<div class="ds-quilt-panel__group">
					<Mono tone="tertiary">latest</Mono>
					<Anchor href={browse.latest.href} class="ds-quilt-panel__latest" arrow="right">
						{browse.latest.title}
					</Anchor>
				</div>
			)}
		</div>
		<Mono tone="tertiary" class="ds-quilt-panel__keys">{keys("close")}</Mono>
	</div>

	<!-- results -->
	<div class="ds-quilt-panel__face ds-quilt-panel__results-face" data-face="results">
		<div class="ds-quilt-panel__strip">
			<Mono tone="primary" data-results="label">{results?.label}</Mono>
			<Mono tone="tertiary" class="ds-quilt-panel__keys">{keys("clear")}</Mono>
		</div>
		<ol
			class="ds-quilt-panel__results"
			role="listbox"
			id={`${id}-results`}
			aria-label="results"
			data-results="list"
		>
			{results?.items.map((r, k) => (
				<li
					class="ds-quilt-panel__result"
					role="option"
					id={`${id}-opt-${k}`}
					aria-selected={k === (results.active ?? 0) ? "true" : "false"}
				>
					<a class="ds-quilt-panel__result-link" href={r.href} tabindex="-1">
						<span class="ds-quilt-panel__result-title" data-result="title">
							{segments(r.title).map((s) => (s.hl ? <mark>{s.text}</mark> : s.text))}
						</span>
						<span class="ds-quilt-panel__result-meta">
							<Mono tone="tertiary" data-result="meta">{r.meta}</Mono>
							<Mono data-result="why">{r.why}</Mono>
						</span>
					</a>
				</li>
			))}
		</ol>
		<template data-result-template>
			<li class="ds-quilt-panel__result" role="option" aria-selected="false">
				<a class="ds-quilt-panel__result-link" href="" tabindex="-1">
					<span class="ds-quilt-panel__result-title" data-result="title"></span>
					<span class="ds-quilt-panel__result-meta">
						<Mono tone="tertiary" data-result="meta" />
						<Mono data-result="why" />
					</span>
				</a>
			</li>
		</template>
	</div>

	<!-- none -->
	<div class="ds-quilt-panel__face ds-quilt-panel__none" data-face="none">
		<div class="ds-quilt-panel__strip">
			<Mono tone="primary">no match</Mono>
			<Mono tone="tertiary" class="ds-quilt-panel__keys">esc clear</Mono>
		</div>
		<div class="ds-quilt-panel__none-body">
			<p class="ds-quilt-panel__title">Nothing for “<span data-none="query">{nothing?.query}</span>”.</p>
			<Body class="ds-quilt-panel__blurb">
				{nothing?.coverage ??
					"Search looks at titles, summaries, categories, tags and dates. Try one of these instead:"}
			</Body>
			<div class="ds-quilt-panel__chips" data-none="suggestions">
				{nothing?.suggestions.map((s) => (
					<Chip as="a" href={s.href}>{s.label}</Chip>
				))}
			</div>
		</div>
	</div>
</div>
