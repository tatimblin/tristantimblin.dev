---
// Prose — the reading container (styles/prose.css). Wrap rendered markdown in
// it: it sets the rhythm between blocks, gives section headings the UI face
// with a hairline under the h2s, and styles the tags markdown leaves as raw
// HTML — fenced code, inline code, images, rules, tables, strikethrough. The
// mapped elements (p, lists, links, blockquotes) style themselves through their
// own DS components; this only spaces them.
//
//   <Prose><Content components={mdxComponents} /></Prose>
//   <Prose numbered>…</Prose>     each h2 carries its index (01, 02 …) in the
//                                 structure voice — for a page with a contents
//                                 rail that numbers the same sections
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	/** Number the h2s (01, 02 …) with a CSS counter, so a contents rail can match. */
	numbered?: boolean;
	class?: string;
	[key: string]: unknown;
}

const { as = "div", numbered = false, class: className, ...rest } = Astro.props;
const Tag = as as any;
---

<Tag class={cx("ds-prose", numbered && "ds-prose--numbered-true", className)} {...rest}><slot /></Tag>
