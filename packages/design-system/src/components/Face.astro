---
// Face — one alternative in a <Faces> stack: a flex column with the widget
// gap. `hidden` renders it aria-hidden, which is the attribute faces.css fades
// on and the one a script toggles to swap faces.
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	hidden?: boolean;
	class?: string;
	[key: string]: unknown;
}

const { as = "div", hidden, class: className, ...rest } = Astro.props;
const Tag = as as any;
---

<Tag class={cx("ds-face", className)} aria-hidden={hidden ? "true" : undefined} {...rest}>
	<slot />
</Tag>
