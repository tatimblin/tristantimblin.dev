---
// Hairline — a 1px rule, fading at both ends (styles/hairline.css): the
// reference dashboard's divider, the same gradient the card header draws.
// An <hr> by default, so it is a separator to a reader as well as to the
// eye; pass as="span" when it is purely decorative.
//
//   <Hairline />
//   <Hairline as="span" />
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	class?: string;
	[key: string]: unknown;
}

const { as = "hr", class: className, ...rest } = Astro.props;
const Tag = as as any;
---

<Tag class={cx("ds-hairline", className)} {...(Tag !== "hr" ? { role: "separator" } : {})} {...rest} />
