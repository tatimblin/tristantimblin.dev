---
// RuleLabel — a label on a dotted rule, the spec sheet's caption (styles/
// rule-label.css): a 1px DOTTED hairline with a small caps label under it —
// an optional leading number in the accent, the label, and an optional
// trailing `meta` in the tertiary ink at the far end — a tile's title row
// (`05 ASSERTING ON AGENT BEHAVIOR`). No box: the rule is the only line.
//
//   <RuleLabel no="05">Asserting on agent behavior</RuleLabel>
//   <RuleLabel no="05" truncate>A title that runs out of room…</RuleLabel>
//   <RuleLabel no="05">Title<Mono slot="meta">Latest</Mono></RuleLabel>
//
// `truncate` holds the label to one line and ellipsises it; without it the
// label wraps. Polymorphic `as`; `class` merges; everything else passes
// through.
import { cx } from "../lib/cx";

interface Props {
	as?: string;
	/** The leading number, in the accent. */
	no?: string | number;
	/** One line, ellipsised. */
	truncate?: boolean;
	class?: string;
	[key: string]: unknown;
}

const {
	as = "div",
	no,
	truncate = false,
	class: className,
	...rest
} = Astro.props;

const Tag = as as any;
const hasMeta = Astro.slots.has("meta");
const cls = cx(
	"ds-rule-label",
	"ds-mono",
	"ds-caps",
	truncate && "ds-rule-label--truncate-true",
	className,
);
---

<Tag class={cls} {...rest}>
	<span class="ds-rule-label__text">
		{no != null && <span class="ds-rule-label__no">{no}</span>}
		<slot />
	</span>
	{hasMeta && <span class="ds-rule-label__meta"><slot name="meta" /></span>}
</Tag>
