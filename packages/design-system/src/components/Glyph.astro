---
// Glyph — a micrographic inlined beside text (styles/glyph.css, class
// ds-glyph): one of the marks in src/glyphs/ (baked from a recipe or
// hand-drawn; the registry, glyphs.ts, does not care which) put on the page
// as an inline <svg>. Inline, because its line work is currentColor — it
// takes the colour of the text it sits in — and its fills are the art
// tokens, and its motion is motion.css, none of which reaches an <img>.
//
//   <Glyph name="ring-in" />                      in a line of text: 1em tall, aria-hidden
//   <Glyph name="ring-in" size={8} />             48px tall (--space-8), 3:2 wide
//   <Glyph name="plus" label="add a track" />     role="img" aria-label
//   <Glyph name="ring-in" play />                 motion running, not only under the pointer
//
// A glyph is DECORATIVE unless it says `label`: aria-hidden and
// focusable="false", the mark beside a word that already says it. With a
// label it is an image with that name. Where Icon is a UI affordance (a
// 2px stroke in the ink, meaning), a glyph is a mark — hairline, the art
// palette, data or decoration.
//
// SIZE. The box is the file's viewBox ratio (3:2, or 3:1 for a wide
// glyph): in text the glyph is 1em tall and as wide as that makes it,
// centred on the x-height; `size` is its height on the space scale, the
// step numbered as Icon's size is (N → --space-N) — 6 is 32px, the 48×32
// viewBox at 1×, so a hairline lands on the pixel grid; 8, 10 (2×) and 12
// (3×) above it. A GlyphTile sizes the glyph itself. `class` merges;
// everything else passes through to the root.
//
// The rendering is GlyphSvg's — the host a generator component (Wave,
// Envelope, …) shares, so a glyph from a file and a mark from a function
// are the same <svg> on the page. This component is the name → file step.
import GlyphSvg from "./GlyphSvg.astro";
import type { GlyphHostProps } from "../lib/glyph-host";
import { type GlyphName, glyphSvg } from "../glyphs/glyphs";

interface Props extends GlyphHostProps {
	name: GlyphName;
}

const { name, ...rest } = Astro.props;
---

<GlyphSvg svg={glyphSvg(name)} data-glyph={name} {...rest} />
