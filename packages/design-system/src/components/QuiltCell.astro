---
// QuiltCell — one entry of a Quilt's grid (styles/quilt.css), the spec
// sheet's: a LABEL ROW — a RuleLabel, the number in the accent and the title
// in caps over a dotted rule — then the ART, bare on the page (the frame
// inside is `<ArtFrame decorative variant="bare" />`; the cell clips nothing
// and draws no plate, edge or corner of its own). A post is a link around
// both, named by its title; a filler is the same row with a dim file tag
// (`F_07`) over art drawn a step back, aria-hidden, no link. The LEAD (the
// newest post) spans a 2×2 block and carries its excerpt under the art in the
// body voice at ≥ 640; on a phone it is the full width and the excerpt is
// not drawn.
//
//   <QuiltCell col={3} row={1} href="/txt/mega-desk" label="The Mega Desk" no="003" numeral="03">
//     <ArtFrame svg={raw} decorative variant="bare" />
//   </QuiltCell>
//   <QuiltCell col={1} row={1} span={[2, 2]} href="…" label="…" no="005" numeral="05" excerpt="…">…</QuiltCell>
//   <QuiltCell col={1} row={3} filler file={7}><ArtFrame svg={filler} decorative variant="bare" /></QuiltCell>
//
// THE STATE CONTRACT, which a script drives and this file renders statically:
//   data-state="lit | faint | gone"   lit is the rest state; faint is the
//                                     ghost (low opacity, greyscale on a desktop
//                                     with a pointer); gone is invisible and
//                                     takes no pointer, but a post stays
//                                     focusable so Tab still reaches it. A
//                                     state fades the label and the art as one.
//   --scatter-delay                   the cell's stagger (0–240ms) into faint
//                                     or gone; the return to lit has none.
//   data-active                       the 1px accent outline round the art —
//                                     the active search result, the stepped
//                                     post.
// Placement: `col`/`row` for the ≥ 1024 grid and `colMd`/`rowMd` for the
// 640–1023 one, as custom properties the stylesheet reads per viewport (an
// inline style for a real API, like Grid's spans), and `span` — [cols, rows]
// — the footprint, as `--cell-cols`/`--cell-rows` and `data-span`; under 640
// every cell flows in DOM order and a spanned cell takes the whole width. A
// filler without a `colMd` is dropped on the tablet grid, one without a `col`
// on the desktop grid (the tablet grid can need more fillers than the desktop
// one), and every filler is dropped on a phone. `data-no` carries the post's
// number for a script that keys on it (`005`); `numeral` is the number as the
// label draws it (`05`; `no` when unset). `class` merges; the rest passes to
// the cell.
import { cx } from "../lib/cx";
import RuleLabel from "./RuleLabel.astro";
import Body from "./Body.astro";

type State = "lit" | "faint" | "gone";

interface Props {
	col?: number;
	row?: number;
	colMd?: number;
	rowMd?: number;
	/** The footprint in cells, [cols, rows]; one cell when unset. */
	span?: [number, number];
	/** A post: the link. */
	href?: string;
	/** The post's title — the link's accessible name, and the label row's text. */
	label?: string;
	/** The post's chronological number, zero-padded ("003"): `data-no`. */
	no?: string | number;
	/** The number as the label draws it ("03"); `no` when unset. */
	numeral?: string | number;
	/** The lead's excerpt, under the art at ≥ 640. */
	excerpt?: string;
	/** A filler: aria-hidden, no link. */
	filler?: boolean;
	/** A filler's file number (1-based), drawn as its tag `F_07`. */
	file?: number | string;
	state?: State;
	/** The accent ring. */
	active?: boolean;
	/** The scatter stagger in ms, when rendering a scattered state statically. */
	delay?: number;
	class?: string;
	style?: string;
	[key: string]: unknown;
}

const {
	col,
	row,
	colMd,
	rowMd,
	span,
	href,
	label,
	no,
	numeral = no,
	excerpt,
	filler = false,
	file,
	state = "lit",
	active = false,
	delay,
	class: className,
	style,
	...rest
} = Astro.props;

if (!filler && !href) {
	throw new Error("QuiltCell: a post cell needs an `href` (or say `filler`).");
}

const vars = [
	col && `--cell-col:${col}`,
	row && `--cell-row:${row}`,
	colMd && `--cell-col-md:${colMd}`,
	rowMd && `--cell-row-md:${rowMd}`,
	span && span[0] > 1 && `--cell-cols:${span[0]}`,
	span && span[1] > 1 && `--cell-rows:${span[1]}`,
	delay != null && `--scatter-delay:${delay}ms`,
	style,
]
	.filter(Boolean)
	.join(";");

const spanned = !!span && (span[0] > 1 || span[1] > 1);
const tag = file != null ? `F_${String(file).padStart(2, "0")}` : undefined;
---

{
	filler ? (
		<div
			class={cx("ds-quilt-cell", className)}
			data-cell="filler"
			data-state={state}
			data-lg={col ? "" : undefined}
			data-md={colMd ? "" : undefined}
			aria-hidden="true"
			style={vars || undefined}
			{...rest}
		>
			<RuleLabel as="span" class="ds-quilt-cell__label" lines={2} dim>{tag}</RuleLabel>
			<span class="ds-quilt-cell__art">
				<slot />
			</span>
		</div>
	) : (
		<div
			class={cx("ds-quilt-cell", className)}
			data-cell="post"
			data-state={state}
			data-no={no}
			data-span={spanned ? `${span![0]}x${span![1]}` : undefined}
			data-active={active ? "" : undefined}
			data-md={colMd ? "" : undefined}
			style={vars || undefined}
			{...rest}
		>
			<a class="ds-quilt-cell__link ds-control" href={href} aria-label={label}>
				<RuleLabel as="span" class="ds-quilt-cell__label" lines={2} no={numeral}>{label}</RuleLabel>
				<span class="ds-quilt-cell__art">
					<slot />
				</span>
				{excerpt && (
					<Body as="span" class="ds-quilt-cell__excerpt">{excerpt}</Body>
				)}
			</a>
		</div>
	)
}
