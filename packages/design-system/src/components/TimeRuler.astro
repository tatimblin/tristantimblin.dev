---
// TimeRuler — a ruler on a time scale, one slot per month from `from` to
// `to`, a year label under every January, and a MARK for each post in its
// month (styles/time-ruler.css). Two drawings of the same strip:
//
//   ticks (default)  a tick per month, a taller lit one for every mark, the
//                    accent PLAYHEAD (line and dot) on one month, a caps
//                    label above.
//   bars             the spec sheet's chart: a mark is an OUTLINED BAR whose
//                    height is its `value` against `max` (words per post),
//                    the mark in FOCUS filled with the accent (the playhead's
//                    job here — no line is drawn), an empty month a tiny tick,
//                    a hairline baseline, a vertical SCALE at the right edge
//                    (`max` … 0), and the label centred on a dimension line
//                    (a DimensionLabel) above.
//
//   <TimeRuler from="2023-01" to="2026-12" label="timeline" playhead="2026-02"
//              marks={[{ month: "2026-02", label: "Asserting on Agent Behavior, Feb 2026",
//                        href: "/txt/asserting-on-agent-behavior", no: "005" }]} />
//   <TimeRuler variant="bars" from="2023-01" to="2026-12" max={1000}
//              label="Timeline · words per post"
//              marks={[{ …, value: 554, focus: true }]} />
//
// A MARK IS A LINK: a real <a> to the post, named by `label` (the title and
// the date), so the ruler works with scripting off and a screen reader hears
// what each mark is. It fills its month's column, so the hit area is the
// column, not the bar; two posts in one month split the column. The plain
// ticks, the scale and the years are decoration and carry nothing.
//
// THE CONTRACT a script drives (the site's src/lib/quilt/index.ts):
//   --at                the playhead's position on the root, a percentage —
//                       `setProperty("--at", …)` glides it (ticks)
//   data-month          on every month column, "YYYY-MM": a script finds a
//                       post's column by it and reads the playhead position
//                       from the column's `--k` / `--n`
//   data-mark, data-no  on a mark; data-dim (with aria-disabled) is a mark
//                       whose post is not in the current filter: drawn in the
//                       tick colour, not clickable
//   data-focus          on the ONE mark in focus (bars): its bar fills with
//                       the accent
//   --time-ruler-value  on a mark (bars): its height as a fraction of `max`
// `class` merges; everything else passes to the root.
import { cx } from "../lib/cx";
import DimensionLabel from "./DimensionLabel.astro";
import Mono from "./Mono.astro";

interface Mark {
	/** "YYYY-MM" */
	month: string;
	/** The accessible name: the title and the date. */
	label: string;
	href: string;
	no?: string | number;
	dim?: boolean;
	/** bars: the bar's height, against `max` (a post's words). */
	value?: number;
	/** bars: the mark in focus, filled with the accent. */
	focus?: boolean;
}

interface Props {
	as?: string;
	/** ticks (default): a tick per month and the playhead. bars: an outlined bar per mark, the scale. */
	variant?: "ticks" | "bars";
	/** "YYYY-MM", inclusive. */
	from: string;
	/** "YYYY-MM", inclusive. */
	to: string;
	marks?: Mark[];
	/** bars: the top of the scale; a mark's `value` is drawn against it. */
	max?: number;
	/** ticks: "YYYY-MM" the playhead sits on; none draws no playhead. */
	playhead?: string;
	/** The caps label above the strip (default "timeline"); a dimension-line label in bars. */
	label?: string;
	class?: string;
	style?: string;
	[key: string]: unknown;
}

const {
	as = "div",
	variant = "ticks",
	from,
	to,
	marks = [],
	max,
	playhead,
	label = "timeline",
	class: className,
	style,
	...rest
} = Astro.props;

const Tag = as as any;
const bars = variant === "bars";

const parse = (ym: string): [number, number] => {
	const m = /^(\d{4})-(\d{2})$/.exec(ym);
	if (!m) throw new Error(`TimeRuler: "${ym}" is not YYYY-MM`);
	return [Number(m[1]), Number(m[2])];
};
const [y0, m0] = parse(from);
const [y1, m1] = parse(to);
const n = (y1 - y0) * 12 + (m1 - m0) + 1;
if (n < 1) throw new Error(`TimeRuler: \`to\` (${to}) is before \`from\` (${from})`);
if (bars && !(max && max > 0)) throw new Error("TimeRuler: `variant=\"bars\"` needs a `max` above 0");

const key = (k: number) => {
	const abs = y0 * 12 + (m0 - 1) + k;
	return `${Math.floor(abs / 12)}-${String((abs % 12) + 1).padStart(2, "0")}`;
};
const months = Array.from({ length: n }, (_, k) => key(k));
const byMonth = new Map<string, Mark[]>();
for (const mark of marks) byMonth.set(mark.month, [...(byMonth.get(mark.month) ?? []), mark]);

/** The playhead's position: the centre of month k, a percentage of the width. */
const at = (k: number) => `${(((k + 0.5) / n) * 100).toFixed(3)}%`;
const headK = !bars && playhead ? months.indexOf(playhead) : -1;
const years = months.flatMap((ym, k) => (ym.endsWith("-01") || k === 0 ? [{ label: ym.slice(0, 4), k }] : []));
/** A bar's height, a fraction of the scale, held to it. */
const fraction = (mark: Mark) =>
	max ? Math.min(1, Math.max(0, (mark.value ?? 0) / max)).toFixed(3) : undefined;

const vars = [`--months:${n}`, headK >= 0 && `--at:${at(headK)}`, style].filter(Boolean).join(";");
---

<Tag
	class={cx("ds-time-ruler", bars && "ds-time-ruler--variant-bars", className)}
	style={vars}
	data-time-ruler
	role="group"
	aria-label={label}
	{...rest}
>
	{
		bars ? (
			<DimensionLabel class="ds-time-ruler__label">{label}</DimensionLabel>
		) : (
			<div class="ds-time-ruler__head">
				<Mono>{label}</Mono>
			</div>
		)
	}
	<div class="ds-time-ruler__body">
		<div class="ds-time-ruler__plot">
			<div class="ds-time-ruler__strip">
				{
					months.map((ym, k) => (
						<span
							class="ds-time-ruler__month"
							data-month={ym}
							data-year={ym.endsWith("-01") ? "" : undefined}
							style={`--k:${k}`}
						>
							{byMonth.get(ym)?.map((mark) => (
								<a
									class="ds-time-ruler__mark ds-control"
									href={mark.href}
									aria-label={mark.label}
									title={mark.label}
									style={bars ? `--time-ruler-value:${fraction(mark)}` : undefined}
									data-mark
									data-no={mark.no}
									data-dim={mark.dim ? "" : undefined}
									data-focus={bars && mark.focus ? "" : undefined}
									aria-disabled={mark.dim ? "true" : undefined}
								/>
							))}
						</span>
					))
				}
				{headK >= 0 ? <span class="ds-playhead ds-time-ruler__playhead" aria-hidden="true" /> : null}
			</div>
			<div class="ds-time-ruler__years" aria-hidden="true">
				{
					years.map((y) => (
						<Mono tone="tertiary" class="ds-time-ruler__year" style={`--k:${y.k}`}>
							{y.label}
						</Mono>
					))
				}
			</div>
		</div>
		{
			bars && (
				<div class="ds-time-ruler__scale" aria-hidden="true">
					<Mono variant="value" tone="tertiary">{max}</Mono>
					<span class="ds-time-ruler__scale-line" />
					<Mono variant="value" tone="tertiary">0</Mono>
				</div>
			)
		}
	</div>
</Tag>
