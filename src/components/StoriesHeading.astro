---
// The "tristan / & other stories" lockup.
//
// Structure (see theme/stories-heading for the mechanics):
//   .sh__wordmark — the h1: "tristan", sized in CSS to the lockup's width, and
//                   position: sticky — from the first pixel of scroll it drifts
//                   up a little, holds where the layout pins it, and rides down
//                   the lockup's box until that box ends, then scrolls on with
//                   whatever follows. Its text is visually hidden ("Tristan
//                   & other stories"); what shows are two aria-hidden layers:
//     .sh__outline  the outlined word, filled with the page colour,
//     .sh__solid    the solid word on an opaque backdrop, wobbling, clipped in
//                   by the outline→solid wipe once the word pins.
//   .sh__sub      — "& other stories", then the page-authored intro (the default
//                   slot). Not sticky: it scrolls with the page, and fades out
//                   over the first stretch of scroll.
//
// The component owns the lockup only. Where it sits, how wide it is and how
// tall its box (the pin's range) is are the layout's: see HomeLayout.astro.
import Text from "@whois/design-system/Text";
---

<stories-heading>
	<h1 class="sh__wordmark">
		<span class="ds-visually-hidden">Tristan &amp; other stories</span>
		<span class="sh__outline" aria-hidden="true">tristan</span>
		<span class="sh__solid" aria-hidden="true"><wobble-text scale="5" speed="0.3">tristan</wobble-text></span>
	</h1>
	<div class="sh__sub">
		{/* One line, in the hero face: the rest of the name, read with the h1 above. */}
		<Text as="p" class="sh__tagline" family="hero" size={6} responsive aria-hidden="true">
			&amp; other stories
		</Text>
		<slot />
	</div>
</stories-heading>
