---
// PostStack — /txt's list: a ruled two-column table, the date on the left and
// the title on the right, with one post open at a time. The newest is open
// on every arrival (a load, a client-router swap, a back/forward restore
// from the bfcache); pointing at another opens it (a tap or click on a
// phone or anywhere a closed post is clicked, focus from the keyboard). The
// open post's body sits in the right half: its category and word count and
// its excerpt, then — pinned to the foot of the body — a control rail: READ,
// a solid accent button flush in the corner the column rule makes with the
// post's bottom hairline, and a faint line from its top edge across the rest
// of the half, an empty strip for controls to come.
//
// THE CLICK RULE: a title is a link only while its post is open (and is
// underlined then, to say so). A click (mouse, pen, touch, or Enter) on a
// post that was CLOSED when the press began — read at pointerdown; at the
// click itself for a keyboard click — only opens it, anywhere in its header
// row, date or title. On a desktop the hover has opened the post before the
// press, so a click on its title navigates at once; a click with no
// movement first, a tap, or a tap's twin on a pen opens and waits for a
// second. From the keyboard, focusing a title opens its post, so Enter on
// it navigates — the same as the hover.
//
// THE INVARIANT: opening a post never moves a different post under a still
// pointer. Two things make that hold:
//
//   1. GEOMETRY. A post's header is laid out identically open and closed —
//      only its ink changes — and every post's open body is the SAME height
//      H, measured by the script as the tallest natural body (the rail
//      included) and set as --stack-open on the list. Exactly one post is
//      open, so the list's height is constant and the posts below the open one never move. When
//      the pointer moves from open post A down to B, A loses H above B's
//      header while B gains H below it: B's bottom edge stays put and B only
//      grows around the pointer. The swap is animated from the current heights
//      of EVERY body to its target on one clock (the same duration and easing,
//      started in one task), so the sum is constant on every frame too — even
//      when a third post is pointed at mid-swap, which plain CSS transitions
//      cannot promise (a reversed transition is shortened).
//   2. INTENT. Only a pointermove whose coordinates differ from the last one
//      opens a post. pointerenter / mouseover (which fire when content slides
//      under a still pointer) never do, and leaving the list leaves the open
//      post open. overflow-anchor: none keeps scroll anchoring out of it.
//
// One consumer, so a site component built from DS pieces and tokens, not a DS
// component (extract it if a second appears). PostIndex still draws the tag
// pages.
//
// DEMOS (src/content/demos) are interleaved by date: the same row, with a
// DEMO chip after the title, `demo / 00N` (their own count) for the meta,
// the one-line description for the excerpt, and VIEW for READ.
import type { CollectionEntry } from "astro:content";
import Text from "@whois/design-system/Text";
import Mono from "@whois/design-system/Mono";
import Body from "@whois/design-system/Body";
import Button from "@whois/design-system/Button";
import Chip from "@whois/design-system/Chip";
import Icon from "@whois/design-system/Icon";
import {
	byDateDesc,
	categories,
	demoHref,
	isoDate,
	monthYear,
	padNo,
	postHref,
	postNumbers,
	readingStats,
} from "../../lib/blog";

type Entry = CollectionEntry<"txt"> | CollectionEntry<"demos">;

interface Props {
	posts: Entry[];
	label?: string;
}

const { posts, label = "Posts" } = Astro.props;
const demoNos = postNumbers(posts.filter((e) => e.collection === "demos"));
const rows = byDateDesc(posts).map((entry) => {
	if (entry.collection === "demos") {
		return {
			href: demoHref(entry.id),
			date: entry.data.date,
			title: entry.data.title,
			demo: true,
			meta: `demo / ${padNo(demoNos.get(entry.id)!)}`,
			excerpt: entry.data.description,
			action: "View",
		};
	}
	const cat = entry.data.category ? categories[entry.data.category] : null;
	const { words } = readingStats(entry.body);
	return {
		href: postHref(entry.id),
		date: entry.data.date,
		title: entry.data.title,
		demo: false,
		meta: [cat?.label, `${words.toLocaleString("en-US")} words`].filter(Boolean).join(" · "),
		excerpt: entry.data.excerpt,
		action: "Read",
	};
});
---

{
	rows.length === 0 ? (
		<Body variant="tertiary">Nothing here yet.</Body>
	) : (
		<ol class="stack" aria-label={label} data-stack>
			{rows.map(({ href, date, title, demo, meta, excerpt, action }, i) => {
				return (
					<li class="stack__post" data-open={i === 0 ? "" : undefined} data-demo={demo ? "" : undefined}>
						<Mono as="time" class="stack__date" datetime={isoDate(date)}>
							{monthYear(date)}
						</Mono>
						<Text as="a" size={4} responsive class="stack__title ds-control" href={href}>
							{title}
							{demo && <Chip class="stack__chip">Demo</Chip>}
						</Text>
						<div class="stack__body">
							<div class="stack__body-inner" data-stack-measure>
								<div class="stack__text">
									<Mono class="stack__meta">{meta}</Mono>
									<Body class="stack__excerpt">{excerpt}</Body>
								</div>
								<div class="stack__rail">
									{/* The second link to the same place: the title is the tab stop. */}
									<Button
										as="a"
										variant="primary"
										href={href}
										tabindex="-1"
										aria-hidden="true"
										class="stack__read"
									>
										{action}
										<Icon slot="end-icon" name="external" />
									</Button>
									<div class="stack__strip" />
								</div>
							</div>
						</div>
					</li>
				);
			})}
		</ol>
	)
}

<style>
	/* The ruled table: the edge above and below the list, one between posts,
	   and the vertical one between the columns. That one is a pseudo-element
	   down the post's middle (the columns are equal halves), not a cell
	   border, so the date can sit on the title's baseline and the open body
	   can span both columns without breaking the rule — drawn with the same
	   var(--border) as the other edges, so its dash and colour are theirs.
	   Square, flat, no fill. */
	.stack {
		list-style: none;
		margin: 0;
		padding: 0;
		border-block: var(--border);
		/* Scroll anchoring must not shift the page while a swap runs. */
		overflow-anchor: none;
	}
	.stack__post {
		--stack-gutter: var(--space-5);
		/* The open body's text inset from its half's left edge: the title's
		   gutter, so the meta, the excerpt and READ's label start on the
		   title's x. On a phone the body bleeds to the viewport edge and this
		   becomes the page gutter it bled through. */
		--stack-inset: var(--stack-gutter);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		grid-template-rows: auto auto;
		position: relative;
	}
	.stack__post::before {
		content: "";
		position: absolute;
		inset-block: 0;
		inset-inline-start: 50%;
		margin-inline-start: calc(var(--border-width) / -2);
		border-inline-start: var(--border);
		pointer-events: none;
	}
	.stack__post + .stack__post {
		border-block-start: var(--border);
	}

	/* THE HEADER. Identical open and closed: the same size, weight, tracking
	   and padding in both states, so a title can never rewrap on open. The
	   ink is the only thing that moves — tertiary closed, primary open — and
	   the open title's underline, which says it is a link now (a closed
	   header only opens its post; see the script). The underline is a text
	   decoration, never a border or padding, so it lays nothing out. The
	   date is the caps label voice (tabular, from Mono), on the title's first
	   baseline. */
	.stack__date,
	.stack__title {
		display: block;
		padding-block: var(--space-4);
		color: var(--text-tertiary);
		transition: color var(--duration-swap) var(--ease-reveal);
	}
	.stack__date {
		grid-column: 1;
		grid-row: 1;
		align-self: baseline;
		padding-inline-end: var(--stack-gutter);
		text-align: end;
	}
	.stack__title {
		grid-column: 2;
		grid-row: 1;
		align-self: baseline;
		padding-inline-start: var(--stack-gutter);
		line-height: var(--line-height-ui);
		/* The control's reset drops the underline; the ring is control.css's,
		   drawn inside the cell so it never clips on the hairlines. */
		--control-ring-offset: var(--focus-ring-inset);
	}
	.stack__post[data-open] .stack__date,
	.stack__post[data-open] .stack__title {
		color: var(--text-primary);
	}
	/* The DS Anchor's underline, as a decoration: a 1px hairline in the
	   text's own ink, clear of the descenders. */
	.stack__post[data-open] .stack__title {
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--space-1);
	}
	/* A demo's marker: the DS chip after its title, on the title's middle.
	   A chip is an inline box, so the open title's underline stops short of it. */
	.stack__chip {
		margin-inline-start: var(--space-2);
		vertical-align: middle;
	}
	/* A closed header is one target: anywhere on it opens the post. */
	.stack__post:not([data-open]) .stack__date {
		cursor: pointer;
	}

	/* THE BODY. Closed: no height, clipped, hidden to readers. Open: exactly
	   --stack-open tall (the script's H; auto without it, so the first post
	   reads with scripting off). The body itself carries no padding, border or
	   margin — all of that is on the inner, which is what the script measures,
	   so H is the whole of what opening adds. The inner is at least H tall
	   (the script lifts that floor while it measures, so H is the natural
	   height), with the text in the right half's first row and the rail in
	   its last: the slack collects between them and the rail sits on the
	   foot of the H box, where the clip reveals it rather than carrying it.
	   The script animates the height; here only visibility waits for the
	   close to finish, and the inner fades. */
	.stack__body {
		grid-column: 1 / -1;
		grid-row: 2;
		block-size: 0;
		overflow: clip;
		visibility: hidden;
		transition: visibility 0s linear var(--duration-swap);
	}
	.stack__post[data-open] .stack__body {
		block-size: var(--stack-open, auto);
		visibility: visible;
		transition: none;
	}
	.stack__body-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		grid-template-rows: 1fr auto;
		min-block-size: var(--stack-open, auto);
		opacity: 0;
		transition: opacity var(--duration-swap) var(--ease-reveal);
	}
	.stack[data-stack-measuring] .stack__body-inner {
		min-block-size: 0;
	}
	.stack__post[data-open] .stack__body-inner {
		opacity: 1;
	}
	.stack__text {
		grid-column: 2;
		grid-row: 1;
		align-self: start;
		display: grid;
		justify-items: start;
		gap: var(--space-4);
		padding-inline-start: var(--stack-inset);
		padding-block-end: var(--space-6);
	}
	.stack__meta {
		display: block;
	}
	.stack__excerpt {
		max-inline-size: var(--measure-note);
	}

	/* THE RAIL: the right half's foot, edge to edge — READ in the corner
	   (the column rule on its left, the post's bottom hairline under it),
	   then the strip: a faint hairline level with READ's top, as tall as
	   READ, empty. READ is the DS's primary button, the accent fill with
	   --on-accent; squared off here so it sits in a ruled corner, and its
	   ring drawn inside, where the body's clip can't cut it. Its leading
	   padding is the text inset, with no border and no caps indent (the
	   button's centring of the tracking) on that side, so the label starts
	   on the title's and the excerpt's x. */
	.stack__rail {
		grid-column: 2;
		grid-row: 2;
		display: flex;
	}
	.stack__read {
		/* A step taller than the DS's fixed --space-6 box (whose ~--space-2 of
		   slack around the icon is its effective block padding): the height
		   follows the padding, and the strip follows READ. */
		block-size: auto;
		padding-block: var(--space-3);
		border-radius: var(--radius-box);
		border-inline-start-width: 0;
		padding-inline-start: var(--stack-inset);
		text-indent: 0;
		--control-ring-offset: var(--focus-ring-inset);
	}
	.stack__strip {
		flex: 1;
		border-block-start: var(--border-width) var(--border-style)
			color-mix(in oklab, var(--hairline) 50%, transparent);
	}

	/* Phone: one column — the date above the title, no rule between them; the
	   rail spans the width at the foot of the body. The list bleeds through
	   the page gutter (BlogLayout's --container-inset) on both sides, so its
	   hairlines run to the viewport's edges, and each post pads that gutter
	   back in: the header stays on the page's x. The body bleeds out again
	   across the post's padding, so READ meets the viewport's left edge and
	   the strip its right; the text is inset by the gutter, back on the
	   title's x. */
	@media (max-width: 639px) {
		.stack {
			margin-inline: calc(-1 * var(--container-inset));
		}
		.stack__post {
			--stack-inset: var(--container-inset);
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: auto auto auto;
			padding-inline: var(--stack-inset);
		}
		.stack__post::before {
			content: none;
		}
		.stack__date {
			grid-column: 1;
			grid-row: 1;
			align-self: start;
			padding-inline-end: 0;
			padding-block-end: 0;
			text-align: start;
		}
		.stack__title {
			grid-column: 1;
			grid-row: 2;
			align-self: start;
			padding-inline-start: 0;
			padding-block-start: var(--space-2);
		}
		.stack__body {
			grid-column: 1;
			grid-row: 3;
			margin-inline: calc(-1 * var(--stack-inset));
		}
		.stack__body-inner {
			grid-template-columns: minmax(0, 1fr);
		}
		.stack__text,
		.stack__rail {
			grid-column: 1;
		}
		.stack__text {
			padding-inline-end: var(--stack-inset);
		}
	}
</style>

<script>
	import { onPage } from "@whois/design-system/lib/lifecycle";

	const POST = ".stack__post";

	/** "260ms" | "0s" → milliseconds. */
	const ms = (value: string): number => {
		const m = /^\s*([\d.]+)\s*(ms|s)\s*$/.exec(value);
		return m ? parseFloat(m[1]) * (m[2] === "s" ? 1000 : 1) : 0;
	};

	function bind(list: HTMLElement) {
		const posts = Array.from(list.querySelectorAll<HTMLElement>(POST));
		const bodies = posts.map((post) => post.querySelector<HTMLElement>(".stack__body")!);
		const inners = posts.map((post) => post.querySelector<HTMLElement>("[data-stack-measure]")!);
		const controller = new AbortController();
		const { signal } = controller;

		/* H: the tallest natural body. Set once up front and again whenever a
		   body's content or the column's width changes (a font arriving, a
		   resize), so every post opens by the same amount. The inners are
		   floored at H, so the floor is lifted for the read and restored in
		   the same task: nothing is painted in between. The texts are
		   observed too, since a floored inner doesn't resize when its text
		   shrinks. */
		let open = 0;
		const measure = () => {
			list.setAttribute("data-stack-measuring", "");
			const next = Math.max(0, ...inners.map((el) => el.getBoundingClientRect().height));
			list.removeAttribute("data-stack-measuring");
			if (next === open) return;
			open = next;
			list.style.setProperty("--stack-open", `${next}px`);
		};
		measure();
		const ro = new ResizeObserver(measure);
		ro.observe(list);
		inners.forEach((el) => {
			ro.observe(el);
			ro.observe(el.querySelector(".stack__text")!);
		});
		document.fonts?.ready.then(() => {
			if (!signal.aborted) measure();
		});

		/* The swap. Every body goes from its CURRENT height (mid-flight or at
		   rest) to its target on one clock, so at any instant the heights sum
		   to H and nothing below the pointer's post moves. The CSS resting
		   values equal the targets, so the animations simply end. */
		const swap = (target: HTMLElement) => {
			if (target.hasAttribute("data-open")) return;
			const style = getComputedStyle(list);
			const duration = ms(style.getPropertyValue("--duration-swap"));
			const easing = style.getPropertyValue("--ease-reveal").trim() || "ease";
			const current = bodies.map((body) => body.getBoundingClientRect().height);
			bodies.forEach((body) => body.getAnimations().forEach((a) => a.cancel()));
			posts.forEach((post) => {
				if (post === target) post.setAttribute("data-open", "");
				else post.removeAttribute("data-open");
			});
			if (duration <= 0) return;
			bodies.forEach((body, i) => {
				const to = posts[i] === target ? open : 0;
				if (current[i] === to) return;
				body.animate([{ blockSize: `${current[i]}px` }, { blockSize: `${to}px` }], {
					duration,
					easing,
				});
			});
		};

		const postOf = (node: EventTarget | null) =>
			node instanceof Element ? node.closest<HTMLElement>(POST) : null;

		/* INTENT: a pointermove whose coordinates changed. The coordinates are
		   tracked on the whole document, not just the list, so the synthetic
		   move a browser sends after a scroll or a layout change (content
		   sliding under a still pointer, even one that was resting outside the
		   list) repeats the last position and never counts. The first move
		   seen only records it. */
		let last: { x: number; y: number } | null = null;
		document.addEventListener(
			"pointermove",
			(e) => {
				if (e.pointerType === "touch") return;
				const moved = last !== null && (e.clientX !== last.x || e.clientY !== last.y);
				last = { x: e.clientX, y: e.clientY };
				if (!moved) return;
				const post = postOf(e.target);
				if (post && list.contains(post)) swap(post);
			},
			{ signal },
		);

		/* THE CLICK RULE (the header comment): a click on a post that was
		   closed when the press began opens it and goes nowhere; on an open
		   post the title (and READ) navigate. The state is read at
		   pointerdown, because the press itself focuses the link and the
		   focusin below has opened the post by the time the click arrives. A
		   keyboard click has no press, so it reads the state at the click. */
		let down: { post: HTMLElement | null; open: boolean } | null = null;
		list.addEventListener(
			"pointerdown",
			(e) => {
				const post = postOf(e.target);
				down = { post, open: post?.hasAttribute("data-open") ?? false };
			},
			{ signal },
		);
		list.addEventListener(
			"click",
			(e) => {
				const press = down;
				down = null;
				const post = postOf(e.target);
				if (!post) return;
				const wasOpen = press && press.post === post ? press.open : post.hasAttribute("data-open");
				if (wasOpen) return;
				e.preventDefault();
				swap(post);
			},
			{ signal },
		);

		/* KEYBOARD: focus on a post's title opens it. */
		list.addEventListener(
			"focusin",
			(e) => {
				const post = postOf(e.target);
				if (post) swap(post);
			},
			{ signal },
		);

		/* ARRIVAL: a back/forward restore from the bfcache brings the page
		   back as it was left — the hovered or tapped post open — and fires
		   no astro:page-load, so the newest is reopened here, at once. The
		   pointer gate starts over too: the restore's first move only
		   records, as a load's does. */
		window.addEventListener(
			"pageshow",
			(e) => {
				if (!e.persisted) return;
				bodies.forEach((body) => body.getAnimations().forEach((a) => a.cancel()));
				posts.forEach((post, i) => {
					if (i === 0) post.setAttribute("data-open", "");
					else post.removeAttribute("data-open");
				});
				last = null;
				down = null;
				measure();
			},
			{ signal },
		);

		return () => {
			controller.abort();
			ro.disconnect();
			bodies.forEach((body) => body.getAnimations().forEach((a) => a.cancel()));
		};
	}

	onPage(() => {
		const list = document.querySelector<HTMLElement>("[data-stack]");
		if (list) return bind(list);
	});
</script>
