---
// All of the site's SEO surface lives here so Layout.astro can pull it in with
// a single <Seo /> line. Owns: the astro-seo <SEO> component (title, meta
// description, Open Graph, Twitter card, canonical) and the schema.org Person
// JSON-LD that describes Tristan Timblin.
import { SEO } from "astro-seo";
import type { BlogPosting, Person, WithContext } from "schema-dts";

interface Props {
	title?: string;
	description?: string;
	/** Path or absolute URL to the social card; defaults to /og-small.jpg.
	 *  A page that passes one gets the large card. */
	image?: string;
	/** What the social card shows, for og:image:alt / twitter:image:alt.
	 *  Falls back to the page title for a custom card, the site name for
	 *  the default. */
	imageAlt?: string;
	noindex?: boolean;
	/** "article" switches OG type and emits BlogPosting JSON-LD. */
	type?: "website" | "article";
	/** Override the canonical URL (e.g. a syndicated post's origin). */
	canonical?: string;
	/** Article dates (ignored unless type === "article"). */
	publishDate?: Date;
	modifiedDate?: Date | null;
	tags?: string[];
}

const SITE_NAME = "Tristan Timblin";
const DEFAULT_DESCRIPTION =
	"Tristan Timblin — a craftsman who builds things to be used, finding creativity through empathetic design.";

const {
	title = SITE_NAME,
	description = DEFAULT_DESCRIPTION,
	image,
	imageAlt,
	noindex = false,
	type = "website",
	canonical: canonicalOverride,
	publishDate,
	modifiedDate,
	tags,
} = Astro.props;

// Astro.site is the configured origin (https://tristantimblin.dev). Everything
// social/canonical must be absolute, so resolve against it.
const canonical = canonicalOverride ?? new URL(Astro.url.pathname, Astro.site).href;
// Default to the small square card (300×300). iMessage/Slack/Discord render a
// compact preview from a small image rather than a full-width hero. Callers can
// still pass a larger per-page image to opt into a big card.
const ogImage = new URL(image ?? "/og-small.jpg", Astro.site).href;
// Declared so consumers size the preview without downloading the image first.
// Only trustworthy for the default card; a custom `image` may differ, so omit.
const ogImageIsDefault = !image;
// A custom card (a post's image or hero) is a real picture worth the large
// preview; the default is the small square.
const twitterCard = ogImageIsDefault ? "summary" : "summary_large_image";
const ogImageAlt = imageAlt ?? (ogImageIsDefault ? SITE_NAME : title);

const person: WithContext<Person> = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Tristan Timblin",
	url: Astro.site?.href ?? "https://tristantimblin.dev/",
	jobTitle: "Software Engineer",
	description:
		"A craftsman who builds things to be used, finding creativity through empathetic design.",
	image: new URL("/og.jpg", Astro.site).href,
	sameAs: [
		"https://github.com/tatimblin",
		"https://www.linkedin.com/in/tristan-timblin/",
	],
};

// For posts, describe the article itself and attribute it to the same Person.
const blogPosting: WithContext<BlogPosting> | null =
	type === "article"
		? {
				"@context": "https://schema.org",
				"@type": "BlogPosting",
				headline: title,
				description,
				image: ogImage,
				author: { "@type": "Person", name: person.name, url: person.url },
				mainEntityOfPage: canonical,
				...(publishDate && { datePublished: publishDate.toISOString() }),
				...(modifiedDate && { dateModified: modifiedDate.toISOString() }),
				...(tags?.length && { keywords: tags.join(", ") }),
			}
		: null;
---

<SEO
	title={title}
	description={description}
	canonical={canonical}
	noindex={noindex}
	openGraph={{
		basic: { title, type: type === "article" ? "article" : "website", image: ogImage, url: canonical },
		optional: { description, siteName: SITE_NAME },
		image: ogImageIsDefault
			? { alt: ogImageAlt, width: 300, height: 300 }
			: { alt: ogImageAlt },
		...(type === "article" && {
			article: {
				...(publishDate && { publishedTime: publishDate.toISOString() }),
				...(modifiedDate && { modifiedTime: modifiedDate.toISOString() }),
				authors: [person.url as string],
				...(tags?.length && { tags }),
			},
		}),
	}}
	twitter={{ card: twitterCard, title, description, image: ogImage, imageAlt: ogImageAlt }}
/>

<script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />
{
	blogPosting && (
		<script type="application/ld+json" set:html={JSON.stringify(blogPosting)} is:inline />
	)
}
