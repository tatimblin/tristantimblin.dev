---
import { intrinsicSize } from "../lib/intrinsicSize";

interface Props {
	slug: string;
	title: string;
	media: string;
	type: "image" | "video";
	poster?: string;
	alt: string;
}

const { slug, title, media, type, poster, alt } = Astro.props;

// Reserve each cell's box up front so the masonry column doesn't reflow as lazy
// images decode (the CLS this grid used to have — the same fix mdx/Img.astro applies
// to post images, sharing the one build-time header reader). Images read from the
// media file; videos read from their poster (the frame that actually paints, since
// they're preload="none"). The CSS still drives the rendered size (width:100%;
// height:auto) — width/height only publish the ASPECT.
const size = type === "video" ? intrinsicSize(poster ?? "") : intrinsicSize(media);
---

<!-- data-reveal sits on the LINK, not on the media inside it: the <img>/<video>
     carries a `transition:name` for the view transition into the detail page, and
     animating a named element's opacity means the transition snapshots it
     mid-fade. Revealing the wrapper leaves the named box untouched. The
     coordinator finds the media by descending, so readiness still gates on the
     real decode. -->
<a href={`/gallery/${slug}`} class="gallery-grid-item" data-reveal>
	{
		type === "video" ? (
			<video
				src={media}
				poster={poster}
				preload="none"
				muted
				aria-label={alt}
				width={size?.w}
				height={size?.h}
				transition:name={`gallery-${slug}`}
			/>
		) : (
			<img
				src={media}
				alt={alt}
				loading="lazy"
				decoding="async"
				width={size?.w}
				height={size?.h}
				transition:name={`gallery-${slug}`}
			/>
		)
	}
	<span class="gallery-grid-item__title">{title}</span>
</a>

<style>
	.gallery-grid-item {
		display: block;
		break-inside: avoid;
		margin-bottom: var(--grid-gap, 1.5rem);
		border-radius: var(--radius);
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		position: relative;
	}

	.gallery-grid-item img,
	.gallery-grid-item video {
		display: block;
		width: 100%;
		height: auto;
	}

	.gallery-grid-item__title {
		display: block;
		padding: var(--space-2) var(--space-3);
		font-size: var(--font-size-base);
		color: var(--color-muted);
	}
</style>
