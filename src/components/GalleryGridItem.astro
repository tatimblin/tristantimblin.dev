---
import { intrinsicSize } from "../lib/intrinsicSize";
import Text from "@whois/design-system/Text";

interface Props {
	slug: string;
	title: string;
	media: string;
	type: "image" | "video";
	poster?: string;
	alt: string;
}

const { slug, title, media, type, poster, alt } = Astro.props;

// Reserve each cell's box up front so the masonry column doesn't reflow as lazy
// images decode (the CLS this grid used to have — the same fix mdx/Img.astro applies
// to post images, sharing the one build-time header reader). Images read from the
// media file; videos read from their poster (the frame that actually paints, since
// they're preload="none"). The CSS still drives the rendered size (width:100%;
// height:auto) — width/height only publish the ASPECT.
const size = type === "video" ? intrinsicSize(poster ?? "") : intrinsicSize(media);
---

<!-- data-reveal sits on the LINK, not on the media inside it: the <img>/<video>
     carries a `transition:name` for the view transition into the detail page, and
     animating a named element's opacity means the transition snapshots it
     mid-fade. Revealing the wrapper leaves the named box untouched. The
     coordinator finds the media by descending, so readiness still gates on the
     real decode. -->
<!-- A RAW <a>, deliberately, where the rest of this route now uses DS Anchor: this
     is a whole-card link wrapping media, not a link in running text. Anchor exists
     to give link TEXT the hyperlink color and a hover/arrow affordance, and it
     asserts `color: var(--color, var(--hyperlink))` — which this card must not
     have, because the card's own caption sets its ink and everything else inside
     is an image. Worse, that assertion lands at the same specificity (0,1,0) as
     the scoped `color: inherit` below, so which one won would come down to
     stylesheet order. The component would be fighting the pattern, not serving it. -->
<a href={`/gallery/${slug}`} class="gallery-grid-item" data-reveal>
	{
		type === "video" ? (
			<video
				src={media}
				poster={poster}
				preload="none"
				muted
				aria-label={alt}
				width={size?.w}
				height={size?.h}
				transition:name={`gallery-${slug}`}
			/>
		) : (
			<img
				src={media}
				alt={alt}
				loading="lazy"
				decoding="async"
				width={size?.w}
				height={size?.h}
				transition:name={`gallery-${slug}`}
			/>
		)
	}
	<Text size={3} variant="tertiary" class="gallery-grid-item__title">{title}</Text>
</a>

<style>
	.gallery-grid-item {
		display: block;
		break-inside: avoid;
		/* 24px, the value the legacy --grid-gap knob (with its hardcoded 1.5rem
		   fallback) already resolved to. Spelled as the DS step so this margin and
		   the grid's column-gap in gallery/index.astro are one decision. */
		margin-bottom: var(--space-5);
		border-radius: var(--border-radius-2);
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		position: relative;
	}

	.gallery-grid-item img,
	.gallery-grid-item video {
		display: block;
		width: 100%;
		height: auto;
	}

	/* The caption's BOX only — its type and color come from the Text (size 3 is the
	   16px the legacy --font-size-base alias meant; variant tertiary is where
	   --color-muted bridges to). Scoped under the card so the selector is (0,2,0):
	   Astro scopes with :where(), so a lone class would tie with .ds-text's
	   `padding: 0` and be decided by stylesheet order. */
	.gallery-grid-item .gallery-grid-item__title {
		display: block;
		padding: var(--space-2) var(--space-3);
	}
</style>
