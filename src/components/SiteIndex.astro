---
// SiteIndex — the Webography post's list: every site, newest first, one line
// each (year · icon · title ···· ● domain ↗), under a row of stats. The data
// is the old Vue site's list (src/data/sites.json).
//
// The dot names the company in a tooltip on hover and keyboard focus, and as
// the dot's accessible description. The bubble's markup follows the agreed
// DS API (<Tooltip label="…">dot</Tooltip>) so it swaps for the component
// once it lands; the --company-* tokens come with it, and until then each
// dot falls back to a genre hue.
import Stat from "@whois/design-system/Stat";
import data from "../data/sites.json";
import { longDate } from "../lib/blog";

const COMPANY: Record<string, string> = {
	Personal: "personal",
	Yext: "yext",
	Cohere: "cohere",
	"Drexel University": "drexel",
};

const domain = (url: string) => new URL(url).hostname.replace(/^www\./, "");
const day = (iso: string) => longDate(new Date(`${iso}T00:00:00Z`));

const years = [...new Set(data.sites.map((s) => s.year))];
const groups = years.map((year) => ({
	year,
	sites: data.sites.filter((s) => s.year === year),
}));
let n = 0;
---

<div class="site-index" data-site-index data-prose-bleed="">
	<div class="site-index__stats">
		<Stat label="Started"><time datetime={data.started}>{day(data.started)}</time></Stat>
		<Stat label="Last added"><time datetime={data.lastAdded}>{day(data.lastAdded)}</time></Stat>
		<Stat label="Sites" value={data.sites.length} />
	</div>

	<ol class="site-index__years">
		{
			groups.map(({ year, sites }) => (
				<li class="site-index__year">
					<span class="site-index__when">{year}</span>
					<ul class="site-index__sites">
						{sites.map((site) => {
							const id = `site-tip-${++n}`;
							return (
								<li class="site-index__site" data-site>
									<span class="site-index__icon" aria-hidden="true">
										{site.icon}
									</span>
									<span class="site-index__title">{site.title}</span>
									<span class="site-index__lead" aria-hidden="true" />
									<span
										class="site-index__tip"
										tabindex="0"
										aria-describedby={id}
										data-company={COMPANY[site.company]}
									>
										<span class="site-index__dot" />
										<span class="site-index__bubble" role="tooltip" id={id}>
											{site.company}
										</span>
									</span>
									<a
										class="site-index__domain"
										href={site.url}
										title={site.desc}
										target="_blank"
										rel="noreferrer"
									>
										{domain(site.url)}
										<span aria-hidden="true"> ↗</span>
									</a>
								</li>
							);
						})}
					</ul>
				</li>
			))
		}
	</ol>
</div>

<style>
	.site-index {
		display: grid;
		gap: var(--space-6);
	}

	.site-index__stats {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4) var(--space-7);
		padding: var(--space-4);
		border: var(--border);
		border-radius: var(--radius-box);
	}

	.site-index__years,
	.site-index__sites {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* A year sits beside its first site; the rest hang under that. */
	.site-index__year {
		display: grid;
		grid-template-columns: 5ch minmax(0, 1fr);
		column-gap: var(--space-3);
		font-family: var(--font-code);
		font-size: var(--font-size-1);
		line-height: var(--line-height-ui);
	}
	.site-index__when {
		padding-block: var(--space-2);
		color: var(--text-subtle);
		font-variant-numeric: tabular-nums;
	}

	.site-index__site {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
		padding-block: var(--space-2);
		color: var(--text-body);
	}
	.site-index__icon {
		flex: none;
		inline-size: 1.5em;
		text-align: center;
	}
	/* The title gives way first: a long one wraps before the domain moves. */
	.site-index__title {
		flex: 0 1 auto;
		min-inline-size: 0;
		text-wrap: pretty;
	}
	.site-index__lead {
		flex: 1 1 var(--space-4);
		min-inline-size: var(--space-2);
		border-block-end: var(--border-width) dotted var(--border-color);
		transform: translateY(calc(-1 * var(--space-1)));
	}

	.site-index__tip {
		--company: var(--genre-other);
		position: relative;
		flex: none;
		display: inline-grid;
		place-items: center;
		inline-size: var(--space-4);
		block-size: var(--space-4);
		align-self: center;
		border-radius: var(--border-radius-pill);
		cursor: help;
	}
	.site-index__tip[data-company="personal"] {
		--company: var(--company-personal, var(--genre-sci-fi));
	}
	.site-index__tip[data-company="yext"] {
		--company: var(--company-yext, var(--genre-thriller));
	}
	.site-index__tip[data-company="cohere"] {
		--company: var(--company-cohere, var(--genre-biopic));
	}
	.site-index__tip[data-company="drexel"] {
		--company: var(--company-drexel, var(--genre-drama));
	}
	.site-index__tip:focus-visible {
		outline: var(--border-width) solid var(--link-color);
		outline-offset: var(--space-1);
	}
	.site-index__dot {
		inline-size: var(--space-2);
		block-size: var(--space-2);
		border-radius: var(--border-radius-pill);
		background: var(--company);
	}

	.site-index__bubble {
		position: absolute;
		inset-block-end: calc(100% + var(--space-1));
		inset-inline-end: calc(-1 * var(--space-2));
		z-index: 1;
		padding: var(--space-1) var(--space-2);
		white-space: nowrap;
		font-family: var(--font-ui);
		color: var(--text-primary);
		background: var(--card-background);
		border: var(--border);
		border-radius: var(--radius-box);
		box-shadow: var(--shadow-panel);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity var(--duration-quick) var(--ease-standard),
			visibility var(--duration-quick) var(--ease-standard);
	}
	.site-index__tip:is(:hover, :focus-visible) .site-index__bubble {
		opacity: 1;
		visibility: visible;
	}

	.site-index__domain {
		flex: none;
		color: var(--link-color);
		text-decoration: none;
	}
	.site-index__domain:hover {
		text-decoration: var(--link-decoration);
		text-underline-offset: var(--link-underline-offset);
	}

	/* A phone has no room for both on one line: the title takes the line
	   (wrapping if it must) and the dot and domain drop under it, past the
	   icon. No leader then. */
	@media (max-width: 639px) {
		.site-index__year {
			grid-template-columns: 4ch minmax(0, 1fr);
			column-gap: var(--space-2);
		}
		.site-index__site {
			flex-wrap: wrap;
			row-gap: var(--space-1);
		}
		.site-index__title {
			flex: 1 0 calc(100% - 1.5em - var(--space-2));
		}
		.site-index__lead {
			display: none;
		}
		.site-index__tip {
			margin-inline-start: calc(1.5em + var(--space-2) - var(--space-1));
		}
		.site-index__domain {
			flex: 1 1 0;
			min-inline-size: 0;
			overflow-wrap: anywhere;
		}
	}
</style>
