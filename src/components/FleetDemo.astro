---
// The playable version of the post's argument: a real VS Code workbench,
// running the real fleet extension, booted inside the article.
//
// The element (packages/vscode-fleet-demo) owns the whole lifecycle — poster →
// prefetch-on-approach → launch → iframe → ready. It launches at any width. This
// file supplies only the two things a package cannot know: the light-DOM markup
// it enhances, and how the frame sits on the ruled post page.
//
// element.css already dresses the poster, button, caption, progress bar and
// error note. The scoped rules below deliberately do NOT restate any of that;
// they bridge the element's token names onto the site's, and handle layout.
import "@whois/vscode-fleet-demo/element.css";
---

<fleet-demo class="fleet-demo" data-prose-bleed>
	{/* [data-poster] is the OVERLAY, not the image: element.css lays it out as a
	    centered flex column stacked over the (later) iframe, with the screenshot
	    absolutely filling it and the button/caption riding on top. */}
	<div data-poster>
		<img
			src="/blog-images/fleet-demo-poster.webp"
			alt="VS Code running a fleet-management extension: vehicle explorer, door controls, and a CAN terminal"
			width="1400"
			height="875"
			loading="lazy"
			decoding="async"
		/>
		<button type="button" data-launch>Launch the demo</button>
		<p data-caption>Real VS Code, real extension, mock vehicles. Roomier on a desktop.</p>
	</div>
</fleet-demo>

<script>
	import "@whois/vscode-fleet-demo";
</script>

<style>
	/* A plain class is enough: the DS Prose container's rhythm (`.ds-prose >
	   * + *`) sits in a cascade layer under this unlayered sheet, so the site
	   wins at any specificity. */
	.fleet-demo {
		/* Token bridge. element.css asks for --color-accent/--color-border/
		   --color-muted (generic names, with literal fallbacks, so the package
		   stands alone); this site's DS publishes --accent/--border-color/
		   --text-tertiary. Aliasing here beats overriding element.css rule by
		   rule — one hop, and the element keeps owning its own appearance. */
		--color-accent: var(--accent, #5686f5);
		--color-border: var(--border-color, rgba(128, 128, 128, 0.35));
		/* --color-muted (the caption) is deliberately NOT bridged onto
		   --text-tertiary. That token flips with the site theme, but what the
		   caption sits on does not: the poster is a Dark Modern screenshot in
		   both themes, so in light mode the "correct" tertiary would be dark
		   grey on a near-black image. The caption gets a fixed light value. */
		--color-muted: rgba(235, 238, 245, 0.86);

		/* THE ROW. The post's text sits in two of the page's four columns; a
		   workbench needs more than that, so the element says data-prose-bleed
		   and the ruled Prose gives it the whole row to the right edge — three
		   columns, ~850px at 1440, on the page's own lines. So it is simply as
		   wide as its cell, no viewport arithmetic: the grid places it. The
		   element's own children (poster, iframe) are `position: absolute;
		   inset: 0`, so the box IS the frame. Square, on the hairline, like every
		   other figure on the ruled page. */
		width: 100%;
		margin: 0;
		border-radius: 0;
		border-color: var(--hairline, var(--color-border));
	}

	/* Prose dresses every image in the column — `inline-size: 100%; block-size:
	   auto; border-radius: var(--border-radius-2)` — which is right for a photo
	   sitting in the column and wrong for a poster the element has already
	   positioned `absolute; inset: 0` inside its own framed box. That rule
	   outranks element.css (the package's sheet is imported before it), so the
	   poster's own sizing and square corners are restated here, where the
	   site's unlayered rule wins. */
	.fleet-demo [data-poster] img {
		height: 100%;
		margin-block: 0;
		border-radius: 0;
	}

	/* Give the launch button the weight of a primary action against a dark
	   screenshot — element.css supplies the accent fill; the shadow is what
	   lifts it off a busy editor background. */
	.fleet-demo [data-launch] {
		font-family: var(--font-ui, inherit);
		font-size: var(--font-size-3, 16px);
		font-weight: var(--font-weight-500, 500);
		box-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
	}

	/* The caption is a static block, so it would paint UNDERNEATH the absolutely
	   positioned poster image on the narrow viewports that reveal it. Positioning
	   it puts it back in the same painting layer as the button above it. */
	.fleet-demo [data-caption] {
		position: relative;
		font-family: var(--font-ui, inherit);
		max-width: 34ch;
		line-height: 1.45;
		text-wrap: balance;
	}

	/* On a phone the poster carries a button AND a caption over a screenshot that
	   is itself a dense screenful of editor at ~360px wide, and the caption is
	   muted grey. Dimming the poster is the one-property way to buy that
	   contrast: a scrim overlay would have to be threaded between the absolutely
	   positioned image and the text above it, which means inventing a stacking
	   order element.css deliberately leaves flat. Keyed to the same breakpoint as
	   element.css's caption reveal — desktop keeps the poster at full strength. */
	@media (max-width: 767px) {
		.fleet-demo [data-poster] img {
			filter: brightness(0.4) saturate(0.75);
		}
	}
</style>
