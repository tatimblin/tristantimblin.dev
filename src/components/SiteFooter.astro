---
// Global site footer — a basic full-width bar with a copyright line and the
// light/dark theme toggle. Themes automatically via DS tokens (--text-primary /
// --background / --hairline). Dark is the site default; the toggle persists
// the user's explicit choice in localStorage and re-tints the whole page,
// including the animating <dotted-grid> visuals (they sample the bridge's
// --color-fg / --color-bg fresh each frame).
import Text from "@whois/design-system/Text";
import Chip from "@whois/design-system/Chip";

const year = new Date().getFullYear();
---

{/* A .container row (global.css), so the footer's edges fall on the header's
     brand and nav — one container, top and bottom. */}
<footer class="site-footer container">
	{/* <Text size={1} variant="tertiary">, not a bare <p>: the size step and the
	     tertiary ink are both DS decisions, so they come from the component rather
	     than being retyped as a font-size and a colour in the scoped block below.
	     What stays local is only what the DS has no opinion about — the face. */}
	<Text as="p" size={1} variant="tertiary" class="site-footer__note">© {year} Tristan Timblin</Text>
	<div class="site-footer__controls">
		{/* The toggles are DS Chips as buttons — the ruled screen's boxed caps
		     control (/txt's filters are the same chip): a hairline box, no fill,
		     the strong hairline under the pointer, the one focus ring, and the ON
		     state read off aria-pressed as the ink filled in. The scripts below
		     keep aria-pressed true to the state, and the chip follows. */}
		<Chip as="button" type="button" data-sound-toggle aria-label="Mute ruler sounds" aria-pressed="false">
			<span data-sound-toggle-label>Sound</span>
		</Chip>
		<Chip as="button" type="button" data-theme-toggle aria-label="Switch to light theme" aria-pressed="false">
			<span data-theme-toggle-label>Light</span>
		</Chip>
	</div>
</footer>

<style>
	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4, 1rem);
		padding-block: var(--space-5, 1.5rem);
		border-top: 1px solid var(--hairline);
		background: var(--background);
		color: var(--text-primary);
	}

	/* UI FACE. A copyright line is chrome — it labels the page rather than saying
	   anything — which is the role --font-ui is defined for (tokens.overrides.css),
	   and the same reasoning that moves the header bar and the toggles below off the
	   body face. Size and colour are gone from here on purpose: <Text size={1}
	   variant="tertiary"> now carries them. */
	.site-footer__note {
		font-family: var(--font-ui);
	}

	.site-footer__controls {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}
</style>

<script>
	// Bind the toggle each time the DOM is (re)painted. astro:page-load fires on
	// the initial load AND after every view-transition navigation, so the handler
	// survives ClientRouter swaps.
	function bind() {
		const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
		if (!btn || btn.dataset.bound === "1") return;
		btn.dataset.bound = "1";

		const label = btn.querySelector<HTMLElement>("[data-theme-toggle-label]");
		const root = document.documentElement;

		const sync = () => {
			const isDark = root.classList.contains("maximeheckel-dark");
			// aria-pressed reflects "light active"; label/aria-label name the target.
			btn.setAttribute("aria-pressed", String(!isDark));
			btn.setAttribute(
				"aria-label",
				isDark ? "Switch to light theme" : "Switch to dark theme"
			);
			if (label) label.textContent = isDark ? "Light" : "Dark";
		};

		btn.addEventListener("click", () => {
			const next = root.classList.contains("maximeheckel-dark")
				? "light"
				: "dark";
			root.classList.remove("maximeheckel-light", "maximeheckel-dark");
			root.classList.add("maximeheckel-" + next);
			localStorage.setItem("theme", next);
			sync();
			// Nudge any paused/reduced-motion <dotted-grid> to repaint with the new
			// tokens (the animating default path already re-tints every frame).
			document.dispatchEvent(new Event("themechange"));
		});

		sync();
	}

	// Sound on/off for the video-carousel ruler ticks. Persists to localStorage
	// (`sound`: "on"/absent = unmuted, "off" = muted) and broadcasts `soundchange`
	// so the <video-carousel> refreshes its mute state live. Same rebind guard as
	// the theme toggle so it survives ClientRouter view-transition swaps.
	function bindSound() {
		const btn = document.querySelector<HTMLButtonElement>("[data-sound-toggle]");
		if (!btn || btn.dataset.bound === "1") return;
		btn.dataset.bound = "1";

		const label = btn.querySelector<HTMLElement>("[data-sound-toggle-label]");

		const isMuted = () => {
			try {
				return localStorage.getItem("sound") === "off";
			} catch {
				return false;
			}
		};

		const sync = () => {
			const muted = isMuted();
			// aria-pressed reflects "muted"; label names the current state.
			btn.setAttribute("aria-pressed", String(muted));
			btn.setAttribute(
				"aria-label",
				muted ? "Unmute ruler sounds" : "Mute ruler sounds"
			);
			if (label) label.textContent = muted ? "Muted" : "Sound";
		};

		btn.addEventListener("click", () => {
			const next = isMuted() ? "on" : "off";
			try {
				localStorage.setItem("sound", next);
			} catch {
				/* storage unavailable — the event still updates live listeners */
			}
			sync();
			document.dispatchEvent(new Event("soundchange"));
		});

		sync();
	}

	document.addEventListener("astro:page-load", bind);
	document.addEventListener("astro:page-load", bindSound);
</script>
