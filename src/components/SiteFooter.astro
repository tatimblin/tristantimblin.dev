---
// Global site footer — a basic full-width bar with a copyright line, the
// privacy line (to /privacy/) and the light/dark theme toggle. Themes automatically via DS tokens (--text-primary /
// --background / --border). Light is the site default; the toggle persists
// the user's explicit choice in localStorage and re-tints the whole page,
// including the <dotted-grid> visuals (they re-resolve their tone when
// data-theme on <html> changes).
import Text from "@whois/design-system/Text";
import Chip from "@whois/design-system/Chip";
import Anchor from "@whois/design-system/Anchor";
import ThemeToggle from "./ThemeToggle.astro";

const year = new Date().getFullYear();
---

{/* A .container row (global.css), so the footer's edges fall on the header's
     brand and nav — one container, top and bottom. */}
<footer class="site-footer container">
	{/* <Text size={1} variant="tertiary">, not a bare <p>: the size step and the
	     tertiary ink are both DS decisions, so they come from the component rather
	     than being retyped as a font-size and a colour in the scoped block below.
	     What stays local is only what the DS has no opinion about — the face. */}
	<div class="site-footer__notes">
		<Text as="p" size={1} variant="tertiary" class="site-footer__note">© {year} Tristan Timblin</Text>
		<Text as="p" size={1} variant="tertiary" class="site-footer__note" data-privacy-note>
			<Anchor href="/privacy/" underline="always" class="site-footer__privacy">
				No cookies. Page views are counted anonymously by GoatCounter.
			</Anchor>
		</Text>
	</div>
	<div class="site-footer__controls">
		{/* The toggles are DS Chips as buttons — the tag-style caps control
		     (/txt's filters are the same chip): the first wash, the ink under the
		     pointer, the one focus ring, and the ON state read off aria-pressed
		     as the wash stepped up. The scripts below keep aria-pressed true to
		     the state, and the chip follows. */}
		<Chip as="button" type="button" data-sound-toggle aria-label="Mute ruler sounds" aria-pressed="false">
			<span data-sound-toggle-label>Sound</span>
		</Chip>
		<ThemeToggle />
	</div>
</footer>

<style>
	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-5);
		border-top: var(--border);
		background: var(--background);
		color: var(--text-primary);
	}

	/* UI FACE. A copyright line is chrome — it labels the page rather than saying
	   anything — which is the role --font-ui is defined for (tokens.overrides.css),
	   and the same reasoning that moves the header bar and the toggles below off the
	   body face. Size and colour are gone from here on purpose: <Text size={1}
	   variant="tertiary"> now carries them. */
	.site-footer__note {
		font-family: var(--font-ui);
	}
	/* Chrome, not copy: the footer's quiet ink, the way the DS asks for a
	   quieter link (scoping --link-color, anchor.css). */
	.site-footer__notes :global(.site-footer__privacy) {
		--link-color: var(--text-tertiary);
	}
	.site-footer__notes {
		display: grid;
		gap: var(--space-1);
		min-inline-size: 0;
	}

	.site-footer__controls {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}
</style>

<script>
	import { onPage } from "@whois/design-system/lib/lifecycle";

	/** Bind a footer chip, [data-<name>-toggle], on every page load: a click
	 *  runs `flip`, then aria-pressed, the aria-label and the visible label
	 *  ([data-<name>-toggle-label]) are re-read from `isOn` via `text`. */
	function bindToggle(
		name: string,
		isOn: () => boolean,
		flip: () => void,
		text: (on: boolean) => { label: string; aria: string },
	) {
		onPage(() => {
			const btn = document.querySelector<HTMLButtonElement>(`[data-${name}-toggle]`);
			if (!btn) return;
			const label = btn.querySelector<HTMLElement>(`[data-${name}-toggle-label]`);
			const sync = () => {
				const on = isOn();
				const t = text(on);
				btn.setAttribute("aria-pressed", String(on));
				btn.setAttribute("aria-label", t.aria);
				if (label) label.textContent = t.label;
			};
			const onClick = () => {
				flip();
				sync();
			};
			btn.addEventListener("click", onClick);
			sync();
			return () => btn.removeEventListener("click", onClick);
		});
	}

	// (The theme chip binds itself: ThemeToggle.astro.)

	// Sound for the video-carousel ruler ticks: pressed = muted. Persists
	// `sound` ("off" = muted) and broadcasts `soundchange` so the carousel
	// updates live, even when storage is unavailable.
	const isMuted = () => {
		try {
			return localStorage.getItem("sound") === "off";
		} catch {
			return false;
		}
	};
	bindToggle(
		"sound",
		isMuted,
		() => {
			try {
				localStorage.setItem("sound", isMuted() ? "on" : "off");
			} catch {
				/* storage unavailable */
			}
			document.dispatchEvent(new Event("soundchange"));
		},
		(muted) =>
			muted
				? { label: "Muted", aria: "Unmute ruler sounds" }
				: { label: "Sound", aria: "Mute ruler sounds" },
	);
</script>
