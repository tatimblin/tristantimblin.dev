---
// Global site footer — a basic full-width bar with a copyright line and the
// light/dark theme toggle. Themes automatically via DS tokens (--color-fg /
// --color-bg / --border-color). Dark is the site default; the toggle persists
// the user's explicit choice in localStorage and re-tints the whole page,
// including the animating <dotted-grid> visuals (they sample --color-fg /
// --color-bg fresh each frame).
import Text from "@whois/design-system/Text";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<!-- <Text size={1} variant="tertiary">, not a bare <p>: the size step and the
	     tertiary ink are both DS decisions, so they come from the component rather
	     than being retyped as a font-size and a colour in the scoped block below.
	     What stays local is only what the DS has no opinion about — the face. -->
	<Text as="p" size={1} variant="tertiary" class="site-footer__note">© {year} Tristan Timblin</Text>
	<div class="site-footer__controls">
		<!-- RAW <button>, NOT the DS <Button> — a deliberate, documented exception.
		     Button is a FILLED control: `border: 0`, a solid per-variant background,
		     a fixed 34px height and --border-radius-1, and a hover that answers by
		     changing that fill. These toggles are the opposite treatment — a hairline
		     outline around transparent, sized by its own padding, answering a hover by
		     tinting its border and its text. Adopting Button would mean overriding
		     border, border-radius, background, height, padding AND the whole hover
		     state, which is keeping the class name and throwing away the component;
		     the alternative is shipping two filled pills into an understated footer.
		     Taking the component here would change the design, and the design is the
		     thing being kept. Tokens are adopted instead — see .site-footer__toggle. -->
		<button
			type="button"
			class="site-footer__toggle"
			data-sound-toggle
			aria-label="Mute ruler sounds"
			aria-pressed="false"
		>
			<span data-sound-toggle-label>Sound</span>
		</button>
		<button
			type="button"
			class="site-footer__toggle"
			data-theme-toggle
			aria-label="Switch to light theme"
			aria-pressed="false"
		>
			<span data-theme-toggle-label>Light</span>
		</button>
	</div>
</footer>

<style>
	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4, 1rem);
		padding-block: var(--space-5, 1.5rem);
		padding-inline: var(--container-pad, clamp(1rem, 4vw, 2rem));
		border-top: 1px solid var(--border-color, var(--color-border));
		background: var(--color-bg);
		color: var(--color-fg);
	}

	/* UI FACE. A copyright line is chrome — it labels the page rather than saying
	   anything — which is the role --font-ui is defined for (tokens.overrides.css),
	   and the same reasoning that moves the header bar and the toggles below off the
	   body face. Size and colour are gone from here on purpose: <Text size={1}
	   variant="tertiary"> now carries them. */
	.site-footer__note {
		font-family: var(--font-ui);
	}

	.site-footer__controls {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2, 0.5rem);
	}

	/* The raw-button exception is argued at the tag (see the comment in the markup).
	   Everything the DS DOES have an opinion about is taken from it here: the gap,
	   the padding and the radius were hand-typed lengths that happened to land near
	   scale steps, so they are now the steps themselves. The radius is a pure rename:
	   --border-radius-2 is 12px, and so is the `var(--radius, 12px)` it replaces —
	   --radius being a site-local alias in global.css that holds the same 12 the DS
	   already names. Same pixels, one fewer spelling of the same decision. */
	.site-footer__toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		padding: var(--space-2) var(--space-3);
		/* `font: inherit` first to clear the UA's button font wholesale (family, size,
		   weight, line-height), THEN the face — otherwise the shorthand would reset
		   whichever of those the longhand set. It had been landing these on the body
		   face; a control labelled "Sound" is interface, so it belongs on --font-ui
		   alongside the note above and the header bar. */
		font: inherit;
		font-family: var(--font-ui);
		font-size: var(--font-size-1, 0.875rem);
		color: var(--color-fg);
		background: transparent;
		border: 1px solid var(--border-color, var(--color-border));
		border-radius: var(--border-radius-2);
		cursor: pointer;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.site-footer__toggle:hover {
		border-color: var(--color-accent, var(--accent));
		color: var(--color-accent, var(--accent));
	}

	.site-footer__toggle:focus-visible {
		outline: 2px solid var(--color-accent, var(--accent));
		outline-offset: 2px;
	}
</style>

<script>
	// Bind the toggle each time the DOM is (re)painted. astro:page-load fires on
	// the initial load AND after every view-transition navigation, so the handler
	// survives ClientRouter swaps.
	function bind() {
		const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
		if (!btn || btn.dataset.bound === "1") return;
		btn.dataset.bound = "1";

		const label = btn.querySelector<HTMLElement>("[data-theme-toggle-label]");
		const root = document.documentElement;

		const sync = () => {
			const isDark = root.classList.contains("maximeheckel-dark");
			// aria-pressed reflects "light active"; label/aria-label name the target.
			btn.setAttribute("aria-pressed", String(!isDark));
			btn.setAttribute(
				"aria-label",
				isDark ? "Switch to light theme" : "Switch to dark theme"
			);
			if (label) label.textContent = isDark ? "Light" : "Dark";
		};

		btn.addEventListener("click", () => {
			const next = root.classList.contains("maximeheckel-dark")
				? "light"
				: "dark";
			root.classList.remove("maximeheckel-light", "maximeheckel-dark");
			root.classList.add("maximeheckel-" + next);
			localStorage.setItem("theme", next);
			sync();
			// Nudge any paused/reduced-motion <dotted-grid> to repaint with the new
			// tokens (the animating default path already re-tints every frame).
			document.dispatchEvent(new Event("themechange"));
		});

		sync();
	}

	// Sound on/off for the video-carousel ruler ticks. Persists to localStorage
	// (`sound`: "on"/absent = unmuted, "off" = muted) and broadcasts `soundchange`
	// so the <video-carousel> refreshes its mute state live. Same rebind guard as
	// the theme toggle so it survives ClientRouter view-transition swaps.
	function bindSound() {
		const btn = document.querySelector<HTMLButtonElement>("[data-sound-toggle]");
		if (!btn || btn.dataset.bound === "1") return;
		btn.dataset.bound = "1";

		const label = btn.querySelector<HTMLElement>("[data-sound-toggle-label]");

		const isMuted = () => {
			try {
				return localStorage.getItem("sound") === "off";
			} catch {
				return false;
			}
		};

		const sync = () => {
			const muted = isMuted();
			// aria-pressed reflects "muted"; label names the current state.
			btn.setAttribute("aria-pressed", String(muted));
			btn.setAttribute(
				"aria-label",
				muted ? "Unmute ruler sounds" : "Mute ruler sounds"
			);
			if (label) label.textContent = muted ? "Muted" : "Sound";
		};

		btn.addEventListener("click", () => {
			const next = isMuted() ? "on" : "off";
			try {
				localStorage.setItem("sound", next);
			} catch {
				/* storage unavailable — the event still updates live listeners */
			}
			sync();
			document.dispatchEvent(new Event("soundchange"));
		});

		sync();
	}

	document.addEventListener("astro:page-load", bind);
	document.addEventListener("astro:page-load", bindSound);
</script>
