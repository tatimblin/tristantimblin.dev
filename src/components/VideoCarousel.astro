---
// An autoplaying dotted-grid carousel with a date ruler that doubles as a
// scrubber. The clip data is authored in the markup (one ruler tick per clip,
// plus the caption) so it degrades gracefully; the <video-carousel> custom
// element upgrades it. See packages/video-carousel.
import Mono from "@whois/design-system/Mono";
import clipsData from "../data/video-clips.json";

interface Clip {
	src: string;
	description: string;
	location: string;
	date: string;
	alt: string;
}

interface Props {
	/** Which side the date ruler sits on relative to the video card. */
	rulerSide?: "left" | "right";
	/** Pin the ruler axis (bypasses the ≤640px auto-flip). Omit for responsive. */
	orientation?: "vertical" | "horizontal";
	/**
	 * The host has been given a box (a grid cell with a definite height) and the
	 * clip fills it; with `rulerSide="right"` the ruler overhangs the host's edge
	 * (the element's `fill` attribute; see the package's styles.css).
	 */
	fill?: boolean;
	/**
	 * The carousel as a full-bleed background scene: the clip cover-fills the host
	 * and dissolves into the ruler, which sits along the bottom edge above the
	 * caption (the element's `scene` attribute). Pair with `orientation="horizontal"`.
	 */
	scene?: boolean;
	/** Extra class(es) forwarded to the <video-carousel> host. */
	class?: string;
	/**
	 * Develop the halftone in on first arrival (the stage's <dotted-grid> `intro`,
	 * a duration in ms; `introDelay` the hold before it). Opt-in: an entrance earns
	 * its keep where the carousel IS the hero, not mid-page behind a scroll dock.
	 */
	intro?: number;
	introDelay?: number;
	/**
	 * Animate clip-to-clip changes: `xfade` is the length in ms, `xfadeMode` the
	 * style, and `xfadeLive` keeps both clips playing through the blend (which
	 * also advances each clip one transition early).
	 */
	xfade?: number;
	xfadeMode?: "threshold" | "rain";
	xfadeLive?: boolean;
	/**
	 * The lattice pitch in CSS px, per instance (a footer card and a full screen
	 * want different densities). The rest of the look (ink, gamma, cutoff, ...)
	 * is per THEME, so it is not a prop: it is set with --dg-* custom properties
	 * on the host's grid (see src/styles/halftone.css and packages/dotted-grid).
	 * An attribute would beat those and pin the value in both themes.
	 */
	cellSize?: number;
	/**
	 * Cap on the halftone's render DPR. The shader's cost is per pixel, so a
	 * full-bleed consumer passes 1; see effectiveDpr() in packages/dotted-grid for
	 * why it must stay an integer.
	 */
	maxDpr?: number;
	/**
	 * Lay the caption over the clip, bottom-left, as a TV caption with a highlight
	 * hugging each line (the element's `caption-overlay` attribute).
	 */
	captionOverlay?: boolean;
	/**
	 * Which edge a horizontal ruler's ticks stand on: `top` (default) hangs them
	 * under the clip with the years below; `bottom` stands them on the strip's
	 * floor with the years above — for a scene ruler sitting on the page edge
	 * (the element's `ruler-baseline` attribute).
	 */
	rulerBaseline?: "top" | "bottom";
}

// The clips are data (src/data/video-clips.json): footage prepared by
// tools/dotgrid/prepare-video.sh, ordered oldest→newest so autoplay steps
// forward in time. Typed, so a row missing a field fails the build.
const clips: Clip[] = clipsData;

const {
	rulerSide = "left",
	orientation,
	fill = false,
	scene = false,
	class: className,
	intro,
	introDelay,
	xfade,
	xfadeMode,
	xfadeLive,
	cellSize = 7,
	maxDpr,
	captionOverlay = false,
	rulerBaseline,
} = Astro.props;

const first = clips[0];

// Each clip's smaller AV1/VP9 .webm sits beside its .mp4 with the same stem.
const toWebm = (src: string) => src.replace(/\.mp4$/, ".webm");
---

<video-carousel
	class:list={["vc", className]}
	tick-src="/audio/tick_004.ogg"
	ruler-side={rulerSide}
	orientation={orientation}
	fill={fill ? "" : undefined}
	scene={scene ? "" : undefined}
	caption-overlay={captionOverlay ? "" : undefined}
	ruler-baseline={rulerBaseline}
>
	{/* Ruler + video share a row so the ruler's height tracks the video box only. */}
	<div class="vc__main">
		<div class="vc__ruler" role="group" data-vc-ruler aria-label="Select clip by date">
			{
				clips.map((clip, i) => (
					<button
						type="button"
						class="vc__tick vc__tick--major"
						data-index={i}
						data-src={clip.src}
						data-src-webm={toWebm(clip.src)}
						data-desc={clip.description}
						data-loc={clip.location}
						data-date={clip.date}
						data-alt={clip.alt}
						aria-label={`${clip.description} — ${clip.location} — ${clip.date}`}
					/>
				))
			}
		</div>

		<figure class="vc__stage" data-vc-stage>
			<dotted-grid
				class="vc__grid"
				data-vc-grid
				src={first?.src}
				src-webm={first ? toWebm(first.src) : undefined}
				color-reveal
				shimmer="1"
				no-loop
				max-dpr={maxDpr}
				cell-size={cellSize}
				intro={intro}
				intro-delay={introDelay}
				xfade={xfade}
				xfade-mode={xfadeMode}
				xfade-live={xfadeLive ? "" : undefined}
			></dotted-grid>
			{/* Title then place, no date (the ruler says when). Each run sits in its
			   own line so `caption-overlay` can give it one highlight that follows the
			   text across a wrap; both wrappers are `display: contents` otherwise. The
			   element rewrites the [data-vc-*] fields on every selection. */}
			<figcaption class="vc__caption">
				<span class="vc__cap-line">
					<span class="vc__cap-run vc__cap-run--title">
						<Mono class="vc__desc" tone="primary" data-vc-desc>{first?.description}</Mono>
					</span>
				</span>
				<span class="vc__cap-line">
					<span class="vc__cap-run vc__cap-run--meta">
						<Mono class="vc__loc" variant="text" data-vc-loc>{first?.location}</Mono>
					</span>
				</span>
			</figcaption>
		</figure>
	</div>
</video-carousel>
