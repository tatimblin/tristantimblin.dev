---
// An autoplaying dotted-grid carousel with a date ruler that doubles as a
// scrubber. The clip data is authored in the markup (one ruler tick per clip,
// plus the caption) so it degrades gracefully; the <video-carousel> custom
// element upgrades it. See @tristimb/video-carousel (github.com/tatimblin/dotgrid).
import clipsData from "../data/video-clips.json";
import { media } from "../lib/media";

interface Clip {
	/** A logical media name ("videos/IMG_0068.mp4"), resolved by src/lib/media.ts. */
	src: string;
	description: string;
	location: string;
	date: string;
	alt: string;
}

interface Props {
	/** Which side the date ruler sits on relative to the video card. */
	rulerSide?: "left" | "right";
	/** Pin the ruler axis (bypasses the ≤640px auto-flip). Omit for responsive. */
	orientation?: "vertical" | "horizontal";
	/** "even": one ruler tick per clip, for a list too bunched in time to scrub. */
	axis?: "even";
	/**
	 * The host has been given a box (a grid cell with a definite height) and the
	 * clip fills it; with `rulerSide="right"` the ruler overhangs the host's edge
	 * (the element's `fill` attribute; see the package's styles.css).
	 */
	fill?: boolean;
	/** Extra class(es) forwarded to the <video-carousel> host. */
	class?: string;
	/**
	 * Animate clip-to-clip changes: `xfade` is the length in ms, `xfadeMode` the
	 * style, and `xfadeLive` keeps both clips playing through the blend (which
	 * also advances each clip one transition early).
	 */
	xfade?: number;
	xfadeMode?: "threshold" | "rain";
	xfadeLive?: boolean;
	/**
	 * The lattice pitch in CSS px, per instance (the wide card and the phone's
	 * compact one want different densities). The rest of the look (ink, gamma, cutoff, ...)
	 * is per THEME, so it is not a prop: it is set with --dg-* custom properties
	 * on the host's grid (see src/styles/halftone.css and @tristimb/dotted-grid).
	 * An attribute would beat those and pin the value in both themes.
	 */
	cellSize?: number;
	/**
	 * Cap on the halftone's render DPR. The shader's cost is per pixel, so the
	 * phone's tile passes 1; see effectiveDpr() in @tristimb/dotted-grid for
	 * why it must stay an integer.
	 */
	maxDpr?: number;
}

// The clips are data (src/data/video-clips.json): footage prepared by
// tools/dotgrid/prepare-video.sh, ordered oldest→newest so autoplay steps
// forward in time. Typed, so a row missing a field fails the build.
const clips: Clip[] = clipsData;

const {
	rulerSide = "left",
	orientation,
	axis,
	fill = false,
	class: className,
	xfade,
	xfadeMode,
	xfadeLive,
	cellSize = 7,
	maxDpr,
} = Astro.props;

const first = clips[0];

// Each clip's smaller AV1/VP9 .webm sits beside its .mp4 with the same stem;
// both resolve to R2 URLs (src/lib/media.ts). <dotted-grid> loads them with
// crossOrigin="anonymous", which the bucket's CORS policy answers.
const mp4 = (src: string) => media(src);
const webm = (src: string) => media(src.replace(/\.mp4$/, ".webm"));
---

<video-carousel
	class:list={["vc", className]}
	tick-src="/audio/tick_004.ogg"
	ruler-side={rulerSide}
	orientation={orientation}
	axis={axis}
	fill={fill ? "" : undefined}
>
	{/* Ruler + video share a row so the ruler's height tracks the video box only. */}
	<div class="vc__main">
		<div class="vc__ruler" role="group" data-vc-ruler aria-label="Select clip by date">
			{
				clips.map((clip, i) => (
					<button
						type="button"
						class="vc__tick vc__tick--major"
						data-index={i}
						data-src={mp4(clip.src)}
						data-src-webm={webm(clip.src)}
						data-desc={clip.description}
						data-loc={clip.location}
						data-date={clip.date}
						data-alt={clip.alt}
						aria-label={`${clip.description} — ${clip.location} — ${clip.date}`}
					/>
				))
			}
		</div>

		<figure class="vc__stage" data-vc-stage>
			<dotted-grid
				class="vc__grid"
				data-vc-grid
				src={first ? mp4(first.src) : undefined}
				src-webm={first ? webm(first.src) : undefined}
				color-reveal
				shimmer="1"
				no-loop
				max-dpr={maxDpr}
				cell-size={cellSize}
				xfade={xfade}
				xfade-mode={xfadeMode}
				xfade-live={xfadeLive ? "" : undefined}
			></dotted-grid>
			{/* The `caption` slot is the consumer's chrome: it carries the [data-vc-*]
			   hooks, and the element rewrites those fields on every selection. */}
			<slot name="caption" />
		</figure>
	</div>
</video-carousel>

<style>
	/* Until the element upgrades, the ruler is only its authored tick buttons,
	   laid out in a column; the upgrade rebuilds it (ticks, years, orientation) in
	   the same task. Shown in that pre-upgrade state it would paint a column of
	   bare buttons for the first frames and then jump into the scrubber, a layout
	   shift. Hidden, it simply appears where it belongs. It does nothing without
	   the script either. */
	video-carousel:not(:defined) .vc__ruler {
		visibility: hidden;
	}
</style>
