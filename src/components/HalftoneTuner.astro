---
// HalftoneTuner — the homepage's dev-only panel for dialling in the videos
// card's halftone against the real carousel, per theme. src/pages/index.astro
// mounts it only under `astro dev`; nothing of it reaches a build.
//
// Starts from src/styles/halftone.css (read as text) and edits the page's
// current theme. Tone goes in as a stylesheet of the same rules the Copy
// output hands back, so each theme's values stay on that theme and a flip or a
// late variant resolves them like the real sheet would; only cell size, an
// attribute per variant, is written onto the elements.
import Knobs from "@whois/design-system/Knobs";
import KnobGroup from "@whois/design-system/KnobGroup";
import Knob from "@whois/design-system/Knob";
import Chip from "@whois/design-system/Chip";
import Button from "@whois/design-system/Button";
import Mono from "@whois/design-system/Mono";
import { attrKnobs, colourKnobs, toneKnobs, POLARITIES } from "../lib/halftone-controls";
import { THEMES } from "../lib/halftone-tuner";

const cellKnob = attrKnobs.find((k) => k.attr === "cell-size")!;
---

<Knobs title="halftone" floating class="halftone-tuner" data-halftone-tuner data-lenis-prevent aria-label="halftone tuner">
	<Fragment slot="meta">
		<Mono tone="tertiary" data-tuner-count></Mono>
		<Chip as="button" type="button" data-tuner-collapse aria-expanded="true">hide</Chip>
	</Fragment>
	<Fragment slot="note"><span data-tuner-editing></span></Fragment>

	<KnobGroup legend="theme (edits this one)" class="halftone-tuner__chips">
		{THEMES.map((t) => (
			<Chip as="button" type="button" data-tuner-theme={t} aria-pressed="false">{t}</Chip>
		))}
	</KnobGroup>

	<KnobGroup legend="colour">
		{colourKnobs.map((c) => (
			<div class="halftone-tuner__row" data-row={c.name}>
				<Knob label={c.name} type="color" out={c.name} value="">
					<input type="color" data-colour={c.name} aria-label={`${c.name} colour`} />
					{/* A span, not a label: the Knob row is already the label (for the picker). */}
					<span class="halftone-tuner__auto">
						<input type="checkbox" data-auto={c.name} aria-label={`${c.name}: auto`} /> auto
					</span>
				</Knob>
				<Chip as="button" type="button" class="halftone-tuner__reset" data-reset={c.name}>reset</Chip>
			</div>
		))}
	</KnobGroup>

	<KnobGroup legend="polarity" class="halftone-tuner__chips" data-row="polarity">
		{POLARITIES.map((p) => (
			<Chip as="button" type="button" data-polarity={p} aria-pressed="false">{p}</Chip>
		))}
		<Chip as="button" type="button" class="halftone-tuner__reset" data-reset="polarity">reset</Chip>
	</KnobGroup>

	<KnobGroup legend="tone (--dg-*)">
		{toneKnobs.map((k) => (
			<div class="halftone-tuner__row" data-row={k.name}>
				<Knob
					label={k.label ?? k.name}
					type="range"
					out={k.name}
					data-var={k.name}
					min={k.min}
					max={k.max}
					step={k.step}
					value={k.value}
				/>
				<Chip as="button" type="button" class="halftone-tuner__reset" data-reset={k.name}>reset</Chip>
			</div>
		))}
	</KnobGroup>

	<KnobGroup legend="cell size (per layout)">
		<Mono as="p" variant="text" class="halftone-tuner__variant" data-tuner-variant></Mono>
		<div class="halftone-tuner__row" data-row="cell-size">
			<Knob
				label="cell-size"
				type="range"
				out="cell-size"
				data-cell
				min={cellKnob.min}
				max={cellKnob.max}
				step={cellKnob.step}
				value={cellKnob.value}
			/>
			<Chip as="button" type="button" class="halftone-tuner__reset" data-reset="cell-size">reset</Chip>
		</div>
	</KnobGroup>

	<KnobGroup legend="keep it">
		<Button variant="secondary" type="button" data-tuner-copy>copy</Button>
		<pre class="halftone-tuner__css" data-tuner-output></pre>
	</KnobGroup>

	<Button slot="actions" variant="tertiary" type="button" data-tuner-reset-theme>reset theme</Button>
	<Button slot="actions" variant="tertiary" type="button" data-tuner-reset-all>reset all</Button>
</Knobs>

<script>
	import { TONE_DEFAULTS } from "@tristimb/dotted-grid";
	import { WIDGET_WIDE_MQ } from "@whois/design-system/lib/breakpoints";
	import { onPage } from "@whois/design-system/lib/lifecycle";
	import shippedCss from "../styles/halftone.css?raw";
	import { DOT_SHAPES } from "../lib/halftone-controls";
	import {
		AUTO,
		LIVE_SELECTOR,
		THEMES,
		VARIANTS,
		defaultsFromTone,
		parseShipped,
		sameValue,
		setOverride,
		shippedValue,
		themeRule,
		tuningOutput,
		type CellSizes,
		type PerTheme,
		type Theme,
		type Variant,
	} from "../lib/halftone-tuner";

	type Grid = HTMLElement & { refreshTone?: () => void };

	const KEY = "halftone-tuner:v1";

	const load = (): { overrides?: Partial<PerTheme>; cell?: CellSizes; collapsed?: boolean } => {
		try {
			return JSON.parse(localStorage.getItem(KEY) ?? "{}");
		} catch {
			return {};
		}
	};

	/** Any CSS colour as #rrggbb, for the picker (the tokens are not all hex). */
	const toHex = (() => {
		let ctx: CanvasRenderingContext2D | null = null;
		return (colour: string) => {
			ctx ??= Object.assign(document.createElement("canvas"), { width: 1, height: 1 }).getContext("2d", {
				willReadFrequently: true,
			});
			if (!ctx) return "#000000";
			ctx.clearRect(0, 0, 1, 1);
			ctx.fillStyle = "#000";
			ctx.fillStyle = colour;
			ctx.fillRect(0, 0, 1, 1);
			const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;
			return `#${[r, g, b].map((n) => n.toString(16).padStart(2, "0")).join("")}`;
		};
	})();

	function wire() {
		const panel = document.querySelector<HTMLElement>("[data-halftone-tuner]");
		const card = document.querySelector<HTMLElement>(".wx-videos");
		if (!panel || !card) return;
		const ac = new AbortController();
		const { signal } = ac;
		const $ = <T extends Element>(sel: string) => panel.querySelector<T>(sel);
		const $$ = <T extends Element>(sel: string) => Array.from(panel.querySelectorAll<T>(sel));
		const on = (el: Element | null | undefined, type: string, fn: () => void) =>
			el?.addEventListener(type, fn, { signal });

		const root = document.documentElement;
		const wide = matchMedia(WIDGET_WIDE_MQ);
		const theme = (): Theme => (root.dataset.theme === "dark" ? "dark" : "light");
		const variant = (): Variant => (wide.matches ? "wide" : "compact");
		const grids = () => Array.from(card.querySelectorAll<Grid>("dotted-grid"));
		const variantGrids = (v: Variant) =>
			Array.from(card.querySelectorAll<Grid>(`.${VARIANTS[v].className} dotted-grid`));

		const shipped = parseShipped(shippedCss, defaultsFromTone(TONE_DEFAULTS));

		// The shipped cell sizes, from the markup: a Deferred variant's template
		// stays in the page either way, so both are readable at any width.
		const shippedCell = {} as Record<Variant, number>;
		for (const v of Object.keys(VARIANTS) as Variant[]) {
			const selector = `.${VARIANTS[v].className} dotted-grid`;
			let grid: Element | null = null;
			for (const t of card.querySelectorAll<HTMLTemplateElement>("template")) {
				grid ??= t.content.querySelector(selector);
			}
			shippedCell[v] = Number(grid?.getAttribute("cell-size"));
		}

		// Saved work, minus anything that has since become what ships (say, the
		// tuning was pasted into halftone.css).
		const saved = load();
		const overrides: PerTheme = { light: {}, dark: {} };
		for (const t of THEMES) {
			for (const [name, value] of Object.entries(saved.overrides?.[t] ?? {})) {
				setOverride(overrides[t], shipped[t], name, value);
			}
		}
		const cell: CellSizes = {};
		for (const v of Object.keys(VARIANTS) as Variant[]) {
			const size = saved.cell?.[v];
			if (size && size !== shippedCell[v]) cell[v] = size;
		}
		let collapsed = saved.collapsed === true;

		const save = () => {
			try {
				localStorage.setItem(KEY, JSON.stringify({ overrides, cell, collapsed }));
			} catch {
				/* storage unavailable: the tuning lasts the page */
			}
		};

		// In the panel, not <head>, so a navigation takes it away with the panel.
		const live = document.createElement("style");
		panel.append(live);

		// Rules for both themes at once; the variables reach the element by
		// cascade, so all it needs is the nudge to re-read them (nothing observes
		// a stylesheet, only <html>).
		const applyTone = () => {
			live.textContent = THEMES.map((t) => themeRule(t, overrides[t], LIVE_SELECTOR)).join("\n");
			for (const g of grids()) g.refreshTone?.();
		};

		const applyCell = () => {
			for (const v of Object.keys(VARIANTS) as Variant[]) {
				const size = String(cell[v] ?? shippedCell[v]);
				for (const g of variantGrids(v)) {
					if (g.getAttribute("cell-size") !== size) g.setAttribute("cell-size", size);
				}
			}
		};

		const value = (name: string) => overrides[theme()][name] ?? shippedValue(shipped[theme()], name);
		const shippedNow = (name: string) => shippedValue(shipped[theme()], name);
		const changed = (name: string) => !sameValue(name, value(name), shippedNow(name));
		const brief = (v: string) => v.replace(/^var\(--(.*)\)$/, "$1");

		const readout = (key: string, text: string) => {
			const out = $<HTMLElement>(`[data-out="${key}"]`);
			if (out) out.textContent = text;
		};
		const mark = (key: string, isChanged: boolean) =>
			$<HTMLElement>(`[data-row="${key}"]`)?.toggleAttribute("data-changed", isChanged);
		const describe = (name: string, shown: string) =>
			changed(name) ? `${shown} (was ${brief(shippedNow(name))})` : shown;

		/** What the grid will actually draw in a colour, for the picker. */
		const effectiveColour = (name: string, grid: Grid | undefined) => {
			if (!grid) return "#000000";
			const css = getComputedStyle(grid);
			const read = (prop: string) => css.getPropertyValue(prop).trim();
			const ink = read("--dg-ink") || read("--color-fg");
			const paper = read("--dg-paper") || read("--color-bg");
			if (name === "ink") return toHex(ink);
			if (name === "ink-hi") return toHex(read("--dg-ink-hi") || ink);
			if (name === "paper") return toHex(paper);
			const glow = read("--dg-glow");
			if (glow && glow !== AUTO) return toHex(glow);
			const hex = toHex(paper);
			const luma = (0.299 * parseInt(hex.slice(1, 3), 16) + 0.587 * parseInt(hex.slice(3, 5), 16) + 0.114 * parseInt(hex.slice(5, 7), 16)) / 255;
			return luma > 0.5 ? "#000000" : "#ffffff";
		};

		const render = () => {
			const t = theme();
			const v = variant();
			const label = VARIANTS[v].label;
			const editing = $<HTMLElement>("[data-tuner-editing]");
			if (editing) editing.textContent = `editing ${t} · ${label} (${wide.matches ? "over 900px" : "up to 900px"})`;
			const note = $<HTMLElement>("[data-tuner-variant]");
			if (note) note.textContent = `this slider is the ${label} layout's; the other keeps its own size`;
			for (const b of $$<HTMLElement>("[data-tuner-theme]")) {
				b.setAttribute("aria-pressed", String(b.dataset.tunerTheme === t));
			}
			for (const b of $$<HTMLElement>("[data-polarity]")) {
				b.setAttribute("aria-pressed", String(b.dataset.polarity === value("polarity")));
			}
			mark("polarity", changed("polarity"));

			for (const input of $$<HTMLInputElement>("[data-var]")) {
				const name = input.dataset.var!;
				const v2 = value(name);
				input.value = name === "dot-shape" ? String(DOT_SHAPES.indexOf(v2)) : v2;
				readout(name, describe(name, v2));
				mark(name, changed(name));
			}

			const grid = grids()[0];
			for (const input of $$<HTMLInputElement>("[data-colour]")) {
				const name = input.dataset.colour!;
				const v2 = value(name);
				const box = $<HTMLInputElement>(`[data-auto="${name}"]`);
				if (box) box.checked = v2 === AUTO;
				input.value = effectiveColour(name, grid);
				readout(name, describe(name, v2 === AUTO ? AUTO : v2.startsWith("var(") ? brief(v2) : input.value));
				mark(name, changed(name));
			}

			const cellInput = $<HTMLInputElement>("[data-cell]");
			const size = cell[v] ?? shippedCell[v];
			if (cellInput) cellInput.value = String(size);
			readout("cell-size", cell[v] !== undefined ? `${size} (was ${shippedCell[v]})` : String(size));
			mark("cell-size", cell[v] !== undefined);

			const count = THEMES.reduce((n, th) => n + Object.keys(overrides[th]).length, 0) + Object.keys(cell).length;
			const countEl = $<HTMLElement>("[data-tuner-count]");
			if (countEl) countEl.textContent = count ? `${count} changed` : "";
			const output = $<HTMLElement>("[data-tuner-output]");
			if (output) output.textContent = tuningOutput(overrides, cell);

			panel.toggleAttribute("data-collapsed", collapsed);
			const toggle = $<HTMLElement>("[data-tuner-collapse]");
			if (toggle) {
				toggle.textContent = collapsed ? "show" : "hide";
				toggle.setAttribute("aria-expanded", String(!collapsed));
			}
		};

		/** Apply a change everywhere it shows. */
		const commit = () => {
			applyTone();
			applyCell();
			save();
			render();
		};

		const setSetting = (name: string, v: string) => {
			setOverride(overrides[theme()], shipped[theme()], name, v);
			commit();
		};

		for (const input of $$<HTMLInputElement>("[data-var]")) {
			const name = input.dataset.var!;
			on(input, "input", () => setSetting(name, name === "dot-shape" ? DOT_SHAPES[+input.value] : input.value));
		}
		for (const input of $$<HTMLInputElement>("[data-colour]")) {
			on(input, "input", () => setSetting(input.dataset.colour!, input.value));
		}
		for (const box of $$<HTMLInputElement>("[data-auto]")) {
			const name = box.dataset.auto!;
			on(box, "change", () => {
				if (box.checked) return setSetting(name, AUTO);
				// Off auto: hold the colour the grid is already drawing.
				setSetting(name, $<HTMLInputElement>(`[data-colour="${name}"]`)!.value);
			});
		}
		for (const b of $$<HTMLElement>("[data-polarity]")) {
			on(b, "click", () => setSetting("polarity", b.dataset.polarity!));
		}
		const cellInput = $<HTMLInputElement>("[data-cell]");
		on(cellInput, "input", () => {
			const size = Number(cellInput!.value);
			if (size === shippedCell[variant()]) delete cell[variant()];
			else cell[variant()] = size;
			commit();
		});
		for (const b of $$<HTMLElement>("[data-reset]")) {
			on(b, "click", () => {
				const name = b.dataset.reset!;
				if (name === "cell-size") delete cell[variant()];
				else delete overrides[theme()][name];
				commit();
			});
		}
		on($("[data-tuner-reset-theme]"), "click", () => {
			overrides[theme()] = {};
			commit();
		});
		on($("[data-tuner-reset-all]"), "click", () => {
			overrides.light = {};
			overrides.dark = {};
			delete cell.wide;
			delete cell.compact;
			commit();
		});

		// The real switch: the footer's toggle calls window.__setTheme, stores the
		// choice and keeps its own label right, all of which this flip must too.
		for (const b of $$<HTMLElement>("[data-tuner-theme]")) {
			on(b, "click", () => {
				const next = b.dataset.tunerTheme as Theme;
				if (next === theme()) return;
				const toggle = document.querySelector<HTMLElement>("[data-theme-toggle]");
				if (toggle) return toggle.click();
				window.__setTheme(next);
				try {
					localStorage.setItem("theme", next);
				} catch {
					/* storage unavailable: the choice lasts the page */
				}
			});
		}

		on($("[data-tuner-collapse]"), "click", () => {
			collapsed = !collapsed;
			save();
			render();
		});

		const copy = $<HTMLButtonElement>("[data-tuner-copy]");
		on(copy, "click", async () => {
			try {
				await navigator.clipboard.writeText(tuningOutput(overrides, cell));
				copy!.textContent = "copied ✓";
			} catch {
				copy!.textContent = "select the CSS below";
			}
			setTimeout(() => (copy!.textContent = "copy"), 1600);
		});

		// A theme flip from anywhere (the footer's toggle too), and a layout
		// change, re-point the panel at what is showing now. A variant that
		// arrives later (Deferred, on crossing a breakpoint) gets its cell size.
		const themeWatch = new MutationObserver(render);
		themeWatch.observe(root, { attributes: true, attributeFilter: ["data-theme"] });
		const variantWatch = new MutationObserver(applyCell);
		variantWatch.observe(card, { childList: true, subtree: true });
		wide.addEventListener(
			"change",
			() => {
				applyCell();
				render();
			},
			{ signal },
		);

		commit();

		return () => {
			ac.abort();
			themeWatch.disconnect();
			variantWatch.disconnect();
			live.remove();
		};
	}

	onPage(wire);
</script>

<style>
	/* Out of the card's way: the card lives in the page's right column, and its
	   ruler in the gutter beyond it, so on a wide screen this goes on the left.
	   (At the compact step the DS keeps it a sheet across the bottom.) */
	@media (min-width: 901px) {
		.halftone-tuner {
			inset-inline: var(--space-4) auto;
		}
		.halftone-tuner[data-collapsed] {
			inline-size: auto;
		}
	}
	@media (max-width: 900px) {
		.halftone-tuner {
			max-block-size: 40vh;
		}
	}

	:global(.halftone-tuner[data-collapsed] > :not(.ds-knobs__head)) {
		display: none;
	}
	:global(.halftone-tuner .ds-knobs__body) {
		overscroll-behavior: contain;
	}

	.halftone-tuner__row {
		display: flex;
		align-items: flex-end;
		gap: var(--space-2);
	}
	.halftone-tuner__row > :global(.ds-knob) {
		flex: 1 1 auto;
	}
	.halftone-tuner__reset {
		visibility: hidden;
	}
	[data-changed] > .halftone-tuner__reset {
		visibility: visible;
	}
	:global([data-changed] > .ds-knob output) {
		color: var(--accent);
	}
	.halftone-tuner__chips {
		flex-direction: row;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.halftone-tuner__chips > :global(legend) {
		flex-basis: 100%;
	}
	.halftone-tuner__auto {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-size: var(--font-size-1);
	}
	.halftone-tuner__variant {
		margin: 0;
	}
	.halftone-tuner__css {
		margin: 0;
		font-family: var(--font-code);
		font-size: var(--font-size-1);
		white-space: pre;
		overflow-x: auto;
		user-select: all;
	}
</style>
