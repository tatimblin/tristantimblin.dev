---
// Site header — the brand + nav bar. Mirrors SiteFooter's model: fixed markup +
// scoped <style> on DS tokens, so it re-tints with the theme toggle (the
// <dotted-grid> re-resolves the same theme colours through the bridge's
// --color-fg / --color-bg when data-theme flips, and this bar reads
// --text-primary and --accent directly).
//
// Two placements, one component — so the site has one header, not two:
//   overlay  (default) absolute over the top of the full-viewport dotgrid scene
//            (AXIOM-style), rendered inside the landing hero.
//   flow     in the normal flow at the top of a page — the blog's quiet top bar
//            (BlogLayout, which PostLayout wraps).
//
// Nav is data-driven; pass `links` to change it per page. The brand and the
// links are DS Anchors in the ink variant — the primary ink at rest, the
// accent under the pointer or focus, the one focus ring — so the bar carries
// no link, hover or ring rules of its own.
import Anchor from "@whois/design-system/Anchor";

interface Props {
	links?: Array<{ label: string; href: string }>;
	variant?: "overlay" | "flow";
}

const { links = [{ label: "Writing", href: "/txt/" }], variant = "overlay" } = Astro.props;
---

{/* A .container row (global.css): the brand and nav sit on the same line as
     every contained row on the site — the homepage's, the blog's wide column,
     the footer. */}
<header class:list={["site-header", "container", variant === "flow" && "site-header--flow"]}>
	<Anchor variant="ink" class="site-header__brand" href="/">tristantimblin.dev</Anchor>
	<nav class="site-header__nav" aria-label="Primary">
		{
			links.map((link) => (
				<Anchor variant="ink" class="site-header__link" href={link.href}>
					{link.label}
				</Anchor>
			))
		}
	</nav>
</header>

<style>
	/* Overlay the top of the hero scene. Absolute (not fixed) so it scrolls away
	   with the hero. z-index 4 sits above .fh__heading (3) and the scene (0). */
	.site-header {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 4;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-4);
		background: transparent;
		/* Let pointers fall through the empty bar to the scene; the brand + links
		   re-enable interaction on themselves (same pattern as the lockup). */
		pointer-events: none;
		/* UI FACE, set once on the bar so the brand and the nav links keep reading in
		   the same voice — which was the point of the earlier change that put them
		   both on the body face. The matching is right; the face was not. A 14px bar
		   holding a wordmark and one nav link is INTERFACE, not prose: it labels the
		   page rather than saying anything, which is precisely the role --font-ui is
		   defined for ("the small, functional type that LABELS things rather than
		   says them" — tokens.overrides.css). The body face, Roboto Mono, has a voice
		   built for a paragraph; at chrome size that voice competes with the hero it
		   is overlaying. DM Sans recedes, so the bar reads as bar. */
		font-family: var(--font-ui);
	}

	/* In the flow: a plain bar above the page, hit-testable everywhere. */
	.site-header--flow {
		position: static;
		pointer-events: auto;
	}

	/* The brand and the links: the face comes from .site-header (brand and nav
	   are one object), the ink, the hover and the ring from the Anchor. What is
	   left is the size and the pointer opt-in. */
	.site-header__brand,
	.site-header__link {
		pointer-events: auto;
		font-size: var(--font-size-1);
	}
	.site-header__brand {
		/* A hand-typed value with no token behind it: the site's tracking tokens
		   are for uppercase (--tracking-caps) and display type (--tracking-heading,
		   --tracking-hero), and there is no role for the small negative tracking a
		   lowercase wordmark wants at 14px. Left as a literal rather than misfiled
		   under one of those. */
		letter-spacing: -0.01em;
	}

	.site-header__nav {
		display: inline-flex;
		align-items: center;
		gap: var(--space-5);
	}
</style>
