---
// Hero site header — the brand + nav bar that overlays the top of the
// full-viewport dotgrid scene (AXIOM-style). Mirrors SiteFooter's model: fixed
// markup + scoped <style> using DS tokens, so it re-tints with the theme toggle
// (the <dotted-grid> samples --color-fg / --color-bg fresh each frame, and this
// bar tracks the same tokens).
//
// Hero-only: it's rendered inside the landing hero (not global) because other
// pages have their own headers and no dark scene to overlay.
//
// Nav is data-driven so adding links is a one-line edit.
const links = [{ label: "Ergonomist", href: "/txt" }];
---

<header class="site-header">
	<a class="site-header__brand" href="/">tristantimblin.dev</a>
	<nav class="site-header__nav" aria-label="Primary">
		{
			links.map((link) => (
				<a class="site-header__link" href={link.href}>
					{link.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	/* Overlay the top of the hero scene. Absolute (not fixed) so it scrolls away
	   with the hero. z-index 4 sits above .fh__heading (3) and the scene (0). */
	.site-header {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 4;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4, 1rem);
		padding-inline: var(--container-pad, clamp(1rem, 4vw, 2rem));
		padding-block: var(--space-4, 1rem);
		background: transparent;
		/* Let pointers fall through the empty bar to the scene; the brand + links
		   re-enable interaction on themselves (same pattern as the lockup). */
		pointer-events: none;
		/* UI FACE, set once on the bar so the brand and the nav links keep reading in
		   the same voice — which was the point of the earlier change that put them
		   both on the body face. The matching is right; the face was not. A 14px bar
		   holding a wordmark and one nav link is INTERFACE, not prose: it labels the
		   page rather than saying anything, which is precisely the role --font-ui is
		   defined for ("the small, functional type that LABELS things rather than
		   says them" — tokens.overrides.css). The body face, PP Mondwest, has a voice
		   built for a paragraph; at chrome size that voice competes with the hero it
		   is overlaying. Neue Montreal recedes, so the bar reads as bar. */
		font-family: var(--font-ui);
	}

	.site-header__brand {
		pointer-events: auto;
		/* Face comes from .site-header — brand and nav are one object.
		   The -0.01em is a hand-typed value with no token behind it: the DS ships
		   --tracking-caps / --tracking-caps-display for UPPERCASE only, and there is
		   no role for the small negative tracking a lowercase wordmark wants at 14px.
		   Left as a literal rather than misfiled under a caps token. */
		font-size: var(--font-size-1, 0.875rem);
		font-weight: var(--font-weight-500, 500);
		letter-spacing: -0.01em;
		color: var(--color-fg);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.site-header__nav {
		display: inline-flex;
		align-items: center;
		gap: var(--space-5, 1.5rem);
	}

	.site-header__link {
		pointer-events: auto;
		font-size: var(--font-size-1, 0.875rem);
		color: var(--color-fg);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.site-header__brand:hover,
	.site-header__link:hover {
		color: var(--color-accent, var(--accent));
	}

	.site-header__brand:focus-visible,
	.site-header__link:focus-visible {
		outline: 2px solid var(--color-accent, var(--accent));
		outline-offset: 2px;
		border-radius: var(--border-radius-0, 4px);
	}
</style>
