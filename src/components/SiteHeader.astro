---
// Site header — the brand + nav bar. Mirrors SiteFooter's model: fixed markup +
// scoped <style> on DS tokens, so it re-tints with the theme toggle (the
// <dotted-grid> re-resolves the same theme colours through the bridge's
// --color-fg / --color-bg when data-theme flips, and this bar reads
// --text-primary and --accent directly).
//
// One bar in the normal flow at the top of every page: the homepage's
// (HomeLayout), the written pages' (BlogLayout) and a post's (PostLayout).
//
// Pass `trail` to put the page's path after the brand (a post:
// `/ txt / <slug>`). The brand, the
// trail and the links are DS Anchors in the ink variant: the primary ink at
// rest, the accent under the pointer, no underline.
//
// A step marked `slug` shortens to fit the bar (src/lib/slug.ts): the script
// shows the longest of its forms that keeps the path inside its share of the
// row, losing vowels first, then a middle ellipsis. The full slug stays in the
// markup for a screen reader, and is what shows with no script.
import Anchor from "@whois/design-system/Anchor";
import VisuallyHidden from "@whois/design-system/VisuallyHidden";

interface Props {
	/** Where the page sits, after the brand: `tristantimblin.dev / txt / mega-desk`.
	 *  A step with an href links up; the last one is the page itself. `slug`
	 *  lets it shorten on a narrow bar. */
	trail?: Array<{ label: string; href?: string; slug?: boolean }>;
}

const { trail = [] } = Astro.props;

const links = [
	{ label: "Writing", href: "/txt/" },
	{ label: "About Me", href: "/about/" },
];

// The nav link for the section the page is in reads in the accent.
const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== "/" && path.startsWith(href);
---

{/* A .container row (global.css): the brand and nav sit on the same line as
     every contained row on the site — the homepage's, the blog's wide column,
     the footer. */}
<header class="site-header container">
	<span class="site-header__path">
		<Anchor variant="ink" class="site-header__brand" href="/" aria-label="tristantimblin.dev">
			<span class="site-header__domain">tristantimblin.dev</span><span class="site-header__home" aria-hidden="true">~</span>
		</Anchor>
		{trail.length > 0 && (
			<span class="site-header__trail" data-trail>
				{trail.map((step, i) => (
					<Fragment>
						<span class="site-header__sep" aria-hidden="true"> / </span>
						{step.href ? (
							<Anchor variant="ink" class="site-header__step" href={step.href}>{step.label}</Anchor>
						) : (
							<span class="site-header__step site-header__step--here" aria-current={i === trail.length - 1 ? "page" : undefined}>
								{step.slug ? (
									<Fragment>
										<span aria-hidden="true" data-slug-fit={step.label}>{step.label}</span>
										<VisuallyHidden as="span">{step.label}</VisuallyHidden>
									</Fragment>
								) : (
									step.label
								)}
							</span>
						)}
					</Fragment>
				))}
			</span>
		)}
	</span>
	<nav class="site-header__nav" aria-label="Primary">
		{
			links.map((link) => (
				<Anchor
					variant="ink"
					class:list={["site-header__link", isCurrent(link.href) && "site-header__link--current"]}
					href={link.href}
				>
					{link.label}
				</Anchor>
			))
		}
	</nav>
</header>

<script>
	// THE SLUG, FITTED: the first of its forms (longest first) under which the
	// path no longer overflows its share of the row. Re-fitted when the bar
	// changes width and once the fonts have arrived (they change the widths).
	import { onPage } from "@whois/design-system/lib/lifecycle";
	import { slugForms } from "../lib/slug";

	onPage(() => {
		const label = document.querySelector<HTMLElement>("[data-slug-fit]");
		const path = label?.closest<HTMLElement>(".site-header__path");
		const bar = path?.parentElement;
		if (!label || !path || !bar) return;
		const forms = slugForms(label.dataset.slugFit ?? "");

		const fit = () => {
			for (const form of forms) {
				label.textContent = form;
				if (path.scrollWidth <= path.clientWidth) return;
			}
		};
		fit();
		void document.fonts?.ready.then(fit);
		const observer = new ResizeObserver(fit);
		observer.observe(bar);
		return () => observer.disconnect();
	});
</script>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-4);
		/* UI FACE, set once on the bar so the brand and the nav links keep reading in
		   the same voice — which was the point of the earlier change that put them
		   both on the body face. The matching is right; the face was not. A 14px bar
		   holding a wordmark and one nav link is INTERFACE, not prose: it labels the
		   page rather than saying anything, which is precisely the role --font-ui is
		   defined for ("the small, functional type that LABELS things rather than
		   says them" — tokens.overrides.css). The body face, Roboto Mono, has a voice
		   built for a paragraph; at chrome size that voice competes with the page
		   below it. DM Sans recedes, so the bar reads as bar. */
		font-family: var(--font-ui);
	}

	/* The brand and the links: the face comes from .site-header (brand and nav
	   are one object), the ink, the hover and the ring from the Anchor. What is
	   left is the size. */
	.site-header__brand,
	.site-header__link {
		font-size: var(--font-size-1);
	}
	.site-header__brand {
		/* A hand-typed value with no token behind it: the site's tracking tokens
		   are for uppercase (--tracking-caps) and display type (--tracking-heading,
		   --tracking-hero), and there is no role for the small negative tracking a
		   lowercase wordmark wants at 14px. Left as a literal rather than misfiled
		   under one of those. */
		letter-spacing: -0.01em;
	}

	.site-header__nav {
		display: inline-flex;
		align-items: center;
		gap: var(--space-5);
	}

	/* The section the page is in reads in the accent at rest. */
	.site-header :global(.site-header__link--current) {
		--link-color: var(--accent);
	}

	/* THE PATH: the brand, then where the page sits, in the code face so it
	   reads as a path. One line; the steps never wrap apart. */
	.site-header__path {
		display: inline-flex;
		align-items: baseline;
		min-inline-size: 0;
		white-space: nowrap;
	}
	.site-header__trail,
	.site-header__path:has(.site-header__trail) :global(.site-header__brand) {
		font-family: var(--font-code);
		font-size: var(--font-size-0);
		letter-spacing: 0;
	}
	.site-header__sep {
		color: var(--text-tertiary);
		white-space: pre;
	}
	.site-header__step--here {
		color: var(--accent);
	}

	/* On a phone, a path's root is home: the domain shortens to `~`. */
	.site-header__home {
		display: none;
	}
	@media (max-width: 639px) {
		.site-header__path:has(.site-header__trail) .site-header__domain {
			display: none;
		}
		.site-header__path:has(.site-header__trail) .site-header__home {
			display: inline;
		}
	}
</style>
