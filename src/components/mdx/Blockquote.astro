---
// MDX `blockquote` → DS Blockquote: no fill, the accent bar, the words up a
// step in the body face. The post page is ruled, and its quote is the one place
// the accent appears in the text. The paragraphs inside arrive as Body (the
// mapped `p`) and read the retuned body tokens. An attribution (a last line
// starting with a dash) is not inside it: the sections plugin
// (src/lib/mdx/post-sections.ts) wraps the quote in a figure and sets the
// attribution as the figure's caption, in the caps mono.
import Blockquote from "@whois/design-system/Blockquote";
const props = Astro.props;
---

<Blockquote {...props}><slot /></Blockquote>
