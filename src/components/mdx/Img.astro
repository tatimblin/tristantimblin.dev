---
// Post image. Mapped from MDX `img` so every image in a /txt post gets three
// things a bare markdown image cannot express:
//
//   1. INTRINSIC DIMENSIONS, read from the actual file at build time. Markdown
//      has no syntax for width/height, so these images shipped without them and
//      the page reflowed as each one decoded (a real CLS cost on 680KB of photos).
//      Measured here rather than hardcoded in each post so re-exporting an image
//      can't silently desynchronise the numbers. The CSS still drives the rendered
//      size (`width: 100%; height: auto` in TxtPostLayout) — these attributes only
//      publish the ASPECT so the browser can reserve the right box up front.
//   2. Lazy loading + async decode, so a long post doesn't fetch every photo at once.
//   3. data-reveal, so each image eases in as it is scrolled to instead of
//      snapping in on decode (see src/lib/reveal.ts).
//
// Dimensions are read straight from the file header — no image library, and no
// build step beyond what Astro already runs in frontmatter (Node).
import { intrinsicSize } from "../../lib/intrinsicSize";

interface Props {
	src: string;
	alt?: string;
	title?: string;
	[key: string]: unknown;
}

const { src, alt = "", ...rest } = Astro.props;

const size = intrinsicSize(src);
---

<img
	src={src}
	alt={alt}
	loading="lazy"
	decoding="async"
	width={size?.w}
	height={size?.h}
	data-reveal
	{...rest}
/>
