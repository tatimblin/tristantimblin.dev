---
// FullHeroLayout — a reusable page shell with three drop-in regions:
//
//   scene    (slot="scene")   full-viewport BACKGROUND layer (100svh, absolute),
//                             faded top+bottom; owns --hero-height. The
//                             direct-WebGL <dotted-grid> drops in here (any
//                             full-bleed visual works — the Layout is
//                             scene-agnostic). Heading + content flow OVER it.
//   heading  (slot="heading") the large heading region, inset to the gutter but
//                             full-width within it. Its slotted content
//                             self-manages: it may ANIMATE (drop in
//                             <stories-heading> with the full-width wordmark +
//                             its own pin/parallax/reveal) or just flow.
//   content  (default slot)   a BARE, full-width opaque riser. Its only job is
//                             the pin coupling — it's opaque + z-indexed so
//                             content rising from below cleanly meets the pinned
//                             heading. The consumer composes ALL grids/sections
//                             here: full-bleed by default; a contained row opts
//                             into gutters with the .fh-row helper.
//
// Wraps the base Layout (html/head/tokens/fonts/ClientRouter) unchanged.
import Layout from "./Layout.astro";
// DS component styles so consumers' <Grid>/<GridItem> resolve.
import "@whois/design-system/styles.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	/** Forwarded to Layout: preload the scene's above-the-fold media, which the
	 *  scene element otherwise only discovers once its bundle runs. */
	preloadMedia?: Array<{ href: string; as: "video" | "image"; type?: string }>;
}

const { title, description, image, preloadMedia } = Astro.props;
---

<Layout
	title={title}
	description={description}
	image={image}
	preloadMedia={preloadMedia}
>
	<div class="fh">
		<!-- SCENE: full-bleed; height driven by --hero-height. -->
		<div class="fh__scene"><slot name="scene" /></div>

		<!-- HEADING: inset to the container gutter so a 12-col lockup lines up
		     with the content rows below. Slotted content owns any animation. -->
		<div class="fh__heading"><slot name="heading" /></div>

		<!-- CONTENT: bare opaque riser. The consumer builds rows/sections here. -->
		<div class="fh__content"><slot /></div>
	</div>
</Layout>

{
	/* DEV-ONLY FOLD ASSERTION. tests/hero-fold.spec.ts proves the fold arithmetic
	   across a viewport × content × preference matrix, but headless Chromium reports
	   svh == lvh == innerHeight at every size, so it structurally cannot reproduce
	   the two states that actually bite on a phone: the URL bar collapsing (which
	   moves lvh but not svh) and OS-level dynamic type. This warns when the invariant
	   breaks in a real browser, on a real device, during development. Stripped from
	   production by the import.meta.env.DEV guard. */
	import.meta.env.DEV && (
		<script is:inline>
			{`
			(() => {
				const check = () => {
					const fh = document.querySelector(".fh");
					if (!fh) return;
					// The scene's own bottom-anchored UI, if any (a plain background scene
					// has none and cannot collide with anything).
					const ui = [...fh.querySelectorAll(".fh__scene .vc__ruler, .fh__scene .vc__caption")]
						.map((el) => el.getBoundingClientRect())
						.filter((r) => r.height > 0);
					if (!ui.length) return;
					const uiTop = Math.min(...ui.map((r) => r.top));
					const group = [...fh.querySelectorAll(".fh__heading .sh__sub, .fh__heading .sh__heading")]
						.map((el) => el.getBoundingClientRect())
						.filter((r) => r.height > 0);
					if (!group.length) return;
					const groupBottom = Math.max(...group.map((r) => r.bottom));
					const clearance = uiTop - groupBottom;
					if (clearance < 0) {
						console.warn(
							"[hero fold] the heading group overlaps the scene's bottom UI by " +
								Math.abs(clearance).toFixed(1) +
								"px. --sh-group-h/--hero-floor are likely stale or unpublished.",
							{ uiTop, groupBottom }
						);
					}
				};
				// After layout settles, and again whenever the viewport changes (the
				// URL-bar case) — but only at rest, so a scroll-driven transform mid-fade
				// isn't mistaken for a layout fault.
				const run = () => requestAnimationFrame(() => setTimeout(check, 200));
				run();
				addEventListener("resize", run, { passive: true });
				document.addEventListener("astro:page-load", run);
			})();
			`}
		</script>
	)
}

<style>
	.fh {
		/* Positioning context for the absolute scene layer below. */
		position: relative;
		/* FIXED type steps (not vw-clamps): the lockup heading changes size only at
		   breakpoints. The overlap formulas in the slotted heading are ratios of
		   these sizes, so a fixed input yields a clean fixed overlap per step; a
		   JS parallax measures real positions and adapts automatically. Base
		   (mobile-first) values here; larger steps in the media queries below.
		   (The "tristan" wordmark is now a full-width SVG that fills the gutters at
		   any size, so it no longer has a fixed type step here.) */
		--heading-size: 2rem;
		/* Full-width within the gutters: every hero region (scene, wordmark,
		   heading, content rows) insets to --container-pad and spans edge-to-edge. */
		--hero-inset: var(--container-pad);
		/* SCENE-OWNED BOTTOM UI. A scene whose own interactive/legible UI hugs its
		   BOTTOM edge (e.g. the carousel's date scrubber + caption) declares how much
		   of that edge it occupies; the heading group then rests ABOVE it rather than
		   through it. 0 for a scene that is pure background (the default). A scene
		   should MEASURE this and publish it, not restate a breakpoint constant. */
		--hero-floor: 0px;
		/* Breathing room between the bottom of the heading group and the floor. */
		--hero-fold-gap: var(--space-5);
		/* THE FOLD, in two clamps. The slotted heading MEASURES its content and
		   publishes --sh-group-h (the group's full height), --sh-wordmark-h, and
		   --sh-header-clear (the minimum lead that clears the site header); the
		   arithmetic lives here, in CSS, so it re-resolves against a true 100svh on
		   every layout pass and in the right units.

		   ① LEAD — bottom-anchor the group above the floor, but never above the
		   header. This is the compression budget: a group that grows eats this
		   whitespace first, sliding up toward the header. */
		/* The TOTAL bottom reserve. Scene-owned UI is all of it: every part of the
		   heading region now scrolls with the page, so nothing there is anchored to the
		   viewport bottom. (The intro used to be, via an absolute box inside the sticky
		   pin; it published a --sh-sub-floor that stacked on here. It is plain flow
		   content now — see the .sh__sub note in stories-heading's styles.css.) */
		--hero-reserve: var(--hero-floor);
		--hero-lead: max(
			var(--sh-header-clear, 0px),
			calc(
				100svh - var(--hero-reserve) - var(--hero-fold-gap) -
					var(--sh-group-h, 0px)
			)
		);
		/* ② HEIGHT — grow the scene only once ① has bottomed out. While the group fits,
		   lead + group + gap + floor == 100svh exactly, so this returns 100svh and
		   growth is dormant; once the lead is pinned at --sh-header-clear the sum
		   exceeds one screen and the scene grows by exactly the overflow. svh (not vh)
		   so the mobile URL bar doesn't change the baseline.

		   Deliberately NOT computed in JS: deriving the lead from the scene's MEASURED
		   height makes every grown state self-justifying (a taller scene supports the
		   same tall lead that grew it), so the hero would never shrink back. Here both
		   clamps read the same fixed 100svh, so the result is a pure function of the
		   content — no hysteresis. */
		--hero-height: max(
			100svh,
			calc(
				var(--hero-lead) + var(--sh-group-h, 0px) + var(--hero-fold-gap) +
					var(--hero-reserve)
			)
		);
		/* Half the wordmark's rendered height, as a fraction of the inner width: the
		   full-width SVG has a ~3.68:1 glyph aspect, so half-height ≈ 0.109 · innerW.
		   Used only by the CSS fallback for --hero-lead until the JS measures and sets
		   --hero-lead directly (2 · split ≈ the wordmark height to skip past). */
		--hero-split-frac: 0.109;
		--hero-split: calc(
			var(--hero-split-frac) * (100vw - 2 * var(--hero-inset))
		);
		/* Pre-JS estimate of the heading group's height, for the fold clamps below: the
		   wordmark (2 · split, per the glyph aspect) plus an allowance for
		   "other stories" + the intro/CTAs beneath it. The slotted heading overwrites
		   this with the MEASURED value on its first layout pass (synchronously in its
		   connectedCallback), so this governs only the pre-hydration frame — but it is
		   deliberately GENEROUS rather than tight: the estimate cannot see --hero-floor
		   (a scene publishes that from JS too), so over-estimating the group keeps the
		   lead short and the fold high, which fails toward empty space at the bottom
		   instead of toward printing the intro over the scene's bottom UI. */
		--sh-group-h: calc(2 * var(--hero-split) + 42svh);
	}

	/* Fixed heading steps at the DS breakpoints (sm 640 / lg 1024 / xl 1280). A
	   slotted <stories-heading> steps --sh-amp-size / --sh-heading-size in lockstep
	   from its own stylesheet. */
	@media (min-width: 640px) {
		.fh {
			--heading-size: 2.5rem;
		}
	}
	@media (min-width: 1024px) {
		.fh {
			--heading-size: 3rem;
		}
	}
	@media (min-width: 1280px) {
		.fh {
			--heading-size: 3.25rem;
		}
	}

	/* SCENE: a full-viewport BACKGROUND layer, pinned to the top of .fh. The
	   heading + content flow OVER it (higher z-index). Top+bottom fade masks blend
	   it into the page so it has no hard seam. */
	.fh__scene {
		--dotted-grid-height: var(--hero-height);
		/* The edge fade, hoisted so a consumer can retarget it. A mask applies to the
		   WHOLE subtree and no z-index escapes it — so a scene with legible UI near an
		   edge (e.g. the carousel's date ruler along the bottom) sets this to `none`
		   here and re-applies the same gradient to its visual layer alone. */
		--fh-scene-mask: linear-gradient(
			to bottom,
			transparent 0,
			#000 12%,
			#000 78%,
			transparent 100%
		);
		position: absolute;
		inset: 0 0 auto 0;
		height: var(--hero-height);
		z-index: 0;
		overflow: hidden;
		-webkit-mask-image: var(--fh-scene-mask);
		mask-image: var(--fh-scene-mask);
	}

	/* HEADING: inset to the container gutter, over the scene. A LEAD space above the
	   wordmark drops the whole lockup down so the group (wordmark + "&" + "other
	   stories" + intro) rests near the bottom of the scene, clear of --hero-floor.
	   The lead is the COMPRESSION BUDGET: the slotted <stories-heading> measures the
	   group and sets --hero-lead to bottom-anchor it, so a growing group eats this
	   whitespace first and only pushes --hero-height past 100svh once the lead has
	   bottomed out at the site header. --hero-split is the CSS-calc fallback for
	   first paint (half the wordmark's height, per the ~3.68:1 glyph aspect); the
	   measured lead only ever tightens from there. z-index ABOVE the content riser
	   so the pinned lockup stays visible while copy rises. */
	.fh__heading {
		padding-inline: var(--hero-inset);
		/* --hero-lead resolves to the CSS-calc fallback until the heading publishes its
		   measured --sh-group-h (both terms of the max() then become content-driven).
		   Pre-JS that fallback places the lockup by the wordmark's ~3.68:1 aspect. */
		padding-block-start: var(--hero-lead);
		position: relative;
		z-index: 3;
		/* This region is full-width and tall at z-index 3, but the slotted lockup
		   only paints its left-aligned text — a pinned heading's empty area would
		   sit OVER content rising below (e.g. the video ruler at ~50vh) and swallow
		   its drag/click. Let pointers fall THROUGH the region; slotted content
		   re-enables interaction on its visible parts (pointer-events: auto). */
		pointer-events: none;
	}

	/* CONTENT: bare, full-width opaque riser. No padding / max-width / grid — the
	   consumer owns those. Opaque + z-indexed (below the heading) so content
	   rising from below cleanly meets the pinned heading and pushes it away. */
	.fh__content {
		background: var(--color-bg);
		position: relative;
		z-index: 2;
	}

</style>

<!-- .fh-row: the container helper for a CONTAINED content row (gutters, full
     width to match the heading's inset). Contents opt in by wrapping in .fh-row;
     full-bleed sections just omit it. Global so consumers can use it. -->
<style is:global>
	.fh-row {
		padding-inline: var(--hero-inset);
	}
</style>
