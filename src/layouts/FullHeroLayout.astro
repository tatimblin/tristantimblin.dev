---
// FullHeroLayout — a page shell with three regions over the base Layout:
//   scene    (slot="scene")   a full-viewport background layer, faded top and
//                             bottom; heading and content flow over it.
//   heading  (slot="heading") the lockup region, inset to the gutter; slotted
//                             content owns its own animation.
//   content  (default slot)   a bare opaque riser; the consumer composes its
//                             grids here (.container for a gutted row).
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
---

<Layout
	title={title}
	description={description}
	image={image}
>
	<div class="fh">
		<div class="fh__scene"><slot name="scene" /></div>
		<div class="fh__heading"><slot name="heading" /></div>
		<div class="fh__content"><slot /></div>
	</div>
</Layout>

<script>
	// THE FLOOR. A scene whose own UI hugs its bottom edge (the carousel's date
	// scrubber + caption) publishes how much of that edge it occupies as
	// --vc-bottom-ui-extent on itself and announces each change with a bubbling
	// `video-carousel:metrics`; custom properties inherit downward only, so it is
	// relayed onto .fh here as --hero-floor for the fold arithmetic below. Read
	// from the element's computed style, not the event, so a measurement published
	// before this module ran still lands. A hidden scene (display: none above the
	// breakpoint that shows it) measures 0 and reserves nothing. Delegated to the
	// document, so view transitions need no rebinding.
	const SCENE = ".fh__scene video-carousel";
	const relay = (scene: HTMLElement) => {
		const fh = scene.closest<HTMLElement>(".fh");
		if (!fh) return;
		const extent = parseFloat(
			getComputedStyle(scene).getPropertyValue("--vc-bottom-ui-extent")
		);
		if (extent > 0) fh.style.setProperty("--hero-floor", `${extent.toFixed(1)}px`);
		else fh.style.removeProperty("--hero-floor");
	};
	document.addEventListener("video-carousel:metrics", (e) => {
		const scene = e.target as HTMLElement;
		if (scene.matches(SCENE)) relay(scene);
	});
	document.querySelectorAll<HTMLElement>(SCENE).forEach(relay);
</script>

<style>
	.fh {
		/* Positioning context for the absolute scene layer below. */
		position: relative;
		/* The site's one --container-inset, so the lockup lines up with the header
		   and the content rows. The videos widget reads it for the margin outside
		   the container. */
		--hero-inset: var(--container-inset);
		/* How much of the scene's bottom edge its own UI occupies (the carousel's
		   scrubber + caption; see the relay above). The scene MEASURES this; a
		   pure background reserves nothing. */
		--hero-floor: 0px;
		--hero-fold-gap: var(--space-5);
		--hero-reserve: var(--hero-floor);
		/* THE FOLD, in two clamps over the group height the slotted heading measures
		   (--sh-group-h) and the lead that clears the site header (--sh-header-clear).
		   ① LEAD bottom-anchors the group above the floor, never above the header: a
		   growing group eats this whitespace first. */
		--hero-lead: max(
			var(--sh-header-clear, 0px),
			calc(
				100svh - var(--hero-reserve) - var(--hero-fold-gap) -
					var(--sh-group-h, 0px)
			)
		);
		/* ② HEIGHT grows the scene only once the lead has bottomed out: while the
		   group fits the sum is exactly 100svh. svh, not vh, so the mobile URL bar
		   does not move the baseline. In CSS rather than JS on purpose: a lead
		   derived from the scene's MEASURED height makes every grown state
		   self-justifying and the hero never shrinks back; here both clamps read the
		   same fixed 100svh, so there is no hysteresis. */
		--hero-height: max(
			100svh,
			calc(
				var(--hero-lead) + var(--sh-group-h, 0px) + var(--hero-fold-gap) +
					var(--hero-reserve)
			)
		);
		/* Pre-JS estimate of the group height: the full-width wordmark SVG has a
		   ~3.68:1 glyph aspect (half-height ≈ 0.109 · inner width), plus an allowance
		   for "other stories" and the intro. The heading overwrites it with the
		   measured value in its connectedCallback. Deliberately GENEROUS: it cannot
		   see --hero-floor, and over-estimating fails toward empty space at the
		   bottom rather than toward printing the intro over the scene's UI. */
		--hero-split-frac: 0.109;
		--hero-split: calc(
			var(--hero-split-frac) * (100vw - 2 * var(--hero-inset))
		);
		--sh-group-h: calc(2 * var(--hero-split) + 42svh);
	}

	/* SCENE: a full-viewport background layer under the heading and content. */
	.fh__scene {
		--dotted-grid-height: var(--hero-height);
		/* The edge fade, hoisted so a consumer can switch it off: a mask applies to
		   the whole subtree, so a scene with legible UI near an edge re-applies it
		   to its visual layer alone. */
		--fh-scene-mask: linear-gradient(
			to bottom,
			transparent 0,
			#000 12%,
			#000 78%,
			transparent 100%
		);
		position: absolute;
		inset: 0 0 auto 0;
		height: var(--hero-height);
		z-index: 0;
		overflow: hidden;
		-webkit-mask-image: var(--fh-scene-mask);
		mask-image: var(--fh-scene-mask);
	}

	/* HEADING: inset to the container gutter, dropped down by the lead so the
	   group rests near the bottom of the scene. Above the content riser so the
	   pinned lockup stays visible while copy rises. */
	.fh__heading {
		padding-inline: var(--hero-inset);
		padding-block-start: var(--hero-lead);
		position: relative;
		z-index: 3;
		/* The region is full-width and tall but paints only its text; its empty area
		   would swallow drags meant for the scene's UI underneath. Slotted content
		   re-enables pointers on its visible parts. */
		pointer-events: none;
	}

	/* CONTENT: a bare, opaque riser below the heading, so content rising from
	   below meets the pinned lockup cleanly. The consumer owns the grids. */
	.fh__content {
		background: var(--background);
		position: relative;
		z-index: 2;
	}

</style>
