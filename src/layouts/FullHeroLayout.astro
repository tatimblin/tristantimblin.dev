---
// FullHeroLayout — a reusable page shell with three drop-in regions:
//
//   scene    (slot="scene")   full-viewport BACKGROUND layer (100svh, absolute),
//                             faded top+bottom; owns --hero-height. The
//                             direct-WebGL <dotted-grid> drops in here (any
//                             full-bleed visual works — the Layout is
//                             scene-agnostic). Heading + content flow OVER it.
//   heading  (slot="heading") the large heading region, inset to the gutter but
//                             full-width within it. Its slotted content
//                             self-manages: it may ANIMATE (drop in
//                             <stories-heading> with the full-width wordmark +
//                             its own pin/parallax/reveal) or just flow.
//   content  (default slot)   a BARE, full-width opaque riser. Its only job is
//                             the pin coupling — it's opaque + z-indexed so
//                             content rising from below cleanly meets the pinned
//                             heading. The consumer composes ALL grids/sections
//                             here: full-bleed by default; a contained row opts
//                             into gutters with the .fh-row helper.
//
// Wraps the base Layout (html/head/tokens/fonts/ClientRouter) unchanged.
import Layout from "./Layout.astro";
// DS component styles so consumers' <Grid>/<GridItem> resolve.
import "@whois/design-system/styles.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
---

<Layout title={title} description={description} image={image}>
	<div class="fh">
		<!-- SCENE: full-bleed; height driven by --hero-height. -->
		<div class="fh__scene"><slot name="scene" /></div>

		<!-- HEADING: inset to the container gutter so a 12-col lockup lines up
		     with the content rows below. Slotted content owns any animation. -->
		<div class="fh__heading"><slot name="heading" /></div>

		<!-- CONTENT: bare opaque riser. The consumer builds rows/sections here. -->
		<div class="fh__content"><slot /></div>
	</div>
</Layout>

<style>
	.fh {
		/* Positioning context for the absolute scene layer below. */
		position: relative;
		/* FIXED type steps (not vw-clamps): the lockup heading changes size only at
		   breakpoints. The overlap formulas in the slotted heading are ratios of
		   these sizes, so a fixed input yields a clean fixed overlap per step; a
		   JS parallax measures real positions and adapts automatically. Base
		   (mobile-first) values here; larger steps in the media queries below.
		   (The "tristan" wordmark is now a full-width SVG that fills the gutters at
		   any size, so it no longer has a fixed type step here.) */
		--heading-size: 2rem;
		/* Full-width within the gutters: every hero region (scene, wordmark,
		   heading, content rows) insets to --container-pad and spans edge-to-edge. */
		--hero-inset: var(--container-pad);
		/* Full-viewport scene height. svh (not vh) so the mobile URL bar doesn't
		   change it. The scene is an absolute background layer; the heading region
		   below reserves the same height so the lockup sits above the fold. */
		--hero-height: 100svh;
		/* Half the wordmark's rendered height, as a fraction of the inner width: the
		   full-width SVG has a ~3.68:1 glyph aspect, so half-height ≈ 0.109 · innerW.
		   Used only by the CSS fallback for --hero-lead until the JS measures and sets
		   --hero-lead directly (2 · split ≈ the wordmark height to skip past). */
		--hero-split-frac: 0.109;
		--hero-split: calc(
			var(--hero-split-frac) * (100vw - 2 * var(--hero-inset))
		);
	}

	/* Fixed heading steps at the DS breakpoints (sm 640 / lg 1024 / xl 1280). A
	   slotted <stories-heading> steps --sh-amp-size / --sh-heading-size in lockstep
	   from its own stylesheet. */
	@media (min-width: 640px) {
		.fh {
			--heading-size: 2.5rem;
		}
	}
	@media (min-width: 1024px) {
		.fh {
			--heading-size: 3rem;
		}
	}
	@media (min-width: 1280px) {
		.fh {
			--heading-size: 3.25rem;
		}
	}

	/* SCENE: a full-viewport BACKGROUND layer, pinned to the top of .fh. The
	   heading + content flow OVER it (higher z-index). Top+bottom fade masks blend
	   it into the page so it has no hard seam. */
	.fh__scene {
		--dotted-grid-height: 100svh;
		position: absolute;
		inset: 0 0 auto 0;
		height: 100svh;
		z-index: 0;
		overflow: hidden;
		/* Fade the scene out at the top and bottom edges. Stops tunable. */
		-webkit-mask-image: linear-gradient(
			to bottom,
			transparent 0,
			#000 12%,
			#000 78%,
			transparent 100%
		);
		mask-image: linear-gradient(
			to bottom,
			transparent 0,
			#000 12%,
			#000 78%,
			transparent 100%
		);
	}

	/* HEADING: inset to the container gutter, over the scene. A LEAD space above the
	   wordmark drops the whole lockup down so "other stories" (which pins at the
	   slotted --sh-top, 50vh) rests at that pin line — the reveal reads 0 at rest,
	   and the wordmark + "&" + "other stories" + intro all sit above the fold. The
	   slotted <stories-heading> JS measures the wordmark and sets --hero-lead so the
	   track top lands on the pin line at any viewport; --hero-split is the CSS-calc
	   fallback (half the wordmark's height, per the ~3.68:1 glyph aspect). z-index
	   ABOVE the content riser so the pinned lockup stays visible while copy rises. */
	.fh__heading {
		padding-inline: var(--hero-inset);
		padding-block-start: var(
			--hero-lead,
			calc(50svh - 2 * var(--hero-split) - var(--space-4))
		);
		position: relative;
		z-index: 3;
		/* This region is full-width and tall at z-index 3, but the slotted lockup
		   only paints its left-aligned text — a pinned heading's empty area would
		   sit OVER content rising below (e.g. the video ruler at ~50vh) and swallow
		   its drag/click. Let pointers fall THROUGH the region; slotted content
		   re-enables interaction on its visible parts (pointer-events: auto). */
		pointer-events: none;
	}

	/* CONTENT: bare, full-width opaque riser. No padding / max-width / grid — the
	   consumer owns those. Opaque + z-indexed (below the heading) so content
	   rising from below cleanly meets the pinned heading and pushes it away. */
	.fh__content {
		background: var(--color-bg);
		position: relative;
		z-index: 2;
	}

</style>

<!-- .fh-row: the container helper for a CONTAINED content row (gutters, full
     width to match the heading's inset). Contents opt in by wrapping in .fh-row;
     full-bleed sections just omit it. Global so consumers can use it. -->
<style is:global>
	.fh-row {
		padding-inline: var(--hero-inset);
	}
</style>
