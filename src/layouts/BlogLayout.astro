---
// BlogLayout — the chrome for the blog's list pages: /txt, /txt/category/<id>
// and /txt/tag/<tag>. Two shells:
//
//   default   the site header in the flow, then one column: a page header
//             (kicker, h1, lede) over whatever the page puts in the slot — a
//             PostIndex. `width="wide"` opens the column to the site
//             container with a compact header row.
//   `tabs`    THE INSTRUMENT: the whole page is one frameless Panels screen,
//             edge to edge and at least the viewport tall. Its first row is
//             this layout's and is the page's header (the banner): the "TT"
//             mark linking home, the h1 as a caps label, the category tabs as
//             pill links to `?q=`, the site's name. No SiteHeader above it —
//             the row already carries the site. The rest is <main>, a nested
//             Panels whose rows the page slots in (the board, the controls,
//             the timeline); the board row takes the leftover height. The
//             site footer (Layout's) follows below the screen.
//
// Pages stay thin: they fetch and group, this owns the shell. Wraps
// Layout.astro (the only html/head).
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Heading from "@whois/design-system/Heading";
import Mono from "@whois/design-system/Mono";
import Body from "@whois/design-system/Body";
import Pill from "@whois/design-system/Pill";
import Panels from "@whois/design-system/Panels";
import Panel from "@whois/design-system/Panel";
// DS component styles are not global — once per page, and a layout's import
// counts for everything it slots.
import "@whois/design-system/styles.css";
import "../styles/blog.css";
import { blogNav } from "../lib/blog";

interface Tab {
	label: string;
	/** A real link: `/txt?q=<category>`, or `/txt` for all. */
	href: string;
	/** The query the tab stands for; "" is all. The script keys on it. */
	query: string;
	active?: boolean;
}

interface Props {
	/** The document title. */
	title: string;
	description?: string;
	noindex?: boolean;
	/** The page's h1. */
	heading: string;
	/** A small caps label above the h1 ("Category", "Tag"). */
	kicker?: string;
	/** The column: the reading measure (the lists), or the site's container
	 *  with a compact header row. Not read with `tabs`. */
	width?: "measure" | "wide";
	/** The instrument's tab row — the category tabs; with these the page is
	 *  one full-page Panels screen and the slot is its remaining rows. */
	tabs?: Tab[];
}

const { title, description, noindex, heading, kicker, width = "measure", tabs } = Astro.props;
const hasLede = Astro.slots.has("lede");
---

<Layout title={title} description={description} noindex={noindex}>
	{
		tabs ? (
			<Panels frame={false} class="blog blog--instrument" data-instrument>
				<Panel as="header" pad="none" class="blog__tabrow">
					<div class="blog__ident">
						<a class="blog__mark" href="/" aria-label="tristantimblin.dev, home">TT</a>
						<Mono as="h1" tone="primary" class="blog__title">{heading}</Mono>
					</div>
					<nav class="blog__tabs" aria-label="Categories" data-tabs>
						{tabs.map((t) => (
							<Pill
								as="a"
								size="lg"
								variant="outline"
								href={t.href}
								class="blog__tab"
								data-tab={t.query}
								aria-current={t.active ? "page" : undefined}
							>
								{t.query === "" && <span class="blog__tab-glyph" aria-hidden="true" />}
								{t.label}
							</Pill>
						))}
					</nav>
					<Mono tone="tertiary" class="blog__site">tristantimblin.dev / txt</Mono>
				</Panel>
				<Panels as="main" class="blog__stage">
					<slot />
				</Panels>
			</Panels>
		) : (
			<div class="blog">
				<SiteHeader variant="flow" links={blogNav} />
				<main class:list={["blog__main", width === "wide" && "blog__main--wide"]}>
					<header class="blog__header">
						{kicker && <Mono class="blog__kicker">{kicker}</Mono>}
						<Heading as="h1" size={4}>{heading}</Heading>
						{hasLede && (
							<Body class="blog__lede"><slot name="lede" /></Body>
						)}
					</header>
					<slot />
				</main>
			</div>
		)
	}
</Layout>
