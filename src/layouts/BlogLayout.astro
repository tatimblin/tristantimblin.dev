---
// BlogLayout — the shell of the site's written pages: the site header in the
// flow, then one column. By default the column is the reading measure under
// a page header (kicker, h1, lede): the tag pages, the credits, the 404.
// `hero` sets the heading in the fabric halftone instead (PageHero), with the
// column on the site container: the section pages, /txt and /about.
import type { ComponentProps } from "astro/types";
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PageHero from "../components/PageHero.astro";
import Heading from "@whois/design-system/Heading";
import Mono from "@whois/design-system/Mono";
import Body from "@whois/design-system/Body";

type Props = ComponentProps<typeof Layout> & {
	/** The page's h1. */
	heading: string;
	/** A small caps label above the h1 ("Tag", "404 /"). */
	kicker?: string;
	/** The heading in the halftone hero (PageHero) instead of the plain
	 *  page header, on the site container; the kicker and lede are not drawn.
	 *  A `hero-cards` slot fills the row of cards overlapping it. */
	hero?: boolean;
};

const { heading, kicker, hero = false, ...layout } = Astro.props;
const hasLede = Astro.slots.has("lede");
---

<Layout {...layout}>
	<div class="blog">
		<SiteHeader />
		{hero && (
			<PageHero heading={heading}>
				<Fragment slot="cards"><slot name="hero-cards" /></Fragment>
			</PageHero>
		)}
		<main class:list={["blog__main", hero && "blog__main--hero"]}>
			{!hero && (
				<header class="blog__header">
					{kicker && <Mono class="blog__kicker">{kicker}</Mono>}
					{/* The page-title step: 44px, 32px below 1024. */}
					<Heading as="h1" size={5} responsive>{heading}</Heading>
					{hasLede && (
						<Body class="blog__lede"><slot name="lede" /></Body>
					)}
				</header>
			)}
			<slot />
		</main>
	</div>
</Layout>

<style>
	/* The page's headings on the UI face, by retuning the heading tokens in
	   scope (the heading components read them). Regular: a page title here is
	   quiet. */
	.blog {
		--font-heading: var(--font-ui);
		--font-heading-weight: var(--font-weight-400);
		min-height: 100vh;
		font-family: var(--font-ui);
	}

	.blog__main {
		max-width: var(--measure-prose);
		margin-inline: auto;
		padding-inline: var(--container-pad);
		padding-block: var(--space-11) var(--space-12);
	}
	/* The site container (.container's inset, restated: the bare gutter above
	   would tie with the class), under the hero's title at the page header's
	   distance to the first row. */
	.blog__main--hero {
		max-width: none;
		padding-inline: var(--container-inset);
		padding-block-start: var(--space-10);
	}

	.blog__header {
		margin-block-end: var(--space-10);
	}
	.blog__header > :global(* + *) {
		margin-block-start: var(--space-3);
	}
	.blog__kicker {
		display: block;
	}
	.blog__lede {
		margin-block-start: var(--space-4);
	}

	@media (max-width: 639px) {
		.blog__main {
			padding-block: var(--space-8) var(--space-10);
		}
		.blog__header {
			margin-block-end: var(--space-6);
		}
	}
</style>
