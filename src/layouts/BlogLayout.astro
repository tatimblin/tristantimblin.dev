---
// BlogLayout — the chrome for the blog's list pages: /txt and /txt/tag/<tag>
// (and the 404). Two shells:
//
//   default   the site header in the flow, then one column: a page header
//             (kicker, h1, lede) over whatever the page puts in the slot — a
//             PostIndex. `width="wide"` opens the column to the site
//             container with a compact header row.
//   `bar`     THE INSTRUMENT: the site header as on every page, then <main> in
//             the site's container (padded by --container-inset, as the
//             homepage's rows and the header are, so the rows' edges fall on
//             the header's brand and nav). Its rows sit straight on the page,
//             spaced rather than cut: this layout's BAR row — the h1 visually
//             hidden, and the one ruled search bar spanning the container:
//             the search, the quick-filter chips (the categories from the
//             enum, each a real link to `?q=<category>`, ALL to /txt — a chip
//             is a search shortcut), the − / + stepper and the `/` hint —
//             then what the page slots in (the board, the timeline). Nothing
//             carries a surface. The rows stack at their own height, a step
//             apart, and the site footer (Layout's) follows.
//
// Pages stay thin: they fetch and group, this owns the shell. Wraps
// Layout.astro (the only html/head).
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Heading from "@whois/design-system/Heading";
import Mono from "@whois/design-system/Mono";
import Body from "@whois/design-system/Body";
import Chip from "@whois/design-system/Chip";
import IconButton from "@whois/design-system/IconButton";
import SearchBar from "@whois/design-system/SearchBar";
import VisuallyHidden from "@whois/design-system/VisuallyHidden";
// DS component styles are not global — once per page, and a layout's import
// counts for everything it slots.
import "@whois/design-system/styles.css";
import "../styles/blog.css";
import { blogNav } from "../lib/blog";

interface ChipLink {
	label: string;
	/** A real link: `/txt?q=<category>`, or `/txt` for all. */
	href: string;
	/** The query the chip stands for; "" is all. The script keys on it. */
	query: string;
	active?: boolean;
}

interface Bar {
	/** The quick filters: ALL and the categories. */
	chips: ChipLink[];
	/** The live count's first reading (`5 posts`). */
	count: string;
}

interface Props {
	/** The document title. */
	title: string;
	description?: string;
	noindex?: boolean;
	/** The page's h1. */
	heading: string;
	/** A small caps label above the h1 ("Category", "Tag"). */
	kicker?: string;
	/** The column: the reading measure (the lists), or the site's container
	 *  with a compact header row. Not read with `bar`. */
	width?: "measure" | "wide";
	/** The instrument's bar row — the search with its chips and stepper;
	 *  with this the page is the instrument in the site container and the
	 *  slot is its remaining rows. */
	bar?: Bar;
}

const { title, description, noindex, heading, kicker, width = "measure", bar } = Astro.props;
const hasLede = Astro.slots.has("lede");
---

<Layout title={title} description={description} noindex={noindex}>
	{
		bar ? (
			<div class="blog blog--instrument">
				<SiteHeader variant="flow" links={blogNav} />
				<main class="blog__main blog__main--instrument">
					<div class="blog__instrument" data-instrument>
						<div class="blog__row blog__bar">
							<VisuallyHidden as="h1">{heading}</VisuallyHidden>
							<form class="blog__search" action="/txt" method="get" data-quilt-form>
								<SearchBar
									id="quilt-search"
									label="Search"
									placeholder="Search a title, a topic, a year…"
									count={bar.count}
									hint="/"
									controls="quilt-panel-results"
									chipsLabel="Quick filters"
								>
									{bar.chips.map((c) => (
										<Chip
											slot="chips"
											as="a"
											href={c.href}
											data-chip={c.query}
											aria-current={c.active ? "page" : undefined}
										>
											{c.label}
										</Chip>
									))}
									<IconButton
										slot="controls"
										variant="outline"
										square
										size="small"
										glyph="−"
										aria-label="Previous post"
										data-step="older"
										type="button"
									/>
									<IconButton
										slot="controls"
										variant="outline"
										square
										size="small"
										glyph="+"
										aria-label="Next post"
										data-step="newer"
										type="button"
									/>
								</SearchBar>
							</form>
						</div>
						<slot />
					</div>
				</main>
			</div>
		) : (
			<div class="blog">
				<SiteHeader variant="flow" links={blogNav} />
				<main class:list={["blog__main", width === "wide" && "blog__main--wide"]}>
					<header class="blog__header">
						{kicker && <Mono class="blog__kicker">{kicker}</Mono>}
						<Heading as="h1" size={4}>{heading}</Heading>
						{hasLede && (
							<Body class="blog__lede"><slot name="lede" /></Body>
						)}
					</header>
					<slot />
				</main>
			</div>
		)
	}
</Layout>
