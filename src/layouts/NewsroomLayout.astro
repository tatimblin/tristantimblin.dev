---
// The chrome for /txt as a NEWS PRODUCT rather than a printed sheet: a slim top
// bar (slogan box, centred wordmark, issue/date), a wire strip whose flag drops
// down the site's routes, a category rail built from the collection's tags, and
// the warm paper the whole thing sits on. The stories themselves arrive through
// <slot />, the same split TxtPostLayout uses.
//
// Replaces the earlier BroadsheetLayout. The Oxford rules, the 168px nameplate
// and the drop cap belonged to a print pastiche; this is the screen equivalent,
// so the nameplate shrinks to a wordmark and the page gains radii and surfaces.
import Layout from "./Layout.astro";
import "@whois/design-system/styles.css";

interface Props {
	title: string;
	description?: string;
	/** Forwarded to Layout — the tag archives opt out of indexing. */
	noindex?: boolean;
	/** The category currently being read, if this is a tag page. */
	activeTag?: string;
	/** Small caps that lead the wordmark, e.g. "The". */
	wordmarkLead?: string;
	/** The publication's name, set in the hero face. */
	wordmark: string;
	volume?: number;
	issue?: number;
	dateline?: Date;
	/** Every tag in the collection, for the category rail. */
	tags?: string[];
	/** Ticker segments. Each is a label plus its value; `live` marks the two the
	 *  client script fills (date and time), which ship empty. */
	ticker?: Array<{
		label: string;
		value?: string;
		live?: "date" | "time";
		/** Market direction, for the up/down tint. */
		tone?: "up" | "down";
	}>;
	/** Slogan phrases for the boxed strapline in the bar's left track. */
	strapline?: string[];
	/** Publication city, printed beside the live clock. */
	city?: string;
	/** IANA zone the clock runs in. The paper's own time, not the reader's. */
	timeZone?: string;
}

const {
	title,
	description,
	noindex,
	activeTag,
	wordmarkLead,
	wordmark,
	volume,
	issue,
	dateline,
	tags = [],
	ticker = [],
	strapline = [],
	city = "San Francisco",
	timeZone = "America/Los_Angeles",
} = Astro.props;

const ROMAN: Array<[number, string]> = [
	[1000, "M"], [900, "CM"], [500, "D"], [400, "CD"],
	[100, "C"], [90, "XC"], [50, "L"], [40, "XL"],
	[10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"],
];
function toRoman(n: number): string {
	if (!Number.isFinite(n) || n < 1) return "";
	let rest = Math.floor(n);
	let out = "";
	for (const [value, numeral] of ROMAN) {
		while (rest >= value) { out += numeral; rest -= value; }
	}
	return out;
}

// UTC: frontmatter dates are bare YYYY-MM-DD, parsed as UTC midnight. Formatting
// them in the build machine's zone prints the day before anywhere west of UTC.
const fmtLong = (d: Date) =>
	new Date(d).toLocaleDateString("en-US", {
		weekday: "long", month: "long", day: "numeric", year: "numeric", timeZone: "UTC",
	});
const iso = (d: Date) => new Date(d).toISOString().split("T")[0];

// Real destinations only — every entry has somewhere to go. These render inside
// the wire flag's disclosure rather than as pills in the bar.
//
// The section link is marked aria-current="true", not "page", and the distinction
// matters: the category chips below use "page" for the exact URL, and a document
// with two elements both claiming to be the current PAGE tells a screen reader
// nothing useful. "true" is the generic "this is the current item", which is what
// a section tab actually is — and on /txt/tag/diy the Writing entry is a section
// ancestor, not the page you are on.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const nav = [
	{ label: "Home", href: "/" },
	{ label: "Writing", href: "/txt" },
	{ label: "Gallery", href: "/gallery" },
].map((link) => ({
	...link,
	current: link.href === "/" ? path === "/" : path === link.href || path.startsWith(`${link.href}/`),
}));

const issueLine = [
	volume ? `Vol. ${toRoman(volume)}` : null,
	issue ? `No. ${issue}` : null,
].filter(Boolean).join(" · ");
---

<Layout title={title} description={description} noindex={noindex}>
	<div class="np">
		<header class="np__bar">
			{strapline.length > 0 && (
				/* The slogan box — a masthead ear, now in the bar's LEFT track where the
				   nav pills used to sit. Real text rather than aria-hidden decoration:
				   unlike the wire, this says something about the publication and is
				   worth reading once. The pills moved down into the wire's flag as a
				   disclosure; three permanent route labels were competing with the
				   nameplate for the top of every page, and the slogan is the thing a
				   masthead is actually for. */
				<p class="np__strapline">
					{strapline.map((phrase, i) => (
						<>
							{i > 0 && <span class="np__strapline-sep" aria-hidden="true">&#9670;</span>}
							<span>{phrase}</span>
						</>
					))}
				</p>
			)}

			<div class="np__lockup">
				<a class="np__wordmark" href="/txt" aria-label={`${wordmarkLead ?? ""} ${wordmark}`.trim()}>
					{wordmarkLead && <span class="np__wordmark-lead" aria-hidden="true">{wordmarkLead}</span>}
					<span class="np__wordmark-name" aria-hidden="true">{wordmark}</span>
				</a>
			</div>

			<div class="np__meta">
				{dateline && (
					<time class="np__date" datetime={iso(dateline)}>{fmtLong(dateline)}</time>
				)}
				{issueLine && <span class="np__issue">{issueLine}</span>}
			</div>
		</header>

		{/* The wire strip. It always renders now, with or without market data, because
		    it carries the site's primary navigation in its flag — the strip is chrome,
		    not a slot for a feed that may be empty.

		    <details>, not a scripted menu: the routes stay reachable with scripting
		    off, and the browser gives keyboard operation, Escape, and the expanded
		    state for free. The script below only adds the two behaviours a native
		    disclosure lacks — closing on an outside click, and on navigation. */}
		<div class="ticker" data-tz={timeZone}>
			<details class="wire" data-wire>
				<summary class="ticker__flag wire__flag">
					<span>Wire</span>
					<svg class="wire__chevron" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
						<path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"
							stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</summary>
				<nav class="wire__menu" aria-label="Primary">
					{nav.map((l) => (
						<a
							class:list={["wire__link", l.current && "wire__link--current"]}
							href={l.href}
							aria-current={l.current ? "true" : undefined}
						>
							{l.label}
						</a>
					))}
				</nav>
			</details>

			{ticker.length > 0 && (
				/* Furniture, not navigation: nothing in the scrolling half is a link, so
				   it adds no second route to anything and stays out of the tab order. It
				   is aria-hidden because a screen reader announcing a loop of market
				   figures on entry is noise — the same data has no meaning read aloud out
				   of order. The hiding is scoped to the window rather than the whole
				   strip, which now contains navigation that must stay announced. */
				<div class="ticker__window" aria-hidden="true">
					<div class="ticker__track" data-ticker-track>
						{/* Rendered twice so the loop can translate exactly -50% and land
						    back where it started with no visible seam. */}
						{[0, 1].map((copy) => (
							<div class="ticker__run">
								{ticker.map((seg) => (
									<span class="ticker__item">
										<span class="ticker__mark">&#9670;</span>
										<span class="ticker__label">{seg.label}</span>
										<span
											class:list={["ticker__value", seg.tone && `ticker__value--${seg.tone}`]}
											data-live={seg.live}
											data-copy={seg.live ? String(copy) : undefined}
										>
											{seg.value}
										</span>
									</span>
								))}
							</div>
						))}
					</div>
				</div>
			)}
		</div>

		{
			tags.length > 0 && (
				/* Ordinary links to real routes, not filter buttons. Each category has
				   its own front page, so these work with scripting off, they are
				   shareable, and nothing has to ship hidden waiting for JS to make it
				   functional. aria-current marks the one being read. */
				<nav class="np__rail" aria-label="Categories">
					<a
						class:list={["np__chip", !activeTag && "np__chip--current"]}
						href="/txt"
						aria-current={!activeTag ? "page" : undefined}
					>
						All
					</a>
					{tags.map((tag) => (
						<a
							class:list={["np__chip", tag === activeTag && "np__chip--current"]}
							href={`/txt/tag/${tag}`}
							aria-current={tag === activeTag ? "page" : undefined}
						>
							{tag.replace(/-/g, " ")}
						</a>
					))}
				</nav>
			)
		}

		<slot />
	</div>
</Layout>

<script>
	// The wire's live segments. Date and time ship EMPTY in the HTML on purpose: a
	// value baked in at build would be wrong the moment it shipped, and stamping one
	// would make every rebuild produce a different file. They run in the PAPER's
	// timezone rather than the reader's — an edition is published from somewhere,
	// and the reader's own wall clock is not news.
	//
	// querySelectorAll, not querySelector: the track renders twice for the seamless
	// loop, so each live segment exists twice and both copies must agree.
	let wireTimer: number | undefined;
	function startWire() {
		const track = document.querySelector<HTMLElement>("[data-ticker-track]");
		if (!track) return;
		const timeZone = track.closest<HTMLElement>(".ticker")?.dataset.tz || undefined;

		const dateFmt = new Intl.DateTimeFormat("en-US", {
			weekday: "short", month: "short", day: "numeric", year: "numeric", timeZone,
		});
		const timeFmt = new Intl.DateTimeFormat("en-US", {
			hour: "numeric", minute: "2-digit", timeZone,
		});

		const tick = () => {
			const now = new Date();
			for (const el of track.querySelectorAll<HTMLElement>('[data-live="date"]')) {
				el.textContent = dateFmt.format(now);
			}
			for (const el of track.querySelectorAll<HTMLElement>('[data-live="time"]')) {
				el.textContent = timeFmt.format(now);
			}
		};

		tick();
		window.clearInterval(wireTimer);
		// Align to the next minute, then run once a minute — a per-second interval
		// would repaint 59 times for no visible change.
		window.setTimeout(() => {
			tick();
			wireTimer = window.setInterval(tick, 60_000);
		}, (60 - new Date().getSeconds()) * 1000);
	}

	// The two things <details> does not do on its own. Everything else about the
	// menu — toggling, keyboard operation, Escape, the expanded state exposed to
	// assistive tech — is the browser's, and none of it is reimplemented here.
	//
	// Delegated to document so it survives view transitions without rebinding, and
	// so a menu added later needs no registration.
	function closeWireNav(except?: EventTarget | null) {
		for (const el of document.querySelectorAll<HTMLDetailsElement>("[data-wire][open]")) {
			if (except && el.contains(except as Node)) continue;
			el.open = false;
		}
	}

	document.addEventListener("pointerdown", (e) => closeWireNav(e.target));
	// Focus leaving the menu by keyboard should close it too, otherwise tabbing past
	// the last link leaves an open panel hanging over the page.
	document.addEventListener("focusin", (e) => closeWireNav(e.target));

	function init() {
		startWire();
	}

	init();
	document.addEventListener("astro:page-load", init);
	document.addEventListener("astro:before-swap", () => {
		window.clearInterval(wireTimer);
		closeWireNav();
	});
</script>

<style is:global>
	/* PAPER — scoped to pages that render this layout.
	 *
	 * `is:global` because the page background lives on <body>, which no scoped
	 * selector here can reach; the rule still only ships in the stylesheet of a page
	 * that includes this component, so the homepage, gallery and design-system
	 * catalogue keep the site's cool white. That scoping is deliberate: the homepage
	 * hero samples --color-bg into a WebGL canvas each frame, so retuning the global
	 * background would re-tint the halftone scene as a side effect.
	 *
	 * Warm, low-chroma cream in light; a warm near-black in dark, so the hue stays
	 * consistent across the toggle rather than flipping to the site's cool blue. */
	.maximeheckel-light {
		--paper: oklch(97.4% 0.016 84);
		--paper-raised: oklch(99.3% 0.008 84);
		--paper-sunk: oklch(94.6% 0.022 84);
		--paper-line: oklch(89% 0.020 84);
	}
	.maximeheckel-dark {
		--paper: oklch(17.5% 0.008 84);
		--paper-raised: oklch(22.5% 0.010 84);
		--paper-sunk: oklch(14.5% 0.007 84);
		--paper-line: oklch(31% 0.012 84);
	}
	/* Rebind the TOKENS, not just body's background. SiteFooter paints
	   `background: var(--color-bg)` of its own, so setting the background alone left
	   a cool-white band across the bottom of a cream page. Redefining the tokens on
	   <body> means the footer, any DS component, and anything else reading them
	   follows to paper without a per-component patch.
	   :has() so this keys off the page's own content rather than needing a class
	   plumbed onto <body> through Layout; where :has() is unsupported the rule drops
	   and the page simply renders on the site's default white, which is still
	   perfectly legible. */
	body:has(.np) {
		--color-bg: var(--paper);
		--border-color: var(--paper-line);
		--color-border: var(--paper-line);
		background: var(--paper);
	}
</style>

<style>
	.np {
		max-width: var(--container-max);
		margin-inline: auto;
		padding-inline: var(--container-pad);
		padding-block: var(--space-4) var(--space-10);
	}

	/* Top bar: pills left, wordmark centred, issue/date right. Three explicit
	   tracks rather than space-between, so the wordmark is centred on the PAGE and
	   not merely between two groups of unequal width. */
	.np__bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: var(--space-4);
		padding-block: var(--space-3) var(--space-4);
		/* Oxford rule: thick over thin, the pair a nameplate sits on. `double` gives
		   two even hairlines; this is the asymmetric print version, so the weights
		   are separate borders on a 5px box (2 + 2 + 1 under the global box-sizing). */
		border-block-end: 1px solid var(--text-primary);
		position: relative;
	}
	.np__bar::after {
		content: "";
		position: absolute;
		inset-inline: 0;
		inset-block-end: -4px;
		block-size: 2px;
		background: var(--text-primary);
	}

	.np__chip {
		font-family: var(--font-ui);
		font-size: var(--font-size-1);
		line-height: 1;
		padding: var(--space-3) var(--space-4);
		border: 1px solid transparent;
		border-radius: var(--border-radius-3);
		background: var(--paper-sunk);
		color: var(--text-secondary);
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: background 0.15s ease, color 0.15s ease;
	}
	.np__chip:hover {
		color: var(--text-primary);
		border-color: var(--paper-line);
	}
	.np__chip--current {
		background: var(--text-primary);
		color: var(--paper);
	}

	/* The nameplate group: wordmark with its slogan box beneath, centred as a unit
	   in the bar's middle track. */
	.np__lockup {
		grid-column: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
	}

	/* The slogan box. Ruled on all four sides rather than underlined, because a box
	   is what a masthead ear is — and the border is --text-primary, the masthead
	   rank, so it reads as part of the nameplate rather than as another hairline. */
	.np__strapline {
		grid-column: 1;
		/* Hug the slogan rather than stretching the rule across the whole 1fr track —
		   a grid item fills its column by default, and this one is a BOX. */
		justify-self: start;
		/* One phrase per line, at every width. Stacked, the box is ~170px rather than
		   ~322px, which fits the bar's 1fr track everywhere: a 1fr track will not
		   shrink below its content, so a one-line box that outgrew its share took the
		   width out of the opposite track and slid the nameplate off centre. Two short
		   stacked lines are also simply what a masthead ear looks like. */
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-1);
		margin: 0;
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--text-primary);
		font-family: var(--font-ui);
		font-weight: 600;
		/* Under the scale's smallest step on purpose — this is a subordinate mark
		   standing next to the nameplate, not body copy, and the wide tracking needs
		   the size pulled back to stop it competing. */
		font-size: calc(var(--font-size-1) * 0.8);
		line-height: 1.25;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--text-secondary);
		text-align: center;
	}
	/* Stacked, the line break separates the phrases. The diamond is only needed when
	   they share a line, which is the phone layout below. */
	.np__strapline-sep {
		display: none;
	}

	/* Wordmark: small caps lead + the name in the hero face, the reference's
	   "THE / DAILY / POST" lockup. Migra ships no italic cut, so the emphasis is
	   carried by size and weight rather than a synthesised slant. */
	.np__wordmark {
		display: inline-flex;
		align-items: baseline;
		gap: var(--space-2);
		text-decoration: none;
		color: var(--text-primary);
	}
	.np__wordmark-lead {
		font-family: var(--font-ui);
		font-weight: 600;
		font-size: var(--font-size-1);
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: var(--text-tertiary);
	}
	.np__wordmark-name {
		font-family: var(--font-hero);
		font-weight: var(--font-hero-weight);
		font-size: var(--font-size-7);
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.np__meta {
		grid-column: 3;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--space-1);
		font-family: var(--font-ui);
		font-size: var(--font-size-1);
		line-height: 1.3;
		color: var(--text-tertiary);
		text-align: end;
	}
	.np__issue {
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	/* ---- ticker ------------------------------------------------------------ */

	.ticker {
		display: flex;
		align-items: stretch;
		gap: var(--space-4);
		margin-block-start: var(--space-5);
		border-block: 1px solid var(--paper-line);
		background: var(--paper-sunk);
		/* No overflow: hidden any more — the flag's menu opens downward out of the
		   strip. The window does its own clipping, which is where it belonged. The
		   z-index puts the open panel over the category rail, which is static and
		   later in the document, so it would otherwise paint on top. */
		position: relative;
		z-index: 1;
	}

	.ticker__flag {
		flex: none;
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding-inline: var(--space-4);
		background: var(--text-primary);
		color: var(--paper);
		font-family: var(--font-ui);
		font-weight: 600;
		font-size: var(--font-size-1);
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}

	/* ---- wire nav ---------------------------------------------------------- */

	.wire {
		flex: none;
		/* The menu anchors to the flag, not the strip, so it opens under the word it
		   belongs to rather than at the far left of the page. */
		position: relative;
	}

	.wire__flag {
		block-size: 100%;
		cursor: pointer;
		user-select: none;
		/* Both are needed to kill the disclosure triangle: the standard property, and
		   the pseudo-element WebKit still paints without it. */
		list-style: none;
	}
	.wire__flag::-webkit-details-marker {
		display: none;
	}
	.wire__flag:focus-visible {
		outline: 2px solid var(--text-primary);
		outline-offset: 2px;
	}

	.wire__chevron {
		flex: none;
		inline-size: 0.6em;
		transition: transform 0.15s ease;
	}
	.wire[open] .wire__chevron {
		transform: rotate(180deg);
	}

	/* min-inline-size rather than a fixed width: the panel is at least as wide as the
	   flag, so it reads as the same block opening rather than a chip floating under
	   it, but a longer label is free to push it wider. */
	.wire__menu {
		position: absolute;
		inset-block-start: 100%;
		inset-inline-start: 0;
		z-index: 20;
		display: flex;
		flex-direction: column;
		min-inline-size: 100%;
		padding: var(--space-2);
		border: 1px solid var(--text-primary);
		background: var(--paper-raised);
		box-shadow: 0 8px 24px oklch(0% 0 0 / 0.16);
	}

	.wire__link {
		padding: var(--space-3) var(--space-4);
		border-radius: var(--border-radius-2);
		font-family: var(--font-ui);
		font-size: var(--font-size-1);
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		color: var(--text-secondary);
		transition: background 0.15s ease, color 0.15s ease;
	}
	.wire__link:hover {
		background: var(--paper-sunk);
		color: var(--text-primary);
	}
	.wire__link--current {
		background: var(--text-primary);
		color: var(--paper);
	}

	@media (prefers-reduced-motion: reduce) {
		.wire__chevron {
			transition: none;
		}
	}

	.ticker__window {
		overflow: hidden;
		flex: 1;
		padding-block: var(--space-3);
	}
	/* Same trailing fade as the category rail: a headline sheared off mid-word by a
	   hard container edge reads as a clipping bug rather than as motion. */
	@supports (mask-image: linear-gradient(black, black)) {
		.ticker__window {
			mask-image: linear-gradient(to right, #000 calc(100% - var(--space-7)), transparent 100%);
		}
	}

	.ticker__track {
		display: flex;
		inline-size: max-content;
	}
	.ticker__run {
		display: flex;
		flex: none;
	}

	.ticker__item {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		padding-inline-end: var(--space-6);
		font-family: var(--font-body);
		font-size: var(--font-size-1);
		line-height: 1;
		white-space: nowrap;
		color: var(--text-secondary);
	}
	.ticker__mark {
		color: var(--text-tertiary);
		font-size: 0.7em;
	}
	/* Label in the UI face and small caps, value in the body face — the pair reads
	   as an instrument panel rather than a sentence. */
	.ticker__label {
		font-family: var(--font-ui);
		font-size: 0.85em;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-tertiary);
	}
	.ticker__value {
		font-variant-numeric: tabular-nums;
		color: var(--text-primary);
	}
	/* Until the script fills them, the live segments have no value and their label
	   would sit next to nothing. Collapse the gap rather than showing a dangling
	   colon-less label. */
	.ticker__value:empty {
