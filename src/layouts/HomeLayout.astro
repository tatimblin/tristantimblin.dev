---
// HomeLayout — the homepage's shell: the site header in the flow, then ONE
// widget grid whose first row is the opener and whose other rows are the
// page's cards (the default slot).
//
//   the opener  a first screen of its own, capped so a very tall window has
//               the cards peek in: the lockup (StoriesHeading: "tristan",
//               "& other stories" and the page's intro, slot="intro") in the
//               grid's left columns, and an open right column where the videos
//               card is parked at rest, the two centred as one group between
//               the header and the first row of cards
//               (src/widgets/videos/videos.css lifts the card out of its own
//               cell, rows 2–3 of the last column, by --home-dock-travel,
//               stated below; the card's height includes the bands its
//               header and footer take at the dock, so a phone's group is
//               stated from the picture between them).
//   the cards   everything else, dense-packed from the row after.
//
// One grid, so the opener sits on the cards' own columns: the lockup is two
// cells wide to the pixel, the parked carousel is in its column, and "tristan"
// drifts a little, holds in the middle of the screen while the first row of
// cards rises to meet it, then rests one gap above that row and leaves with it
// — no measurement, no script, the same with or without one.
import type { ComponentProps } from "astro/types";
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StoriesHeading from "../components/StoriesHeading.astro";
import WidgetGrid from "@whois/design-system/WidgetGrid";
import "@whois/stories-heading/styles.css";
import "@whois/wobble-text/styles.css";
import "@tristimb/dotted-grid/styles.css";
import "@tristimb/video-carousel/styles.css";

type Props = ComponentProps<typeof Layout>;

const props = Astro.props;
---

<Layout {...props}>
	<SiteHeader />
	<main class="container home">
		<WidgetGrid cols={4}>
			<StoriesHeading>
				<slot name="intro" />
			</StoriesHeading>
			<slot />
		</WidgetGrid>
	</main>
</Layout>

<script>
	import "@whois/wobble-text";
	import "@tristimb/dotted-grid";
	import "@tristimb/video-carousel";
	// The cards' scripts: each <Widget name> in the slot is mounted from its own
	// chunk when it comes due (src/widgets/index.ts).
	import "../widgets";
</script>

<style is:global>
	.home {
		/* THE SITE HEADER'S BAND: its block padding round one line of the bar's
		   type (SiteHeader). Stated rather than measured, so where "tristan" pins
		   (below) is known before any script runs; tests/home-opener.spec.ts holds
		   it to the real bar. */
		--home-header-h: calc(
			2 * var(--space-4) + var(--font-size-1) * var(--line-height-body)
		);
		/* From the header down to the opener. */
		--home-lead: var(--space-8);
		padding-block: var(--home-lead) var(--space-10);
		/* THE FIRST SCREEN: the window, capped at the page's own measure, so the
		   opener is never taller than the content is wide and a tall window has
		   the cards peek in. svh, so a mobile browser's collapsing chrome never
		   resizes it. */
		--home-first-screen: min(100svh, var(--container-max));
	}

	/* THE OPENER'S GEOMETRY, on the grid so the lockup and the videos card read
	   the same numbers. Every size is the grid's own (--widget-cell,
	   --widget-grid-gap, widget-grid.css), so it lands on the cards' columns at
	   every width, and all of it is stylesheet, so the first frame is final. */
	.home .ds-widget-grid {
		/* A 1×2 tile's height: the videos card, parked centred in the opener. */
		--home-tile-h: calc(2 * var(--widget-cell) + var(--widget-grid-gap));
		/* "tristan"'s box: two cells wide, the line height over the size that
		   width gives it. */
		--home-word-h: calc(
			0.8 * (2 * var(--widget-cell) + var(--widget-grid-gap)) / var(--sh-wordmark-em)
		);
		/* How far below the opener's top the parked card sits (phones, below). */
		--home-tile-drop: 0px;
		/* The tile's empty band under the picture, which the group doesn't count
		   when it centres but the row still holds (phones, below). */
		--home-tile-foot: 0px;
		/* THE GROUP the opener centres: the parked tile and, on a phone, the word
		   overlapping it from half a word above. The lockup's copy is shorter than
		   the tile beside it, so this is the group's height, from the grid's own
		   sizes and known before anything is measured. */
		--home-group-h: calc(var(--home-tile-drop) + var(--home-tile-h) - var(--home-tile-foot));
		/* THE LOCKUP ON THE TILE'S AXIS (desktop; a phone overlaps them instead):
		   how far below the tile's top the word starts, so the shorter lockup
		   centres beside it. The word's height is exact; the copy under it (the
		   sub's margin, "& other stories" and two lines of intro) is stated as
		   steps, because where the word pins
		   has to be a number before any script runs. A pixel or two of the copy's
		   wrap reads as nothing against a 444px tile. */
		--home-lockup-h: calc(var(--home-word-h) + var(--space-3) + var(--space-11));
		--home-lockup-drop: max(0px, (var(--home-tile-h) - var(--home-lockup-h)) / 2);
		/* THE FOLD: the row height that puts the first row of cards a step below
		   the first screen's bottom. */
		--home-fold: calc(
			var(--home-first-screen) + var(--space-4) - var(--home-header-h) -
				var(--home-lead) - var(--widget-grid-gap)
		);
		/* THE ROW'S HEIGHT, and so the pin's range: a first screen, or the group's
		   room if that is more. A floor: the lockup's own content can still grow
		   the row (a large root font), and then the card parks that much lower
		   and still lands in its cell. */
		--home-opener-h: max(var(--home-group-h) + var(--home-tile-foot), var(--home-fold));
		/* THE CENTRE: how far below the opener's top the group starts, to sit
		   midway between the header and the first row (the lead above the opener
		   and the gap below it are part of that space). Never negative and never
		   past the row's foot: where the group fills the space (a short window, a
		   large root font) it is simply top-anchored. */
		--home-center-drop: max(
			0px,
			min(
				(var(--home-lead) + var(--home-opener-h) + var(--widget-grid-gap) - var(--home-group-h)) / 2 -
					var(--home-lead),
				var(--home-opener-h) - var(--home-group-h) - var(--home-tile-foot)
			)
		);
		/* Where the word starts in the row: the group's drop, then its own. */
		--home-word-drop: calc(var(--home-center-drop) + var(--home-lockup-drop));
		/* THE PARK: from its cell (the row after, a gap down) up to its place in
		   the centred group. It is also the dock's scroll range (videos.css),
		   which brings the cell to where the card started. */
		--home-dock-travel: calc(
			var(--home-opener-h) + var(--widget-grid-gap) - var(--home-center-drop) -
				var(--home-tile-drop)
		);
		/* THE DRIFT: how far "tristan" rises from its rest before it holds. Enough
		   to read as parallax, not enough to leave the middle. */
		--home-drift: var(--space-6);
		/* The scroll from the sticky line catching the word to the first row
		   arriving under it: the row's height below the word's resting place. */
		--home-word-range: calc(
			var(--home-opener-h) - var(--home-word-drop) - var(--home-word-h)
		);
		/* Where the word rests on the first screen: the header, the lead and the
		   centring down. */
		--home-word-top: calc(
			var(--home-header-h) + var(--home-lead) + var(--home-word-drop)
		);
	}

	/* A printed page has no fold to clear and no scroll to settle over. */
	@media print {
		.home .ds-widget-grid {
			--home-fold: 0px;
		}
	}

	/* THE OPENER: the lockup, across the grid's whole first row, so no card
	   packs into it (its box lets pointers through to the parked carousel; the
	   text opts back in). */
	.home stories-heading {
		grid-column: 1 / -1;
		grid-row: 1;
		/* Over the parked carousel, which "tristan" overlaps on a phone. */
		z-index: 2;
		/* THE LEFT COLUMN: two cells and the gap — "tristan" fills it, the
		   intro is set in it. The third column is the air between it and the
		   carousel in the fourth. */
		--sh-wordmark-w: calc(2 * var(--widget-cell) + var(--widget-grid-gap));
		--sh-sub-w: var(--sh-wordmark-w);
		min-block-size: var(--home-opener-h);
		/* Centred. Padding, inside the row's height, so the sticky word still
		   rides down to the row's foot. */
		padding-block-start: var(--home-word-drop);
		/* The wipe's bounds, in scroll: the longest it plays over where the row
		   allows, and the shortest the drift must leave it. */
		--home-wipe-max: 300px;
		--home-wipe-min: var(--space-12);
		/* HOW FAR IT RISES, which is also the scroll at which the sticky line
		   catches its resting box: --home-drift, unless the row arrives so soon
		   that the slow drift would still be running when it did (a short window).
		   Then only what leaves the wipe its minimum, down to none at all, the word
		   held from the start. A drift of D at rate r ends at D / r, so it spends
		   D(1 − r) / r of --home-word-range. Nor past a step from the top of the
		   window, where a top-anchored word (a short window, a tablet) starts. */
		--sh-pin-at: min(
			var(--home-drift),
			var(--home-word-top) - var(--space-2),
			max(
				0px,
				(var(--home-word-range) - var(--home-wipe-min) - var(--space-5)) *
					var(--sh-drift-rate) / (1 - var(--sh-drift-rate))
			)
		);
		/* HELD NEAR THE MIDDLE: its rest top less the rise. It drifts up from the
		   first pixel of scroll and reaches this line at --sh-pinned-at
		   (stories-heading/styles.css), and THE WIPE starts there (the component's
		   default --sh-wipe-at). */
		--sh-top: calc(var(--home-word-top) - var(--sh-pin-at));
		/* ...and finishes while the word is still held: within the range less the
		   drift's slow start, a step short of the row. */
		--sh-reveal: max(
			var(--space-2),
			min(
				var(--home-wipe-max),
				var(--home-word-range) - (var(--sh-pinned-at) - var(--sh-pin-at)) - var(--space-5)
			)
		);
	}

	/* PHONES AND TABLETS (the grid's compact step, two columns): "tristan" spans
	   both and runs over the top of the carousel's PICTURE, which is parked half
	   a word down the right column. The tile is parked higher than that by the
	   empty band above the picture (--vc-head-band, src/widgets/videos/videos.css;
	   on a narrow phone that puts the tile's box a little above the word, which
	   is nothing to see); "& other stories" and the intro take the left column
	   beside it (centred on the picture: THE COPY ON THE PICTURE'S AXIS, below),
	   and all of it, word to picture, centres as one
	   (--home-group-h). The wipe plays over 100px at most, and the solid layer's
	   backdrop is opaque, so it must never lie over the picture. The word holds
	   half a word above the picture's rest, but the tile sinks faster than the
	   page at first (videos.css) and is clear of the word well before the word
	   pins; it only climbs back as it docks, and the word has to have gone by
	   then. A rise of a quarter of the word's height (more than the fixed drift
	   on the wider steps, where the word is taller) keeps a backdrop's width
	   between them to the end (tests/home-opener.spec.ts holds that clearance
	   through the whole hold). */
	@media (max-width: 900px) {
		.home {
			--home-lead: var(--space-2);
		}
		.home .ds-widget-grid {
			--home-tile-drop: calc(var(--home-word-h) / 2 - var(--vc-head-band));
			--home-tile-foot: var(--vc-foot-band);
			--home-lockup-drop: 0px;
			--home-drift: max(var(--space-6), var(--home-word-h) / 4);
			/* The picture alone, between the tile's two empty bands. */
			--home-picture-h: calc(var(--home-tile-h) - var(--vc-head-band) - var(--home-tile-foot));
		}
		.home stories-heading {
			--sh-sub-w: var(--widget-cell);
			--home-wipe-max: 100px;
		}
	}

	/* THE COPY ON THE PICTURE'S AXIS (the compact step, parked): "& other stories"
	   and the intro, as one block, centred on the picture beside them. The copy's
	   line count varies with the width, so nothing estimates it: .sh__sub is a box
	   SYMMETRIC ABOUT THE PICTURE'S MIDDLE and the copy is centred in it by
	   flexbox. The box starts where the copy always did, a --space-3 margin
	   (stories-heading/styles.css) under the word, which overlaps the picture by
	   half a word, so a box whose top is one margin plus half a word below the
	   picture's top must stop as far above its foot: the picture's height less a
	   word and two margins.
	     Copy taller than that (a narrow phone, a large root font) outgrows the box
	   from the top, so it sits directly under "tristan", as near the middle as it
	   can get without touching the word.
	     Only the picture ON THE SCREEN counts (100svh, so a collapsing browser bar
	   moves nothing): in a short window the picture runs past the fold, and its
	   true middle would put the copy below the fold, where it fades before it is
	   ever seen.
	     The box ends above the picture's foot, so it never adds to the row's
	   height: the opener's arithmetic doesn't see it. Not under reduced motion (the
	   card is docked below and the column beside the copy is empty) or in print
	   (the card's place there depends on where the page was scrolled to), or
	   without scroll timelines (docked below, as under reduced motion): the copy
	   stays directly under the word. */
	@media screen and (max-width: 900px) and (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: scroll()) {
			.home .sh__sub {
				display: flex;
				flex-direction: column;
				justify-content: center;
				min-block-size: max(
					0px,
					min(
						var(--home-picture-h),
						100svh - var(--home-word-top) - var(--home-word-h) / 2
					) - var(--home-word-h) - 2 * var(--space-3)
				);
			}
		}
	}

	/* REDUCED MOTION, OR NO SCROLL TIMELINES: no drift, so nothing to rise
	   through: the word holds where it rests, from the first pixel. */
	@media (prefers-reduced-motion: reduce) {
		.home .ds-widget-grid {
			--home-drift: 0px;
		}
	}
	@supports not (animation-timeline: scroll()) {
		.home .ds-widget-grid {
			--home-drift: 0px;
		}
	}
</style>
