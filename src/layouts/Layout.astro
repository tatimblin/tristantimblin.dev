---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
// Asset-arrival reveal (the motion; the scheduling lives in src/lib/reveal.ts and
// the arming script in this file's <head>).
import "../styles/reveal.css";
// The site's four self-hosted faces, plus the metric-matched fallbacks that keep
// the swap from reflowing the copy.
import "../styles/fonts.css";
// Design-system token cascade (generated DS tokens → site overrides → legacy
// name bridge). Imported after global.css so its custom properties win.
import "@whois/design-system/tokens.css";
// The component styles, once for the whole site: two cascade layers under the
// unlayered site CSS (see packages/design-system/src/styles/index.css).
import "@whois/design-system/styles.css";
import SiteFooter from "../components/SiteFooter.astro";
import Seo from "../components/Seo.astro";

interface Props {
	title?: string;
	description?: string;
	/** Path or absolute URL to the social card; defaults to /og-small.jpg. */
	image?: string;
	/** What the social card shows (og:image:alt). */
	imageAlt?: string;
	/** Ask crawlers to skip this page (e.g. scratch/experiments pages). */
	noindex?: boolean;
	/** Article SEO surface, forwarded to <Seo />. Defaults keep pages as "website". */
	type?: "website" | "article";
	canonical?: string;
	publishDate?: Date;
	modifiedDate?: Date | null;
	tags?: string[];
	/**
	 * Media to preload in <head>, highest-value first. Use for an above-the-fold
	 * asset that JS discovers LATE: <dotted-grid> builds its <video> in
	 * connectedCallback, so without a preload the clip can't even start downloading
	 * until the page bundle has been fetched, parsed and executed. The hero clip is
	 * ~60KB, so the win is in discovery time, not bytes.
	 *
	 * Opt-in per page rather than hardcoded here: a preload for an asset the page
	 * doesn't render is pure waste, and only the homepage has the hero scene.
	 */
	preloadMedia?: Array<{ href: string; as: "video" | "image"; type?: string }>;
}

const {
	title,
	description,
	image,
	imageAlt,
	noindex,
	type,
	canonical,
	publishDate,
	modifiedDate,
	tags,
	preloadMedia = [],
} = Astro.props;
---

<!doctype html>
{/* Dark is the site default. The DS's OKLCH palettes are applied via the
     .maximeheckel-{light,dark} class on <html>; its ThemeProvider is React-only,
     so we manage the class ourselves. The server renders the dark class and the
     inline head script below re-applies any stored choice before first paint, so
     tokens resolve with no JS dependency and no FOUC. */}
<html lang="en" class="maximeheckel-dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		{/* Start above-the-fold media during HTML parse instead of after the page
		     bundle executes (see the preloadMedia prop). First, so it races the
		     stylesheet below rather than queueing behind it. */}
		{
			preloadMedia.map((m) => (
				<link rel="preload" href={m.href} as={m.as} type={m.type} />
			))
		}
		{/* The faces that paint above the fold on EVERY page: the body face
		     (every paragraph), the UI face and its Bold (the header, the hero
		     lede, every heading) and the hero cut of Migra (the wordmark lockup).
		     They are @font-face'd in src/styles/fonts.css, which the browser only
		     discovers after the stylesheet parses — preloading starts the fetch
		     during HTML parse instead, so the swap happens before first scroll
		     rather than after it.

		     `crossorigin` is REQUIRED even though these are same-origin: fonts are
		     always fetched in CORS mode, and a preload without it is treated as a
		     different request, discarded, and fetched a second time.

		     BOTH Migra cuts are here because the hero lockup uses both: the wordmark
		     is set in the medium and the "&" / "other stories" in the bold. Missing
		     either one leaves half the lockup swapping late.

		     Mondwest's Light and Thin are NOT preloaded: they are served but hold no
		     role, so nothing requests them and a preload would be a wasted fetch
		     the browser warns about. Neue Montreal's Semibold is left to normal
		     discovery for the same reason. */}
		<link
			rel="preload"
			href="/fonts/neue-montreal-regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/ppmondwest-regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/fs-mondwest-bold.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/migra-medium.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/migra-bold.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Writing — Tristan Timblin"
			href="/rss.xml"
		/>
		<Seo
			title={title}
			description={description}
			image={image}
			imageAlt={imageAlt}
			noindex={noindex}
			type={type}
			canonical={canonical}
			publishDate={publishDate}
			modifiedDate={modifiedDate}
			tags={tags}
		/>
		{/* No-FOUC theme init: apply the stored choice before first paint, and
		     re-apply after each view-transition swap. Dark is the fallback. */}
		<script is:inline>
			(function () {
				function apply() {
					var t = localStorage.getItem("theme") === "light" ? "light" : "dark";
					var r = document.documentElement;
					r.classList.remove("maximeheckel-light", "maximeheckel-dark");
					r.classList.add("maximeheckel-" + t);
				}
				apply();
				document.addEventListener("astro:after-swap", apply);
			})();
		</script>
		{/* ARM THE ASSET REVEAL. src/styles/reveal.css only hides a [data-reveal]
		     element while this class is present, so the class IS the opt-in and its
		     removal is the universal escape hatch.

		     Deliberately inline, dependency-free, and in <head>: every page bundles
		     its custom elements into one module, so a single parse error there would
		     take out the coordinator too. The timeout below is the only part of the
		     mechanism outside that blast radius — it guarantees content appears even
		     if no module ever runs. It must never be turned into an import.

		     Not armed at all when the visitor asked for less motion or less data, or
		     when IntersectionObserver is missing (the coordinator gates on it), so
		     those visitors get the content immediately with no machinery involved.

		     Armed on the initial hard load ONLY — no astro:after-swap hook, unlike
		     the theme script above. Internal navigations run against warm caches, so
		     re-arming would blink already-decoded content on every click. */}
		<script is:inline>
			(function () {
				if (window.__revealArmed) return;
				try {
					var m = window.matchMedia;
					if (m && m("(prefers-reduced-motion: reduce)").matches) return;
					if (!("IntersectionObserver" in window)) return;
					var c = navigator.connection;
					if (c && c.saveData === true) return;
				} catch (e) {
					// A throw in feature detection must not leave the page armed with
					// nothing able to disarm it.
					return;
				}
				window.__revealArmed = true;
				var root = document.documentElement;
				root.classList.add("reveal-armed");
				// Terminality backstop. 3s is past the p95 for a below-the-fold decode,
				// and short enough that a broken bundle costs a blink, not a blank page.
				setTimeout(function () {
					root.classList.remove("reveal-armed");
				}, 3000);
			})();
		</script>
		<ClientRouter />
	</head>
	<body>
		<slot />
		<SiteFooter />
		<script>
			// Reveal coordinator: schedules the [data-reveal] fades. Safe to load late —
			// the inline arming script in <head> owns the fail-visible backstop, so if this
			// module never arrives the page simply shows everything.
			import "../lib/reveal";
			import Lenis from "lenis";
			import "lenis/dist/lenis.css";

			declare global {
				interface Window {
					__lenis?: Lenis;
				}
			}

			// Smooth scroll, initialized once and shared across view-transition
			// navigations. Lenis drives the real window scroll (no transform hack), so it
			// composes with the scroll-listener web components (stories-heading,
			// video-carousel) without changes to them.
			function initLenis() {
				if (window.__lenis) return window.__lenis;
				// Honor reduced-motion: leave native scrolling untouched.
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return null;

				// Wheel/trackpad only. Lenis 1.x keeps touch native (syncTouch off), so on a
				// touch device it smooths NOTHING — yet the raf() loop below would still run
				// every frame forever, a pure main-thread/battery cost with no visual payoff.
				// Gate on a fine pointer so phones and tablets never start that loop; desktop
				// wheel/trackpad smoothing is unchanged.
				if (!window.matchMedia("(pointer: fine)").matches) return null;

				// Subtle smoothing, close to native.
				const lenis = new Lenis({ lerp: 0.18, smoothWheel: true });
				window.__lenis = lenis;

				function raf(time: number) {
					lenis.raf(time);
					requestAnimationFrame(raf);
				}
				requestAnimationFrame(raf);
				return lenis;
			}

			initLenis();

			// After a view-transition swap, re-measure the new page and reset to top.
			document.addEventListener("astro:after-swap", () => {
				const lenis = window.__lenis;
				if (!lenis) return;
				lenis.scrollTo(0, { immediate: true });
				lenis.resize();
			});
		</script>
	</body>
</html>
