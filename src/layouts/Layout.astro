---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
// Design-system token cascade (generated DS tokens → site overrides → legacy
// name bridge). Imported after global.css so its custom properties win.
import "@whois/design-system/tokens.css";

interface Props {
	title?: string;
}

const { title = "The Hidden Girl" } = Astro.props;
---


<script>
	import "scroll-timeline-polyfill/dist/scroll-timeline.js";
</script>

<!doctype html>
<!-- The design system's light OKLCH palette is applied via this static class
     (its ThemeProvider is React-only; we don't ship it). Tokens resolve at
     first paint with no JS and no FOUC. -->
<html lang="en" class="maximeheckel-light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- DS fonts (Inter, Fira Code, Space Grotesk) + the site's own faces
		     (Playfair Display for the wordmark/copy, Quintessential for the
		     decorative outline). The DS package ships no font files. -->
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;560;600&family=Fira+Code:wght@400;500&family=Space+Grotesk:wght@400;500&family=Playfair+Display:wght@400;600;700&family=Quintessential&display=swap"
		/>
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>
