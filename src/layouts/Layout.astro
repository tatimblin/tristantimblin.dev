---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
// Design-system token cascade (generated DS tokens → site overrides → legacy
// name bridge). Imported after global.css so its custom properties win.
import "@whois/design-system/tokens.css";
import SiteFooter from "../components/SiteFooter.astro";
import Seo from "../components/Seo.astro";

interface Props {
	title?: string;
	description?: string;
	/** Path or absolute URL to the social card; defaults to /og.png. */
	image?: string;
	/** Ask crawlers to skip this page (e.g. scratch/experiments pages). */
	noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---


<script>
	import "scroll-timeline-polyfill/dist/scroll-timeline.js";
	import Lenis from "lenis";
	import "lenis/dist/lenis.css";

	declare global {
		interface Window {
			__lenis?: Lenis;
		}
	}

	// Smooth scroll, initialized once and shared across view-transition
	// navigations. Lenis drives the real window scroll (no transform hack), so it
	// composes with the scroll-timeline polyfill and the scroll-listener web
	// components (stories-heading, video-carousel) without changes to them.
	function initLenis() {
		if (window.__lenis) return window.__lenis;
		// Honor reduced-motion: leave native scrolling untouched.
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return null;

		// Subtle smoothing, close to native. Touch stays native by default in
		// Lenis 1.x (syncTouch is off), so this is desktop wheel/trackpad only.
		const lenis = new Lenis({ lerp: 0.18, smoothWheel: true });
		window.__lenis = lenis;

		function raf(time) {
			lenis.raf(time);
			requestAnimationFrame(raf);
		}
		requestAnimationFrame(raf);
		return lenis;
	}

	initLenis();

	// After a view-transition swap, re-measure the new page and reset to top.
	document.addEventListener("astro:after-swap", () => {
		const lenis = window.__lenis;
		if (!lenis) return;
		lenis.scrollTo(0, { immediate: true });
		lenis.resize();
	});
</script>

<!doctype html>
<!-- Dark is the site default. The DS's OKLCH palettes are applied via the
     .maximeheckel-{light,dark} class on <html>; its ThemeProvider is React-only,
     so we manage the class ourselves. The server renders the dark class and the
     inline head script below re-applies any stored choice before first paint, so
     tokens resolve with no JS dependency and no FOUC. -->
<html lang="en" class="maximeheckel-dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- DS fonts (Inter, Fira Code, Space Grotesk) + the site's own faces
		     (Playfair Display for the wordmark/copy, Quintessential for the
		     decorative outline). The DS package ships no font files. -->
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;560;600&family=Fira+Code:wght@400;500&family=Space+Grotesk:wght@400;500&family=Playfair+Display:wght@400;600;700&family=Quintessential&display=swap"
		/>
		<Seo title={title} description={description} image={image} noindex={noindex} />
		<!-- No-FOUC theme init: apply the stored choice before first paint, and
		     re-apply after each view-transition swap. Dark is the fallback. -->
		<script is:inline>
			(function () {
				function apply() {
					var t = localStorage.getItem("theme") === "light" ? "light" : "dark";
					var r = document.documentElement;
					r.classList.remove("maximeheckel-light", "maximeheckel-dark");
					r.classList.add("maximeheckel-" + t);
				}
				apply();
				document.addEventListener("astro:after-swap", apply);
			})();
		</script>
		<ClientRouter />
	</head>
	<body>
		<slot />
		<SiteFooter />
	</body>
</html>
