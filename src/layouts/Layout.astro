---
import type { ComponentProps } from "astro/types";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
// Asset-arrival reveal (the motion; the scheduling lives in src/lib/reveal.ts and
// the arming script in this file's <head>).
import "../styles/reveal.css";
// The site's two self-hosted faces (DM Sans, Roboto Mono), plus the
// metric-matched fallbacks that keep the swap from reflowing the copy.
import "../styles/fonts.css";
// Per-theme <dotted-grid> tone presets (--dg-* variables): hero, carousel, footer clip.
import "../styles/halftone.css";
// Design-system token cascade (generated DS tokens → site overrides → legacy
// name bridge). Imported after global.css so its custom properties win.
import "@whois/design-system/tokens.css";
// The component styles, once for the whole site: two cascade layers under the
// unlayered site CSS (see theme/design-system/src/styles/index.css).
import "@whois/design-system/styles.css";
import SiteFooter from "../components/SiteFooter.astro";
import Seo from "../components/Seo.astro";
import { MEDIA_BASE } from "../lib/media";
import { normalisePath } from "../lib/analytics/path";

type Props = ComponentProps<typeof Seo> & {
	/** The site footer; a full-screen page (a demo) leaves it out. */
	footer?: boolean;
	/** The path this page is counted under (src/lib/analytics/count.ts).
	 *  Defaults to the page's own; the 404 page sets one for every miss. */
	hitPath?: string;
};

const { footer = true, hitPath, ...seo } = Astro.props;
const hit = normalisePath(hitPath ?? Astro.url.pathname);
if (!hit) throw new Error(`Layout: "${hitPath ?? Astro.url.pathname}" is not a countable path.`);
---

<!doctype html>
{/* Light is the site default. The theme is the data-theme attribute on <html>
     (light | dark), which the token layer keys off (tokens/themes/*.css). The
     server renders light and the inline head script below re-applies any stored
     choice before first paint, so tokens resolve with no JS dependency and no
     FOUC. */}
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		{/* The path GoatCounter counts this page under, read by
		     src/lib/analytics/count.ts on every page load (hard or soft). */}
		<meta name="hit-path" content={hit} />
		{/* Preload the faces every page paints above the fold, so the swap lands
		     before first scroll rather than after fonts.css is parsed: the body
		     face's Regular and DM Sans Medium (the hero lockup and headings).
		     `crossorigin` is required even same-origin — fonts fetch in CORS mode,
		     and a preload without it is discarded and fetched twice. Unused cuts
		     are left out on purpose. */}
		<link
			rel="preload"
			href="/fonts/RobotoMono-400-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/DMSans-500-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		{/* The videos come from R2 (src/lib/media.ts) in CORS mode, so the
		     preconnect needs `crossorigin` to be the connection they reuse. */}
		<link rel="preconnect" href={MEDIA_BASE} crossorigin />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Writing — Tristan Timblin"
			href="/rss.xml"
		/>
		<Seo {...seo} />
		{/* No-FOUC theme init: apply the stored choice before first paint, and
		     re-apply after each view-transition swap. Light is the fallback.
		     window.__setTheme is the one attribute write; the footer toggle calls
		     it too (inline, so it cannot be an import). */}
		<script is:inline>
			(function () {
				window.__setTheme = function (t) {
					document.documentElement.setAttribute("data-theme", t === "dark" ? "dark" : "light");
				};
				function stored() {
					try {
						return localStorage.getItem("theme");
					} catch (e) {
						return null;
					}
				}
				function apply() {
					window.__setTheme(stored() === "dark" ? "dark" : "light");
				}
				apply();
				document.addEventListener("astro:after-swap", apply);
			})();
		</script>
		{/* Arm the asset reveal: reveal.css hides [data-reveal] only while
		     .reveal-armed is on <html>. Inline and import-free on purpose, so a
		     broken bundle can't strand the page — the timeout always disarms.
		     Skipped for reduced motion, save-data or no IntersectionObserver.
		     Hard loads only: re-arming on a swap would blink cached content. */}
		<script is:inline>
			(function () {
				if (window.__revealArmed) return;
				try {
					var m = window.matchMedia;
					if (m && m("(prefers-reduced-motion: reduce)").matches) return;
					if (!("IntersectionObserver" in window)) return;
					var c = navigator.connection;
					if (c && c.saveData === true) return;
				} catch (e) {
					// A throw in feature detection must not leave the page armed with
					// nothing able to disarm it.
					return;
				}
				window.__revealArmed = true;
				var root = document.documentElement;
				root.classList.add("reveal-armed");
				// Terminality backstop. 3s is past the p95 for a below-the-fold decode,
				// and short enough that a broken bundle costs a blink, not a blank page.
				setTimeout(function () {
					root.classList.remove("reveal-armed");
				}, 3000);
			})();
		</script>
		<ClientRouter />
	</head>
	<body>
		<slot />
		{footer && <SiteFooter />}
		<script>
			// Reveal coordinator: schedules the [data-reveal] fades. Safe to load late —
			// the inline arming script in <head> owns the fail-visible backstop, so if this
			// module never arrives the page simply shows everything.
			import "../lib/reveal";
			import Lenis from "lenis";
			import "lenis/dist/lenis.css";
			// Page-view counting: GoatCounter, on the production host only.
			import { startCounting } from "../lib/analytics/count";

			startCounting();

			declare global {
				interface Window {
					__lenis?: Lenis;
					/** Set data-theme on <html> (defined inline in <head>). */
					__setTheme: (theme: "light" | "dark") => void;
				}
			}

			// Smooth scroll, initialized once and shared across view-transition
			// navigations. Lenis drives the real window scroll (no transform hack), so it
			// composes with the scroll-listener web components (stories-heading,
			// video-carousel) without changes to them.
			function initLenis() {
				if (window.__lenis) return window.__lenis;
				// Honor reduced-motion: leave native scrolling untouched.
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return null;

				// Wheel/trackpad only. Lenis 1.x keeps touch native (syncTouch off), so on a
				// touch device it smooths NOTHING — yet the raf() loop below would still run
				// every frame forever, a pure main-thread/battery cost with no visual payoff.
				// Gate on a fine pointer so phones and tablets never start that loop; desktop
				// wheel/trackpad smoothing is unchanged.
				if (!window.matchMedia("(pointer: fine)").matches) return null;

				// Subtle smoothing, close to native.
				const lenis = new Lenis({ lerp: 0.18, smoothWheel: true });
				window.__lenis = lenis;

				function raf(time: number) {
					lenis.raf(time);
					requestAnimationFrame(raf);
				}
				requestAnimationFrame(raf);
				return lenis;
			}

			initLenis();

			// After a view-transition swap, re-measure the new page and reset to top.
			document.addEventListener("astro:after-swap", () => {
				const lenis = window.__lenis;
				if (!lenis) return;
				lenis.scrollTo(0, { immediate: true });
				lenis.resize();
			});
		</script>
	</body>
</html>
