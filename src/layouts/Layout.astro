---
import type { ComponentProps } from "astro/types";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
// The site's two self-hosted faces (DM Sans, Roboto Mono), plus the
// metric-matched fallbacks that keep the swap from reflowing the copy.
import "../styles/fonts.css";
// Per-theme <dotted-grid> tone presets (--dg-* variables): section hero, videos card.
import "../styles/halftone.css";
// Design-system token cascade (generated DS tokens → site overrides → legacy
// name bridge). Imported after global.css so its custom properties win.
import "@whois/design-system/tokens.css";
// The component styles, once for the whole site: two cascade layers under the
// unlayered site CSS (see theme/design-system/src/styles/index.css).
import "@whois/design-system/styles.css";
import SiteFooter from "../components/SiteFooter.astro";
import Seo from "../components/Seo.astro";
import { MEDIA_BASE } from "../lib/media";
import { normalisePath } from "../lib/analytics/path";

type Props = ComponentProps<typeof Seo> & {
	/** The site footer; a full-screen page (a demo) leaves it out. */
	footer?: boolean;
	/** The path this page is counted under (src/lib/analytics/count.ts).
	 *  Defaults to the page's own; the 404 page sets one for every miss. */
	hitPath?: string;
};

const { footer = true, hitPath, ...seo } = Astro.props;
const hit = normalisePath(hitPath ?? Astro.url.pathname);
if (!hit) throw new Error(`Layout: "${hitPath ?? Astro.url.pathname}" is not a countable path.`);
---

<!doctype html>
{/* Light is the site default. The theme is the data-theme attribute on <html>
     (light | dark), which the token layer keys off (tokens/themes/*.css). The
     server renders light and the inline head script below re-applies any stored
     choice before first paint, so tokens resolve with no JS dependency and no
     FOUC. */}
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		{/* The path GoatCounter counts this page under, read by
		     src/lib/analytics/count.ts on every page load (hard or soft). */}
		<meta name="hit-path" content={hit} />
		{/* Preload the faces every page paints above the fold, so the swap lands
		     before first scroll rather than after fonts.css is parsed: the body
		     face's Regular and DM Sans Medium (the hero lockup and headings).
		     `crossorigin` is required even same-origin — fonts fetch in CORS mode,
		     and a preload without it is discarded and fetched twice. Unused cuts
		     are left out on purpose. */}
		<link
			rel="preload"
			href="/fonts/RobotoMono-400-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/DMSans-500-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		{/* The videos come from R2 (src/lib/media.ts) in CORS mode, so the
		     preconnect needs `crossorigin` to be the connection they reuse. */}
		<link rel="preconnect" href={MEDIA_BASE} crossorigin />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Writing — Tristan Timblin"
			href="/rss.xml"
		/>
		<Seo {...seo} />
		{/* No-FOUC theme init: apply the stored choice before first paint, and
		     re-apply after each view-transition swap. Light is the fallback.
		     window.__setTheme is the one attribute write; the footer toggle calls
		     it too (inline, so it cannot be an import). */}
		<script is:inline>
			(function () {
				window.__setTheme = function (t) {
					document.documentElement.setAttribute("data-theme", t === "dark" ? "dark" : "light");
				};
				function stored() {
					try {
						return localStorage.getItem("theme");
					} catch (e) {
						return null;
					}
				}
				function apply() {
					window.__setTheme(stored() === "dark" ? "dark" : "light");
				}
				apply();
				document.addEventListener("astro:after-swap", apply);
			})();
		</script>
		<slot name="head" />
		<ClientRouter />
	</head>
	<body>
		<slot />
		{footer && <SiteFooter />}
		<script>
			// Page-view counting: GoatCounter, on the production host only.
			import { startCounting } from "../lib/analytics/count";
			// No halftone decodes video in a background tab.
			import { pauseHalftonesWhileHidden } from "../lib/pause-hidden";

			startCounting();
			pauseHalftonesWhileHidden();

			declare global {
				interface Window {
					/** Set data-theme on <html> (defined inline in <head>). */
					__setTheme: (theme: "light" | "dark") => void;
				}
			}
		</script>
	</body>
</html>
