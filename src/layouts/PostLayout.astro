---
// PostLayout — the reading page for a /txt post, on BlogLayout's wide
// column: one four-column grid (--ruled-columns / --ruled-gap, the tokens the
// ruled Prose reads too, so the page's rows and the body's sections fall on
// the same lines), one column below 1024.
//
// The body arrives via <slot /> already sectioned and mapped to DS components
// (src/components/mdx-components.ts, applied in txt/[slug].astro). `image` is
// the social card only; `hero` is the figure on the page.
import type { ImageMetadata } from "astro";
import BlogLayout from "./BlogLayout.astro";
import Img from "../components/mdx/Img.astro";
import Anchor from "@whois/design-system/Anchor";
import Fig from "@whois/design-system/Fig";
import Grid from "@whois/design-system/Grid";
import Heading from "@whois/design-system/Heading";
import Index from "@whois/design-system/Index";
import IndexRow from "@whois/design-system/IndexRow";
import Text from "@whois/design-system/Text";
import Mono from "@whois/design-system/Mono";
import Prose from "@whois/design-system/Prose";
import {
	categories,
	dottedDate,
	filedDate,
	isoDate,
	padNo,
	tagHref,
	type CategoryId,
} from "../lib/blog";

/** A neighbouring post, as the index at the foot lists it. */
export interface Neighbour {
	title: string;
	href: string;
	date: Date;
	/** Its chronological number. */
	no: number;
}

/** The post's hero image, from its frontmatter: the collection resolves the
 *  path to the import (width, height, format), which the page hands to
 *  <Picture>. */
export interface Hero {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}

interface Props {
	title: string;
	description?: string;
	category?: CategoryId;
	tags?: string[];
	date: Date;
	modified?: Date | null;
	/** The social card, and what it shows. Not shown on the page. */
	image?: string;
	imageAlt?: string;
	canonical?: string;
	/** The post's chronological number, and how many there are. */
	no: number;
	total: number;
	stats: { words: number; minutes: number };
	hero?: Hero | null;
	prev?: Neighbour | null;
	next?: Neighbour | null;
}

const {
	title,
	description,
	category,
	tags = [],
	date,
	modified,
	image,
	imageAlt,
	canonical,
	no,
	stats,
	hero = null,
	prev = null,
	next = null,
} = Astro.props;

const cat = category ? categories[category] : null;
const COLUMNS = "var(--ruled-columns)";

/** The two neighbour rows of the index: the older post, then the newer. */
const neighbourRows = [
	{ key: "prev", label: "← previous", post: prev, none: "Nothing older" },
	{ key: "next", label: "next →", post: next, none: "Nothing newer" },
] as const;
---

<BlogLayout
	wide
	type="article"
	title={title}
	description={description}
	image={image}
	imageAlt={imageAlt}
	canonical={canonical}
	publishDate={date}
	modifiedDate={modified}
	tags={tags}
>
	<article class="post" data-post>
		<Grid templateColumns={COLUMNS} gapX={4} class="post__strip" data-post-strip>
			<Mono tone="primary" class="post__cell post__no">txt / {padNo(no)}</Mono>
			{cat && category ? (
				<Mono class="post__cell post__category">{cat.label}</Mono>
			) : (
				<span class="post__cell" />
			)}
			<Mono class="post__cell post__stats">
				{stats.minutes} min · {stats.words.toLocaleString("en-US")} words
			</Mono>
			<Mono
				as="time"
				tone="primary"
				datetime={isoDate(date)}
				class="post__cell post__cell--end post__date"
			>
				{dottedDate(date)}
			</Mono>
		</Grid>

		<Grid templateColumns={COLUMNS} gapX={4} class="post__colnos" aria-hidden="true">
			{["01", "02", "03", "04"].map((n) => (
				<Mono>{n}</Mono>
			))}
		</Grid>

		<Grid as="header" templateColumns={COLUMNS} gapX={4} class="post__head">
			<Heading as="h1" size={6} responsive class="post__title">{title}</Heading>
			{description && (
				<Text as="p" size={5} responsive variant="primary" family="ui" class="post__lead">
					{description}
				</Text>
			)}
		</Grid>

		{hero && (
			<Fig no="01" caption={hero.caption ?? hero.alt} layout="ruled" class="post__fig" data-post-hero="">
				<Img src={hero.src} alt={hero.alt} priority />
			</Fig>
		)}

		<Prose variant="ruled" class="post__prose">
			<slot />
		</Prose>

		<Index class="post__index" aria-label="Index" data-post-index="">
			<IndexRow head>
				<Mono>index</Mono>
				<Mono>no.</Mono>
				<Mono>title</Mono>
				<Mono class="ds-index__fold">filed</Mono>
			</IndexRow>
			<IndexRow data-index-row="tags">
				<Mono>tags</Mono>
				<Mono tone="primary">{padNo(no)}</Mono>
				<Mono tone="primary" class="ds-index__span">
					{tags.length > 0
						? tags.map((tag, i) => (
								<Fragment>
									{i > 0 && " · "}
									<Anchor variant="ink" href={tagHref(tag)}>{tag.replace(/[-_]+/g, " ")}</Anchor>
								</Fragment>
							))
						: "—"}
				</Mono>
			</IndexRow>
			{neighbourRows.map(({ key, label, post, none }) =>
				post ? (
					<IndexRow data-index-row={key}>
						<Mono>{label}</Mono>
						<Mono tone="primary">{padNo(post.no)}</Mono>
						<Anchor variant="ink" href={post.href} class="ds-index__title" data-neighbour={key}>
							{post.title}
						</Anchor>
						<Mono class="ds-index__fold">
							<time datetime={isoDate(post.date)}>{filedDate(post.date)}</time>
						</Mono>
					</IndexRow>
				) : (
					<IndexRow dim data-index-row={key}>
						<Mono>{label}</Mono>
						<Mono>—</Mono>
						<Text as="span" size={3} variant="tertiary" class="ds-index__title">
							{none}
						</Text>
						<Mono class="ds-index__fold">—</Mono>
					</IndexRow>
				),
			)}
		</Index>
	</article>
</BlogLayout>

<style>
	/* THE GRID. Four columns a step apart, the tokens the ruled Prose reads
	   too, so the page's rows and the sections fall on the same lines. The
	   page's headings — the title here, the section heads through Prose — on
	   the UI face at its Medium, by the heading tokens in scope. */
	.post {
		--ruled-columns: repeat(4, minmax(0, 1fr));
		--ruled-gap: var(--space-4);
		--font-heading: var(--font-ui);
		--font-heading-weight: var(--font-weight-500);
	}

	/* THE STATUS STRIP. One row between the strong hairlines, the date on
	   the right edge. */
	.post__strip {
		margin-block-start: var(--space-10);
		border-block: var(--border);
	}
	.post__cell {
		padding-block: var(--space-2);
		min-inline-size: 0;
	}
	.post__cell--end {
		text-align: end;
	}

	/* THE COLUMN NUMBERS: tiny, over the columns, a step under the strip. */
	.post__colnos {
		margin-block-start: var(--space-8);
	}

	/* THE TITLE AND THE LEAD. The title at the display step (72px, 44px
	   below 1024) across three columns, balanced so two lines share the
	   words; the lead a step down in the second and third. */
	.post__title {
		grid-column: 1 / span 3;
		grid-row: 1;
		margin-block-start: var(--space-5);
		text-wrap: balance;
		overflow-wrap: anywhere;
	}
	.post__lead {
		grid-column: 2 / span 2;
		grid-row: 2;
		margin-block-start: var(--space-8);
		/* The UI leading: a step under the heading it follows, above the body's. */
		line-height: var(--line-height-ui);
	}

	/* THE HERO (a ruled Fig) and THE INDEX (an Index): their rows are the
	   components'; the page places them. */
	.post__fig {
		margin: var(--space-11) 0 0;
	}
	.post__index {
		margin-block-start: var(--space-12);
	}

	/* ONE COLUMN, below the desktop step: the strip two by two (the date
	   still on the right edge), no column numbers, the title a step down,
	   the hero and the table full
	   width. The table keeps three columns — label, number, title — and the
	   FILED cell drops under the title (the header's is not drawn). */
	@media (max-width: 1023px) {
		.post {
			--ruled-columns: minmax(0, 1fr);
		}
		/* The strip two by two, read as two label/value lines: the number
		   and the date on the first, the category and the reading time on
		   the second, the right-hand cells on the right edge. */
		.post__strip {
			--ruled-columns: repeat(2, minmax(0, 1fr));
		}
		.post__date {
			order: 1;
		}
		.post__category,
		.post__strip > .post__cell:nth-child(2) {
			order: 2;
		}
		.post__stats {
			order: 3;
			text-align: end;
		}
		.post__colnos {
			display: none;
		}
		.post__title {
			grid-column: 1;
			grid-row: auto;
			text-wrap: pretty;
		}
		.post__lead {
			grid-column: 1;
			grid-row: auto;
			margin-block-start: var(--space-5);
		}
		.post__fig {
			margin-block-start: var(--space-9);
		}
	}
	/* Phone: the strip sits right under <main>'s top pad (BlogLayout), so
	   the post starts in the first screen, not after a band of nothing. */
	@media (max-width: 639px) {
		.post__strip {
			margin-block-start: 0;
		}
	}
</style>
