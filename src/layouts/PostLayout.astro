---
// PostLayout — the reading page for a /txt post, on BlogLayout's wide
// column: one four-column grid (--ruled-columns / --ruled-gap, the tokens the
// ruled Prose reads too, so the page's rows and the body's sections fall on
// the same lines), one column below 1024.
//
// The body arrives via <slot /> already sectioned and mapped to DS components
// (src/components/mdx-components.ts, applied in txt/[slug].astro). `image` is
// the social card only; `hero` is the figure on the page.
import type { ImageMetadata } from "astro";
import BlogLayout from "./BlogLayout.astro";
import Img from "../components/mdx/Img.astro";
import Fig from "@whois/design-system/Fig";
import Grid from "@whois/design-system/Grid";
import Heading from "@whois/design-system/Heading";
import Card from "@whois/design-system/Card";
import CardBody from "@whois/design-system/CardBody";
import Stat from "@whois/design-system/Stat";
import Chip from "@whois/design-system/Chip";
import Text from "@whois/design-system/Text";
import Mono from "@whois/design-system/Mono";
import Anchor from "@whois/design-system/Anchor";
import VisuallyHidden from "@whois/design-system/VisuallyHidden";
import Prose from "@whois/design-system/Prose";
import {
	categories,
	longDate,
	filedDate,
	isoDate,
	padNo,
	tagHref,
	type CategoryId,
} from "../lib/blog";

/** A neighbouring post, as the foot card links it. */
export interface Neighbour {
	title: string;
	href: string;
	date: Date;
}

/** The post's hero image, from its frontmatter: the collection resolves the
 *  path to the import (width, height, format), which the page hands to
 *  <Picture>. */
export interface Hero {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}

interface Props {
	title: string;
	description?: string;
	category?: CategoryId;
	tags?: string[];
	date: Date;
	modified?: Date | null;
	/** The social card, and what it shows. Not shown on the page. */
	image?: string;
	imageAlt?: string;
	canonical?: string;
	/** The post's slug: the last step of the header's path. */
	slug: string;
	/** The post's chronological number, and how many there are. */
	no: number;
	total: number;
	stats: { words: number; minutes: number };
	/** "212 reads" (src/lib/pageviews.ts formatReads), or null to leave it off. */
	reads?: string | null;
	hero?: Hero | null;
	/** One link under the lede: where to get what the post introduces. */
	cta?: { label: string; href: string } | null;
	prev?: Neighbour | null;
	next?: Neighbour | null;
}

const {
	title,
	description,
	category,
	tags = [],
	date,
	modified,
	image,
	imageAlt,
	canonical,
	slug,
	no,
	total,
	stats,
	reads = null,
	hero = null,
	cta = null,
	prev = null,
	next = null,
} = Astro.props;

const cat = category ? categories[category] : null;
/** The title split so every hyphenated word ("sub-human") is an odd run,
 *  set unbreakable: a name never breaks at its hyphen. */
const titleRuns = title.split(/(\S+-\S+)/);
const COLUMNS = "var(--ruled-columns)";

/** The two halves of the foot card: the older post on the left, the newer on
 *  the right, each pointing the way it goes. */
const neighbours = [
	{ key: "prev", label: "← Older", post: prev, none: "This is the first post" },
	{ key: "next", label: "Newer →", post: next, none: "This is the latest post" },
] as const;
---

<BlogLayout
	wide
	type="article"
	title={`${title} — Tristan Timblin`}
	headline={title}
	description={description}
	image={image}
	imageAlt={imageAlt}
	canonical={canonical}
	publishDate={date}
	modifiedDate={modified}
	tags={tags}
	wordCount={stats.words}
	trail={[{ label: "txt", href: "/txt/" }, { label: slug, slug: true }]}
>
	<article class="post" data-post>
		<Grid as="header" templateColumns={COLUMNS} gapX={4} class="post__head">
			<Heading as="h1" size={5} responsive class="post__title">{titleRuns.map((run, i) =>
				i % 2 ? <span class="post__nobreak">{run}</span> : run
			)}</Heading>
		{/* THE DETAILS: a DS Card of Stat pairs (value over its label), in
		    the first column beside the lead on desktop, between the title and
		    the lead below 1024. */}
		<Card class="post__strip" data-post-strip>
			<CardBody class="post__facts">
				<Stat label="Date"><time datetime={isoDate(date)} class="post__date">{longDate(date)}</time></Stat>
				{cat && category && <Stat label="Topic"><span class="post__category">{cat.label}</span></Stat>}
				<Stat label="Length">
					{/* Unbreakable runs with breaks between them, so a narrow cell
					    wraps a run onto a second line, never mid-figure. */}
					<span class="post__stats" data-post-stats><span class="post__run">{stats.minutes} min</span> <span class="post__run">· {stats.words.toLocaleString("en-US")} words</span>{reads && (
						<Fragment> <span class="post__run post__reads" data-post-reads>· {reads}</span></Fragment>
					)}</span>
				</Stat>
			</CardBody>
		</Card>
			{(description || cta) && (
				<div class="post__intro">
					{description && (
						<Text as="p" size={6} responsive variant="secondary" family="ui" class="post__lead">
							{description}
						</Text>
					)}
					{cta && (
						<Anchor href={cta.href} arrow="right" class="post__cta" data-post-cta="">
							<Mono>{cta.label}</Mono>
						</Anchor>
					)}
				</div>
			)}
			{/* THE HERO, in the head's grid: with one, the lead goes under the
			    title and the details card into the hero's first column, over
			    its Fig. 01 — the column the figure leaves empty. */}
			{hero && (
				<Fig no="01" caption={hero.caption ?? hero.alt} layout="ruled" class="post__fig" data-post-hero="">
					<Img src={hero.src} alt={hero.alt} priority />
				</Fig>
			)}
		</Grid>

		<Prose variant="ruled" class="post__prose">
			<slot />
		</Prose>
		{/* Where a code block's COPY says it worked, for a screen reader: the
		    button's own label changing is not announced. */}
		<VisuallyHidden as="p" aria-live="polite" data-code-copy-status="" />

		{/* THE FOOT: a panel, "keep reading". Its body is the two neighbours,
		     side by side — each half one big link: which way it goes, the title,
		     the month — and its foot the post's tags as chip links. Where there
		     is no neighbour the half says so, dimmed, and links nowhere. */}
		<Card as="nav" class="post-more" aria-label="Keep reading" data-post-more="" title="Keep reading">
			<Mono slot="meta" tone="tertiary" class="post-more__count">
				txt / {padNo(no)} of {padNo(total)}
			</Mono>
			<div class="post-more__pair">
				{neighbours.map(({ key, label, post, none }) =>
					post ? (
						<a
							class={`post-more__half post-more__half--${key} ds-control`}
							href={post.href}
							data-half={key}
							data-neighbour={key}
						>
							<Mono class="post-more__dir">{label}</Mono>
							<Text as="span" size={3} class="post-more__title">{post.title}</Text>
							<Mono tone="tertiary" class="post-more__date">
								<time datetime={isoDate(post.date)}>{filedDate(post.date)}</time>
							</Mono>
						</a>
					) : (
						<div class={`post-more__half post-more__half--${key} post-more__half--none`} data-half={key}>
							<Mono tone="tertiary" class="post-more__dir">{label}</Mono>
							<Text as="span" size={3} variant="tertiary" class="post-more__title">{none}</Text>
						</div>
					),
				)}
			</div>
			{tags.length > 0 && (
				<div class="post-more__tags" data-half="tags">
					<Mono tone="tertiary">Tagged</Mono>
					<ul class="post-more__chips">
						{tags.map((tag) => (
							<li>
								<Chip as="a" href={tagHref(tag)}>{tag.replace(/[-_]+/g, " ")}</Chip>
							</li>
						))}
					</ul>
				</div>
			)}
		</Card>
	</article>
</BlogLayout>

<script>
	// COPY on a code block (the header the sections plugin builds,
	// src/lib/mdx/post-sections.ts): shown only where the clipboard is there to
	// write to, it copies the block's text and reads COPIED for a moment.
	import { onPage } from "@whois/design-system/lib/lifecycle";

	const RESET_MS = 2000;

	onPage(() => {
		if (!navigator.clipboard?.writeText) return;
		const status = document.querySelector<HTMLElement>("[data-code-copy-status]");
		const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-code-copy]"));
		const timers = new Map<HTMLButtonElement, number>();

		const onClick = async (event: Event) => {
			const button = event.currentTarget as HTMLButtonElement;
			const code = button.closest("figure")?.querySelector("pre")?.textContent ?? "";
			try {
				await navigator.clipboard.writeText(code);
			} catch {
				return;
			}
			button.textContent = "Copied";
			if (status) status.textContent = "Copied to clipboard";
			clearTimeout(timers.get(button));
			timers.set(
				button,
				window.setTimeout(() => {
					button.textContent = "Copy";
					if (status) status.textContent = "";
				}, RESET_MS),
			);
		};

		for (const button of buttons) {
			button.hidden = false;
			button.addEventListener("click", onClick);
		}
		return () => {
			for (const button of buttons) button.removeEventListener("click", onClick);
			for (const timer of timers.values()) clearTimeout(timer);
		};
	});
</script>

<style>
	/* THE GRID. Four columns a step apart, the tokens the ruled Prose reads
	   too, so the page's rows and the sections fall on the same lines. The
	   page's headings — the title here, the section heads through Prose — on
	   the UI face at its Medium, by the heading tokens in scope. */
	.post {
		--ruled-columns: repeat(4, minmax(0, 1fr));
		--ruled-gap: var(--space-4);
		--font-heading: var(--font-ui);
		--font-heading-weight: var(--font-weight-500);
	}

	/* THE DETAILS. The Card is the DS's; the page only places it — the first
	   column, level with the lead — and stacks its Stats a step apart. */
	.post__strip {
		grid-column: 1;
		grid-row: 2;
		align-self: start;
		margin-block-start: var(--space-8);
	}
	.post__facts {
		display: grid;
		gap: var(--space-4);
	}
	/* Each Stat reads label first, then the value (a form's order). */
	.post__facts :global(.ds-stat) {
		flex-direction: column-reverse;
	}
	/* The stats may wrap, between its runs only (the caps Mono is nowrap). */
	.post__stats {
		white-space: normal;
	}
	.post__run {
		white-space: nowrap;
	}

	/* THE TITLE AND THE LEAD. The title at the page-title step every other
	   page's h1 takes (44px; 32, then 24 on a phone) across three columns,
	   balanced so two lines share the words; the lead at 24px in the second
	   and third. Body 14 → lead 24 → title 44 is one ~1.75 ratio, so the
	   three read as one scale. */
	.post__nobreak {
		white-space: nowrap;
	}
	.post__title {
		grid-column: 1 / span 3;
		grid-row: 1;
		margin-block-start: var(--space-10);
		text-wrap: balance;
		overflow-wrap: anywhere;
	}
	.post__intro {
		grid-column: 2 / span 2;
		grid-row: 2;
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: var(--space-4);
		margin-block-start: var(--space-8);
	}
	/* The lede, set apart by size, the secondary ink and a slant — three
	   instruments, not four, so no weight (the slant is the browser's oblique:
	   the site ships no italic cut, and global.css leaves style synthesis on
	   for exactly this). */
	.post__lead {
		align-self: stretch;
		margin: 0;
		font-style: italic;
		/* The UI leading: a step under the heading it follows, above the body's. */
		line-height: var(--line-height-ui);
	}

	/* THE HERO (a ruled Fig): its rows are the component's; the page places
	   it. The post's main image stands on its own, without the dashed edge
	   the body's figures keep. */
	.post__fig {
		grid-column: 1 / -1;
		grid-row: 3;
		margin: var(--space-9) 0 0;
	}
	/* With a hero the head reads title, lead, then the picture: the lead
	   takes the title's three columns under it, and the details card moves
	   into the hero's row — the first column, at its top, over the Fig. 01
	   that sits at its foot. */
	.post__head:has(.post__fig) .post__intro {
		grid-column: 1 / span 3;
		margin-block-start: var(--space-5);
	}
	.post__head:has(.post__fig) .post__strip {
		grid-row: 3;
		position: relative;
		z-index: 1;
		margin-block-start: var(--space-9);
	}
	.post__fig :global(img) {
		border: 0;
	}

	/* THE FOOT CARD. The two halves split the body down a dashed rule; each is
	   one link, the whole half its target, tinted with the first wash under
	   the pointer. The newer half reads from the right edge, so each arrow
	   points out of the card the way it goes. Below 640 they stack, older
	   on top, the rule between them, both on the left edge. */
	.post-more {
		margin-block-start: var(--space-12);
	}
	.post-more__pair {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
	}
	.post-more__half {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		padding: var(--space-5) var(--space-4);
		color: var(--text-primary);
		text-decoration: none;
		transition: background-color var(--duration-standard) var(--ease-standard);
		--control-ring-offset: var(--focus-ring-inset);
	}
	.post-more__half--next {
		align-items: flex-end;
		text-align: end;
		border-inline-start: var(--border);
	}
	a.post-more__half:hover {
		background: var(--wash-1);
	}
	a.post-more__half .post-more__dir {
		color: var(--text-secondary);
	}
	a.post-more__half:hover .post-more__dir {
		color: var(--accent);
	}
	.post-more__title {
		line-height: var(--line-height-ui);
		text-wrap: pretty;
	}
	a.post-more__half .post-more__title {
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--border-color);
		text-underline-offset: var(--space-1);
	}
	a.post-more__half:hover .post-more__title {
		text-decoration-color: currentColor;
	}

	/* Tags: the card's foot row, a quiet label and the chips. */
	.post-more__tags {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4);
		border-block-start: var(--border);
	}
	.post-more__chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 639px) {
		.post-more__pair {
			grid-template-columns: minmax(0, 1fr);
		}
		.post-more__half--next {
			align-items: flex-start;
			text-align: start;
			border-inline-start: 0;
			border-block-start: var(--border);
		}
	}

	/* ONE COLUMN, below the desktop step: the details card under the title,
	   its Stats side by side, the title a step down, the hero full width. */
	@media (max-width: 1023px) {
		.post {
			--ruled-columns: minmax(0, 1fr);
		}
		/* (The :has twins restate it over the desktop's hero placement.) */
		.post__strip,
		.post__head:has(.post__fig) .post__strip {
			grid-column: 1;
			grid-row: auto;
			z-index: auto;
			margin-block-start: var(--space-5);
		}
		.post__facts {
			grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
		}
		.post__title {
			margin-block-start: var(--space-5);
			grid-column: 1;
			grid-row: auto;
			text-wrap: pretty;
		}
		.post__intro,
		.post__head:has(.post__fig) .post__intro {
			grid-column: 1;
			grid-row: auto;
			margin-block-start: var(--space-5);
		}
		.post__fig {
			grid-column: 1;
			grid-row: auto;
			margin-block-start: var(--space-9);
		}
	}
	/* On a phone the title lands on 24px, so the lead steps under it to the
	   reading-lead size rather than meeting it. */
	@media (max-width: 639px) {
		.post__lead {
			font-size: var(--font-size-4);
		}
	}
</style>
