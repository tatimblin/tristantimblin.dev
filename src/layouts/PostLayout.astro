---
// PostLayout — the reading page for a /txt post, RULED: the site header, then
// one four-column grid in the site container that every row of the page is
// laid on, top to bottom:
//
//   1. The STATUS STRIP — one line between two strong hairlines, in the
//      structure voice: `TXT / 005` · the category · `3 MIN · 541 WORDS` ·
//      the date, `02.02.2026`, on the right edge.
//   2. The column numbers, `01 02 03 04`, tiny over the columns.
//   3. The TITLE across the first three columns at the display step, the LEAD
//      (the excerpt) in the second and third, and the post's art as a MARK in
//      the fourth — no plate, the page's ink — resting on the lead's last
//      line, playing (the one page where the art moves without a pointer).
//   4. The HERO, when the frontmatter names one: `Fig. 01 /` in the first
//      column, the image on a hairline across the other three, its caption
//      under it. The body's figures count on from it.
//   5. The SECTIONS: the body, cut at each h2 by the rehype plugin and drawn
//      by Prose `ruled` — each a row under a hairline, its number and heading
//      sticky in the first column, its text in the next two, the fourth air.
//      A post with no h2s is one section, `00 / Intro`, its text at the same
//      measure as any other.
//   6. The INDEX: a table at the foot, its header row the ink with the page
//      colour on it — `INDEX · NO. · TITLE · FILED` — then the tags, the
//      previous (older) post and the next (newer) as hairline-cut rows; an
//      end with nothing beyond it is a dimmed row saying so.
//
// The grid is `--ruled-columns` / `--ruled-gap` on the article, the tokens
// the ruled Prose reads too, so the page's rows and the body's sections fall
// on the same lines. Below 1024 it is one column: the strip two by two, the
// heads over their text, the mark after the lead at a modest width, the
// hero and the table full width. The page's headings take the UI face at the
// semibold by retuning the heading tokens in scope, as Prose does.
//
// The body arrives via <slot /> already sectioned and mapped to DS
// components (src/components/mdx-components.ts, applied at the <Content>
// render site in txt/[slug].astro). `image` is the social card only.
import ArticleLayout from "./ArticleLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Img from "../components/mdx/Img.astro";
import ArtFrame from "@whois/design-system/ArtFrame";
import Grid from "@whois/design-system/Grid";
import Heading from "@whois/design-system/Heading";
import Text from "@whois/design-system/Text";
import Mono from "@whois/design-system/Mono";
import Prose from "@whois/design-system/Prose";
import "@whois/design-system/styles.css";
import "../styles/blog.css";
import {
	blogNav,
	categories,
	dottedDate,
	filedDate,
	isoDate,
	padNo,
	queryHref,
	tagHref,
	type CategoryId,
} from "../lib/blog";

/** A neighbouring post, as the index at the foot lists it. */
export interface Neighbour {
	title: string;
	href: string;
	date: Date;
	/** Its chronological number. */
	no: number;
}

/** The post's hero image, from its frontmatter. */
export interface Hero {
	src: string;
	alt: string;
	caption?: string;
}

interface Props {
	title: string;
	description?: string;
	category?: CategoryId;
	tags?: string[];
	date: Date;
	modified?: Date | null;
	/** The social card, and what it shows. Not shown on the page. */
	image?: string;
	imageAlt?: string;
	canonical?: string;
	/** The post's chronological number, and how many there are. */
	no: number;
	total: number;
	stats: { words: number; minutes: number };
	/** The post's raw art (src/content/txt/<slug>.svg), or null. */
	art?: string | null;
	hero?: Hero | null;
	prev?: Neighbour | null;
	next?: Neighbour | null;
}

const {
	title,
	description,
	category,
	tags = [],
	date,
	modified,
	image,
	imageAlt,
	canonical,
	no,
	stats,
	art = null,
	hero = null,
	prev = null,
	next = null,
} = Astro.props;

const cat = category ? categories[category] : null;
const COLUMNS = "var(--ruled-columns)";

/** The two neighbour rows of the index: the older post, then the newer. */
const neighbourRows = [
	{ key: "prev", label: "← previous", post: prev, none: "Nothing older" },
	{ key: "next", label: "next →", post: next, none: "Nothing newer" },
] as const;
---

<ArticleLayout
	title={title}
	description={description}
	image={image}
	imageAlt={imageAlt}
	canonical={canonical}
	publishDate={date}
	modifiedDate={modified}
	tags={tags}
>
	<div class="blog">
		<SiteHeader variant="flow" links={blogNav} />
		<main class="blog__main blog__main--wide blog__main--post">
			<article class="post" data-post>
				<Grid templateColumns={COLUMNS} gapX={4} class="post__strip" data-post-strip>
					<Mono tone="primary" class="post__cell post__no">txt / {padNo(no)}</Mono>
					{cat && category ? (
						<Mono
							as="a"
							href={queryHref(category)}
							class="post__cell post__category"
						>
							{cat.label}
						</Mono>
					) : (
						<span class="post__cell" />
					)}
					<Mono class="post__cell post__stats">
						{stats.minutes} min · {stats.words.toLocaleString("en-US")} words
					</Mono>
					<Mono
						as="time"
						tone="primary"
						datetime={isoDate(date)}
						class="post__cell post__cell--end post__date"
					>
						{dottedDate(date)}
					</Mono>
				</Grid>

				<Grid templateColumns={COLUMNS} gapX={4} class="post__colnos" aria-hidden="true">
					{["01", "02", "03", "04"].map((n) => (
						<Mono>{n}</Mono>
					))}
				</Grid>

				<Grid as="header" templateColumns={COLUMNS} gapX={4} class="post__head">
					<Heading as="h1" size={4} class="post__title">{title}</Heading>
					{description && (
						<Text as="p" size={5} variant="primary" spaced={false} class="post__lead">
							{description}
						</Text>
					)}
					{art && <ArtFrame svg={art} label={title} variant="mark" play class="post__mark" />}
				</Grid>

				{hero && (
					<Grid as="figure" templateColumns={COLUMNS} gapX={4} class="post__fig" data-post-hero>
						<Mono class="post__fig-label">fig. 01 /</Mono>
						<div class="post__hero">
							<Img src={hero.src} alt={hero.alt} priority />
						</div>
						<Mono as="figcaption" class="post__figcap">{hero.caption ?? hero.alt}</Mono>
					</Grid>
				)}

				<Prose variant="ruled" class="post__prose">
					<slot />
				</Prose>

				<nav class="post__index" aria-label="Index" data-post-index>
					<Grid templateColumns={COLUMNS} gapX={4} class="post__row post__row--head">
						<Mono>index</Mono>
						<Mono>no.</Mono>
						<Mono>title</Mono>
						<Mono class="post__filed">filed</Mono>
					</Grid>
					<Grid templateColumns={COLUMNS} gapX={4} class="post__row" data-index-row="tags">
						<Mono>tags</Mono>
						<Mono tone="primary">{padNo(no)}</Mono>
						<Mono tone="primary" class="post__span post__tags">
							{tags.length > 0
								? tags.map((tag, i) => (
										<Fragment>
											{i > 0 && " · "}
											<a href={tagHref(tag)}>{tag.replace(/[-_]+/g, " ")}</a>
										</Fragment>
									))
								: "—"}
						</Mono>
					</Grid>
					{neighbourRows.map(({ key, label, post, none }) =>
						post ? (
							<Grid
								templateColumns={COLUMNS}
								gapX={4}
								align="baseline"
								class="post__row"
								data-index-row={key}
							>
								<Mono>{label}</Mono>
								<Mono tone="primary">{padNo(post.no)}</Mono>
								<Text
									as="a"
									size={3}
									variant="primary"
									spaced={false}
									href={post.href}
									class="post__index-title"
									data-neighbour={key}
								>
									{post.title}
								</Text>
								<Mono class="post__filed">
									<time datetime={isoDate(post.date)}>{filedDate(post.date)}</time>
								</Mono>
							</Grid>
						) : (
							<Grid
								templateColumns={COLUMNS}
								gapX={4}
								align="baseline"
								class="post__row post__row--dim"
								data-index-row={key}
							>
								<Mono>{label}</Mono>
								<Mono>—</Mono>
								<Text as="span" size={3} variant="tertiary" spaced={false} class="post__index-title">
									{none}
								</Text>
								<Mono class="post__filed">—</Mono>
							</Grid>
						),
					)}
				</nav>
			</article>
		</main>
	</div>
</ArticleLayout>

<style>
	/* THE GRID. Four columns a step apart, the tokens the ruled Prose reads
	   too, so the page's rows and the sections fall on the same lines. The
	   page's headings — the title here, the section heads through Prose — on
	   the UI face at the semibold, by the heading tokens in scope. */
	.post {
		--ruled-columns: repeat(4, minmax(0, 1fr));
		--ruled-gap: var(--space-4);
		--font-heading: var(--font-ui);
		--font-heading-weight: var(--font-weight-600);
	}

	/* THE STATUS STRIP. One row between the strong hairlines, the date on
	   the right edge. The category is a link to its query on the quilt, in
	   the same voice (Mono's link reset). */
	.post__strip {
		margin-block-start: var(--space-10);
		border-block: 1px solid var(--hairline-strong);
	}
	.post__cell {
		padding-block: var(--space-2);
		min-inline-size: 0;
	}
	.post__cell--end {
		text-align: end;
	}

	/* THE COLUMN NUMBERS: tiny, over the columns, a step under the strip. */
	.post__colnos {
		margin-block-start: var(--space-8);
	}

	/* THE TITLE, THE LEAD AND THE MARK. The title at the display step across
	   three columns, its lines almost touching (the heading leading retuned
	   below 1 in scope), balanced so two lines share the words; the lead a
	   step down in the second and third; the mark in the fourth, spanning
	   both rows and resting on the lead's last line. */
	.post__title {
		grid-column: 1 / span 3;
		grid-row: 1;
		margin-block-start: var(--space-5);
		font-size: var(--font-size-9);
		--line-height-heading: 0.95;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}
	.post__lead {
		grid-column: 2 / span 2;
		grid-row: 2;
		margin-block-start: var(--space-8);
		font-family: var(--font-ui);
		line-height: var(--line-height-ui);
	}
	.post__mark {
		grid-column: 4;
		grid-row: 1 / span 2;
		align-self: end;
		margin-block-end: var(--space-1);
	}

	/* THE HERO. The label sits on the image's bottom line; the image on a
	   hairline across the last three columns; the caption row under it. */
	.post__fig {
		margin: var(--space-11) 0 0;
	}
	.post__fig-label {
		align-self: end;
	}
	.post__hero {
		grid-column: 2 / span 3;
		min-inline-size: 0;
	}
	.post__hero :global(img) {
		display: block;
		inline-size: 100%;
		block-size: auto;
		border: 1px solid var(--hairline);
	}
	.post__figcap {
		grid-column: 2 / span 3;
		margin-block-start: var(--space-2);
		white-space: normal;
		line-height: var(--line-height-ui);
	}

	/* THE INDEX. The header row is the ink with the page colour on it — the
	   fill on the row, so the gaps between its cells carry it too — and its
	   Monos take the page colour through the token they read. Every other
	   row is cut off by a hairline, on the row for the same reason. Cells are
	   padded a step in, so the text sits off the column lines. */
	.post__index {
		margin-block-start: var(--space-12);
	}
	.post__row {
		border-block-end: 1px solid var(--hairline);
	}
	.post__row > :global(*) {
		padding: var(--space-3);
		min-inline-size: 0;
	}
	.post__row--head {
		--text-secondary: var(--background);
		background: var(--text-primary);
		color: var(--background);
		border: 0;
	}
	.post__row--head > :global(*) {
		padding-block: var(--space-2);
	}
	.post__span {
		grid-column: 3 / -1;
		white-space: normal;
		line-height: var(--line-height-ui);
	}
	.post__tags a {
		color: inherit;
		text-decoration: none;
		transition: color var(--duration-swap) var(--ease-reveal);
	}
	.post__tags a:hover,
	.post__tags a:focus-visible,
	a.post__index-title:hover,
	a.post__index-title:focus-visible {
		color: var(--accent);
	}
	.post__index-title {
		line-height: var(--line-height-ui);
		text-decoration: none;
		transition: color var(--duration-swap) var(--ease-reveal);
	}
	.post__filed {
		white-space: nowrap;
	}
	a:focus-visible {
		outline: var(--focus-ring);
		outline-offset: var(--focus-ring-offset);
	}

	/* ONE COLUMN, below the desktop step: the strip two by two (the date
	   still on the right edge), no column numbers, the title a step down,
	   the mark after the lead at a modest width, the hero and the table full
	   width. The table keeps three columns — label, number, title — and the
	   FILED cell drops under the title (the header's is not drawn). */
	@media (max-width: 1023px) {
		.post {
			--ruled-columns: minmax(0, 1fr);
		}
		.post__strip {
			--ruled-columns: repeat(2, minmax(0, 1fr));
		}
		.post__colnos {
			display: none;
		}
		.post__title {
			grid-column: 1;
			grid-row: auto;
			font-size: var(--font-size-8);
		}
		.post__lead {
			grid-column: 1;
			grid-row: auto;
			margin-block-start: var(--space-5);
		}
		.post__mark {
			grid-column: 1;
			grid-row: auto;
			align-self: start;
			max-inline-size: 16rem;
			margin-block: var(--space-6) 0;
		}
		.post__fig {
			margin-block-start: var(--space-9);
		}
		.post__fig-label {
			margin-block-end: var(--space-2);
		}
		.post__hero,
		.post__figcap {
			grid-column: 1;
		}
		.post__row {
			--ruled-columns: auto auto minmax(0, 1fr);
		}
		.post__row > :global(*) {
			padding: var(--space-3) var(--space-2);
		}
		.post__row--head > .post__filed,
		.post__row--dim > .post__filed {
			display: none;
		}
		.post__row:not(.post__row--head) > .post__filed {
			grid-column: 3;
			padding-block-start: 0;
		}
	}
</style>
