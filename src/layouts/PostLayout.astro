---
// PostLayout — the reading page for a /txt post, on BlogLayout's wide
// column: one four-column grid (--ruled-columns / --ruled-gap, the tokens the
// ruled Prose reads too, so the page's rows and the body's sections fall on
// the same lines), one column below 1024.
//
// The body arrives via <slot /> already sectioned and mapped to DS components
// (src/components/mdx-components.ts, applied in txt/[slug].astro). `image` is
// the social card only; `hero` is the figure on the page.
import type { ImageMetadata } from "astro";
import BlogLayout from "./BlogLayout.astro";
import Img from "../components/mdx/Img.astro";
import Fig from "@whois/design-system/Fig";
import Grid from "@whois/design-system/Grid";
import Heading from "@whois/design-system/Heading";
import Card from "@whois/design-system/Card";
import Chip from "@whois/design-system/Chip";
import Text from "@whois/design-system/Text";
import Mono from "@whois/design-system/Mono";
import Prose from "@whois/design-system/Prose";
import {
	categories,
	dottedDate,
	filedDate,
	isoDate,
	padNo,
	tagHref,
	type CategoryId,
} from "../lib/blog";

/** A neighbouring post, as the foot card links it. */
export interface Neighbour {
	title: string;
	href: string;
	date: Date;
}

/** The post's hero image, from its frontmatter: the collection resolves the
 *  path to the import (width, height, format), which the page hands to
 *  <Picture>. */
export interface Hero {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}

interface Props {
	title: string;
	description?: string;
	category?: CategoryId;
	tags?: string[];
	date: Date;
	modified?: Date | null;
	/** The social card, and what it shows. Not shown on the page. */
	image?: string;
	imageAlt?: string;
	canonical?: string;
	/** The post's chronological number, and how many there are. */
	no: number;
	total: number;
	stats: { words: number; minutes: number };
	/** "212 reads" (src/lib/pageviews.ts formatReads), or null to leave it off. */
	reads?: string | null;
	hero?: Hero | null;
	prev?: Neighbour | null;
	next?: Neighbour | null;
}

const {
	title,
	description,
	category,
	tags = [],
	date,
	modified,
	image,
	imageAlt,
	canonical,
	no,
	total,
	stats,
	reads = null,
	hero = null,
	prev = null,
	next = null,
} = Astro.props;

const cat = category ? categories[category] : null;
const COLUMNS = "var(--ruled-columns)";

/** The two halves of the foot card: the older post on the left, the newer on
 *  the right, each pointing the way it goes. */
const neighbours = [
	{ key: "prev", label: "← Older", post: prev, none: "This is the first post" },
	{ key: "next", label: "Newer →", post: next, none: "This is the latest post" },
] as const;
---

<BlogLayout
	wide
	type="article"
	title={`${title} — Tristan Timblin`}
	headline={title}
	description={description}
	image={image}
	imageAlt={imageAlt}
	canonical={canonical}
	publishDate={date}
	modifiedDate={modified}
	tags={tags}
	wordCount={stats.words}
	trail={[{ label: "txt", href: "/txt/" }, { label: padNo(no) }]}
>
	<article class="post" data-post>
		{/* THE STATUS STRIP, ruled straight under the site header so the two
		    read as one masthead: the header names the post (its number is the
		    last step of the path), the strip describes it. */}
		<Grid templateColumns={COLUMNS} gapX={4} class="post__strip" data-post-strip>
			{cat && category ? (
				<Mono class="post__cell post__category">{cat.label}</Mono>
			) : (
				<span class="post__cell" />
			)}
			{/* Unbreakable runs with breaks between them, so a narrow cell wraps
			    a run onto a second line, never mid-figure; a phone keeps only
			    the minutes. */}
			<Mono class="post__cell post__stats" data-post-stats>
				<span class="post__run">{stats.minutes} min</span> <span class="post__run post__words">· {stats.words.toLocaleString("en-US")} words</span>{reads && (
					<Fragment> <span class="post__run post__words post__reads" data-post-reads>· {reads}</span></Fragment>
				)}
			</Mono>
			<Mono
				as="time"
				tone="primary"
				datetime={isoDate(date)}
				class="post__cell post__cell--end post__date"
			>
				{dottedDate(date)}
			</Mono>
		</Grid>

		<Grid as="header" templateColumns={COLUMNS} gapX={4} class="post__head">
			<Heading as="h1" size={6} responsive class="post__title">{title}</Heading>
			{description && (
				<Text as="p" size={5} responsive variant="primary" family="ui" class="post__lead">
					{description}
				</Text>
			)}
		</Grid>

		{hero && (
			<Fig no="01" caption={hero.caption ?? hero.alt} layout="ruled" class="post__fig" data-post-hero="">
				<Img src={hero.src} alt={hero.alt} priority />
			</Fig>
		)}

		<Prose variant="ruled" class="post__prose">
			<slot />
		</Prose>

		{/* THE FOOT: a panel, "keep reading". Its body is the two neighbours,
		     side by side — each half one big link: which way it goes, the title,
		     the month — and its foot the post's tags as chip links. Where there
		     is no neighbour the half says so, dimmed, and links nowhere. */}
		<Card as="nav" class="post-more" aria-label="Keep reading" data-post-more="" title="Keep reading">
			<Mono slot="meta" tone="tertiary" class="post-more__count">
				txt / {padNo(no)} of {padNo(total)}
			</Mono>
			<div class="post-more__pair">
				{neighbours.map(({ key, label, post, none }) =>
					post ? (
						<a
							class={`post-more__half post-more__half--${key} ds-control`}
							href={post.href}
							data-half={key}
							data-neighbour={key}
						>
							<Mono class="post-more__dir">{label}</Mono>
							<Text as="span" size={3} class="post-more__title">{post.title}</Text>
							<Mono tone="tertiary" class="post-more__date">
								<time datetime={isoDate(post.date)}>{filedDate(post.date)}</time>
							</Mono>
						</a>
					) : (
						<div class={`post-more__half post-more__half--${key} post-more__half--none`} data-half={key}>
							<Mono tone="tertiary" class="post-more__dir">{label}</Mono>
							<Text as="span" size={3} variant="tertiary" class="post-more__title">{none}</Text>
						</div>
					),
				)}
			</div>
			{tags.length > 0 && (
				<div class="post-more__tags" data-half="tags">
					<Mono tone="tertiary">Tagged</Mono>
					<ul class="post-more__chips">
						{tags.map((tag) => (
							<li>
								<Chip as="a" href={tagHref(tag)}>{tag.replace(/[-_]+/g, " ")}</Chip>
							</li>
						))}
					</ul>
				</div>
			)}
		</Card>
	</article>
</BlogLayout>

<style>
	/* THE GRID. Four columns a step apart, the tokens the ruled Prose reads
	   too, so the page's rows and the sections fall on the same lines. The
	   page's headings — the title here, the section heads through Prose — on
	   the UI face at its Medium, by the heading tokens in scope. */
	.post {
		--ruled-columns: repeat(4, minmax(0, 1fr));
		--ruled-gap: var(--space-4);
		--font-heading: var(--font-ui);
		--font-heading-weight: var(--font-weight-500);
	}

	/* THE STATUS STRIP. One row between the strong hairlines, straight under
	   the site header (BlogLayout's headless main adds no top pad on
	   desktop), the date on the right edge. */
	.post__strip {
		border-block: var(--border);
	}
	.post__date {
		grid-column: -2 / -1;
	}
	.post__cell {
		padding-block: var(--space-2);
		min-inline-size: 0;
	}
	.post__cell--end {
		text-align: end;
	}
	/* The stats may wrap, between its runs only (the caps Mono is nowrap). */
	.post__stats {
		white-space: normal;
	}
	.post__run {
		white-space: nowrap;
	}

	/* THE COLUMN NUMBERS: tiny, over the columns, a step under the strip. */
	/* THE TITLE AND THE LEAD. The title at the display step (72px, 44px
	   below 1024) across three columns, balanced so two lines share the
	   words; the lead a step down in the second and third. */
	.post__title {
		grid-column: 1 / span 3;
		grid-row: 1;
		margin-block-start: var(--space-10);
		text-wrap: balance;
		overflow-wrap: anywhere;
	}
	.post__lead {
		grid-column: 2 / span 2;
		grid-row: 2;
		margin-block-start: var(--space-8);
		/* The UI leading: a step under the heading it follows, above the body's. */
		line-height: var(--line-height-ui);
	}

	/* THE HERO (a ruled Fig): its rows are the component's; the page places
	   it. The post's main image stands on its own, without the dashed edge
	   the body's figures keep. */
	.post__fig {
		margin: var(--space-11) 0 0;
	}
	.post__fig :global(img) {
		border: 0;
	}

	/* THE FOOT CARD. The two halves split the body down a dashed rule; each is
	   one link, the whole half its target, tinted with the first wash under
	   the pointer. The newer half reads from the right edge, so each arrow
	   points out of the card the way it goes. Below 640 they stack, older
	   on top, the rule between them, both on the left edge. */
	.post-more {
		margin-block-start: var(--space-12);
	}
	.post-more__pair {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
	}
	.post-more__half {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		padding: var(--space-5) var(--space-4);
		color: var(--text-primary);
		text-decoration: none;
		transition: background-color var(--duration-standard) var(--ease-standard);
		--control-ring-offset: var(--focus-ring-inset);
	}
	.post-more__half--next {
		align-items: flex-end;
		text-align: end;
		border-inline-start: var(--border);
	}
	a.post-more__half:hover {
		background: var(--wash-1);
	}
	a.post-more__half .post-more__dir {
		color: var(--text-secondary);
	}
	a.post-more__half:hover .post-more__dir {
		color: var(--accent);
	}
	.post-more__title {
		line-height: var(--line-height-ui);
		text-wrap: pretty;
	}
	a.post-more__half .post-more__title {
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--border-color);
		text-underline-offset: var(--space-1);
	}
	a.post-more__half:hover .post-more__title {
		text-decoration-color: currentColor;
	}

	/* Tags: the card's foot row, a quiet label and the chips. */
	.post-more__tags {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4);
		border-block-start: var(--border);
	}
	.post-more__chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 639px) {
		.post-more__pair {
			grid-template-columns: minmax(0, 1fr);
		}
		.post-more__half--next {
			align-items: flex-start;
			text-align: start;
			border-inline-start: 0;
			border-block-start: var(--border);
		}
	}

	/* ONE COLUMN, below the desktop step: the strip two by two (the date
	   still on the right edge), no column numbers, the title a step down,
	   the hero full width. */
	@media (max-width: 1023px) {
		.post {
			--ruled-columns: minmax(0, 1fr);
		}
		/* The strip on one line: the category and the reading time on the
		   left, the date on the right edge. */
		.post__strip {
			--ruled-columns: auto minmax(0, 1fr) auto;
		}
		.post__title {
			margin-block-start: var(--space-5);
			grid-column: 1;
			grid-row: auto;
			text-wrap: pretty;
		}
		.post__lead {
			grid-column: 1;
			grid-row: auto;
			margin-block-start: var(--space-5);
		}
		.post__fig {
			margin-block-start: var(--space-9);
		}
	}
	/* Phone: the minutes only, so the strip stays one line. */
	@media (max-width: 639px) {
		.post__words {
			display: none;
		}
	}
</style>
