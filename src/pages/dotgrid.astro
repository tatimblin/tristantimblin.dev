---
import Layout from "../layouts/Layout.astro";
import "@whois/dotted-grid/styles.css";

const SOURCES = [
	{
		label: "fabric",
		src: "/videos/fabric.web.mp4",
		webm: "/videos/fabric.web.webm",
	},
	{ label: "beach", src: "/videos/beach.web.mp4", webm: "/videos/beach.web.webm" },
];
const SRC = SOURCES[0].src;
const SRC_WEBM = SOURCES[0].webm;
---

<Layout
	title="Dotted Grid — Tristan Timblin"
	description="An interactive playground for the dotted-grid web component: tune cell size, dot size, gamma, and contrast against live video sources."
>
	<main class="dotgrid-demo">
		<!-- Full-viewport hero preview, driven live by the control panel. -->
		<dotted-grid data-hero src={SRC} src-webm={SRC_WEBM}></dotted-grid>

		<aside class="controls" data-controls aria-label="dotted-grid controls">
			<h2>&lt;dotted-grid&gt;</h2>
			<div class="sources">
				{SOURCES.map((s, i) => (
					<button type="button" data-src={s.src} data-webm={s.webm} class={i === 0 ? "is-active" : ""}>
						{s.label}
					</button>
				))}
			</div>
			<label>
				<span>cell-size <output data-out="cell-size"></output></span>
				<input type="range" data-attr="cell-size" min="2" max="24" step="1" value="6" />
			</label>
			<label>
				<span>dot-scale <output data-out="dot-scale"></output></span>
				<input type="range" data-attr="dot-scale" min="0.2" max="1.5" step="0.05" value="1" />
			</label>
			<label>
				<span>levels <output data-out="levels"></output></span>
				<input type="range" data-attr="levels" min="1" max="12" step="1" value="5" />
			</label>
			<label>
				<span>cutoff <output data-out="cutoff"></output></span>
				<input type="range" data-attr="cutoff" data-zero-off min="0" max="1" step="0.05" value="0" />
			</label>
			<label>
				<span>feather <output data-out="feather"></output></span>
				<input type="range" data-attr="feather" data-zero-off min="0" max="1" step="0.05" value="0" />
			</label>
			<label>
				<span>denoise <output data-out="denoise"></output></span>
				<input type="range" data-attr="denoise" data-zero-off min="0" max="1" step="0.05" value="0" />
			</label>
			<label>
				<span>gamma <output data-out="gamma"></output></span>
				<input type="range" data-attr="gamma" min="0.2" max="3" step="0.05" value="0.8" />
			</label>
			<label>
				<span>contrast <output data-out="contrast"></output></span>
				<input type="range" data-attr="contrast" min="0.2" max="3" step="0.05" value="1.1" />
			</label>
			<label>
				<span>color-reveal <output data-out="color-reveal"></output></span>
				<input type="range" data-attr="color-reveal" data-zero-off min="0" max="300" step="10" value="0" />
			</label>
			<label>
				<span>shimmer % <output data-out="shimmer"></output></span>
				<input type="range" data-attr="shimmer" data-zero-off min="0" max="100" step="1" value="0" />
			</label>
			<label>
				<span>reveal-boost <output data-out="reveal-boost"></output></span>
				<input type="range" data-attr="reveal-boost" min="0" max="1" step="0.05" value="1" />
			</label>
			<label>
				<span>dot-shape (0 sq / 1 circle / 2 morph) <output data-out="dot-shape"></output></span>
				<input type="range" data-attr="dot-shape" min="0" max="2" step="1" value="2" />
			</label>
			<label>
				<span>bloom <output data-out="bloom"></output></span>
				<input type="range" data-attr="bloom" data-zero-off min="0" max="1" step="0.05" value="0.55" />
			</label>
			<label>
				<span>crosshatch <output data-out="crosshatch"></output></span>
				<input type="range" data-attr="crosshatch" data-zero-off min="0" max="1" step="0.05" value="0.35" />
			</label>
			<label>
				<span>intro-jitter <output data-out="intro-jitter"></output></span>
				<input type="range" data-attr="intro-jitter" min="0" max="0.5" step="0.02" value="0.16" />
			</label>
			<!-- The intro wipe is a one-shot ENTRANCE, so it can't be driven by a live
			     slider like the other knobs: it runs once per element and latches. These
			     two feed the replay button, which re-runs it on a fresh element at the
			     chosen delay + duration (see the handler in the page script). -->
			<label>
				<span>intro delay ms <output data-out="intro-delay-ms">600</output></span>
				<input type="range" data-intro-delay-ms min="0" max="3000" step="100" value="600" />
			</label>
			<label>
				<span>intro ms <output data-out="intro-ms">3200</output></span>
				<input type="range" data-intro-ms min="300" max="8000" step="100" value="3200" />
			</label>
			<button type="button" data-replay-intro>replay intro ▶</button>
			<div class="row">
				<label class="color">
					<span>color</span>
					<input type="color" data-attr="color" value="#ededed" />
				</label>
				<label class="color">
					<span>background</span>
					<input type="color" data-attr="background" value="#000000" />
				</label>
			</div>
			<div class="row">
				<label class="check">
					<input type="checkbox" data-attr="invert" />
					<span>invert</span>
				</label>
				<label class="check">
					<input type="checkbox" data-attr="paused" />
					<span>paused</span>
				</label>
			</div>
		</aside>
	</main>
	<script>
		import "@whois/dotted-grid";

		// Live controls: reflect each input onto the hero <dotted-grid> attributes.
		// Boolean attrs (invert/paused) toggle presence; the rest set a value.
		//
		// Resolved on every use, not captured once: the "replay intro" button below
		// swaps in a FRESH element (the only honest way to re-run a one-shot entrance),
		// so a captured reference would leave every other slider driving a discarded
		// node while the visible one ignored them.
		const hero = () => document.querySelector<HTMLElement>("[data-hero]");
		const panel = document.querySelector<HTMLElement>("[data-controls]");
		if (hero() && panel) {
			const sync = (input: HTMLInputElement) => {
				const attr = input.dataset.attr;
				// The intro delay/duration sliders have no data-attr: they feed the replay
				// button below rather than an attribute, since the wipe is a one-shot
				// entrance that would otherwise re-latch on every drag. Their readout is
				// named after the slider so both stay in step.
				if (!attr) {
					const key = input.dataset.introMs !== undefined ? "intro-ms" : "intro-delay-ms";
					const out = panel.querySelector<HTMLElement>(`[data-out="${key}"]`);
					if (out) out.textContent = input.value;
					return;
				}
				const el = hero();
				if (!el) return;
				if (input.type === "checkbox") {
					input.checked ? el.setAttribute(attr, "") : el.removeAttribute(attr);
				} else if (input.dataset.zeroOff !== undefined && input.value === "0") {
					// "absent = off" attrs (color-reveal, shimmer): 0 removes the attr.
					el.removeAttribute(attr);
				} else {
					el.setAttribute(attr, input.value);
				}
				const out = panel.querySelector<HTMLElement>(`[data-out="${attr}"]`);
				if (out) out.textContent = input.value;
			};
			panel.querySelectorAll<HTMLInputElement>("input").forEach((input) => {
				input.addEventListener("input", () => sync(input));
				sync(input); // apply initial state on load
			});

			// Replay the intro wipe. It latches after running (an entrance, not a loop),
			// and the latch lives in the element instance — so the honest way to replay it
			// is to give the page a FRESH element with the attribute already set, exactly
			// as a real page load would. Copies the current attributes across so the
			// replay reflects whatever the other sliders are set to.
			const replay = panel.querySelector<HTMLButtonElement>("[data-replay-intro]");
			const msInput = panel.querySelector<HTMLInputElement>("[data-intro-ms]");
			const delayInput = panel.querySelector<HTMLInputElement>("[data-intro-delay-ms]");
			replay?.addEventListener("click", () => {
				const current = document.querySelector<HTMLElement>("[data-hero]");
				if (!current) return;
				const fresh = document.createElement("dotted-grid");
				for (const { name, value } of Array.from(current.attributes)) {
					fresh.setAttribute(name, value);
				}
				fresh.setAttribute("intro-delay", delayInput?.value ?? "600");
				fresh.setAttribute("intro", msInput?.value ?? "3200");
				current.replaceWith(fresh);
			});

			// Source switcher: swap the video the effect samples.
			panel.querySelectorAll<HTMLButtonElement>("[data-src]").forEach((btn) => {
				btn.addEventListener("click", () => {
					// Set src-webm before src: the element reads src-webm fresh when the
					// src change triggers a (gapless) reload, so the pair stays consistent.
					const el = hero();
					if (!el) return;
					if (btn.dataset.webm) el.setAttribute("src-webm", btn.dataset.webm);
					else el.removeAttribute("src-webm");
					el.setAttribute("src", btn.dataset.src!);
					panel
						.querySelectorAll("[data-src]")
						.forEach((b) => b.classList.toggle("is-active", b === btn));
				});
			});
		}
	</script>
</Layout>

<style>
	.dotgrid-demo {
		background: #000;
		color: #fafaf7;
		position: relative;
		min-height: 100vh;
	}

	.dotgrid-demo > dotted-grid {
		--dotted-grid-height: 100vh;
	}

	.controls {
		position: fixed;
		top: var(--space-4, 1.5rem);
		right: var(--space-4, 1.5rem);
		z-index: 10;
		width: 240px;
		display: flex;
		flex-direction: column;
		gap: var(--space-3, 0.75rem);
		padding: var(--space-4, 1.5rem);
		background: rgba(10, 10, 12, 0.72);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--radius, 12px);
		font-family: var(--font-sans);
		font-size: 0.8rem;
	}

	.controls h2 {
		margin: 0 0 var(--space-1, 0.25rem);
		font-size: 0.95rem;
		font-family: ui-monospace, monospace;
	}

	.controls .sources {
		display: flex;
		gap: 0.4rem;
	}

	.controls .sources button {
		flex: 1;
		padding: 0.35rem 0.5rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 8px;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.78rem;
		cursor: pointer;
	}

	.controls .sources button.is-active {
		background: #7fd4ff;
		border-color: #7fd4ff;
		color: #03060d;
		font-weight: 600;
	}

	.controls label {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.controls label span {
		display: flex;
		justify-content: space-between;
		opacity: 0.85;
	}

	.controls output {
		font-variant-numeric: tabular-nums;
		opacity: 0.6;
	}

	.controls input[type="range"] {
		width: 100%;
		accent-color: #7fd4ff;
	}

	.controls .row {
		display: flex;
		gap: var(--space-3, 0.75rem);
	}

	.controls .color {
		flex: 1;
	}

	.controls .color input {
		width: 100%;
		height: 28px;
		padding: 0;
		border: none;
		background: none;
	}

	.controls .check {
		flex-direction: row;
		align-items: center;
		gap: 0.4rem;
	}

	@media (max-width: 640px) {
		.controls {
			left: var(--space-4, 1.5rem);
			width: auto;
		}
	}
</style>
