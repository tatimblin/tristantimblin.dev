---
// /dotgrid — the playground for the <dotted-grid> web component: the hero
// grid full-viewport, driven live by a Knobs panel (the design system's
// control panel) fixed to the corner.
import Layout from "../layouts/Layout.astro";
import Knobs from "@whois/design-system/Knobs";
import KnobGroup from "@whois/design-system/KnobGroup";
import Knob from "@whois/design-system/Knob";
import Chip from "@whois/design-system/Chip";
import Button from "@whois/design-system/Button";
import "@whois/dotted-grid/styles.css";

const SOURCES = [
	{
		label: "fabric",
		src: "/videos/fabric.web.mp4",
		webm: "/videos/fabric.web.webm",
	},
	{ label: "beach", src: "/videos/beach.web.mp4", webm: "/videos/beach.web.webm" },
];
const SRC = SOURCES[0].src;
const SRC_WEBM = SOURCES[0].webm;

// The knobs: an attribute each, a range over it. `zeroOff` marks the
// "absent = off" attributes (0 removes the attribute rather than setting it).
const knobs = [
	{ attr: "cell-size", min: 2, max: 24, step: 1, value: 6 },
	{ attr: "dot-scale", min: 0.2, max: 1.5, step: 0.05, value: 1 },
	{ attr: "levels", min: 1, max: 12, step: 1, value: 5 },
	{ attr: "cutoff", min: 0, max: 1, step: 0.05, value: 0, zeroOff: true },
	{ attr: "feather", min: 0, max: 1, step: 0.05, value: 0, zeroOff: true },
	{ attr: "denoise", min: 0, max: 1, step: 0.05, value: 0, zeroOff: true },
	{ attr: "gamma", min: 0.2, max: 3, step: 0.05, value: 0.8 },
	{ attr: "contrast", min: 0.2, max: 3, step: 0.05, value: 1.1 },
	{ attr: "color-reveal", min: 0, max: 300, step: 10, value: 0, zeroOff: true },
	{ attr: "shimmer", label: "shimmer %", min: 0, max: 100, step: 1, value: 0, zeroOff: true },
	{ attr: "reveal-boost", min: 0, max: 1, step: 0.05, value: 1 },
	{ attr: "dot-shape", label: "dot-shape (0 sq / 1 circle / 2 morph)", min: 0, max: 2, step: 1, value: 2 },
	{ attr: "bloom", min: 0, max: 1, step: 0.05, value: 0.55, zeroOff: true },
	{ attr: "crosshatch", min: 0, max: 1, step: 0.05, value: 0.35, zeroOff: true },
	{ attr: "intro-jitter", min: 0, max: 0.5, step: 0.02, value: 0.16 },
];
---

<Layout
	title="Dotted Grid — Tristan Timblin"
	description="An interactive playground for the dotted-grid web component: tune cell size, dot size, gamma, and contrast against live video sources."
	noindex
>
	<main class="dotgrid-demo">
		{/* Full-viewport hero preview, driven live by the control panel. */}
		<dotted-grid data-hero src={SRC} src-webm={SRC_WEBM}></dotted-grid>

		<Knobs title="<dotted-grid>" class="dotgrid-demo__knobs" data-controls aria-label="dotted-grid controls">
			<KnobGroup legend="source" class="dotgrid-demo__sources">
				{SOURCES.map((s, i) => (
					<Chip as="button" type="button" data-src={s.src} data-webm={s.webm} aria-pressed={i === 0 ? "true" : "false"}>
						{s.label}
					</Chip>
				))}
			</KnobGroup>
			<KnobGroup legend="halftone">
				{knobs.map((k) => (
					<Knob
						label={k.label ?? k.attr}
						type="range"
						out={k.attr}
						data-attr={k.attr}
						data-zero-off={k.zeroOff ? "" : undefined}
						min={k.min}
						max={k.max}
						step={k.step}
						value={k.value}
					/>
				))}
			</KnobGroup>
			<KnobGroup legend="intro">
				{/* The intro wipe is a one-shot ENTRANCE, so it can't be driven by a live
				     slider like the other knobs: it runs once per element and latches. These
				     two feed the replay button, which re-runs it on a fresh element at the
				     chosen delay + duration (see the handler in the page script). */}
				<Knob label="intro delay ms" type="range" out="intro-delay-ms" data-intro-delay-ms min="0" max="3000" step="100" value="600" />
				<Knob label="intro ms" type="range" out="intro-ms" data-intro-ms min="300" max="8000" step="100" value="3200" />
				<Button variant="secondary" type="button" data-replay-intro>replay intro ▶</Button>
			</KnobGroup>
			<KnobGroup legend="colour" class="dotgrid-demo__row">
				<Knob label="color" type="color" data-attr="color" value="#ededed" />
				<Knob label="background" type="color" data-attr="background" value="#000000" />
			</KnobGroup>
			<KnobGroup legend="switches" class="dotgrid-demo__row">
				<Knob label="invert" type="checkbox" data-attr="invert" />
				<Knob label="paused" type="checkbox" data-attr="paused" />
			</KnobGroup>
		</Knobs>
	</main>
	<script>
		import "@whois/dotted-grid";

		// Live controls: reflect each input onto the hero <dotted-grid> attributes.
		// Boolean attrs (invert/paused) toggle presence; the rest set a value.
		//
		// Resolved on every use, not captured once: the "replay intro" button below
		// swaps in a FRESH element (the only honest way to re-run a one-shot entrance),
		// so a captured reference would leave every other slider driving a discarded
		// node while the visible one ignored them.
		const hero = () => document.querySelector<HTMLElement>("[data-hero]");

		// Wired on astro:page-load, which ClientRouter fires for the first load AND
		// after every navigation: a module script runs once per session, so wiring
		// at its top level would leave the controls dead after navigating here from
		// another page. The marker keeps a second page-load on the same panel a no-op.
		function wireControls() {
			const panel = document.querySelector<HTMLElement>("[data-controls]");
			if (!hero() || !panel || panel.dataset.wired) return;
			panel.dataset.wired = "true";
			const sync = (input: HTMLInputElement) => {
				const attr = input.dataset.attr;
				// The intro delay/duration sliders have no data-attr: they feed the replay
				// button below rather than an attribute, since the wipe is a one-shot
				// entrance that would otherwise re-latch on every drag. Their readout is
				// named after the slider so both stay in step.
				if (!attr) {
					const key = input.dataset.introMs !== undefined ? "intro-ms" : "intro-delay-ms";
					const out = panel.querySelector<HTMLElement>(`[data-out="${key}"]`);
					if (out) out.textContent = input.value;
					return;
				}
				const el = hero();
				if (!el) return;
				if (input.type === "checkbox") {
					input.checked ? el.setAttribute(attr, "") : el.removeAttribute(attr);
				} else if (input.dataset.zeroOff !== undefined && input.value === "0") {
					// "absent = off" attrs (color-reveal, shimmer): 0 removes the attr.
					el.removeAttribute(attr);
				} else {
					el.setAttribute(attr, input.value);
				}
				const out = panel.querySelector<HTMLElement>(`[data-out="${attr}"]`);
				if (out) out.textContent = input.value;
			};
			panel.querySelectorAll<HTMLInputElement>("input").forEach((input) => {
				input.addEventListener("input", () => sync(input));
				sync(input); // apply initial state on load
			});

			// Replay the intro wipe. It latches after running (an entrance, not a loop),
			// and the latch lives in the element instance — so the honest way to replay it
			// is to give the page a FRESH element with the attribute already set, exactly
			// as a real page load would. Copies the current attributes across so the
			// replay reflects whatever the other sliders are set to.
			const replay = panel.querySelector<HTMLButtonElement>("[data-replay-intro]");
			const msInput = panel.querySelector<HTMLInputElement>("[data-intro-ms]");
			const delayInput = panel.querySelector<HTMLInputElement>("[data-intro-delay-ms]");
			replay?.addEventListener("click", () => {
				const current = document.querySelector<HTMLElement>("[data-hero]");
				if (!current) return;
				const fresh = document.createElement("dotted-grid");
				for (const { name, value } of Array.from(current.attributes)) {
					fresh.setAttribute(name, value);
				}
				fresh.setAttribute("intro-delay", delayInput?.value ?? "600");
				fresh.setAttribute("intro", msInput?.value ?? "3200");
				current.replaceWith(fresh);
			});

			// Source switcher: swap the video the effect samples. The chips are
			// toggles; the pressed one is the source playing.
			panel.querySelectorAll<HTMLButtonElement>("[data-src]").forEach((btn) => {
				btn.addEventListener("click", () => {
					// Set src-webm before src: the element reads src-webm fresh when the
					// src change triggers a (gapless) reload, so the pair stays consistent.
					const el = hero();
					if (!el) return;
					if (btn.dataset.webm) el.setAttribute("src-webm", btn.dataset.webm);
					else el.removeAttribute("src-webm");
					el.setAttribute("src", btn.dataset.src!);
					panel
						.querySelectorAll("[data-src]")
						.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
				});
			});
		}

		document.addEventListener("astro:page-load", wireControls);
	</script>
</Layout>

<style>
	.dotgrid-demo {
		background: #000;
		color: #fafaf7;
		position: relative;
		min-height: 100vh;
	}

	.dotgrid-demo > dotted-grid {
		--dotted-grid-height: 100vh;
	}

	/* The panel: fixed to the top-right corner, as tall as the viewport lets
	   it be (the Knobs body scrolls); on a phone across the bottom instead. */
	.dotgrid-demo__knobs {
		position: fixed;
		top: var(--space-4);
		right: var(--space-4);
		z-index: 10;
		width: 264px;
		max-height: calc(100vh - var(--space-8));
	}
	.dotgrid-demo__sources,
	.dotgrid-demo__row {
		flex-direction: row;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.dotgrid-demo__sources > :global(legend),
	.dotgrid-demo__row > :global(legend) {
		flex-basis: 100%;
	}
	.dotgrid-demo__row > :global(.ds-knob) {
		flex: 1 1 0;
	}

	@media (max-width: 640px) {
		.dotgrid-demo__knobs {
			top: auto;
			bottom: 0;
			left: 0;
			right: 0;
			width: auto;
			max-height: 45vh;
			border-radius: var(--border-radius-2) var(--border-radius-2) 0 0;
		}
	}
</style>
