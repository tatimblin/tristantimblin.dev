---
// /txt/<slug> — one post. The body arrives already cut into sections (the
// rehype plugin in astro.config, src/lib/mdx/post-sections.ts) and mapped
// onto DS components at the <Content> below; PostLayout draws the rest.
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import { mdxComponents } from "../../components/mdx-components";
import { postPlaces } from "../../lib/blog";
import { getPosts } from "../../lib/posts";

export const getStaticPaths = (async () => {
	const posts = await getPosts();
	const places = postPlaces(posts);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, total: posts.length, ...places.get(post.id)! },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, no, total, prev, next } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} no={no} total={total} prev={prev} next={next}>
	<Content components={mdxComponents} />
</PostLayout>
