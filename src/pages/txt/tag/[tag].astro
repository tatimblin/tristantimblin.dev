---
// /txt/tag/<tag> — one tag's posts, by year. Tags are the free-form, plural
// labels a post carries (categories are the closed set the index is organised
// by), and every tag keeps a page: these URLs predate the redesign and may be
// linked from elsewhere.
//
// noindex: many tag pages over a handful of posts is thin archive for a
// crawler, and none of it is content that does not already exist on /txt or
// the posts themselves.
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import PostIndex from "../../../components/txt/PostIndex.astro";
import Pill from "@whois/design-system/Pill";
import { getPosts } from "../../../lib/posts";

export const getStaticPaths = (async () => {
	const posts = await getPosts();
	const tags = new Set<string>();
	for (const post of posts) for (const tag of post.data.tags) tags.add(tag);

	return [...tags].map((tag) => ({
		params: { tag },
		props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}) satisfies GetStaticPaths;

interface Props {
	tag: string;
	posts: CollectionEntry<"txt">[];
}

const { tag, posts } = Astro.props;
const label = tag.replace(/-/g, " ");
---

<BlogLayout
	title={`${label} — Tristan Timblin`}
	description={`Writing by Tristan Timblin tagged ${label}.`}
	noindex
	kicker="Tag"
	heading={label}
>
	<Fragment slot="lede">
		<Pill as="a" href={`/txt?q=${encodeURIComponent(label)}`} variant="outline">
			search this in the quilt
		</Pill>
	</Fragment>
	<PostIndex posts={posts} label={`Posts tagged ${label}, by year`} />
</BlogLayout>
