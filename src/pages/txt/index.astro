---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("txt"))
	.filter((post) => import.meta.env.PROD === false || !post.data.draft)
	.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const fmt = (d: Date) =>
	new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const iso = (d: Date) => new Date(d).toISOString().split("T")[0];
---

<Layout title="txt — Tristan Timblin" description="Writing by Tristan Timblin.">
	<main>
		<h1>txt</h1>
		{
			posts.length > 0 ? (
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/txt/${post.id}`}>
								{post.data.icon && <span aria-hidden="true">{post.data.icon} </span>}
								{post.data.title}
							</a>
							<time datetime={iso(post.data.date)}>{fmt(post.data.date)}</time>
							<p>{post.data.excerpt}</p>
						</li>
					))}
				</ul>
			) : (
				<p>No posts yet.</p>
			)
		}
	</main>
</Layout>
