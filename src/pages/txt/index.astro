---
// /txt — every post, by year, newest first: the default BlogLayout shell over
// the DS post list (PostIndex). Deliberately plain — a base to build on.
import BlogLayout from "../../layouts/BlogLayout.astro";
import PostIndex from "../../components/txt/PostIndex.astro";
import { BLOG_DESCRIPTION, BLOG_TITLE } from "../../lib/blog";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
---

<BlogLayout
	title={`${BLOG_TITLE} — Tristan Timblin`}
	description={BLOG_DESCRIPTION}
	heading={BLOG_TITLE}
>
	<PostIndex posts={posts} />
</BlogLayout>
