---
// /txt — the blog's front page as an INSTRUMENT: three rows straight on the
// page, in the site container. The BAR is the layout's: one open search
// bar — the search with its count drawn at the right, the quick-filter
// tabs with their counts (each a query on the quilt), the − / + that step
// through the matching posts. Then the BOARD, right under
// it: the quilt, the spec sheet's grid — every post an entry, a numbered
// caps label over a dotted rule with its art bare under it, the newest post
// the 2×2 LEAD with its excerpt, the leftover cells fillers tagged `F_NN` —
// and the panel that takes a freed block of it when a tile is hovered or
// stepped to or the bar is used. Then the TIMELINE, docked to the
// window's bottom edge while the quilt scrolls under it: one tick per month,
// the posts as the tall ones, an accent playhead on the post in focus. The
// page computes the index at build (numbers, slots, reading time) and
// renders the design system's contract; src/lib/quilt/index.ts drives it on
// the client from the JSON embedded below. With scripting off it is the
// full quilt, every tile, chip and tick a link, and the bar submits to ?q=
// (which the script reads on load).
import BlogLayout from "../../layouts/BlogLayout.astro";
import Quilt from "@whois/design-system/Quilt";
import QuiltCell from "@whois/design-system/QuiltCell";
import QuiltPanel from "@whois/design-system/QuiltPanel";
import ArtFrame from "@whois/design-system/ArtFrame";
import TimeRuler from "@whois/design-system/TimeRuler";
import {
	BLOG_DESCRIPTION,
	BLOG_TITLE,
	categories,
	categoryIds,
	monthOf,
	padNo,
	postHref,
	postNumbers,
	queryHref,
	TXT_HREF,
	readingStats,
} from "../../lib/blog";
import { artFor, fillerArtFor } from "../../lib/quilt/art";
import { layout, toColRow, type IndexedPost } from "../../lib/quilt/engine";
import { getPosts } from "../../lib/posts";

const COLS = 5;
const COLS_MD = 3;
/** The art's frame on the sheet: bare (no plate, edge or corner). Set to
 *  "corners" for registration ticks at each crop corner. */
const ART_VARIANT: "bare" | "corners" = "bare";
/** The number as a label draws it: two digits, the sheet's width (`05`,
 *  `F_07`); `padNo` (`005`) is the index's and the card's. */
const numeral = (n: number) => String(n).padStart(2, "0");

const posts = await getPosts();
const numbers = postNumbers(posts);

// One layout per grid: the desktop 5-column quilt and the tablet 3-column
// one. The newest post is the LEAD, a 2×2 block at the top-left of both;
// every other post's slot comes from its chronological number, so it stays
// put as newer posts arrive (the old lead takes a fresh slot).
const lg = layout({ cols: COLS, postCount: posts.length });
const md = layout({ cols: COLS_MD, postCount: posts.length });

type QuiltPost = IndexedPost & { colMd: number; rowMd: number; words: number; ym: string };
const index: QuiltPost[] = posts.map((post) => {
	const no = numbers.get(post.id)!;
	const month = monthOf(post.data.date);
	const at = toColRow(lg.slots[no - 1], COLS);
	const atMd = toColRow(md.slots[no - 1], COLS_MD);
	const lead = no === posts.length && lg.lead ? lg.lead.span : undefined;
	const stats = readingStats(post.body);
	const date = new Date(post.data.date);
	return {
		id: post.id,
		no,
		title: post.data.title,
		excerpt: post.data.excerpt,
		category: post.data.category,
		tags: post.data.tags,
		year: String(date.getUTCFullYear()),
		month: month.short,
		monthLong: month.long,
		minutes: stats.minutes,
		words: stats.words,
		ym: `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, "0")}`,
		href: postHref(post.id),
		col: at.col,
		row: at.row,
		colMd: atMd.col,
		rowMd: atMd.row,
		...(lead && { span: lead }),
	};
});
const art = new Map(posts.map((post) => [post.id, artFor(post.id)]));

// Fillers: every cell the posts leave on the desktop grid, and the first
// (tablet cells − posts) of them also get a tablet slot. Should the tablet
// grid ever need more fillers than the desktop one (ten posts: 12 cells
// against 10), the extra ones have a tablet slot only.
const fillerCount = Math.max(lg.fillerCells.length, md.fillerCells.length);
const fillers = Array.from({ length: fillerCount }, (_, k) => {
	const cell = lg.fillerCells[k];
	const cellMd = md.fillerCells[k];
	// The file cycles from the desktop order; a tablet-only filler continues it.
	const file = (lg.fillerOrder[k] ?? md.fillerOrder[k]) + 1;
	return {
		file,
		cell,
		cellMd,
		at: cell != null ? toColRow(cell, COLS) : null,
		atMd: cellMd != null ? toColRow(cellMd, COLS_MD) : null,
	};
});

const catCounts = new Map<string, number>();
for (const p of index) if (p.category) catCounts.set(p.category, (catCounts.get(p.category) ?? 0) + 1);

// The bar's chips: a category is a query, so each is a real link to ?q=<id>
// (and ALL to /txt/) — a search shortcut; the script upgrades them and keeps
// aria-current in step with the query. Each carries its post count (ALL the
// total). The page is static, so at build ALL is current; the script
// corrects it from ?q= on load.
const chips = [
	{ label: "all", href: TXT_HREF, query: "", count: index.length, active: true },
	...categoryIds.map((id) => ({
		label: categories[id].label.toLowerCase(),
		href: queryHref(id),
		query: id,
		count: catCounts.get(id) ?? 0,
	})),
];

// The panel's build-time faces. The card is the latest post (the script
// refills it); browse and nothing are real links to ?q=, so they work with
// scripting off.
const browse = {
	categories: [...catCounts].map(([id, count]) => ({
		label: categories[id as keyof typeof categories].label.toLowerCase(),
		count,
		href: queryHref(id),
	})),
	years: [...new Set(index.map((p) => p.year))].map((y) => ({ label: y, href: queryHref(y) })),
	latest: index[0] ? { title: index[0].title, href: index[0].href } : undefined,
};
const tagCounts = new Map<string, number>();
for (const p of index) for (const t of p.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const topTags = [...tagCounts]
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
	.slice(0, 2)
	.map(([t]) => t);
const nothing = {
	query: "",
	suggestions: [...catCounts.keys(), ...topTags]
		.slice(0, 6)
		.map((w) => ({ label: w.replace(/[-_]+/g, " "), href: queryHref(w) })),
};
const first = index[0];
const card = first
	? {
			no: padNo(first.no),
			category: first.category,
			minutes: first.minutes,
			words: first.words,
			month: first.month,
			year: first.year,
			rate: Math.round(first.words / first.minutes),
			title: first.title,
			blurb: first.excerpt,
			href: first.href,
		}
	: undefined;

// The timeline: one tick per month from January of the first post's year
// through December of the current year (or of the newest post's, if a post
// is dated past it), so a year label sits under every January and the
// range grows a year at a time.
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const years = index.map((p) => Number(p.year));
const firstYear = years.length ? Math.min(...years) : new Date().getUTCFullYear();
const lastYear = Math.max(new Date().getUTCFullYear(), ...years);
const timeline = {
	from: `${firstYear}-01`,
	to: `${lastYear}-12`,
	label: `timeline // ${firstYear}—${lastYear}`,
	marks: index.map((p) => ({
		month: p.ym,
		label: `${p.title}, ${cap(p.month)} ${p.year}`,
		href: p.href,
		no: padNo(p.no),
	})),
	playhead: first?.ym,
	readout: first ? `latest · ${first.month} ${first.year}` : undefined,
};
---

<BlogLayout
	title={`${BLOG_TITLE} — Tristan Timblin`}
	description={BLOG_DESCRIPTION}
	heading={BLOG_TITLE}
	bar={{ chips, count: `${index.length} posts`, readout: numeral(index.length) }}
>
	<div class="blog__row">
		<Quilt cols={COLS} rows={lg.rows} colsMd={COLS_MD} rowsMd={md.rows} aria-label="Posts">
			{index.map((p) => (
				<QuiltCell
					col={p.col}
					row={p.row}
					colMd={p.colMd}
					rowMd={p.rowMd}
					span={p.span}
					href={p.href}
					label={p.title}
					no={padNo(p.no)}
					numeral={numeral(p.no)}
					excerpt={p.span ? p.excerpt : undefined}
				>
					{art.get(p.id) && <ArtFrame svg={art.get(p.id)!} decorative variant={ART_VARIANT} />}
				</QuiltCell>
			))}
			{fillers.map((f) => (
				<QuiltCell
					col={f.at?.col}
					row={f.at?.row}
					colMd={f.atMd?.col}
					rowMd={f.atMd?.row}
					filler
					file={f.file}
					data-cell-lg={f.cell}
					data-cell-md={f.cellMd}
				>
					<ArtFrame svg={fillerArtFor(f.file)} decorative variant={ART_VARIANT} />
				</QuiltCell>
			))}
			<QuiltPanel
				id="quilt-panel"
				mode="hidden"
				col={1}
				row={1}
				card={card}
				browse={browse}
				results={{ label: "", items: [] }}
				nothing={nothing}
			/>
		</Quilt>
	</div>

	<div class="blog__row blog__timeline">
		<TimeRuler
			from={timeline.from}
			to={timeline.to}
			marks={timeline.marks}
			playhead={timeline.playhead}
			readout={timeline.readout}
			label={timeline.label}
			data-quilt-ruler
		/>
	</div>

	<script
		type="application/json"
		data-quilt-index
		set:html={JSON.stringify({
			posts: index,
			grid: { lg: { cols: COLS, rows: lg.rows }, md: { cols: COLS_MD, rows: md.rows } },
		}).replace(/</g, "\\u003c")}
	/>
	<script>
		import "../../lib/quilt";
	</script>
</BlogLayout>

