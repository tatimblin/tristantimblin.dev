---
// /txt — every post and demo, newest first: the BlogLayout shell, on the site
// container, over the expanding post stack (PostStack): the newest open, the
// rest a ruled list. Demos are interleaved by date, marked with a chip.
import BlogLayout from "../../layouts/BlogLayout.astro";
import PostStack from "../../components/txt/PostStack.astro";
import TopPosts from "../../components/txt/TopPosts.astro";
import { BLOG_DESCRIPTION, BLOG_TITLE } from "../../lib/blog";
import { getDemos, getPosts } from "../../lib/posts";

const posts = await getPosts();
const entries = [...posts, ...(await getDemos())];
---

<BlogLayout
	wide
	hero
	title={`${BLOG_TITLE} — Tristan Timblin`}
	description={BLOG_DESCRIPTION}
	heading={BLOG_TITLE}
>
	<TopPosts slot="hero-cards" posts={posts} />
	<PostStack posts={entries} />
</BlogLayout>
