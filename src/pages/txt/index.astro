---
// /txt — every post, newest first: the default BlogLayout shell over the
// expanding post stack (PostStack): the newest open, the rest a ruled list.
import BlogLayout from "../../layouts/BlogLayout.astro";
import PostStack from "../../components/txt/PostStack.astro";
import { BLOG_DESCRIPTION, BLOG_TITLE } from "../../lib/blog";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
---

<BlogLayout
	title={`${BLOG_TITLE} — Tristan Timblin`}
	description={BLOG_DESCRIPTION}
	heading={BLOG_TITLE}
>
	<PostStack posts={posts} />
</BlogLayout>
