---
// /txt — the blog's front page: an intro, then every post by year.
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import PostIndex from "../../components/txt/PostIndex.astro";
import Anchor from "@whois/design-system/Anchor";
import { BLOG_DESCRIPTION, BLOG_TITLE } from "../../lib/blog";

const posts = (await getCollection("txt")).filter(
	(post) => import.meta.env.PROD === false || !post.data.draft
);
---

<BlogLayout title={`${BLOG_TITLE} — Tristan Timblin`} description={BLOG_DESCRIPTION} heading={BLOG_TITLE}>
	<Fragment slot="lede">
		Notes from Tristan Timblin on the things I build and use: software, furniture,
		the occasional routine. Also on{" "}
		<Anchor href="https://github.com/tatimblin" underline>GitHub</Anchor>, and there is
		an <Anchor href="/rss.xml" underline>RSS feed</Anchor>.
	</Fragment>
	<PostIndex posts={posts} />
</BlogLayout>
