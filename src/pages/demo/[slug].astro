---
// /demo/<slug> — one demo, drawn by DemoLayout. Demos are numbered on their
// own (`demo / 001`), never as a txt.
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import DemoLayout from "../../layouts/DemoLayout.astro";
import { postPlaces } from "../../lib/blog";
import { getDemos } from "../../lib/posts";

export const getStaticPaths = (async () => {
	const demos = await getDemos();
	const places = postPlaces(demos);
	return demos.map((demo) => ({
		params: { slug: demo.id },
		props: { demo, no: places.get(demo.id)!.no },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { demo, no } = Astro.props;
---

<DemoLayout demo={demo} no={no} />
