---
import FullHeroLayout from "../layouts/FullHeroLayout.astro";
import StoriesHeading from "../components/StoriesHeading.astro";
import VideoCarousel from "../components/VideoCarousel.astro";
import Grid from "@whois/design-system/Grid";
import GridItem from "@whois/design-system/GridItem";
import "@whois/stories-heading/styles.css";
import "@whois/dotted-grid/styles.css";
import "@whois/video-carousel/styles.css";
---

<script>
	import "@whois/stories-heading";
	import "@whois/dotted-grid";
	import "@whois/video-carousel";
</script>

<FullHeroLayout>
	<!-- SCENE: fabric video as a dotted-grid halftone, with the "tristan"
	     wordmark straddling its bottom edge and spilling onto the page below. -->
	<dotted-grid
		slot="scene"
		class="hero__video"
		src="/videos/fabric.web.mp4"
		color="#121212"
		background="#fff"
		cell-size="8"
		dot-size="0.35"
		levels="1"
		gamma="0.45"
		contrast="0.95"
		color-reveal="0"
	>
		<h1 class="wordmark">tristan</h1>
	</dotted-grid>

	<!-- HEADING: the animated "& other stories" lockup. Its big ampersand
	     parallaxes from bottom-aligned (under "tristan") to top-aligned while the
	     outline→solid font-swap reveal wipes, both over the pin duration. -->
	<StoriesHeading slot="heading" />

	<!-- CONTENT: the page owns its grid rows here. First row — body copy (cols
	     4–7) + the video carousel (cols 9–12) — rises into the pinned lockup and
	     pushes it away. A second row or a full-bleed section would just be more
	     markup in this slot. -->
	<div class="fh-row">
		<Grid class="home__grid">
			<GridItem class="home__copy">
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
					eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad
					minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip
					ex ea commodo consequat. Duis aute irure dolor in reprehenderit in
					voluptate velit esse cillum dolore eu fugiat nulla pariatur.
				</p>
				<p>
					Excepteur sint occaecat cupidatat non proident, sunt in culpa qui
					officia deserunt mollit anim id est laborum. Sed ut perspiciatis unde
					omnis iste natus error sit voluptatem accusantium doloremque
					laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore
					veritatis et quasi architecto beatae vitae dicta sunt explicabo.
				</p>
			</GridItem>
			<GridItem class="home__rail">
				<VideoCarousel />
			</GridItem>
		</Grid>
	</div>
</FullHeroLayout>

<style>
	/* SCENE ------------------------------------------------------------- */
	/* Let the wordmark's lower half spill past the grid (the dotted-grid package
	   sets overflow:hidden; override it here). Height is inherited from
	   .fh__scene's --dotted-grid-height. */
	.hero__video {
		display: block;
		overflow: visible;
	}

	/* "tristan" lives INSIDE the scene, anchored to its bottom edge and pushed
	   down so the lower portion falls onto the page below. */
	.wordmark {
		position: absolute;
		/* Align the wordmark's left edge to the shared container-aware inset (the
		   same line the ampersand + copy rest on), even though the scene is
		   full-bleed. */
		left: var(--hero-inset);
		bottom: 0;
		margin: 0;
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: var(--wordmark-size);
		line-height: 0.82;
		letter-spacing: -0.02em;
		color: var(--text-primary);
		transform: translateY(42%);
		pointer-events: none;
		z-index: 1; /* above the grid canvas */
	}

	@media (max-width: 640px) {
		.wordmark {
			transform: translateY(30%);
		}
	}

	/* CONTENT ROW ------------------------------------------------------- */
	/* The 12-col template lives here (not the DS Grid's inline templateColumns
	   prop) so it can be media-queried; <Grid> supplies display:grid. */
	.home__grid {
		grid-template-columns: repeat(12, 1fr);
		column-gap: var(--space-5);
	}

	.home__copy {
		grid-column: 4 / span 4;
		min-width: 0;
	}

	.home__copy :global(p) {
		font-family: var(--font-serif);
		font-size: var(--font-size-4);
		line-height: 1.6;
		color: var(--text-secondary);
	}

	.home__copy :global(p + p) {
		margin-block-start: var(--space-5);
	}

	/* Video carousel on the right, lifted so it starts ABOVE the paragraph. */
	.home__rail {
		grid-column: 9 / span 4;
		grid-row: 1;
		align-self: start;
		margin-block-start: calc(-1 * var(--space-13, 128px));
		min-width: 0;
	}

	.home__rail :global(.vc) {
		width: 100%;
	}

	/* Stacked layout (≤900px): one column, in DOM order — copy then carousel. */
	@media (max-width: 900px) {
		.home__grid {
			display: block;
		}
		.home__copy {
			margin-block-start: var(--space-7);
		}
		.home__rail {
			margin-block-start: var(--space-7);
		}
	}
</style>
