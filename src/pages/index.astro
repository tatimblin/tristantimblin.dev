---
import FullHeroLayout from "../layouts/FullHeroLayout.astro";
import StoriesHeading from "../components/StoriesHeading.astro";
import Grid from "@whois/design-system/Grid";
import GridItem from "@whois/design-system/GridItem";
import WidgetGrid from "@whois/design-system/WidgetGrid";
import Widget from "@whois/design-system/Widget";
import NowPlaying from "../widgets/now-playing/NowPlaying.astro";
import BikeStats from "../widgets/bike-stats/BikeStats.astro";
import Videos from "../widgets/videos/Videos.astro";
import "@whois/stories-heading/styles.css";
import "@whois/dotted-grid/styles.css";
import "@whois/video-carousel/styles.css";
import "../widgets/widgets.css";
---

<script>
	import "@whois/stories-heading";
	import "@whois/dotted-grid";
	import "@whois/video-carousel";
</script>

<FullHeroLayout>
	<!-- SCENE: fabric video as a dotted-grid halftone — a capped banner across
	     the top of the page. -->
	<!-- No color/background attrs: the grid falls back to --color-fg / --color-bg
	     and re-samples them each frame, so it inverts with the active theme. -->
	<dotted-grid
		slot="scene"
		class="hero__video"
		src="/videos/fabric.web.mp4"
		cell-size="6"
		dot-size="1"
		levels="10"
		gamma="0.5"
		contrast="1.1"
		color-reveal="0"
		color="#7f7f7f"
	/>

	<!-- HEADING: the full-width "tristan" wordmark, then the animated
	     "& other stories" lockup. The big "&" overlaps the wordmark (indented) and
	     parallaxes + fades on its own scroll position; "other stories" pins mid-
	     viewport and wipes its outline→solid reveal. -->
	<StoriesHeading slot="heading" />

	<!-- CONTENT: the page owns its grid rows here. First row — body copy (cols
	     1–5) — rises into the pinned lockup and pushes it away. The video carousel
	     no longer lives here: it's a cell in the widget grid below that
	     parallaxes UP to visually sit alongside this row (see widgets/videos). -->
	<div class="fh-row">
		<Grid class="home__grid">
			<GridItem class="home__copy">
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
					eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad
					minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip
					ex ea commodo consequat. Duis aute irure dolor in reprehenderit in
					voluptate velit esse cillum dolore eu fugiat nulla pariatur.
				</p>
				<p>
					Excepteur sint occaecat cupidatat non proident, sunt in culpa qui
					officia deserunt mollit anim id est laborum. Sed ut perspiciatis unde
					omnis iste natus error sit voluptatem accusantium doloremque
					laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore
					veritatis et quasi architecto beatae vitae dicta sunt explicabo.
				</p>
			</GridItem>
		</Grid>
	</div>

	<!-- WIDGETS: an Apple-widgets-style grid at the foot of the page. Mixed
	     sizes in non-packed DOM order so grid-auto-flow: dense re-packs holes;
	     every cell is a DS Card. Placeholder/skeleton content for now. -->
	<div class="fh-row home__widgets">
		<WidgetGrid cols={4}>
			<Videos />

			<NowPlaying />

			<BikeStats />

			<!-- Placeholder 1×1 to fill column 3 alongside the 1×2 video cell; swap
			     for a real widget as more land. -->
			<Widget size="1x1" class="wx-soon">
				<span class="wx-soon__label">more soon</span>
			</Widget>
		</WidgetGrid>
	</div>
</FullHeroLayout>

<style>
	/* SCENE ------------------------------------------------------------- */
	/* The dotgrid banner. Height is inherited from .fh__scene's
	   --dotted-grid-height; nothing straddles its edge anymore. */
	.hero__video {
		display: block;
	}

	/* CONTENT ROW ------------------------------------------------------- */
	/* The 12-col template lives here (not the DS Grid's inline templateColumns
	   prop) so it can be media-queried; <Grid> supplies display:grid. */
	.home__grid {
		grid-template-columns: repeat(12, 1fr);
		column-gap: var(--space-5);
	}

	/* Start at the left gutter (col 1) so the copy shares a left edge with "other
	   stories"; span a readable column subset. */
	.home__copy {
		grid-column: 1 / span 5;
		min-width: 0;
	}

	.home__copy :global(p) {
		font-family: var(--font-serif);
		font-size: var(--font-size-4);
		line-height: 1.6;
		color: var(--text-secondary);
	}

	.home__copy :global(p + p) {
		margin-block-start: var(--space-5);
	}

	/* Stacked layout (≤900px): single column (only the copy lives here now). */
	@media (max-width: 900px) {
		.home__grid {
			display: block;
		}
		.home__copy {
			margin-block-start: var(--space-7);
		}
	}

	/* WIDGETS ----------------------------------------------------------- */
	.home__widgets {
		margin-block-start: var(--space-10);
		padding-block-end: var(--space-10);
	}

	/* Let each widget's slot content fill the card body below the header. */
	.home__widgets :global(.ds-widget) {
		display: flex;
		flex-direction: column;
	}

	/* Shared widget primitives (.wx-stat*) live in ../widgets/widgets.css; each
	   widget's bespoke look lives in its own module (e.g. ../widgets/now-playing/). */

	/* Placeholder tile filling column 3 until another real widget lands. */
	.home__widgets :global(.wx-soon) {
		align-items: center;
		justify-content: center;
	}
	.home__widgets :global(.wx-soon__label) {
		font-size: var(--font-size-1);
		color: var(--text-tertiary);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

</style>
