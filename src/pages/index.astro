---
import FullHeroLayout from "../layouts/FullHeroLayout.astro";
import StoriesHeading from "../components/StoriesHeading.astro";
import VideoCarousel from "../components/VideoCarousel.astro";
import Grid from "@whois/design-system/Grid";
import GridItem from "@whois/design-system/GridItem";
import WidgetGrid from "@whois/design-system/WidgetGrid";
import Widget from "@whois/design-system/Widget";
import "@whois/stories-heading/styles.css";
import "@whois/dotted-grid/styles.css";
import "@whois/video-carousel/styles.css";

// Spotify SSE proxy endpoint (Cloud Run). The <spotify-player> shows its skeleton
// state until a message arrives. The component ships its own styles (Shadow DOM);
// it's themed from here via the ::part()/--ssp-* API in the widget CSS below.
const SPOTIFY_SSE_URL = "https://spotify-stream-player-j2yxapx3oa-uk.a.run.app/";
---

<script>
	import "@whois/stories-heading";
	import "@whois/dotted-grid";
	import "@whois/video-carousel";
	import "@tristimb/spotify-stream-player";
</script>

<FullHeroLayout>
	<!-- SCENE: fabric video as a dotted-grid halftone — a capped banner across
	     the top of the page. -->
	<!-- No color/background attrs: the grid falls back to --color-fg / --color-bg
	     and re-samples them each frame, so it inverts with the active theme. -->
	<dotted-grid
		slot="scene"
		class="hero__video"
		src="/videos/fabric.web.mp4"
		cell-size="8"
		dot-size="1"
		levels="5"
		gamma="0.35"
		contrast="1.1"
		color-reveal="0"
	/>

	<!-- HEADING: the full-width "tristan" wordmark, then the animated
	     "& other stories" lockup. The big "&" overlaps the wordmark (indented) and
	     parallaxes + fades on its own scroll position; "other stories" pins mid-
	     viewport and wipes its outline→solid reveal. -->
	<StoriesHeading slot="heading" />

	<!-- CONTENT: the page owns its grid rows here. First row — body copy (cols
	     4–7) + the video carousel (cols 9–12) — rises into the pinned lockup and
	     pushes it away. A second row or a full-bleed section would just be more
	     markup in this slot. -->
	<div class="fh-row">
		<Grid class="home__grid">
			<GridItem class="home__copy">
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
					eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad
					minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip
					ex ea commodo consequat. Duis aute irure dolor in reprehenderit in
					voluptate velit esse cillum dolore eu fugiat nulla pariatur.
				</p>
				<p>
					Excepteur sint occaecat cupidatat non proident, sunt in culpa qui
					officia deserunt mollit anim id est laborum. Sed ut perspiciatis unde
					omnis iste natus error sit voluptatem accusantium doloremque
					laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore
					veritatis et quasi architecto beatae vitae dicta sunt explicabo.
				</p>
			</GridItem>
			<GridItem class="home__rail">
				<VideoCarousel />
			</GridItem>
		</Grid>
	</div>

	<!-- WIDGETS: an Apple-widgets-style grid at the foot of the page. Mixed
	     sizes in non-packed DOM order so grid-auto-flow: dense re-packs holes;
	     every cell is a DS Card. Placeholder/skeleton content for now. -->
	<div class="fh-row home__widgets">
		<WidgetGrid cols={4}>
			<Widget size="1x1" class="wx-nowplaying-widget">
				<spotify-player src={SPOTIFY_SSE_URL} layout="cover" tint></spotify-player>
			</Widget>

			<Widget size="1x1" title="Rides">
				<div class="wx-stat">
					<span class="wx-stat-num">958</span>
					<span class="wx-stat-label">rides</span>
				</div>
			</Widget>

			<Widget size="2x2" title="Feature">
				<div class="wx-block wx-block--fill"></div>
			</Widget>

			<Widget size="1x2" title="Activity">
				<div class="wx-stack">
					<span class="wx-bar wx-bar--md"></span>
					<span class="wx-bar wx-bar--sm"></span>
					<span class="wx-bar wx-bar--lg"></span>
					<span class="wx-bar wx-bar--sm"></span>
				</div>
			</Widget>

			<Widget size="1x1" variant="tertiary" class="wx-placeholder">
				<span class="wx-plus">+</span>
			</Widget>

			<Widget size="1x1" title="Miles">
				<div class="wx-stat">
					<span class="wx-stat-num">1394</span>
					<span class="wx-stat-label">miles</span>
				</div>
			</Widget>
		</WidgetGrid>
	</div>
</FullHeroLayout>

<style>
	/* SCENE ------------------------------------------------------------- */
	/* The dotgrid banner. Height is inherited from .fh__scene's
	   --dotted-grid-height; nothing straddles its edge anymore. */
	.hero__video {
		display: block;
	}

	/* CONTENT ROW ------------------------------------------------------- */
	/* The 12-col template lives here (not the DS Grid's inline templateColumns
	   prop) so it can be media-queried; <Grid> supplies display:grid. */
	.home__grid {
		grid-template-columns: repeat(12, 1fr);
		column-gap: var(--space-5);
	}

	/* Start at the left gutter (col 1) so the copy shares a left edge with "other
	   stories"; span a readable column subset. */
	.home__copy {
		grid-column: 1 / span 5;
		min-width: 0;
	}

	.home__copy :global(p) {
		font-family: var(--font-serif);
		font-size: var(--font-size-4);
		line-height: 1.6;
		color: var(--text-secondary);
	}

	.home__copy :global(p + p) {
		margin-block-start: var(--space-5);
	}

	/* Video carousel on the right, lifted so it starts near the top of the fold —
	   alongside the lockup rather than ~600px below it.

	   Two things pull it up:
	   1. The base lift (--space-13) so the carousel top sits ABOVE the paragraph.
	   2. An offset for HALF the sticky-header track. StoriesHeading's .sh__track
	      reserves scroll distance in normal flow — height =
	      --sh-reveal (300px) + --sh-hold (300px) + --sh-pin-height — and that
	      reserved block sits ABOVE this content region, pushing everything here
	      (the carousel included) further down the page. Cancelling the FULL amount
	      lifts the carousel to the very top; instead we cancel HALF (~324px) so the
	      carousel rests at the MIDPOINT of the distance "other stories" scrolls
	      through. --sh-reveal/--sh-hold default to 300px each (inlined here since
	      those custom props live on the <stories-heading> element and aren't
	      reliably in this scope); --sh-pin-height (~48px, the "other stories" line
	      height) is JS-set on that element and not readable here. Half of
	      (300 + 300 + 48) ≈ 324px. */
	.home__rail {
		grid-column: 9 / span 4;
		grid-row: 1;
		align-self: start;
		margin-block-start: calc(-1 * var(--space-13, 128px) - 324px);
		min-width: 0;
	}

	.home__rail :global(.vc) {
		width: 100%;
	}

	/* Stacked layout (≤900px): one column, in DOM order — copy then carousel. */
	@media (max-width: 900px) {
		.home__grid {
			display: block;
		}
		.home__copy {
			margin-block-start: var(--space-7);
		}
		.home__rail {
			margin-block-start: var(--space-7);
		}
	}

	/* WIDGETS ----------------------------------------------------------- */
	.home__widgets {
		margin-block-start: var(--space-10);
		padding-block-end: var(--space-10);
	}

	/* Let each widget's slot content fill the card body below the header. */
	.home__widgets :global(.ds-widget) {
		display: flex;
		flex-direction: column;
	}

	/* Clip the component's full-bleed album gradient to the card's rounded
	   corners (the tinted background bleeds to every edge). */
	.home__widgets :global(.wx-nowplaying-widget) {
		overflow: hidden;
	}

	/* Now Playing — the <spotify-player> web component is styled entirely through
	   its public API: size it to fill the card body, then map DS tokens onto the
	   component's --ssp-* custom properties + tune a couple of ::part()s. Under
	   `tint` the component paints an album-derived gradient and owns its own
	   (light) text color, so we don't set one here. Kept in :global() so Astro
	   doesn't rewrite the custom-element/::part() selectors. */
	.home__widgets :global(.wx-nowplaying-widget spotify-player) {
		display: block;
		width: 100%;
		flex: 1;
		min-height: 0;
		padding: 0; /* gradient is full-bleed; inner spacing lives on ::part(root) */
		--ssp-gap: var(--space-2);
		--ssp-title-size: var(--font-size-3);
		--ssp-subtitle-size: var(--font-size-1);
		--ssp-timestamp-size: 11px;
		--ssp-progress-height: 6px;
		--ssp-radius: var(--border-radius-2);
		/* soft/tinted bar: pale translucent white over the album gradient */
		--ssp-accent: oklch(1 0 0 / 0.9);
		--ssp-track: oklch(1 0 0 / 0.25);
	}
	/* Inner spacing so the gradient is full-bleed but art/text stay inset. */
	.home__widgets :global(.wx-nowplaying-widget spotify-player)::part(root) {
		padding: var(--space-3);
	}
	.home__widgets :global(.wx-nowplaying-widget spotify-player)::part(art) {
		border-radius: var(--border-radius-0);
		/* Reuse the card's own DS depth shadow (--card-shadow, set by
		   .ds-card--depth-N). It inherits through the shadow boundary, so the art
		   lifts with the same shadow the card uses. */
		box-shadow: var(--card-shadow);
	}
	/* The album frame clips its contents (overflow:hidden in the component); allow
	   the art's box-shadow to escape it. The art already fits the frame, so nothing
	   else is actually clipped. */
	.home__widgets :global(.wx-nowplaying-widget spotify-player)::part(album) {
		overflow: visible;
	}
	.home__widgets :global(.wx-nowplaying-widget spotify-player)::part(album-text) {
		display: none;
	}

	/* Skeleton primitives — muted rounded blocks, theme-aware via DS tokens. */
	.home__widgets :global(.wx-bar),
	.home__widgets :global(.wx-block) {
		background: oklch(from var(--border-color) l c h / 60%);
		border-radius: var(--border-radius-1);
	}

	.home__widgets :global(.wx-bar) {
		height: 12px;
	}
	.home__widgets :global(.wx-bar--lg) {
		width: 90%;
	}
	.home__widgets :global(.wx-bar--md) {
		width: 60%;
	}
	.home__widgets :global(.wx-bar--sm) {
		width: 40%;
	}

	.home__widgets :global(.wx-stat) {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: var(--space-1);
		padding: var(--space-4);
		flex: 1;
	}
	.home__widgets :global(.wx-stat-num) {
		font-family: var(--font-numeric, var(--font-mono));
		font-size: var(--font-size-7);
		font-weight: var(--font-weight-600);
		line-height: 1;
		color: var(--text-primary);
	}
	.home__widgets :global(.wx-stat-label) {
		font-size: var(--font-size-1);
		color: var(--text-tertiary);
	}

	.home__widgets :global(.wx-block--fill) {
		flex: 1;
		margin: var(--space-4);
	}

	.home__widgets :global(.wx-stack) {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--space-3);
		padding: var(--space-4);
		flex: 1;
	}

	.home__widgets :global(.wx-placeholder) {
		border-style: dashed;
	}
	.home__widgets :global(.wx-placeholder) :global(.wx-plus) {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 1;
		font-size: var(--font-size-7);
		color: var(--text-tertiary);
	}
</style>
