---
import FullHeroLayout from "../layouts/FullHeroLayout.astro";
import StoriesHeading from "../components/StoriesHeading.astro";
import SiteHeader from "../components/SiteHeader.astro";
import VideoCarousel from "../components/VideoCarousel.astro";
import Grid from "@whois/design-system/Grid";
import GridItem from "@whois/design-system/GridItem";
import WidgetGrid from "@whois/design-system/WidgetGrid";
import Widget from "@whois/design-system/Widget";
import Button from "@whois/design-system/Button";
import "@whois/design-system/styles.css";
import NowPlaying from "../widgets/now-playing/NowPlaying.astro";
import BikeStats from "../widgets/bike-stats/BikeStats.astro";
import Videos from "../widgets/videos/Videos.astro";
import "@whois/stories-heading/styles.css";
import "@whois/dotted-grid/styles.css";
import "@whois/video-carousel/styles.css";
import "@whois/wobble-text/styles.css";
import "../widgets/widgets.css";
---

<script>
	import "@whois/stories-heading";
	import "@whois/dotted-grid";
	import "@whois/video-carousel";
	import "@whois/wobble-text";
</script>

<script>
	// FLOOR WIRING (≤900px, where the carousel IS the hero scene).
	//
	// The carousel measures how much of its bottom edge its own overlay UI (date
	// scrubber ∪ caption) occupies and announces it; FullHeroLayout consumes that as
	// --hero-floor to keep the heading group clear of it. The relay is needed because
	// custom properties inherit DOWNWARD only — .fh is an ANCESTOR of the carousel, so
	// it cannot read a property set on the carousel host.
	//
	// Above 900px the carousel is display:none in the hero (fabric is the scene) and
	// reports 0-height boxes, so the floor stays 0 and the hero is a plain 100svh —
	// which is why this is gated rather than always-on.
	function wireHeroFloor() {
		const fh = document.querySelector<HTMLElement>(".fh");
		const carousel = document.querySelector<HTMLElement>(".hero-carousel");
		if (!fh || !carousel) return;

		// This module runs at script scope AND on astro:page-load, which ClientRouter
		// also fires for the FIRST load — so without a marker the same carousel gets two
		// sets of listeners, each with its own `latest`. They then disagree on a
		// media-query change and the later one wins, which can remove a floor the other
		// had correctly set (and nothing re-publishes it, since the carousel only
		// dispatches when the extent CHANGES). Wire each element exactly once.
		if (carousel.dataset.heroFloorWired) return;
		carousel.dataset.heroFloorWired = "true";

		const mq = window.matchMedia("(max-width: 900px)");

		const apply = () => {
			// Read the carousel's own published property rather than caching the event's
			// value: it is the single source of truth, so a missed/early dispatch can't
			// leave this relay stuck at 0. Falls back to the package's CSS default.
			const raw = getComputedStyle(carousel)
				.getPropertyValue("--vc-bottom-ui-extent")
				.trim();
			const extent = parseFloat(raw);
			if (mq.matches && Number.isFinite(extent) && extent > 0) {
				fh.style.setProperty("--hero-floor", `${extent.toFixed(1)}px`);
			} else {
				fh.style.removeProperty("--hero-floor");
			}
		};

		carousel.addEventListener("video-carousel:metrics", apply);
		mq.addEventListener("change", apply);
		// Apply once on wire, in case the carousel measured before this ran.
		apply();
	}

	wireHeroFloor();
	// Layout uses ClientRouter view transitions: re-wire on each navigation, since the
	// elements are replaced (the data- marker keeps a re-wire of the SAME node a no-op).
	document.addEventListener("astro:page-load", wireHeroFloor);
</script>

<!-- NB: no preloadMedia here, deliberately. Preloading the hero clip looks like an
     obvious win — <dotted-grid> only creates its <video> in connectedCallback, so
     the clip isn't requested until the page bundle has run (measured: 218ms vs a
     bundle finishing at 54ms). But A/B under 500kbps/200ms throttling showed no
     benefit (~6.5s vs ~6.0s to first halftone pixels, i.e. slightly worse, within
     noise): the clip is only ~60KB, and on this page it contends with the video
     carousel's own clips for the same connection, so promoting it just reorders the
     queue. The Layout still supports `preloadMedia` for a page whose hero asset is
     genuinely the critical path — this one's isn't. -->
<FullHeroLayout
	title="Tristan Timblin"
	description="Tristan Timblin — a craftsman who builds things to be used, finding creativity through empathetic design."
>
	<!-- SCENE: fabric video as a dotted-grid halftone — a full-viewport background
	     layer, faded at the top+bottom edges (see FullHeroLayout .fh__scene). -->
	<!-- No color/background attrs: the grid falls back to --color-fg / --color-bg
	     and re-samples them each frame, so it inverts with the active theme. -->
	<!-- `intro`: develop the halftone in on arrival, brightest dots first, so the
	     scene resolves out of the page colour instead of snapping to full strength
	     the moment the first video frame decodes. Runs once, starts at that first
	     frame, and is skipped entirely under prefers-reduced-motion.
	     No hold (intro-delay="0"): the develop-in starts immediately on the first
	     frame — kept subtle by the eased ramp and the scene's low opacity. -->
	<dotted-grid
		slot="scene"
		class="hero__video"
		src="/videos/fabric.web.mp4"
		src-webm="/videos/fabric.web.webm"
		cell-size="6"
		dot-scale="1"
		levels="10"
		gamma="0.5"
		contrast="1.1"
		color="#7f7f7f"
		intro-delay="0"
		intro="3200"
	/>

	<!-- SCENE (mobile only): the video carousel promoted into the hero as the
	     full-bleed background, replacing fabric ≤900px (see .hero-carousel styles
	     + videos.css which hides the footer copy at the same breakpoint). Portrait
	     clip cover-fills; the date ruler is pinned HORIZONTAL along the bottom edge
	     as a film scrubber, and publishes how much of that edge it occupies so the
	     heading group can rest above it (--hero-floor; see the script below). -->
	<!-- intro/introDelay match the fabric scene above so BOTH hero variants make the
	     same entrance — the halftone develops in brightest-dots-first with no hold,
	     whichever scene the breakpoint is showing. Runs once, on the first
	     clip; later clips swap in without re-developing. -->
	<VideoCarousel
		slot="scene"
		class="hero-carousel"
		orientation="horizontal"
		introDelay={0}
		intro={3200}
		xfade={1600}
		xfadeMode="threshold"
		xfadeLive
	/>

	<!-- HEADER: brand + nav, overlaying the top of the scene (z-index 4). Lives in
	     the heading slot so it renders inside the hero over the dotgrid. -->
	<SiteHeader slot="heading" />

	<!-- HEADING: the full-width "tristan" wordmark, then the animated
	     "& other stories" lockup. The big "&" overlaps the wordmark (indented) and
	     parallaxes + fades on its own scroll position; "other stories" pins mid-
	     viewport and wipes its outline→solid reveal.
	     INTRO + CTAs are passed as the default slot: they ride INSIDE the pin,
	     directly under "other stories", so the whole lockup reads as one group. -->
	<StoriesHeading slot="heading">
		<!-- A short "who I am" lede and DS Button links. Static (no reveal). The
		     parent regions opt pointers out; .hero-intro opts back in.
		     On the SAME 12-col grid as the body copy below (.home__grid) so the lede
		     shares its exact measure — cols 1–5 — instead of an eyeballed max-width;
		     the CTAs take the far columns and stay right-aligned to the gutter. -->
		<Grid class="hero-intro" align="end">
			<GridItem class="hero-intro__lede">
				<p>
					American computer programmer and human-computer interaction engineer, known
					for novel computer interfaces and high-throughput IoT systems.
				</p>
			</GridItem>
			<GridItem class="hero-intro__cta">
				<Button variant="primary" rounded as="a" href="#work">See my work</Button>
				<Button variant="secondary" rounded as="a" href="/txt">Writing</Button>
			</GridItem>
		</Grid>
	</StoriesHeading>

	<!-- CONTENT: the page owns its grid rows here. First row — body copy (cols
	     1–5) — rises into the pinned lockup and pushes it away. The video carousel
	     no longer lives here: it's a cell in the widget grid below that
	     parallaxes UP to visually sit alongside this row (see widgets/videos). -->
	<div class="fh-row">
		<Grid class="home__grid">
			<!-- Eases in as it is scrolled to. Marked on the grid CELL rather than on
			     <wobble-text> inside it, so the reveal's opacity and the element's
			     `filter` stay on separate boxes (a filter on the same element as a
			     fading ancestor is the containing-block hazard called out in
			     src/lib/reveal.ts). -->
			<GridItem class="home__copy" data-reveal>
				<wobble-text scale="2.8" speed="0.3">
					<p>
						I am a craftsman, I create things to be used. Even if they often are
						not, it is for the love of the process. My creativite nature comes
						through in an empathetic design, where with a deep understanding of
						another I can build them worlds.
					</p>
					<blockquote class="home__quote" cite="https://future-sf.com/fiction/1700/">
						I'm arrogant enough to demand the Reader's complete, total
						attention. The Reader should likewise demand that the Writer puts all
						of herself into her text, to infuse it with her soul. We deserve each
						other. It's an act of love to read and an act of love to write.
						However idealized or pretentious that may sound, it's also the
						truth.
						<cite class="home__cite">&mdash; Ken Liu, in <a class="home__cite-link" href="https://future-sf.com/fiction/1700/">&ldquo;Good Stories&rdquo;</a></cite>
					</blockquote>
					<p>
						So I build to be read. With care in what won't be seen.
					</p>
				</wobble-text>
			</GridItem>
		</Grid>
	</div>

	<!-- WIDGETS: an Apple-widgets-style grid at the foot of the page. Mixed
	     sizes in non-packed DOM order so grid-auto-flow: dense re-packs holes;
	     every cell is a DS Card. Placeholder/skeleton content for now.

	     The cells carry data-reveal so the row eases in as one staggered group when
	     scrolled to (see src/lib/reveal.ts). Order follows the VISUAL left-to-right
	     packing, which grid-auto-flow: dense makes differ from DOM order: the 1×2
	     video cell is authored first but lands in the last column, so it reveals
	     last. data-reveal-order exists for exactly this mismatch.
	     Each widget's own <Widget> forwards data-* through Card → Box, so no wrapper
	     element is needed (which would also disturb the dense packing). -->
	<div class="fh-row home__widgets">
		<WidgetGrid cols={4}>
			<Videos />

			<NowPlaying />

			<BikeStats />

			<!-- Placeholder 1×1 to fill column 3 alongside the 1×2 video cell; swap
			     for a real widget as more land. -->
			<Widget
				size="1x1"
				class="wx-soon"
				data-reveal
				data-reveal-group="widgets"
				data-reveal-order="2"
			>
				<span class="wx-soon__label">more soon</span>
			</Widget>
		</WidgetGrid>
	</div>
</FullHeroLayout>

<style>
	/* SCENE ------------------------------------------------------------- */
	/* Two stacked scene layers inside FullHeroLayout's .fh__scene (100svh absolute
	   background layer). Both fill it; only one shows per breakpoint:
	     >900px  → fabric dotgrid (.hero__video), carousel hidden.
	     ≤900px  → video carousel (.hero-carousel) full-bleed, fabric hidden;
	               the footer carousel is hidden at the same breakpoint (videos.css).
	   NB: `.hero-carousel` lands on the <video-carousel> host, which belongs to
	   VideoCarousel.astro's style scope — so these rules must be :global() to reach
	   it from here. `.hero__video` is authored in this file, so it stays scoped. */
	.hero__video {
		position: absolute;
		inset: 0;
		display: block;
		/* Dial the halftone back so it reads as a faint texture under the type rather
		   than a strong field competing with it. Keeps the dot structure; just quieter
		   against the page in both themes. */
		opacity: 0.55;
	}

	/* Desktop: fabric is the scene; the carousel lives only in the footer widget. */
	:global(.hero-carousel) {
		position: absolute;
		inset: 0;
		display: none;
	}

	@media (max-width: 900px) {
		.hero__video {
			display: none;
		}
		:global(.hero-carousel) {
			display: block;
		}

		/* Move the scene's top/bottom edge fade OFF the scene wrapper and onto the
		   carousel's video layer alone (below). A mask applies to its whole subtree
		   and nothing — no z-index — paints outside it, so leaving it on .fh__scene
		   dragged the bottom-pinned date ruler + caption into the fade-to-transparent
		   band and made the year labels unreadable. The clip still blends into the
		   page identically; only the overlay UI escapes. */
		:global(.fh__scene:has(.hero-carousel)) {
			--fh-scene-mask: none;
		}
	}

	/* FULL-BLEED HERO CAROUSEL (≤900px) --------------------------------------
	   Reach into the carousel's light-DOM .vc__* classes (mirrors videos.css) so
	   the portrait clip cover-fills the viewport and the HORIZONTAL date ruler +
	   caption pin along the bottom edge (like a film scrubber). "other stories"
	   parallaxes DOWN over this bottom strip as the lockup settles. Only rendered
	   ≤900px (display gated above); harmless above it (element is display:none). */

	/* .vc__main is a flex row (ruler + stage); here it just fills the scene box so
	   its children can absolutely position within it. */
	:global(.hero-carousel .vc__main) {
		position: absolute;
		inset: 0;
		width: 100%;
		display: block;
	}

	/* Stage (video + caption) fills the whole scene; the dotgrid shader cover-maps
	   the portrait clip so it crops to fill with no letterbox/stretch. */
	:global(.hero-carousel .vc__stage) {
		position: absolute;
		inset: 0;
		max-width: none;
		width: 100%;
		background: none;
	}
	/* THE BOTTOM DISSOLVE — ONE band, over ONE layer, covering BOTH the halftone and
	   the ruler.

	   Why it is applied to .vc__main (their shared parent) and not to each of them:
	   two separate masks CANNOT produce one fade. Each would resolve `100%` against
	   its own box, so the halftone (full-height) and the strip (~46px) get different
	   gradient geometry, and each has its own hard start edge — which is exactly the
	   "two fade-outs" artifact. Masking the common ancestor makes the dot grid and the
	   scrubber a single image that dissolves together, so there is one gesture and no
	   internal seam. Nothing may re-mask a descendant, or the second fade returns.

	   BOTTOM-ALIGNED. Both are anchored to the same bottom edge (the ruler at
	   `bottom: 0`, the halftone filling to it), so the band acts on both at the same
	   height rather than catching one before the other.

	   SIZED BY WHAT IT MUST SPARE, not by how soft it looks in isolation. Now that one
	   band acts on the clip AND the strip, its height is bounded by the strip's own
	   anatomy: the ticks stand on the bottom edge and the year labels sit above them,
	   so a band taller than the tick growth extent starts eating the labels. Measured
	   at 553x844 — the mask's alpha at the year row by band size:
	     2.4x --vc-ruler-h (109px) → 0.34   labels and ticks both nearly gone
	     1.0x --vc-ruler-h  (46px) → 0.81   labels dimmed
	     0.6x --vc-max-tick-h (14px) → 1.0  labels crisp, only the tick FEET dissolve
	   Hence the tick extent, not the strip height. It is the same length the ruler's
	   own tick-root fade used before this consolidation, which is the point: that value
	   was already tuned to dissolve feet without touching type. */
	:global(.hero-carousel) {
		--hero-vc-dissolve: calc(var(--vc-max-tick-h) * 0.6);
	}

	/* THE SINGLE MASKED LAYER. The top fade (the scene's upper edge) lives here too,
	   so the whole scene — clip + overlay UI — is one continuously masked image.

	   THE BOTTOM STOP IS NOT 78%, and that was the original bug: at 78% of the hero
	   height the band began ~120px ABOVE the bottom UI, so the caption and the entire
	   ruler sat INSIDE it. Measured at 390x844, the halftone behind the scrubber was at
	   ~9% of its mid-video strength (luminance 10.0 vs 24.6) and the ticks appeared to
	   float on flat black. Anchoring to the bottom EDGE puts the ruler at the START of
	   the dissolve instead of buried in it. */
	:global(.hero-carousel .vc__main) {
		-webkit-mask-image: linear-gradient(
			to bottom,
			transparent 0,
			#000 12%,
			#000 calc(100% - var(--hero-vc-dissolve)),
			transparent 100%
		);
		mask-image: linear-gradient(
			to bottom,
			transparent 0,
			#000 12%,
			#000 calc(100% - var(--hero-vc-dissolve)),
			transparent 100%
		);
	}

	/* The clip fills the masked layer. It carries NO mask of its own — see .vc__main
	   above: a second gradient here is what read as a second fade. */
	:global(.hero-carousel .vc__grid) {
		width: 100%;
		height: 100%;
		aspect-ratio: auto;
		-webkit-mask-image: none;
		mask-image: none;
		/* Match the desktop fabric (.hero__video): dial the halftone back so it reads as
		   a faint texture under the type. The ruler is a separate layer and keeps its
		   own (already-faint) opacity. */
		opacity: 0.55;
	}

	/* Horizontal ruler, BOTTOM-ALIGNED with the halftone so the shared dissolve on
	   .vc__main acts on both at the same height. Orientation is locked horizontal
	   (attr), so the package's horizontal tick math applies and mainSize() reads
	   clientWidth (now the scene width). The package anchors this axis baseline-down —
	   ticks stand on the ruler's bottom edge and grow upward, years above them — so the
	   shared band catches the tick FEET first and the year row last, which is what
	   makes one gradient work for the whole strip. */
	:global(.hero-carousel .vc__ruler) {
		position: absolute;
		left: 0;
		right: 0;
		/* FLUSH WITH THE CLIP'S BOTTOM EDGE. Not an inset: the ruler and the halftone
		   must share one bottom baseline, or the single mask on .vc__main reaches them at
		   different heights and the offset strip reads as a separate element fading on
		   its own schedule. The visual breathing room comes from the dissolve itself —
		   the strip's feet are already melting into the page — rather than from a gap
		   that would re-introduce that mismatch. */
		bottom: 0;
		z-index: 2;
		/* Rest the ruler faint so it reads as a subtle scrubber rather than a strong
		   band along the hero's foot; it still brightens toward full on drag/focus (the
		   package animates opacity on interaction). Matches the package's 0.5 default,
		   restated here because the hero override sits at this specificity. */
		--vc-rest-opacity: 0.5;
		/* NO MASK OF ITS OWN. The tick-root dissolve that used to live here is now part
		   of the ONE band on .vc__main: a gradient on this element resolves 100% against
		   the ~46px strip while the parent's resolves against the full scene, so the two
		   ramps disagree and the pair reads as two fades. The shared mask covers the
		   ticks' feet for free, because the strip is bottom-aligned with the clip. */
		-webkit-mask-image: none;
		mask-image: none;
		/* NO LEGIBILITY SCRIM. There used to be one here — a to-bottom black wash at
		   0.55 alpha behind the year row — and it READ AS A SECOND FADE-OUT. Measured
		   background luminance down the hero (dot pattern averaged out, UI text hidden):
		   the wash dimmed the strip to ~14, the grid then RECOVERED to ~25 just below
		   it, and only after that did the real bottom dissolve run. Two declines with a
		   brightening between them is, to the eye, two fades — the scrim's own hard top
		   edge being the first.
		   The labels do not need it. They are --color-fg over a halftone whose dots are
		   sparse and dark, and the strip now rests on unfaded grid rather than in the
		   dissolve, so contrast is carried by the ink itself. Any wash reintroduced here
		   MUST be feathered at BOTH edges (transparent → alpha → transparent), or it
		   brings the phantom second fade back with it. */
		background: none;
		/* Horizontal breathing space only. Never padding-block: the ticks and year
		   labels are absolutely positioned against the padding box (whose edges coincide
		   with the border box's), so vertical padding would shrink their room and clip
		   the year digits against the ruler's `overflow: hidden` rather than inset them.
		   The vertical edge treatment is the shared dissolve, not a gap. */
		padding-inline: var(--space-4);
	}

	/* Year labels (above their tick in horizontal mode) sit faint like the ticks. The
	   label is text — far more ink than a 1px tick — so at full --color-fg it read
	   bolder than the hairline ticks even under the ruler's shared 0.5 rest-opacity.
	   --color-muted drops its weight to match, so the whole ruler reads as one quiet
	   affordance. Legible enough now that the halftone behind it is itself dialed back. */
	:global(.hero-carousel .vc__tick-year) {
		color: var(--color-muted);
	}

	/* Caption as overlay text (no white panel): light, sitting just ABOVE the
	   bottom ruler strip. Above the video, below the heading lockup. */
	:global(.hero-carousel .vc__caption) {
		position: absolute;
		left: var(--space-4);
		right: var(--space-4);
		/* Clear the ruler strip below: its height (the strip is bottom-aligned at 0, so
		   that height IS its top edge) plus a gap. DERIVED from the package's own
		   published geometry so the two can't drift apart — the old hardcoded 56px
		   already disagreed with the real strip by ~14px.
		   Sits ABOVE the dissolve's start, so the caption stays legible while the strip
		   beneath it melts away — it is the one piece of bottom UI the shared band is
		   meant to spare. */
		bottom: calc(var(--vc-ruler-h) + var(--space-4));
		z-index: 1;
		padding: 0;
		background: none;
		color: var(--color-fg);
	}
	:global(.hero-carousel .vc__loc) {
		color: var(--text-secondary, var(--color-fg));
	}

	/* HERO INTRO + CTAs ------------------------------------------------- */
	/* Sits with the lockup in the lower-left of the first screen. The parent
	   .fh__heading opts pointers out (so its empty area doesn't block content
	   rising below); this block opts back in for its lede + buttons. */
	/* Intro lede + CTAs on the shared 12-col grid (see .home__grid): the lede
	   occupies cols 1–5 — the SAME span as the body copy below — so both blocks
	   share one measure and one left edge. The CTAs sit in the last columns,
	   right-aligned to the gutter. Stacks on the ≤900px layout. */
	/* NO top margin: .sh__sub already supplies the single --sh-heading-gap that binds
	   the intro to "other stories" as one group. A margin here stacked on top of it
	   and split the lockup in two. */
	.hero-intro {
		/* Pointers fall through the full-width box (it overlays the scene's date
		   scrubber on mobile, and its empty area would swallow the drag); the lede
		   text and buttons opt back in below. */
		pointer-events: none;
		grid-template-columns: repeat(12, 1fr);
		column-gap: var(--space-5);
	}

	.hero-intro__lede {
		/* Matches .home__copy exactly — change both together. */
		grid-column: 1 / span 5;
		min-width: 0;
	}

	.hero-intro__lede p {
		margin: 0;
		pointer-events: auto;
		/* Sans uppercase statement line (site --font-sans, the de-facto uppercase
		   recipe used by .wx-soon__label) — a quieter, more graphic register than the
		   serif it replaced, still prominent at --text-secondary. */
		font-family: var(--font-sans);
		font-size: var(--font-size-3);
		line-height: 1.5;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--text-secondary);
	}

	.hero-intro__cta {
		/* Trailing columns, contents flushed to the right gutter. */
		grid-column: 9 / span 4;
		display: flex;
		gap: var(--space-4);
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	/* The buttons themselves are the pointer targets (the wrapper opts out). */
	.hero-intro__cta :global(.ds-button) {
		pointer-events: auto;
	}

	@media (max-width: 900px) {
		/* Single column: the grid collapses, both blocks stack full-width. */
		.hero-intro {
			display: block;
		}
		.hero-intro__cta {
			margin-block-start: var(--space-5);
			justify-content: flex-start;
		}
	}

	/* CONTENT ROW ------------------------------------------------------- */
	/* The 12-col template lives here (not the DS Grid's inline templateColumns
	   prop) so it can be media-queried; <Grid> supplies display:grid. */
	.home__grid {
		grid-template-columns: repeat(12, 1fr);
		column-gap: var(--space-5);
	}

	/* Start at the left gutter (col 1) so the copy shares a left edge with "other
	   stories"; span a readable column subset. */
	.home__copy {
		grid-column: 1 / span 5;
		min-width: 0;
		padding-block-start: var(--space-5);
	}

	.home__copy :global(p) {
		font-family: var(--font-serif);
		font-size: var(--font-size-4);
		line-height: 1.6;
		color: var(--text-secondary);
	}

	.home__copy :global(p + p) {
		margin-block-start: var(--space-5);
	}

