---
import FullHeroLayout from "../layouts/FullHeroLayout.astro";
import StoriesHeading from "../components/StoriesHeading.astro";
import SiteHeader from "../components/SiteHeader.astro";
import VideoCarousel from "../components/VideoCarousel.astro";
import Grid from "@whois/design-system/Grid";
import GridItem from "@whois/design-system/GridItem";
import WidgetGrid from "@whois/design-system/WidgetGrid";
import Body from "@whois/design-system/Body";
import Text from "@whois/design-system/Text";
import NowPlaying from "../widgets/now-playing/NowPlaying.astro";
import BikeStats from "../widgets/bike-stats/BikeStats.astro";
import Github from "../widgets/github/Github.astro";
import Videos from "../widgets/videos/Videos.astro";
import Volo from "../widgets/volo/Volo.astro";
import Readers from "../widgets/readers/Readers.astro";
import "@whois/stories-heading/styles.css";
import "@whois/dotted-grid/styles.css";
import "@whois/video-carousel/styles.css";
import "@whois/wobble-text/styles.css";
---

<script>
	import "@whois/stories-heading";
	import "@whois/dotted-grid";
	import "@whois/video-carousel";
	import "@whois/wobble-text";
</script>

<script>
	// FLOOR WIRING (≤900px, where the carousel IS the hero scene).
	//
	// The carousel measures how much of its bottom edge its own overlay UI (date
	// scrubber ∪ caption) occupies and announces it; FullHeroLayout consumes that as
	// --hero-floor to keep the heading group clear of it. The relay is needed because
	// custom properties inherit DOWNWARD only — .fh is an ANCESTOR of the carousel, so
	// it cannot read a property set on the carousel host.
	//
	// Above 900px the carousel is display:none in the hero (fabric is the scene) and
	// reports 0-height boxes, so the floor stays 0 and the hero is a plain 100svh —
	// which is why this is gated rather than always-on.
	function wireHeroFloor() {
		const fh = document.querySelector<HTMLElement>(".fh");
		const carousel = document.querySelector<HTMLElement>(".hero-carousel");
		if (!fh || !carousel) return;

		// This module runs at script scope AND on astro:page-load, which ClientRouter
		// also fires for the FIRST load — so without a marker the same carousel gets two
		// sets of listeners, each with its own `latest`. They then disagree on a
		// media-query change and the later one wins, which can remove a floor the other
		// had correctly set (and nothing re-publishes it, since the carousel only
		// dispatches when the extent CHANGES). Wire each element exactly once.
		if (carousel.dataset.heroFloorWired) return;
		carousel.dataset.heroFloorWired = "true";

		const mq = window.matchMedia("(max-width: 900px)");

		const apply = () => {
			// Read the carousel's own published property rather than caching the event's
			// value: it is the single source of truth, so a missed/early dispatch can't
			// leave this relay stuck at 0. Falls back to the package's CSS default.
			const raw = getComputedStyle(carousel)
				.getPropertyValue("--vc-bottom-ui-extent")
				.trim();
			const extent = parseFloat(raw);
			if (mq.matches && Number.isFinite(extent) && extent > 0) {
				fh.style.setProperty("--hero-floor", `${extent.toFixed(1)}px`);
			} else {
				fh.style.removeProperty("--hero-floor");
			}
		};

		carousel.addEventListener("video-carousel:metrics", apply);
		mq.addEventListener("change", apply);
		// Apply once on wire, in case the carousel measured before this ran.
		apply();
	}

	wireHeroFloor();
	// Layout uses ClientRouter view transitions: re-wire on each navigation, since the
	// elements are replaced (the data- marker keeps a re-wire of the SAME node a no-op).
	document.addEventListener("astro:page-load", wireHeroFloor);
</script>

<!-- NB: no preloadMedia here, deliberately. Preloading the hero clip looks like an
     obvious win — <dotted-grid> only creates its <video> in connectedCallback, so
     the clip isn't requested until the page bundle has run (measured: 218ms vs a
     bundle finishing at 54ms). But A/B under 500kbps/200ms throttling showed no
     benefit (~6.5s vs ~6.0s to first halftone pixels, i.e. slightly worse, within
     noise): the clip is only ~60KB, and on this page it contends with the video
     carousel's own clips for the same connection, so promoting it just reorders the
     queue. The Layout still supports `preloadMedia` for a page whose hero asset is
     genuinely the critical path — this one's isn't. -->
<FullHeroLayout
	title="Tristan Timblin"
	description="Tristan Timblin — American computer programmer and human-computer interaction engineer."
>
	<!-- SCENE: fabric video as a dotted-grid halftone — a full-viewport background
	     layer, faded at the top+bottom edges (see FullHeroLayout .fh__scene). -->
	<!-- No color/background attrs, DELIBERATELY: the grid falls back to --color-fg /
	     --color-bg, so it inverts with the active theme. This carried a hardcoded
	     color="#fff" so the fold's crest could reach full white on the dark page —
	     but --color-bg in the light theme is oklch(99.24%), so white dots landed on
	     a white backdrop and the scene disappeared entirely. The highlight lift is
	     what buys that crest anyway: it pushes the brightest cells toward the
	     background's contrast pole (white on dark, black on light), which is the
	     theme-safe version of the same intent. -->
	<!-- `intro`: develop the halftone in on arrival, brightest dots first, so the
	     scene resolves out of the page colour instead of snapping to full strength
	     the moment the first video frame decodes. Runs once, starts at that first
	     frame, and is skipped entirely under prefers-reduced-motion.
	     No hold (intro-delay="0"): the develop-in starts immediately on the first
	     frame — kept subtle by the eased ramp and the grid's sparse, cut-off field. -->
	<dotted-grid
		slot="scene"
		class="hero__video"
		src="/videos/fabric.web.mp4"
		src-webm="/videos/fabric.web.webm"
		rate="0.65"
		max-dpr="1"
		cell-size="11"
		dot-scale="0.55"
		levels="14"
		gamma="0.6"
		contrast="1"
		intro-delay="0"
		intro="3200"
		cutoff="0.1"
		feather="0.4"
		denoise="1"
		crosshatch="0"
	/>

	<!-- SCENE (mobile only): the video carousel promoted into the hero as the
	     full-bleed background, replacing fabric ≤900px (see .hero-carousel styles
	     + videos.css which hides the footer copy at the same breakpoint). Portrait
	     clip cover-fills; the date ruler is pinned HORIZONTAL along the bottom edge
	     as a film scrubber, and publishes how much of that edge it occupies so the
	     heading group can rest above it (--hero-floor; see the script below). -->
	<!-- intro/introDelay match the fabric scene above so BOTH hero variants make the
	     same entrance — the halftone develops in brightest-dots-first with no hold,
	     whichever scene the breakpoint is showing. Runs once, on the first
	     clip; later clips swap in without re-developing. -->
	<!-- max-dpr: this canvas is FULL-BLEED, and the halftone's cost is per-pixel — at
	     DPR 2 on a phone that is ~1.3 Mpx re-composited on every video frame. Measured
	     at 8x CPU throttle while scrolling: 46.6ms median frame at 1.32 Mpx against
	     11.8ms at 0.33 Mpx, i.e. the canvas was roughly three quarters of the frame and
	     the cost tracks area. The footer widget's card is a fraction of the size and
	     keeps the default cap. See effectiveDpr() for why a cap of 1 does not
	     reintroduce lattice moiré (the upscale stays a whole number). -->
	<!-- HALFTONE: the finer, dimmer grid, which is NOT the component's default. Those
	     defaults suit the footer widget — a small card, viewed directly, where a coarse
	     bright grid reads as texture. Here the same clip is the full-bleed scene at 0.55
	     opacity with the wordmark on top of it, and the coarser grid competes with the
	     type instead of sitting under it. Same values the hero used before the defaults
	     moved; gamma is the component default, restated so the whole look reads in one
	     place rather than half here and half there. -->
	<!-- color: THE ONE DELIBERATE EXCEPTION to the fabric scene's "no colour, stay
	     theme-aware" note above, and the case VideoCarousel's own `color` prop doc
	     is written around. The fabric grid can drop its colour because it also runs
	     at full strength and leans on the highlight lift to reach the background's
	     contrast pole. This one doesn't: it is held at opacity 0.55 (see
	     .hero-carousel .vc__grid) so the wordmark stays legible on top of it, and
	     --color-fg at 0.55 lands close to this grey in BOTH themes anyway while
	     swinging its absolute value by the full page contrast range. A fixed mid
	     grey reads at the same weight against the near-white light backdrop and the
	     near-black dark one, which is what a scene under type wants. Pick a fixed
	     colour ONLY with that both-backdrops check done — the hardcoded #fff this
	     pattern started from is what made the light theme's scene vanish. -->
	<VideoCarousel
		slot="scene"
		class="hero-carousel"
		orientation="horizontal"
		maxDpr={1}
		cellSize={4}
		levels={10}
		gamma={0.5}
		contrast={1.1}
		color="#7f7f7f"
		introDelay={0}
		intro={3200}
		xfade={1600}
		xfadeMode="threshold"
		xfadeLive
	/>

	<!-- HEADER: brand + nav, overlaying the top of the scene (z-index 4). Lives in
	     the heading slot so it renders inside the hero over the dotgrid. -->
	<SiteHeader slot="heading" />

	<!-- HEADING: the full-width "tristan" wordmark, then the animated
	     "& other stories" lockup. The big "&" overlaps the wordmark (indented) and
	     parallaxes + fades on its own scroll position; "other stories" pins mid-
	     viewport and wipes its outline→solid reveal.
	     The INTRO is passed as the default slot: it flows directly beneath
	     "other stories" (as a static sibling of the pin, so it scrolls away with the
	     page rather than hanging pinned), and the two read as one group. -->
	<StoriesHeading slot="heading">
		<!-- A short "who I am" lede. Static (no reveal). The parent regions opt
		     pointers out; .hero-intro opts back in.
		     On the SAME 12-col grid as the body copy below (.home__grid) so the lede
		     shares its exact measure — cols 1–5 — instead of an eyeballed max-width. -->
		<Grid class="hero-intro" align="end">
			<GridItem class="hero-intro__lede">
				<!-- A RAW <p>, deliberately — NOT <Body>. This line is a sentence, but it
				     is not the reading role: it is a small uppercase statement set in the
				     sub-heading face, and every part of that (face, 14px step, 1.5 leading,
				     caps tracking) is the opposite of what --font-body-* describes. Body
				     would replace all four, and .ds-body.ds-body is (0,2,0) against this
				     file's scoped (0,1,1), so the page could not win them back. The setting
				     therefore stays whole in .hero-intro__lede p below rather than being
				     split half into props and half into CSS. -->
				<p>
					American computer programmer and human-computer interaction engineer.
				</p>
			</GridItem>
		</Grid>
	</StoriesHeading>

	<!-- CONTENT: the page owns its grid rows here. First row — body copy (cols
	     1–5) — rises into the pinned lockup and pushes it away. The video carousel
	     no longer lives here: it's a cell in the widget grid below that
	     parallaxes UP to visually sit alongside this row (see widgets/videos). -->
	<div class="fh-row">
		<Grid class="home__grid">
			<!-- Eases in as it is scrolled to. Marked on the grid CELL rather than on
			     <wobble-text> inside it, so the reveal's opacity and the element's
			     `filter` stay on separate boxes (a filter on the same element as a
			     fading ancestor is the containing-block hazard called out in
			     src/lib/reveal.ts). -->
			<GridItem class="home__copy" data-reveal>
				<!-- <Body> rather than bare <p> + a local type rule. This copy IS the
				     reading role, so it should be set by the role and nothing else: the
				     rule it replaces hand-rolled the face at --font-size-4 (18px, the
				     SUB-HEADING step) with 1.6 leading and no tracking, while post prose
				     runs the role's 16px/1.7/0.3px — so the site had two different "body
				     texts" and this was the louder one. Body takes no size prop on purpose;
				     retuning reading text is one edit in tokens.overrides.css. -->
				<wobble-text scale="3.2" speed="0.3">
					<Body>
						I am a craftsman, I create things to be used. Even if they often are
						not, it is for the love of the process. My creativite nature comes
						through in an empathetic design, where with a deep understanding of
						another I can build them worlds.
					</Body>
					<blockquote class="home__quote" cite="https://future-sf.com/fiction/1700/">
						<!-- Same role as the copy around it — the blockquote's job is to MARK
						     the passage (rule, indent, quieter ink), not to re-set the type,
						     which is why the face/size/leading have left .home__quote. The
						     quieter ink is a Body prop rather than a local colour: the role
						     already has a variant for it. -->
						<Body variant="tertiary">
							I'm arrogant enough to demand the Reader's complete, total
							attention. The Reader should likewise demand that the Writer puts
							all of herself into her text, to infuse it with her soul. We
							deserve each other. It's an act of love to read and an act of love
							to write.
						</Body>
						<!-- <Text size={1}>, not <Body>: the attribution is a label on the
						     quote, so it steps DOWN off the scale — which is exactly what Body
						     refuses to do. It replaces a `font-size: var(--font-size-2)` that
						     never applied: the DS scale is 1,3,4,5,6,7,8, so that token does
						     not exist and the declaration was invalid at computed-value time,
						     leaving the cite silently inheriting the paragraph's size. (DS
						     size 1 → --font-size-1, 14px. DS size 2 also maps to --font-size-1;
						     1 is the honest spelling.) -->
						<!-- The link inside stays a raw <a>, not <Anchor>. Anchor's only
						     underline is the `underline` variant, a HOVER-REVEALED
						     border-bottom that resolves to --accent — the inverse of this
						     mark, which is underlined at rest in the cite's own ink and only
						     changes colour on hover. .ds-anchor's `color: var(--color,
						     var(--hyperlink))` would also pull it off the quote's tertiary,
						     and both of those are (0,1,0) against a scoped (0,1,0) here, so
						     the tie would be decided by stylesheet order rather than by
						     intent. Adopting the component would mean changing the look; the
						     look is the thing being kept. -->
						<Text as="cite" size={1} variant="tertiary" class="home__cite">
							&mdash; Ken Liu, in <a class="home__cite-link" href="https://future-sf.com/fiction/1700/">&ldquo;Good Stories&rdquo;</a>
						</Text>
					</blockquote>
					<Body>
						So I build to be read. With care in what won't be seen.
					</Body>
				</wobble-text>
			</GridItem>
		</Grid>
	</div>

	<!-- WIDGETS: an Apple-widgets-style grid at the foot of the page. Mixed
	     sizes in non-packed DOM order so grid-auto-flow: dense re-packs holes;
	     every cell is a DS Widget in the instrument UI (src/widgets/*).

	     The cells carry data-reveal so the row eases in as one staggered group when
	     scrolled to (see src/lib/reveal.ts). Order follows the VISUAL left-to-right
	     packing, which grid-auto-flow: dense makes differ from DOM order: the 1×2
	     video cell is authored first but lands in the last column, so it reveals
	     last. data-reveal-order exists for exactly this mismatch.
	     Each widget's own <Widget> forwards data-* through Card → Box, so no wrapper
	     element is needed (which would also disturb the dense packing). -->
	<div class="fh-row home__widgets">
		<WidgetGrid cols={4}>
			<Videos />

			<NowPlaying />

			<BikeStats />

			<!-- 1×1 in column 3 alongside the 1×2 video cell. -->
			<Github />

			<!-- 2×2, and the first item that fits columns 1–2 of row 2 once the
			     three 1×1s have filled row 1 — so it lands bottom-left with no
			     explicit placement, purely from size + DOM order. -->
			<Volo />

			<!-- 1×1, and the only cell left once Volo has taken columns 1–2 of row
			     2 — so it lands beside it with no explicit placement, from size and
			     DOM order alone. -->
			<Readers />
		</WidgetGrid>
	</div>
</FullHeroLayout>

<style>
	/* SCENE ------------------------------------------------------------- */
	/* Two stacked scene layers inside FullHeroLayout's .fh__scene (100svh absolute
	   background layer). Both fill it; only one shows per breakpoint:
	     >900px  → fabric dotgrid (.hero__video), carousel hidden.
	     ≤900px  → video carousel (.hero-carousel) full-bleed, fabric hidden;
	               the footer carousel is hidden at the same breakpoint (videos.css).
	   NB: `.hero-carousel` lands on the <video-carousel> host, which belongs to
	   VideoCarousel.astro's style scope — so these rules must be :global() to reach
	   it from here. `.hero__video` is authored in this file, so it stays scoped. */
	.hero__video {
		position: absolute;
		inset: 0;
		display: block;
		/* FULL STRENGTH, deliberately — no opacity here. This was opacity: 0.55, to
		   keep the halftone a faint texture under the type rather than a field
		   competing with it, and it did buy that. But opacity is a blunt way to pay
		   for it: it dims the whole layer, so the dots — lifted toward the
		   background's contrast pole — capped out at 55% white and the fold's crest
		   could never actually read as white. Measured on one frame at the #fff the
		   element then hardcoded: peak luminance 145 of 255 at 0.55
		   against 255 here, while the lit area barely moves (1.2% -> 1.8% of the
		   band above the wordmark).
		   The quiet is `cutoff`'s job now (on the element below): it removes the dim
		   dots outright instead of greying every dot down, which is the same trade
		   made at the right end of the ramp. Raise that, not this, if the field ever
		   gets loud — dimming here would just take the highlights down with it. */
	}

	/* Desktop: fabric is the scene; the carousel lives only in the footer widget. */
	:global(.hero-carousel) {
		position: absolute;
		inset: 0;
		display: none;
	}

	@media (max-width: 900px) {
		.hero__video {
			display: none;
		}
		:global(.hero-carousel) {
			display: block;
		}

		/* Move the scene's top/bottom edge fade OFF the scene wrapper and onto the
		   carousel's video layer alone (below). A mask applies to its whole subtree
		   and nothing — no z-index — paints outside it, so leaving it on .fh__scene
		   dragged the bottom-pinned date ruler + caption into the fade-to-transparent
		   band and made the year labels unreadable. The clip still blends into the
		   page identically; only the overlay UI escapes. */
		:global(.fh__scene:has(.hero-carousel)) {
			--fh-scene-mask: none;
		}
	}

	/* FULL-BLEED HERO CAROUSEL (≤900px) --------------------------------------
	   Reach into the carousel's light-DOM .vc__* classes (mirrors videos.css) so the
	   portrait clip cover-fills the viewport and its overlay UI stacks along the
	   bottom edge. Only rendered ≤900px (display gated above); harmless above it
	   (element is display:none). */

	/* .vc__main is a flex row (ruler + stage); here it just fills the scene box so
	   its children can absolutely position within it. */
	:global(.hero-carousel .vc__main) {
		position: absolute;
		inset: 0;
		width: 100%;
		display: block;
	}

	/* Stage (video + caption) fills the whole scene; the dotgrid shader cover-maps
	   the portrait clip so it crops to fill with no letterbox/stretch. */
	:global(.hero-carousel .vc__stage) {
		position: absolute;
		inset: 0;
		max-width: none;
		width: 100%;
		background: none;
	}

	/* THE FOOT OF THE SCENE — three bands, stacked, read top to bottom:

	     clip  ──────────────────────────  the halftone, filling the scene
	           ░░ dissolve ░░              spent across the ruler's tick band
	     ruler  ╷ ╷╷ ╷ ╷╷╷ ╷              ticks hang from its top, growing DOWN
	            2023   2024   2025         years at the foot of the strip
	     caption  JOINED FISKER            what the clip is, dimmed to match

	   WHY THIS ORDER. The intro copy sits directly above this foot, and with the
	   caption previously ABOVE the ruler it landed immediately under the lede and
	   read as another line of hero copy rather than as a label on the video. Putting
	   the ruler between them breaks that misreading: the scrubber is unmistakably
	   chrome, so everything below it reads as belonging to the clip, not to the page.
	   The caption's rest opacity is the second half of that separation — it matches
	   the ruler (see --vc-rest-opacity) so the pair reads as one quiet band of
	   video UI, distinct from the full-strength hero type above.

	   THE DISSOLVE IS ONE BAND, ON THE CLIP ALONE. It runs from the ruler's top edge
	   down over the tick growth extent, so the ticks emerge OUT of the fading halftone
	   and the year row sits on clean page background just past its end. It must not be
	   raised to the ruler's shared parent (.vc__main): that would drag the strip and
	   the caption into the fade with it — the exact bug that put the ruler on flat
	   black, measured at 9% of mid-video halftone strength. And nothing below may
	   re-mask, or the two ramps resolve `100%` against different boxes and the pair
	   reads as two stacked fade-outs. One gradient, one layer, the clip only. */
	:global(.hero-carousel) {
		/* Inset of the whole foot from the scene's bottom edge. */
		--hero-vc-foot: var(--space-5);
		/* Separation between the ruler's year row and the caption below it. */
		--hero-vc-cap-gap: var(--space-4);
		/* The dissolve's height: EXACTLY the tick growth extent, so the fade is spent
		   by the time it reaches the year row. Sized by what it must spare, not by how
		   soft it looks in isolation — the ticks stand within this band and the labels
		   sit past its end, so a taller one starts eating the type (measured on the
		   previous, mirrored layout: at 2.4x the strip height the labels were at 0.34
		   alpha and effectively gone). */
		--hero-vc-dissolve: var(--vc-max-tick-h);
		/* Scene bottom → the ruler's TOP edge, which is where the dissolve begins.
		   DERIVED from the package's own published geometry — --vc-caption-h is
		   MEASURED per clip and per width (the text rewraps), --vc-ruler-h is the
		   strip's real height — so the three bands cannot drift apart. An earlier
		   hardcoded 56px here already disagreed with the real strip by ~14px. */
		--hero-vc-ruler-top: calc(
			var(--hero-vc-foot) + var(--vc-caption-h) + var(--hero-vc-cap-gap) +
				var(--vc-ruler-h)
		);
		/* Rest opacity for BOTH pieces of overlay UI. Declared on the HOST rather than
		   on .vc__ruler so the package's own `opacity: var(--vc-rest-opacity)` and the
		   caption rule below read ONE value and stay tied together — dimming one
		   without the other is what made the caption read as hero copy. The ruler still
		   brightens to full on drag/focus (the package animates that). */
		--vc-rest-opacity: 0.5;
	}

	/* NOT masked here — see the note above. The shared-parent mask this used to carry
	   is now on .vc__grid alone, so the ruler and caption escape the fade entirely. */
	:global(.hero-carousel .vc__main) {
		-webkit-mask-image: none;
		mask-image: none;
	}

	/* THE SINGLE MASKED LAYER: the clip. Top edge fades into the page (the scene's
	   upper edge, folded in here because .fh__scene's own mask is switched off on this
	   breakpoint); bottom edge dissolves across the tick band and is fully out by the
	   year row. */
	:global(.hero-carousel .vc__grid) {
		width: 100%;
		height: 100%;
		aspect-ratio: auto;
		/* Deliberately NOT matched to the desktop fabric any more — that scene dropped
		   its opacity so its highlights could reach full white, and buys its quiet from
		   `cutoff` instead. This one carries no cutoff (the carousel sets the grid's
		   attributes and has no reason to blank its clips' shadows), so it is still
		   dialled back the blunt way. The overlay UI is a separate layer and keeps its
		   own (already-faint) rest opacity. */
		opacity: 0.55;
		-webkit-mask-image: linear-gradient(
			to bottom,
			transparent 0,
			#000 12%,
			#000 calc(100% - var(--hero-vc-ruler-top)),
			transparent
				calc(100% - var(--hero-vc-ruler-top) + var(--hero-vc-dissolve))
		);
		mask-image: linear-gradient(
			to bottom,
			transparent 0,
			#000 12%,
			#000 calc(100% - var(--hero-vc-ruler-top)),
			transparent
				calc(100% - var(--hero-vc-ruler-top) + var(--hero-vc-dissolve))
		);
	}

	/* Horizontal ruler, lifted to sit directly ABOVE the caption. Orientation is
	   locked horizontal (attr), so the package's horizontal tick math applies and
	   mainSize() reads clientWidth (now the scene width). The package anchors this axis
	   baseline-UP — ticks hang from the ruler's top edge and grow downward, years below
	   them — which is what lets the clip's dissolve land on the tick band and be spent
	   before it reaches the type. */
	:global(.hero-carousel .vc__ruler) {
		position: absolute;
		left: 0;
		right: 0;
		/* Clear the caption below it. DERIVED from the measured caption height, not a
		   constant: the caption text changes per clip and rewraps at every width, and a
		   fixed offset would let the two collide on the wrapping case. */
		bottom: calc(
			var(--hero-vc-foot) + var(--vc-caption-h) + var(--hero-vc-cap-gap)
		);
		z-index: 2;
		/* NO MASK OF ITS OWN. The strip now sits below the clip's dissolve rather than
		   inside it, so it has nothing to fade against — and a gradient here would
		   resolve 100% against the ~46px strip while the clip's resolves against the
		   full scene, so the two ramps disagree and the pair reads as two fades. */
		-webkit-mask-image: none;
		mask-image: none;
		/* NO LEGIBILITY SCRIM. There used to be one here — a to-bottom black wash at
		   0.55 alpha behind the year row — and it READ AS A SECOND FADE-OUT: measured
		   background luminance down the hero dimmed to ~14 under the wash, RECOVERED to
		   ~25 just below it, then fell again for the real dissolve. Two declines with a
		   brightening between them is, to the eye, two fades — the scrim's own hard top
		   edge being the first. The labels do not need it: they now rest on plain page
		   background, past the end of the dissolve entirely. Any wash reintroduced here
		   MUST be feathered at BOTH edges (transparent → alpha → transparent). */
		background: none;
		/* Horizontal breathing space only. Never padding-block: the ticks and year
		   labels are absolutely positioned against the padding box (whose edges coincide
		   with the border box's), so vertical padding would shrink their room and clip
		   the year digits against the ruler's `overflow: hidden` rather than inset them.
		   The vertical separation is the foot arithmetic above, not a pad. */
		padding-inline: var(--space-4);
	}

	/* Year labels (below their tick in horizontal mode) sit faint like the ticks. The
	   label is text — far more ink than a 1px tick — so at full --color-fg it read
	   bolder than the hairline ticks even under the ruler's shared rest opacity.
	   --color-muted drops its weight to match, so the whole ruler reads as one quiet
	   affordance. */
	:global(.hero-carousel .vc__tick-year) {
		color: var(--color-muted);
	}

	/* Caption LAST, at the foot of the stack: overlay text (no white panel) below the
	   ruler, dimmed to the same rest opacity so it reads as part of the video's chrome
	   rather than as another line of the hero lede above. */
	:global(.hero-carousel .vc__caption) {
		position: absolute;
		left: var(--space-4);
		right: var(--space-4);
		bottom: var(--hero-vc-foot);
		z-index: 1;
		padding: 0;
		background: none;
		color: var(--color-fg);
		opacity: var(--vc-rest-opacity, 0.5);
	}
	:global(.hero-carousel .vc__loc) {
		color: var(--text-secondary, var(--color-fg));
	}

	/* HERO INTRO -------------------------------------------------------- */
	/* Sits with the lockup in the lower-left of the first screen. The parent
	   .fh__heading opts pointers out (so its empty area doesn't block content
	   rising below); this block opts back in for its lede. */
	/* Intro lede on the shared 12-col grid (see .home__grid): it occupies cols 1–5 —
	   the SAME span as the body copy below — so both blocks share one measure and one
	   left edge. Stacks on the ≤900px layout. */
	/* NO top margin: .sh__sub already supplies the single --sh-heading-gap that binds
	   the intro to "other stories" as one group. A margin here stacked on top of it
	   and split the lockup in two. */
	.hero-intro {
		/* Pointers fall through the full-width box (it overlays the scene's date
		   scrubber on mobile, and its empty area would swallow the drag); the lede
		   text opts back in below. */
		pointer-events: none;
		grid-template-columns: repeat(12, 1fr);
		column-gap: var(--space-5);
	}

	.hero-intro__lede {
		/* Matches .home__copy exactly — change both together. */
		grid-column: 1 / span 5;
		min-width: 0;
	}

	.hero-intro__lede p {
		margin: 0;
		pointer-events: auto;
		/* Uppercase statement line in the sub-heading face — a quieter, more graphic
		   register than the hero face above it, still prominent at --text-secondary.
		   FS Mondwest is normalised onto Migra's x-height in fonts.css, so the
		   --font-size-1 step means the same here as anywhere else.
		   The weight travels WITH the family, as every face on this site does:
		   font-synthesis-weight is off globally (global.css) and FS Mondwest ships a
		   single cut, so an unpaired family lands on whichever cut the browser guesses
		   is nearest. 400 is that cut — it IS the bold, which is the same reasoning
		   heading.css states for .ds-heading.ds-text--size-4, the DS's spelling of
		   this exact role. */
		font-family: var(--font-subheading);
		font-weight: 400;
		font-size: var(--font-size-1);
		line-height: 1.5;
		text-transform: uppercase;
		/* The site's caps tracking, not a sixth hand-typed value. Uppercase is drawn
		   to sit next to lowercase and jams when run together, so it always gets
		   tracking — and --tracking-caps is the workhorse step for small uppercase
		   marks like this one. Wider than the 0.04em it replaces (1.4px against
		   0.56px at 14px), which on a full sentence rather than a two-word label is a
		   visible loosening; it is the register this line is already going for. */
		letter-spacing: var(--tracking-caps);
		color: var(--text-secondary);
	}

	@media (max-width: 900px) {
		/* Single column: the grid collapses, the lede goes full-width. */
		.hero-intro {
			display: block;
		}
	}

	/* CONTENT ROW ------------------------------------------------------- */
	/* The 12-col template lives here (not the DS Grid's inline templateColumns
	   prop) so it can be media-queried; <Grid> supplies display:grid. */
	.home__grid {
		grid-template-columns: repeat(12, 1fr);
		column-gap: var(--space-5);
	}

	/* Start at the left gutter (col 1) so the copy shares a left edge with "other
	   stories"; span a readable column subset. */
	.home__copy {
		grid-column: 1 / span 5;
		min-width: 0;
		padding-block-start: var(--space-5);
	}

	/* NO TYPE RULE FOR THE PARAGRAPHS HERE — see the <Body> wrappers in the markup.
	   There used to be one (--font-body at --font-size-4/1.6, --text-secondary) and
	   it was a hand-rolled Body at the wrong step: 18px is the sub-heading size, so
	   this page's prose ran a full step louder than every post's. Body carries all
	   four of those declarations from the --font-body-* tokens, and its default
	   `secondary` variant is the same ink this set. It must not come back either:
	   .ds-body.ds-body is (0,2,0) and Astro scopes this file's selectors with
	   :where(), so a rule here could only fight the role from below.
	   Layout below is still the page's business. */
	.home__copy :global(p + p) {
		margin-block-start: var(--space-5);
	}

	/* Ken Liu passage set apart from the surrounding copy: same body face, but
	   indented + ruled + darker to mark it as borrowed words. NOT italic — PP
	   Mondwest has no italic cut and a synthesised oblique shears a bitmap face
	   off its pixel grid; the rule, the indent and the quieter colour already do
	   the marking.
	   MARKING ONLY — the rule, the indent, the ink. The face/size/leading that used
	   to sit here (--font-body at --font-size-3/1.6, and no letter-spacing, so it
	   quietly dropped the 0.3px the body role tracks Mondwest at) were a second
	   hand-roll of the same role the copy around it was hand-rolling; the <Body>
	   inside the element carries them now. The colour stays because it is the
	   marking, and it keeps the quote tertiary for anything that inherits rather
	   than asking for the variant (the <cite> below does ask, explicitly). */
	.home__quote {
		margin: 0;
		margin-block: var(--space-5) var(--space-6);
		padding-inline-start: var(--space-5);
		margin-inline-start: var(--space-4);
		border-inline-start: 2px solid var(--text-tertiary, currentColor);
		/* One neutral step quieter than the body (--text-secondary), so the
		   borrowed words recede. --text-primary is a blue accent in dark mode. */
		color: var(--text-tertiary);
	}

	/* Placement only. The size is <Text size={1}> and the ink is variant="tertiary";
	   what is left is where the attribution sits and the fact that it must not be
	   italic — the UA styles <cite> that way, and see the no-italic note above.
	   DESCENDANT SELECTOR, not a bare .home__cite: the element now carries .ds-text,
	   whose `margin: 0` is (0,1,0) — the same weight a scoped single class gets —
	   so the margin below would be a tie decided by stylesheet order. Qualifying it
	   with the parent makes it (0,2,0) and settles it on intent instead. */
	.home__quote .home__cite {
		display: block;
		margin-block-start: var(--space-3);
		font-style: normal;
	}

	.home__cite-link {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-thickness: from-font;
	}

	.home__cite-link:hover {
		color: var(--text-secondary);
	}

	/* Stacked layout (≤900px): single column (only the copy lives here now). */
	@media (max-width: 900px) {
		.home__grid {
			display: block;
		}
		.home__copy {
			margin-block-start: var(--space-5);
			padding-block-start: 0;
		}
	}

	/* WIDGETS ----------------------------------------------------------- */
	.home__widgets {
		margin-block-start: var(--space-10);
		padding-block-end: var(--space-10);
	}

