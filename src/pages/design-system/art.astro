---
// /design-system/art — the art catalogue. Every post's art
// (src/content/txt/<slug>.svg) and every quilt filler
// (packages/design-system/src/art/filler-NN.svg), each through the DS ArtFrame
// on both theme pages side by side, with its bytes, element count and motion,
// and an anchor per file (#<slug>) — the post-art skill's "look at it" step.
//
// The files are globbed, so a new one shows up on the next build or dev reload
// with no edit here, and a group with no files yet shows an empty state rather
// than failing. noindex: a working page, not content.
import Layout from "../../layouts/Layout.astro";
import "@whois/design-system/styles.css";
import { getCollection } from "astro:content";
import ArtFrame from "@whois/design-system/ArtFrame";
import H1 from "@whois/design-system/H1";
import H2 from "@whois/design-system/H2";
import Mono from "@whois/design-system/Mono";
import Anchor from "@whois/design-system/Anchor";
import InlineCode from "@whois/design-system/InlineCode";

const postFiles = import.meta.glob<string>("../../content/txt/*.svg", {
	query: "?raw",
	import: "default",
	eager: true,
});
const packageFiles = import.meta.glob<string>(
	"../../../packages/design-system/src/art/*.svg",
	{ query: "?raw", import: "default", eager: true },
);

const slugOf = (path: string) => path.split("/").pop()!.replace(/\.svg$/, "");

interface Piece {
	slug: string;
	title: string;
	file: string;
	svg: string;
	bytes: number;
	elements: number;
	motion: string | null;
}

// The same measures the validator budgets: bytes of the file as written
// (comments included), and elements below the root (comments excluded).
function measure(svg: string) {
	const bytes = new TextEncoder().encode(svg).length;
	const tags = svg.replace(/<!--[\s\S]*?-->/g, "").match(/<[a-zA-Z][\w:-]*/g) ?? [];
	const motion = svg.match(/data-motion="([^"]+)"/)?.[1] ?? null;
	return { bytes, elements: Math.max(0, tags.length - 1), motion };
}

const posts = (await getCollection("txt")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const titleOf = new Map(posts.map((p) => [p.id, p.data.title]));

const postPieces: Piece[] = Object.entries(postFiles)
	.map(([path, svg]) => {
		const slug = slugOf(path);
		return {
			slug,
			title: titleOf.get(slug) ?? "no post with this slug",
			file: `src/content/txt/${slug}.svg`,
			svg,
			...measure(svg),
		};
	})
	.sort((a, b) => a.slug.localeCompare(b.slug));
const withArt = new Set(postPieces.map((p) => p.slug));
const missing = posts.filter((p) => !withArt.has(p.id));

const packagePieces: Piece[] = Object.entries(packageFiles)
	.map(([path, svg]) => {
		const slug = slugOf(path);
		return {
			slug,
			title: slug === "_template" ? "the template every artwork starts from" : "quilt filler",
			file: `packages/design-system/src/art/${slug}.svg`,
			svg,
			...measure(svg),
		};
	})
	.sort((a, b) => a.slug.localeCompare(b.slug));
const fillers = packagePieces.filter((p) => p.slug.startsWith("filler-"));
const template = packagePieces.filter((p) => p.slug === "_template");

const groups: { id: string; title: string; note: string; pieces: Piece[]; empty: string }[] = [
	{
		id: "posts",
		title: `Posts (${postPieces.length} of ${posts.length})`,
		note: "src/content/txt/<slug>.svg, beside the post's .mdx.",
		pieces: postPieces,
		empty: "No post art yet. Draw one with the post-art skill.",
	},
	{
		id: "fillers",
		title: `Fillers (${fillers.length})`,
		note: "packages/design-system/src/art/filler-NN.svg, the quilt's padding tiles.",
		pieces: fillers,
		empty: "No fillers yet.",
	},
	{
		id: "template",
		title: "Template",
		note: "packages/design-system/src/art/_template.svg, the file every artwork starts from.",
		pieces: template,
		empty: "No template found.",
	},
];

const themes = ["light", "dark"] as const;
const kb = (n: number) => `${(n / 1024).toFixed(1)} KB`;
---

<Layout
	title="Art — Design System — Tristan Timblin"
	description="Every post artwork and quilt filler, in both themes, through the design system's ArtFrame."
	noindex
>
	<main class="art-cat">
		<header class="art-cat__head">
			<Mono><Anchor href="/design-system/#art" discreet arrow="left">design system</Anchor></Mono>
			<H1>Art</H1>
			<p class="art-cat__note">
				Every post's art and every quilt filler through <InlineCode>ArtFrame</InlineCode>,
				on the light and dark pages side by side, at hero and tile size. Motion is
				paused at rest and runs on hover; the toggle sets <InlineCode>data-art-play</InlineCode>
				on every frame. Link to one piece with <InlineCode>/design-system/art#&lt;slug&gt;</InlineCode>.
			</p>
			<nav class="art-cat__toc" aria-label="Art groups">
				{groups.map((g) => (
					<Mono variant="text"><Anchor href={`#${g.id}`} discreet>{g.title}</Anchor></Mono>
				))}
			</nav>
		</header>

		<label class="art-cat__toggle">
			<input type="checkbox" data-art-play-toggle />
			<Mono variant="text">play all — data-art-play on every frame</Mono>
		</label>

		{groups.map((g) => (
			<section class="art-cat__group" id={g.id} aria-labelledby={`${g.id}-h`}>
				<H2 id={`${g.id}-h`}>{g.title}</H2>
				<p class="art-cat__note"><Mono variant="text">{g.note}</Mono></p>

				{g.pieces.length === 0 ? (
					<p class="art-cat__empty"><Mono variant="text">{g.empty}</Mono></p>
				) : (
					g.pieces.map((p) => (
						<article class="art-cat__piece" id={p.slug} aria-labelledby={`${p.slug}-h`}>
							<header class="art-cat__meta">
								<Mono as="h3" variant="value" size={1} class="art-cat__slug" id={`${p.slug}-h`}>
									<a href={`#${p.slug}`} class="art-cat__self">#{p.slug}</a>
								</Mono>
								<Mono variant="text">{p.title}</Mono>
								<span class="art-cat__stats">
									<Mono variant="value">{p.bytes} B ({kb(p.bytes)})</Mono>
									<Mono variant="value">{p.elements} elements</Mono>
									<Mono variant="value">{p.motion ? `motion: ${p.motion}` : "still"}</Mono>
								</span>
								<Mono variant="text">{p.file}</Mono>
							</header>
							<div class="art-cat__themes">
								{themes.map((t) => (
									<div class={`maximeheckel-${t} art-cat__page`}>
										<Mono>{t} page</Mono>
										<ArtFrame svg={p.svg} label={`${p.slug} on the ${t} page, hero size`} data-art-entry />
										<ArtFrame
											svg={p.svg}
											label={`${p.slug} on the ${t} page, tile size`}
											class="art-cat__tile"
											data-art-entry
										/>
									</div>
								))}
							</div>
						</article>
					))
				)}

				{g.id === "posts" && missing.length > 0 && (
					<div class="art-cat__missing">
						<Mono>no art yet</Mono>
						<ul>
							{missing.map((p) => (
								<li><Mono variant="text">{p.id} — {p.data.title}</Mono></li>
							))}
						</ul>
					</div>
				)}
			</section>
		))}
	</main>
	<script>
		// The play toggle: data-art-play on every frame, the attribute the frame's
		// motion runs under. Re-bound on each navigation (the site uses the client
		// router).
		function bindArtPlay() {
			const toggle = document.querySelector<HTMLInputElement>("[data-art-play-toggle]");
			if (!toggle) return;
			const sync = () => {
				for (const frame of document.querySelectorAll<HTMLElement>("[data-art-entry]")) {
					frame.toggleAttribute("data-art-play", toggle.checked);
				}
			};
			toggle.addEventListener("change", sync);
			sync();
		}
		document.addEventListener("astro:page-load", bindArtPlay);
	</script>
</Layout>

<style>
	.art-cat {
		max-width: 1200px;
		margin-inline: auto;
		padding: var(--space-10) var(--space-6);
		color: var(--text-primary);
	}
	.art-cat__head {
		display: grid;
		gap: var(--space-3);
		margin-bottom: var(--space-6);
	}
	.art-cat__note {
		max-width: 68ch;
		margin: 0;
		font-size: var(--font-size-1);
		line-height: var(--line-height-ui);
		color: var(--text-tertiary);
	}
	.art-cat__toc {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
	}
	.art-cat__toggle {
		position: sticky;
		top: var(--space-2);
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3);
		margin-bottom: var(--space-6);
		background: var(--background);
		border: 1px solid var(--hairline);
		border-radius: var(--border-radius-1);
		cursor: pointer;
	}
	.art-cat__toggle input {
		accent-color: var(--accent);
	}
	.art-cat__group {
		display: grid;
		gap: var(--space-4);
		margin-bottom: var(--space-10);
		scroll-margin-top: var(--space-8);
	}
	.art-cat__empty {
		margin: 0;
		padding: var(--space-6);
		border: 1px dashed var(--hairline);
		border-radius: var(--border-radius-1);
	}
	.art-cat__piece {
		display: grid;
		gap: var(--space-3);
		padding-top: var(--space-5);
		border-top: 1px solid var(--hairline);
		scroll-margin-top: var(--space-8);
	}
	.art-cat__piece:target .art-cat__self {
		color: var(--accent);
	}
	.art-cat__meta {
		display: grid;
		gap: var(--space-1);
	}
	.art-cat__slug {
		margin: 0;
	}
	.art-cat__self {
		color: var(--text-primary);
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	.art-cat__self:hover {
		color: var(--accent);
	}
	.art-cat__stats {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-4);
	}
	/* The two theme pages side by side: each wrapper's theme class
	   re-resolves the ART block (and every other themed token) in scope. */
	.art-cat__themes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--space-4);
	}
	.art-cat__page {
		display: grid;
		gap: var(--space-3);
		align-content: start;
		padding: var(--space-4);
		background: var(--background);
		color: var(--text-primary);
		border: 1px solid var(--hairline);
		border-radius: var(--border-radius-1);
	}
	.art-cat__page :global(.art-cat__tile) {
		width: 230px;
		max-width: 100%;
	}
	.art-cat__missing ul {
		margin: var(--space-2) 0 0;
		padding-left: var(--space-5);
	}
	@media (max-width: 640px) {
		.art-cat {
			padding: var(--space-8) var(--space-4);
		}
	}
</style>
