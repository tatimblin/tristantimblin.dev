---
// /design-system/glyphs — the glyph tile sheet. Every registered glyph
// (GLYPH_NAMES: a baked recipe or a hand-drawn file) and a spread of every
// generator's variants, each in a GlyphTile captioned `<family>·NN name`
// with how it is made (R recipe, H hand-drawn, G generator, T html text),
// grouped by family A–I under RuleLabels — G is the readouts, the HTML
// text that sits in a tile where a mark would; then two L3 compositions
// (the signal chain and a readouts panel). An anchor per tile —
// #glyph-<name>, #gen-<component>-<n>, #readout-<component>-<n> — as the
// art page has one per file.
//
// Glyph files are read from the registry, so a new one shows up on the next
// build with no edit here: FAMILY below places it (unknown → F, controls).
// The generator spread is listed by hand, since its point is the variants.
// The sheet follows the page's theme; the switch at the top puts it on the
// other page (the theme class on the sheet, as ThemePage does). noindex: a
// working page, not content.
import Layout from "../../layouts/Layout.astro";
import Heading from "@whois/design-system/Heading";
import Mono from "@whois/design-system/Mono";
import Anchor from "@whois/design-system/Anchor";
import Chip from "@whois/design-system/Chip";
import Flex from "@whois/design-system/Flex";
import RuleLabel from "@whois/design-system/RuleLabel";
import Stat from "@whois/design-system/Stat";
import Glyph from "@whois/design-system/Glyph";
import GlyphTile from "@whois/design-system/GlyphTile";
import Wave from "@whois/design-system/Wave";
import Envelope from "@whois/design-system/Envelope";
import Filter from "@whois/design-system/Filter";
import Curve from "@whois/design-system/Curve";
import Gauge from "@whois/design-system/Gauge";
import Dial from "@whois/design-system/Dial";
import Ladder from "@whois/design-system/Ladder";
import Segments from "@whois/design-system/Segments";
import Selector from "@whois/design-system/Selector";
import Progress from "@whois/design-system/Progress";
import Fan from "@whois/design-system/Fan";
import Rings from "@whois/design-system/Rings";
import Matrix from "@whois/design-system/Matrix";
import ReadoutStack from "@whois/design-system/ReadoutStack";
import Formula from "@whois/design-system/Formula";
import NumberStream from "@whois/design-system/NumberStream";
import ArtFrame from "@whois/design-system/ArtFrame";
import ThemePage from "@whois/design-system/ThemePage";
import { GLYPH_NAMES, glyphSvg, type GlyphName } from "@whois/design-system/glyphs";
import { typeSpecimen } from "@whois/design-system/art/specimen.ts";

type FamilyKey = "A" | "B" | "C" | "D" | "E" | "F" | "G" | "H" | "I";
type Kind = "R" | "H" | "G" | "T";

const FAMILIES: Record<FamilyKey, string> = {
	A: "Waves",
	B: "Curves",
	C: "Instruments",
	D: "Routing",
	E: "Fields",
	F: "Controls",
	G: "Readouts",
	H: "Iso parts",
	I: "Bold shapes",
};

// Where each glyph FILE sits; a name not listed is a control (F).
const FAMILY: Partial<Record<GlyphName, FamilyKey>> = {
	bezier: "B",
	"phase-cross": "A",
	"phase-invert": "B",
	ramp: "B",
	"sample-hold": "A",
	shelf: "B",
	"sine-lock": "A",
	"sine-square": "A",
	transient: "A",
	waveshaper: "B",
	clock: "C",
	"colour-bars": "C",
	"knob-notch": "C",
	"ladder-switch": "C",
	loader: "C",
	scale: "C",
	skyline: "C",
	"switch-ladder": "C",
	crossfade: "D",
	junction: "D",
	leader: "D",
	loop: "D",
	mixer: "D",
	patch: "D",
	"ring-in": "D",
	"ring-out": "D",
	send: "D",
	switch: "D",
	wire: "D",
	distort: "E",
	"dot-rain": "E",
	halo: "E",
	orbit: "E",
	pendulum: "E",
	radar: "E",
	registration: "E",
	reticle: "E",
	rgb: "E",
	scatter: "E",
	target: "E",
	cards: "F",
	eject: "F",
	key: "F",
	power: "F",
	slider: "F",
	battery: "H",
	cone: "H",
	handset: "H",
	"iso-shell": "H",
	joystick: "H",
	pcb: "H",
	rotary: "H",
	screw: "H",
	spring: "H",
	burst: "I",
	"checker-warp": "I",
	"iso-stripes": "I",
	petals: "I",
	"stripe-disc": "I",
	swirl: "I",
	"tri-bands": "I",
};

const KIND_NAME: Record<Kind, string> = { R: "recipe", H: "hand-drawn", G: "generator", T: "html text" };
const ENTRY_KIND: Record<Kind, string> = { R: "glyph", H: "glyph", G: "generator", T: "readout" };

// A baked file starts with the bake's header; anything else was drawn by hand.
const BAKED = /^\s*<!-- baked from recipes\/[\w-]+\.ts — edit the recipe -->/;
const WIDE = /viewBox="0 0 96 32"/;

interface Entry {
	id: string;
	name: string;
	family: FamilyKey;
	kind: Kind;
	wide?: boolean;
	// A capitalised variable is a component in Astro's markup.
	Comp: any;
	props: Record<string, unknown>;
	/** The default slot's text (a Chip's word). */
	text?: string;
}

const glyphEntries: Entry[] = GLYPH_NAMES.map((name) => {
	const svg = glyphSvg(name);
	return {
		id: `glyph-${name}`,
		name,
		family: FAMILY[name] ?? "F",
		kind: BAKED.test(svg) ? "R" : "H",
		wide: WIDE.test(svg),
		Comp: Glyph,
		props: { name },
	};
});

// The generator spread: [family, component name, Component, name, props, wide?]
const spread: [FamilyKey, string, any, string, Record<string, unknown>, boolean?][] = [
	["A", "wave", Wave, "sine", { shape: "sine" }],
	["A", "wave", Wave, "saw", { shape: "saw" }],
	["A", "wave", Wave, "square", { shape: "square" }],
	["A", "wave", Wave, "triangle", { shape: "triangle" }],
	["A", "wave", Wave, "noise", { shape: "noise" }],
	["A", "wave", Wave, "burst", { shape: "burst" }],
	["B", "envelope", Envelope, "adsr", {}],
	["B", "envelope", Envelope, "ar", { a: 0.1, d: 0, s: 1, h: 0.2, r: 0.4 }],
	["B", "filter", Filter, "lowpass", { type: "lp" }],
	["B", "filter", Filter, "highpass", { type: "hp" }],
	["B", "filter", Filter, "bandpass", { type: "bp", q: 3 }],
	["B", "filter", Filter, "notch", { type: "notch" }],
	["B", "curve", Curve, "automation", {}],
	[
		"B",
		"curve",
		Curve,
		"curve smooth",
		{ points: [[6, 24], [16, 9], [25, 22], [34, 7], [42, 17]], smooth: true, dotted: false, nodes: false, paint: "blue" },
	],
	["C", "segments", Segments, "segments 8", { value: "20260929" }, true],
	["C", "gauge", Gauge, "gauge", { value: 0.62, label: "Level" }],
	["C", "gauge", Gauge, "gauge 180", { value: 0.35, sweep: 180, paint: "blue" }],
	["C", "dial", Dial, "dial", { value: 0.38, label: "Frequency" }],
	["C", "dial", Dial, "dial 9", { value: 0.5, ticks: 9, sweep: 180, paint: "red" }],
	["C", "ladder", Ladder, "ladder", { value: 0.66 }],
	["C", "ladder", Ladder, "ladder h", { lit: 4, steps: 6, axis: "horizontal", paint: "green", label: "Signal" }],
	["C", "segments", Segments, "segments", { value: "045" }],
	["C", "selector", Selector, "selector", {}],
	["C", "selector", Selector, "selector spin", { n: 6, active: 2, spin: true }],
	["C", "progress", Progress, "progress", { value: 0.62, label: "Progress" }],
	["C", "progress", Progress, "progress solid", { value: 0.3, dotted: false, paint: "blue" }],
	["D", "fan", Fan, "split", {}],
	["D", "fan", Fan, "merge", { n: 3, dir: "merge" }],
	["D", "fan", Fan, "spread", { n: 6, dotted: true }],
	["E", "matrix", Matrix, "matrix 6×10", { rows: 6, cols: 10, on: "1011001110;0100110001;1110011010;0011100101;1001011100;0110100011" }, true],
	["E", "rings", Rings, "unison", {}],
	["E", "rings", Rings, "unison fade", { n: 3, fade: true }],
	["E", "rings", Rings, "concentric", { mode: "concentric", n: 3, dotted: 2, accent: "blue" }],
	["E", "matrix", Matrix, "matrix", { hot: [2, 2] }],
	["E", "matrix", Matrix, "x grid", { rows: 3, cols: 3, mark: "x", on: "100;010;001", cursor: [1, 1] }],
];

const genCount: Record<string, number> = {};
const genEntries: Entry[] = spread.map(([family, component, Comp, name, props, wide]) => {
	const n = (genCount[component] = (genCount[component] ?? 0) + 1);
	return { id: `gen-${component}-${n}`, name, family, kind: "G", wide: !!wide, Comp, props };
});
const components = Object.keys(genCount);

// The readouts (G): HTML text in a tile, where a mark would sit — the
// components, and Chip's two tags. [component name, Component, name, props, text?]
const readouts: [string, any, string, Record<string, unknown>, string?][] = [
	["stack", ReadoutStack, "sample rate", { values: ["32.0k", "44.1k", "96.0k"], active: 1, "aria-label": "Sample rate" }],
	["stack", ReadoutStack, "division", { values: ["1/4", "1/8", "1/16"], active: 2, "aria-label": "Division" }],
	["formula", Formula, "unit delay", { value: "z^-1" }],
	["formula", Formula, "cubic", { value: "x^3" }],
	["formula", Formula, "cutoff", { value: "f_c", label: "cutoff frequency" }],
	["stream", NumberStream, "stream", {}],
	["stream", NumberStream, "stream motion", { seed: 42, rows: 3, digits: 8, motion: true }],
	["tag", Chip, "telematic", { tone: "accent" }, "Telematic"],
	["tag", Chip, "replace", { variant: "arrow" }, "Replace"],
	["tag", Chip, "replace accent", { variant: "arrow", tone: "accent" }, "Replace"],
];
const readoutCount: Record<string, number> = {};
const readoutEntries: Entry[] = readouts.map(([component, Comp, name, props, text]) => {
	const n = (readoutCount[component] = (readoutCount[component] ?? 0) + 1);
	return { id: `readout-${component}-${n}`, name, family: "G", kind: "T", Comp, props, text };
});

// Generators lead a family, files follow in the registry's order; a wide
// tile goes first so it starts a row and the grid never leaves a hole.
const groups = (Object.keys(FAMILIES) as FamilyKey[])
	.map((key) => {
		const all = [...genEntries, ...glyphEntries, ...readoutEntries].filter((e) => e.family === key);
		const entries = [...all.filter((e) => e.wide), ...all.filter((e) => !e.wide)];
		return { key, title: FAMILIES[key], entries };
	})
	.filter((g) => g.entries.length > 0);

// The type specimen: six HUD modules on one art plate (packages/design-
// system/src/art/specimen.ts), held to the art profile by its test.
const specimen = typeSpecimen();

const no = (i: number) => String(i + 1).padStart(2, "0");
const kinds = (entries: Entry[]) =>
	(["G", "R", "H", "T"] as Kind[])
		.map((k) => [k, entries.filter((e) => e.kind === k).length] as const)
		.filter(([, n]) => n > 0)
		.map(([k, n]) => `${n} ${k}`)
		.join(" · ");
---

<Layout
	title="Glyphs — Design System — Tristan Timblin"
	description="Every micrographic glyph and generator variant, in keycap tiles, grouped by family."
	noindex
>
	<main class="glyph-sheet-page">
		<header class="glyph-sheet-page__head">
			<Mono><Anchor href="/design-system/#glyphs" discreet arrow="left">design system</Anchor></Mono>
			<Heading as="h1" size={5} responsive>Glyphs</Heading>
			<p class="glyph-sheet-page__note">
				Every registered glyph and a spread of every generator, each in a <code>GlyphTile</code> captioned <code>family·NN name</code> and marked by how it is made: <strong>R</strong> a recipe baked from the L0 kit, <strong>H</strong> hand-drawn, <strong>G</strong> a generator drawn from props, <strong>T</strong> HTML text — the G family, the readouts that sit in a tile where a mark would. Then two L3 compositions. Hover a tile to play its motion. Link to one tile with <code>/design-system/glyphs#glyph-&lt;name&gt;</code> or <code>#gen-&lt;component&gt;-&lt;n&gt;</code>.
			</p>
			<p class="glyph-sheet-page__note">
				<Mono variant="value">{glyphEntries.length} glyphs · {genEntries.length} generator variants of {components.length} components</Mono>
			</p>
			<nav class="glyph-sheet-page__toc" aria-label="Glyph families">
				{groups.map((g) => (
					<Mono variant="text"><Anchor href={`#family-${g.key}`} discreet>{`${g.key} ${g.title}`}</Anchor></Mono>
				))}
				<Mono variant="text"><Anchor href="#type-modules" discreet>Type &amp; modules</Anchor></Mono>
				<Mono variant="text"><Anchor href="#modules" discreet>L3 modules</Anchor></Mono>
			</nav>
		</header>

		<div class="glyph-sheet-page__controls">
			<Flex gap={2} role="group" aria-label="Sheet theme">
				<Mono variant="text">sheet on</Mono>
				{(["page", "light", "dark"] as const).map((t) => (
					<Chip as="button" type="button" data-sheet-theme={t} aria-pressed={t === "page" ? "true" : "false"}>
						{t === "page" ? "this page" : `${t} page`}
					</Chip>
				))}
			</Flex>
			<label class="glyph-sheet-page__toggle">
				<input type="checkbox" data-sheet-play />
				<Mono variant="text">play all</Mono>
			</label>
		</div>

		<div class="glyph-sheet" data-glyph-sheet>
			{groups.map((g) => (
				<section class="glyph-sheet__family" id={`family-${g.key}`} aria-labelledby={`family-${g.key}-h`}>
					<RuleLabel role="heading" aria-level="2" no={g.key} id={`family-${g.key}-h`}>
						{g.title}
						<Mono slot="meta" variant="text">{kinds(g.entries)}</Mono>
					</RuleLabel>
					<div class="glyph-sheet__grid">
						{g.entries.map((e, i) => (
							<GlyphTile
								id={e.id}
								wide={e.wide}
								class="glyph-sheet__tile"
								data-glyph-entry={ENTRY_KIND[e.kind]}
								data-kind={e.kind}
							>
								{e.text ? <e.Comp {...e.props}>{e.text}</e.Comp> : <e.Comp {...e.props} />}
								<Flex as="span" slot="label" justifyContent="space-between" gap={2}>
									<span class="glyph-sheet__name">
										<Mono tone="primary">{g.key}·{no(i)}</Mono> {e.name}
									</span>
									<Chip title={KIND_NAME[e.kind]}>{e.kind}</Chip>
								</Flex>
							</GlyphTile>
						))}
					</div>
				</section>
			))}

			<section class="glyph-sheet__family" id="type-modules" aria-labelledby="type-modules-h">
				<RuleLabel role="heading" aria-level="2" no="T" id="type-modules-h">
					Type &amp; modules
					<Mono slot="meta" variant="text">one art plate · the kit's type + module helpers</Mono>
				</RuleLabel>
				<p class="glyph-sheet-page__note">
					Six modules of a HUD module sheet on one 320×180 art plate, drawn with <code>kit("art")</code>: a node label over a rule (<code>k.text</code>, <code>k.rule</code>, <code>ids</code>), a big thin numeral (<code>art-numeral</code>), a bracketed state and a routed pill (<code>k.bracketLabel</code>), a section head over a dotted rule with a readout (<code>k.section</code>, <code>k.readout</code>), a line glyph with its fields (<code>part()</code>), and the bold shapes, placed on <code>grid(3, 2, 12, 14)</code>. It passes the art profile. At the hero width and at a small tile's, on each page.
				</p>
				<div class="glyph-specimen">
					{(["dark", "light"] as const).map((t) => (
						<ThemePage theme={t}>
							<div class="glyph-specimen__pair">
								<ArtFrame svg={specimen} label="Type specimen: six HUD modules on one plate" class="glyph-specimen__hero" data-specimen="hero" />
								<ArtFrame svg={specimen} decorative class="glyph-specimen__tile" data-specimen="tile" />
							</div>
						</ThemePage>
					))}
				</div>
			</section>

			<section class="glyph-sheet__family" id="modules" aria-labelledby="modules-h">
				<RuleLabel role="heading" aria-level="2" no="L3" id="modules-h">
					Module · signal chain
					<Mono slot="meta" variant="text">glyph tiles + html labels</Mono>
				</RuleLabel>
				<div class="glyph-chain-wrap">
					<div class="glyph-chain" aria-label="Signal chain: speed, amount, dest, p.dest" role="group">
						<GlyphTile label="Speed"><Dial value={0.3} /></GlyphTile>
						<div class="glyph-chain__wire" aria-hidden="true"><Glyph name="junction" /><Mono>&nbsp;</Mono></div>
						<GlyphTile label="Amount">
							<Glyph name="amp" />
							<span slot="readout" class="glyph-chain__readout">34</span>
						</GlyphTile>
						<div class="glyph-chain__wire" aria-hidden="true"><Glyph name="junction" /><Mono>&nbsp;</Mono></div>
						<GlyphTile label="Dest">
							<span class="glyph-chain__stack"><Envelope a={0.08} d={0.3} s={0.35} h={0.2} r={0.3} paint="ink" /></span>
						</GlyphTile>
						<div class="glyph-chain__wire" aria-hidden="true"><Glyph name="junction" /><Mono>&nbsp;</Mono></div>
						<GlyphTile label="P.Dest"><Selector /></GlyphTile>
					</div>
				</div>
			</section>

			<section class="glyph-sheet__family" aria-labelledby="readouts-h">
				<RuleLabel role="heading" aria-level="2" no="L3" id="readouts-h">
					Module · readouts
					<Mono slot="meta" variant="text">the G readouts + a glyph</Mono>
				</RuleLabel>
				<div class="glyph-readouts">
					<div class="glyph-readouts__cell">
						<Stat variant="numeral" value="45" label="Phonic" />
						<Chip variant="arrow" tone="accent">Replace</Chip>
					</div>
					<div class="glyph-readouts__cell glyph-readouts__cell--centre">
						<Dial value={0.38} size={12} label="Freq" />
						<Mono>Freq</Mono>
					</div>
					<div class="glyph-readouts__cell">
						<Stat variant="numeral" value="45" label="Baud" />
						<Chip tone="accent">Telematic</Chip>
					</div>
					<div class="glyph-readouts__cell glyph-readouts__cell--centre">
						<ReadoutStack values={["32.0k", "44.1k", "96.0k"]} active={1} aria-label="Sample rate" />
						<Mono>Rate</Mono>
					</div>
					<div class="glyph-readouts__cell">
						<Formula value="z^-1" />
						<Chip variant="arrow">Delay</Chip>
					</div>
					<div class="glyph-readouts__cell">
						<NumberStream motion />
						<Mono>Stream</Mono>
					</div>
				</div>
			</section>
		</div>
	</main>
	<script>
		import { onPage } from "@whois/design-system/lib/lifecycle";

		// The sheet's theme (the theme class on the sheet, re-resolving every
		// themed token inside, as ThemePage does) and play-all (data-art-play on
		// the sheet, which every glyph under it obeys). Bound with onPage: the
		// site uses the client router, and the teardown drops the listeners.
		function bindGlyphSheet() {
			const sheet = document.querySelector<HTMLElement>("[data-glyph-sheet]");
			if (!sheet) return;
			const ac = new AbortController();
			const { signal } = ac;
			const buttons = document.querySelectorAll<HTMLButtonElement>("[data-sheet-theme]");
			for (const b of buttons) {
				b.addEventListener("click", () => {
					const t = b.dataset.sheetTheme;
					sheet.classList.remove("maximeheckel-light", "maximeheckel-dark");
					if (t === "light" || t === "dark") sheet.classList.add(`maximeheckel-${t}`);
					sheet.toggleAttribute("data-themed", t !== "page");
					for (const o of buttons) o.setAttribute("aria-pressed", String(o === b));
				}, { signal });
			}
			const play = document.querySelector<HTMLInputElement>("[data-sheet-play]");
			play?.addEventListener("change", () => sheet.toggleAttribute("data-art-play", play.checked), { signal });
			return () => ac.abort();
		}
		onPage(bindGlyphSheet);
	</script>
</Layout>

<style>
	.glyph-sheet-page {
		max-width: var(--container-max);
		margin-inline: auto;
		padding: var(--space-10) var(--space-6);
		color: var(--text-primary);
	}
	.glyph-sheet-page__head {
		display: grid;
		gap: var(--space-3);
		margin-bottom: var(--space-6);
	}
	.glyph-sheet-page__note {
		max-width: var(--measure-note);
		margin: 0;
		font-size: var(--font-size-1);
		line-height: var(--line-height-ui);
		color: var(--text-tertiary);
	}
	.glyph-sheet-page__note strong {
		color: var(--text-primary);
	}
	.glyph-sheet-page__toc {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
	}
	/* The controls: sticky under the top edge, as the art page's toggle is. */
	.glyph-sheet-page__controls {
		position: sticky;
		top: var(--space-2);
		z-index: 2;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-5);
		inline-size: fit-content;
		max-inline-size: 100%;
		padding: var(--space-2) var(--space-3);
		margin-bottom: var(--space-6);
		background: var(--background);
		border: 1px solid var(--hairline);
		border-radius: var(--border-radius-1);
	}
	.glyph-sheet-page__toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		cursor: pointer;
	}
	.glyph-sheet-page__toggle input {
		accent-color: var(--accent);
	}

	/* THE SHEET. Its own page colour and ink, so a theme class on it (the
	 * switch) repaints it as a ThemePage would; on the page's own theme it is
	 * the page. */
	.glyph-sheet {
		display: grid;
		gap: var(--space-9);
		background: var(--background);
		color: var(--text-primary);
		border-radius: var(--border-radius-1);
	}
	.glyph-sheet[data-themed] {
		padding: var(--space-5);
		border: 1px solid var(--hairline);
	}
	.glyph-sheet__family {
		display: grid;
		gap: var(--space-4);
		scroll-margin-top: var(--space-10);
	}
	/* Six across, three on a tablet, two on a phone; a wide tile spans two. */
	.glyph-sheet__grid {
		--glyph-tile-gap: var(--space-4);
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: var(--space-5) var(--glyph-tile-gap);
	}
	@media (max-width: 1023px) {
		.glyph-sheet__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	@media (max-width: 639px) {
		.glyph-sheet__grid {
