---
// /privacy — what the site counts and who counts it, in a few plain sentences.
// On BlogLayout's plain shell (the reading measure under a page header), like
// the 404. The footer's privacy line links here.
import BlogLayout from "../layouts/BlogLayout.astro";
import Body from "@whois/design-system/Body";
import Anchor from "@whois/design-system/Anchor";
---

<BlogLayout
	title="Privacy — Tristan Timblin"
	description="What this site counts, and who counts it."
	kicker="Privacy /"
	heading="No cookies"
>
	<Fragment slot="lede">
		This site sets no cookies and has no accounts or ads.
	</Fragment>
	<div class="privacy">
		<Body>
			It is hosted on Cloudflare, which serves the pages and, like any host, sees the requests
			made to it.
		</Body>
		<Body>
			Page views are counted by <Anchor href="https://www.goatcounter.com" external>GoatCounter</Anchor>,
			without cookies and without storing your IP address. It records which page was read, the
			referring site, and the browser, screen size and country, and nothing that identifies you.
			The visitor and read counts shown on this site come from it.
		</Body>
		<Body>
			For now, Cloudflare Web Analytics, which is also cookieless, runs alongside it.
		</Body>
	</div>
</BlogLayout>

<style>
	.privacy {
		display: grid;
		gap: var(--space-5);
	}
</style>
