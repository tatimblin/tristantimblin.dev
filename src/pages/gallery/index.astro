---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import GalleryGridItem from "../../components/GalleryGridItem.astro";
import H1 from "@whois/design-system/H1";
import Body from "@whois/design-system/Body";
// Tokens are global (Layout imports them); component CSS is NOT. One import per
// page that renders DS components — this one also covers the <Text> inside
// GalleryGridItem, which is why the child doesn't import it again.
import "@whois/design-system/styles.css";

const items = (await getCollection("gallery")).sort(
	(a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout
	title="Gallery — Tristan Timblin"
	description="A gallery of images and videos by Tristan Timblin."
>
	<main class="gallery-page">
		<header class="gallery-header">
			<H1 class="gallery-title">Gallery</H1>
		</header>

		{
			items.length > 0 ? (
				<div class="gallery-grid">
					{items.map((item) => (
						<GalleryGridItem
							slug={item.id}
							title={item.data.title}
							media={item.data.media}
							type={item.data.type}
							poster={item.data.poster}
							alt={item.data.alt}
						/>
					))}
				</div>
			) : (
				/* tertiary, not Body's default secondary: this is the quiet "nothing
				   here" line, and the rule it replaces set --color-muted, which the
				   legacy bridge aliases straight onto --text-tertiary. Same ink. */
				<Body variant="tertiary">No items yet.</Body>
			)
		}
	</main>
</Layout>

<style>
	.gallery-page {
		max-width: var(--container-max);
		margin-inline: auto;
		padding-inline: var(--container-pad);
		padding-block: var(--space-7);
	}

	/* Positions the heading and nothing else — <H1> owns its own type now.
	   The rule that used to sit here set font-size: var(--font-size-3xl), which is
	   global.css's legacy clamp(2rem, 5vw, 3.5rem) alias rather than a step on the
	   DS scale, plus a bare font-weight: 700 and no font-family at all (so the face
	   came from the bare-h1 fallback). Three separate decisions where the heading
	   role is one: .ds-heading sets family and weight together — they have to
	   travel as a pair, Migra being one family with a 500 and a 700 cut — along
	   with display leading and the -0.02em tracking the bare h1 already carried. */
	.gallery-header {
		margin-bottom: var(--space-7);
	}

	/* The page title stays FLUID, now anchored to the scale at both ends instead of
	   to the legacy clamp's off-scale 3.5rem. <H1> alone resolves to a flat 32px
	   (--font-size-7), which quietly demoted a 56px page title to the size of a post
	   headline — a redesign, not a systematisation, so the fluidity comes back here.
	   Top end is --font-size-8 (44px), the scale's largest step; /txt's lead headline
	   clamps between the same two, so the site's two big page titles now behave
	   alike.
	   TWO simple selectors deliberately: font-size arrives from .ds-text--size-7 at
	   (0,1,0), which is exactly what Astro's :where()-scoped single class gets, so a
	   lone .gallery-title would be a stylesheet-order tie rather than a win. */
	.gallery-header .gallery-title {
		font-size: clamp(var(--font-size-7), 5vw, var(--font-size-8));
	}

	/* --space-5 is 24px, exactly what the legacy --grid-gap knob was worth. It is
	   spelled as the DS step here and in GalleryGridItem's bottom margin so the
	   masonry gutter stays square from ONE token instead of two names for it. */
	.gallery-grid {
		column-count: 3;
		column-gap: var(--space-5);
	}

	@media (min-width: 640px) {
		.gallery-grid {
			column-count: 4;
		}
	}

	@media (min-width: 1024px) {
		.gallery-grid {
			column-count: 5;
		}
	}
</style>
