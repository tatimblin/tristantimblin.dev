---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Heading from "@whois/design-system/Heading";
import Anchor from "@whois/design-system/Anchor";
import Text from "@whois/design-system/Text";
// Tokens are global (Layout imports them); component CSS is not — one import per
// page that renders DS components.
import "@whois/design-system/styles.css";

export const getStaticPaths = (async () => {
	const items = await getCollection("gallery");
	return items.map((item) => ({
		params: { slug: item.id },
		props: { item },
	}));
}) satisfies GetStaticPaths;

const { item } = Astro.props;
const { title, date, media, type, poster, alt } = item.data;
const formattedDate = new Date(date).toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
// Tailor the social card to this item: use its own image (a video's poster, or
// the image itself). Falls back to the site default /og.png when neither exists.
const cardImage = type === "video" ? poster : media;
---

<Layout
	title={`${title} — Gallery`}
	description={alt}
	image={cardImage}
>
	<main class="detail-page">
		<nav class="detail-nav">
			<!-- The same back-link affordance TxtPostLayout uses, and now literally the
			     same component: Anchor's arrow="left" variant draws the arrow as a
			     masked icon in currentColor that slides on hover, which is what the
			     hand-rolled &larr; glyph was standing in for. Going through the
			     component also means this link is colored by the DS hyperlink/accent
			     pair rather than by a page rule. -->
			<Anchor href="/gallery" arrow="left">Gallery</Anchor>
		</nav>

		<!-- data-reveal on the FIGURE, not the media: the child carries a
		     `transition:name` for the view transition from the grid, and animating a
		     named element's own opacity would be captured mid-fade in the snapshot.
		     This is the page's main subject, so it is eager (no lazy loading) — the
		     reveal only smooths its arrival. -->
		<figure class="detail-media" data-reveal>
			{
				type === "video" ? (
					<video
						src={media}
						poster={poster}
						controls
						autoplay
						muted
						aria-label={alt}
						transition:name={`gallery-${item.id}`}
					/>
				) : (
					<img
						src={media}
						alt={alt}
						decoding="async"
						transition:name={`gallery-${item.id}`}
					/>
				)
			}
			<figcaption class="detail-caption">
				{/* size 3 → --font-size-6 (24px), the step this caption title already
				    carried. Plain <H1> would have resolved to 32px and grown the
				    caption a step for no reason other than the component's default. */}
				<Heading as="h1" size={3}>{title}</Heading>
				{/* The date is a meta mark, not prose, so it is a Text rather than a
				    Body: size 3 (16px) and variant tertiary are exactly what the rule
				    this replaces spelled as --font-size-base and --color-muted. */}
				<Text as="time" size={3} variant="tertiary" datetime={date.toISOString().split("T")[0]}>
					{formattedDate}
				</Text>
			</figcaption>
		</figure>
	</main>
</Layout>

<style>
	.detail-page {
		max-width: var(--container-max);
		margin-inline: auto;
		padding-inline: var(--container-pad);
		padding-block: var(--space-6);
	}

	/* Only the gap under the nav — the link inside is an Anchor and brings its own
	   color, hover and underline behaviour. */
	.detail-nav {
		margin-bottom: var(--space-5);
	}

	.detail-media {
		margin: 0;
	}

	.detail-media img,
	.detail-media video {
		display: block;
		width: 100%;
		max-height: 80vh;
		object-fit: contain;
		border-radius: var(--border-radius-2);
	}

	.detail-caption {
		margin-top: var(--space-5);
	}

	/* Only the gap under the title; <H1> owns its type. TWO simple selectors
	   (0,1,1) rather than one (0,1,0) on purpose: Astro scopes with :where(), so a
	   lone class here would tie with .ds-text's `margin: 0` and be decided by
	   stylesheet order. Nesting it under the caption wins outright, no !important. */
	.detail-caption h1 {
		margin-bottom: var(--space-2);
	}
</style>
