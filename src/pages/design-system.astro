							<span class="ds-demo__swatch ds-demo__swatch--on" style="background: var(--accent); color: var(--on-accent)">Aa</span>
						) : name === "--focus-ring" ? (
							<span class="ds-demo__swatch" style="outline: var(--focus-ring); outline-offset: var(--focus-ring-offset)" />
						) : (
							<span class="ds-demo__swatch" style={`background: var(${name})`} />
