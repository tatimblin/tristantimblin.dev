				))}
			</Grid>

			<Text size={1} variant="secondary" style="margin-top:20px; display:block;">
				1 col → 2 (sm) → 3 (md) → 4 (lg), via CSS media queries
			</Text>
			<Grid class="ds-bp-grid" gap={4} style="margin-top:6px;">
				{Array.from({ length: 4 }).map((_, i) => (
					<GridItem class="ds-cell">{i + 1}</GridItem>
				))}
			</Grid>
			<Text size={1} variant="tertiary" style="margin-top: var(--space-2); display:block;">
				current: <span class="ds-bp-readout"></span>
			</Text>
		</section>

		<section class="ds-demo__section">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">VisuallyHidden</Heading>
			<Text size={3}>There is a hidden label after this:</Text>
			<VisuallyHidden>screen-reader only text</VisuallyHidden>
		</section>
	</main>
	<script>
		import { onPage } from "@whois/design-system/lib/lifecycle";

		// Live token editor: reflect each control onto an inline custom property on
		// <html>, which overrides the class-scoped stylesheet so the catalogue below
		// updates instantly. "Copy config" exports only the changed tokens as JSON,
		// split into root/themed so the agent can drop them into tokens.overrides.css.
		function initTokenControls(signal: AbortSignal) {
			const panelEl = document.querySelector<HTMLElement>("[data-token-controls]");
			if (!panelEl) return;
			// Rebound so the narrowing reaches the nested function declarations.
			const panel = panelEl;

			const root = document.documentElement;
			const scopeOf = (varName: string): "root" | "themed" => {
				const fs = panel
					.querySelector(`[data-var="${varName}"]`)
					?.closest<HTMLElement>("[data-scope]");
				return (fs?.dataset.scope as "root" | "themed") ?? "themed";
			};
			const currentTheme = () => (root.dataset.theme === "dark" ? "dark" : "light");

			// Resolve any CSS color (incl. oklch) to #rrggbb by painting a pixel and
			// reading its bytes — canvas serializes oklch as "oklch(...)", not hex, so
			// we sample the rasterized RGB instead. Returns null on an unparseable value.
			const canvas = document.createElement("canvas");
			canvas.width = canvas.height = 1;
			const canvasCtx = canvas.getContext("2d", { willReadFrequently: true });
			const hex2 = (n: number) => n.toString(16).padStart(2, "0");
			const toHex = (color: string): string | null => {
				if (!canvasCtx) return null;
				// Reject values the canvas can't parse (it keeps the prior fillStyle).
				canvasCtx.fillStyle = "#000000";
				canvasCtx.fillStyle = color;
				if (canvasCtx.fillStyle === "#000000" && !/^(#000000|black)$/i.test(color.trim()))
					return null;
				canvasCtx.clearRect(0, 0, 1, 1);
				canvasCtx.fillRect(0, 0, 1, 1);
				const [r, g, b] = canvasCtx.getImageData(0, 0, 1, 1).data;
				return `#${hex2(r)}${hex2(g)}${hex2(b)}`;
			};

			// Changed tokens keyed by var name → { value, scope }. Empty = pristine.
			const changed = new Map<string, { value: string; scope: "root" | "themed" }>();
			const baselines = new Map<string, string>();

			// Seed every control from the resolved baseline for the active theme.
			function seed() {
				// Drop any live-preview overrides we set (leave other inline styles alone).
				for (const varName of changed.keys()) root.style.removeProperty(varName);
				changed.clear();
				baselines.clear();
				const cs = getComputedStyle(root);

				panel.querySelectorAll<HTMLInputElement>("[data-var]").forEach((input) => {
					const varName = input.dataset.var!;
					const base = cs.getPropertyValue(varName).trim();
					baselines.set(varName, base);

					const role = input.dataset.role;
					if (input.type === "range") {
						input.value = parseFloat(base).toString();
						const out = panel.querySelector<HTMLElement>(`[data-out="${varName}"]`);
						if (out) out.textContent = base;
					} else if (role === "value") {
						input.value = base; // text field holds the true (maybe oklch) value
					} else if (role === "swatch") {
						const hex = toHex(base);
						if (hex) input.value = hex;
					}
				});

				const nameEl = panel.querySelector<HTMLElement>("[data-theme-name]");
				if (nameEl) nameEl.textContent = currentTheme();
			}

			function apply(varName: string, value: string) {
				root.style.setProperty(varName, value);
				const base = baselines.get(varName);
				if (base !== undefined && value === base) changed.delete(varName);
				else changed.set(varName, { value, scope: scopeOf(varName) });
			}

			panel.querySelectorAll<HTMLInputElement>("[data-var]").forEach((input) => {
				const varName = input.dataset.var!;
				input.addEventListener("input", () => {
					if (input.type === "range") {
						const value = input.value + (input.dataset.unit || "");
						const out = panel.querySelector<HTMLElement>(`[data-out="${varName}"]`);
						if (out) out.textContent = value;
						apply(varName, value);
					} else if (input.dataset.role === "swatch") {
						// Mirror the picker into the paired text field (the source of truth).
						const text = panel.querySelector<HTMLInputElement>(
							`input[data-var="${varName}"][data-role="value"]`,
						);
						if (text) text.value = input.value;
						apply(varName, input.value);
					} else {
						// Text field: keep the swatch in sync when the value is hex-able.
						const swatch = panel.querySelector<HTMLInputElement>(
							`input[data-var="${varName}"][data-role="swatch"]`,
						);
						const hex = toHex(input.value);
						if (swatch && hex) swatch.value = hex;
						apply(varName, input.value);
					}
				}, { signal });
			});

			const copyBtn = panel.querySelector<HTMLButtonElement>("[data-copy]");
			copyBtn?.addEventListener("click", async () => {
				const rootTokens: Record<string, string> = {};
				const themed: Record<string, string> = {};
				for (const [varName, { value, scope }] of changed) {
					(scope === "root" ? rootTokens : themed)[varName] = value;
				}
				const config = {
					// :root tokens go in the overrides; themed ones in the theme's file.
					target: "packages/design-system/src/tokens/tokens.overrides.css",
					themeTarget: `packages/design-system/src/tokens/themes/${currentTheme()}.css`,
					theme: currentTheme(),
					root: rootTokens,
					themed,
				};
				const json = JSON.stringify(config, null, 2);
				try {
					await navigator.clipboard.writeText(json);
				} catch {
					// Clipboard blocked (e.g. insecure context): log so it's still grabbable.
					console.log(json);
				}
				const label = copyBtn.textContent;
				copyBtn.textContent = changed.size ? "Copied!" : "No changes";
				setTimeout(() => (copyBtn.textContent = label), 1200);
			}, { signal });

			panel
				.querySelector<HTMLButtonElement>("[data-reset]")
				?.addEventListener("click", () => seed(), { signal });

			seed();
			// Re-seed when the theme flips. Watch the attribute itself rather than the
			// footer's `themechange` event: data-theme on <html> IS the theme, and any
			// writer (the toggle, the init script after a swap, a test) moves it.
			const themeWatch = new MutationObserver(() => seed());
			themeWatch.observe(root, { attributes: true, attributeFilter: ["data-theme"] });
			signal.addEventListener("abort", () => themeWatch.disconnect());
		}

		// The Faces demo: the pill moves aria-hidden between the two faces.
		function initFacesDemo(signal: AbortSignal) {
			const button = document.querySelector<HTMLButtonElement>("[data-faces-demo]");
			const faces = document.querySelectorAll<HTMLElement>("[data-faces-demo-stack] > .ds-face");
			button?.addEventListener("click", () => {
				for (const face of faces) {
					face.setAttribute("aria-hidden", String(face.getAttribute("aria-hidden") !== "true"));
				}
			}, { signal });
		}

		// The art demo: the checkbox sets data-art-play on every demo frame, the
		// attribute ArtFrame's `play` sets.
		function initArtDemo(signal: AbortSignal) {
			const toggle = document.querySelector<HTMLInputElement>("[data-art-play-toggle]");
			const frames = document.querySelectorAll<HTMLElement>("[data-art-demo]");
			toggle?.addEventListener("change", () => {
				for (const frame of frames) frame.toggleAttribute("data-art-play", toggle.checked);
			}, { signal });
		}

		// Bound with onPage: on every page load (the client router swaps the
		// DOM), every listener on the bind's signal, so the teardown before a
		// swap removes them — the theme observer on <html> included.
		onPage(() => {
			const ac = new AbortController();
			initTokenControls(ac.signal);
			initFacesDemo(ac.signal);
			initArtDemo(ac.signal);
			return () => ac.abort();
		});
	</script>
</Layout>

<style>
	/* The catalogue is the site container wide. */
	.ds-demo {
		max-width: var(--container-max);
		margin-inline: auto;
		padding: var(--space-10) var(--space-6);
		color: var(--text-primary);
	}
	/* Keep the catalogue clear of the floating token panel (a Knobs, a
	   --space-14 column inset by --space-4) above the compact step, where it
	   docks to the bottom instead. */
	@media (min-width: 901px) {
		.ds-demo {
			margin-inline: 0 auto;
			padding-right: calc(var(--space-14) + var(--space-4) + var(--space-8));
		}
	}
	/* The catalogue's own headings are DS Headings — the page title at the
	   page-title step (size 5, responsive), the sections at size 2 in the
	   secondary ink; only their spacing is the page's. */
	.ds-demo__title {
		margin-bottom: var(--space-8);
	}
	.ds-demo__section {
		padding-block: var(--space-6);
		border-top: var(--border);
	}
	.ds-demo__rule-labels {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
		gap: var(--space-5) var(--space-6);
	}
	.ds-demo__h {
		margin-bottom: var(--space-4);
	}
	/* A sub-heading inside a section: the next block of the same section. A
	   bare h2, so set a step under the section's own Heading (size 2) — the
	   global h2 is the post's section head, far too loud here. */
	.ds-demo__h--sub {
		margin-top: var(--space-7);
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: var(--font-size-3);
		line-height: var(--line-height-ui);
		color: var(--text-secondary);
	}

	/* Instrument token swatches: a square of the token beside its name and job. */
	.ds-demo__swatches {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: var(--space-3) var(--space-6);
	}
	.ds-demo__swatch-row {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}
	.ds-demo__swatch {
		flex: none;
		inline-size: var(--space-6);
		block-size: var(--space-6);
		border-radius: var(--border-radius-0);
		border: var(--border);
	}
	.ds-demo__swatch--on {
		display: inline-grid;
		place-items: center;
		font-family: var(--font-code);
		font-size: var(--font-size-0);
		line-height: 1;
	}

	/* Art swatches: the ink and the fills are only ever seen on the plate, so
	   each sits on a plate square. */
	.ds-demo__swatch--art {
		display: grid;
		place-items: center;
		background: var(--art-plate);
		border-color: var(--art-edge);
	}
	.ds-demo__swatch--art > i {
		display: block;
		inline-size: 60%;
		block-size: 60%;
		border-radius: var(--border-radius-tile);
		background: var(--swatch);
	}
	/* A small (230px) frame beside a
	   hero-width frame: the same file, the same 1px line. */
	.ds-demo__art-sizes {
		display: grid;
		grid-template-columns: 230px minmax(0, 1fr);
		gap: var(--space-4);
		align-items: start;
	}
	/* The edge specimen's prose: the paragraph and the slab a step apart. */
	.ds-demo__edge-prose {
		display: grid;
		gap: var(--space-3);
	}
	/* The template on each theme's page (ThemePage), side by side. */
	.ds-demo__art-themes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--space-4);
	}
	.ds-demo__art-toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
		cursor: pointer;
	}
	.ds-demo__art-toggle input {
		accent-color: var(--accent);
	}
	.ds-demo__art-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
		gap: var(--space-4);
	}
	.ds-demo__art-fig {
		margin: 0;
		display: grid;
		gap: var(--space-2);
	}
	.ds-demo__art-cap {
		display: grid;
		gap: var(--space-1);
	}
	.ds-demo__art-link {
		display: block;
		border-radius: var(--art-radius);
	}
	.ds-demo__art-link:focus-visible {
		outline: var(--focus-ring);
		outline-offset: var(--focus-ring-offset);
	}
	/* The glyph size row: the steps on one baseline, each captioned. */
	.ds-demo__glyph-sizes {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: var(--space-6);
		margin-top: var(--space-5);
	}
	.ds-demo__glyph-size {
		margin: 0;
		display: grid;
		gap: var(--space-2);
		justify-items: center;
	}
	@media (max-width: 640px) {
		.ds-demo__art-sizes {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.ds-demo__note {
		max-width: var(--measure-note);
		margin-block: calc(-1 * var(--space-3)) var(--space-5);
		font-size: var(--font-size-1);
		line-height: var(--line-height-ui);
		/* The subtle ink, not the tertiary: the tertiary is the dashed edge's
		   grey, ~2.2:1 on cream — fine for a rule, too faint for a paragraph. */
		color: var(--text-subtle);
	}

	.ds-demo__note code {
		font-family: var(--font-code);
	}

	/* One row per face: the token that selects it, what it is, where it goes, and a
	   specimen set in it. The specimen is last so the four line up for comparison. */
	.ds-demo__face {
		display: grid;
		grid-template-columns: minmax(0, 18ch) minmax(0, 17ch) minmax(0, 1fr);
		gap: var(--space-2) var(--space-4);
		align-items: baseline;
		width: 100%;
	}

	.ds-demo__face-token {
		font-family: var(--font-code);
		font-size: var(--font-size-1);
		color: var(--accent);
	}

	.ds-demo__face-name {
		font-size: var(--font-size-1);
		color: var(--text-secondary);
	}

	.ds-demo__face-use {
		font-size: var(--font-size-1);
		color: var(--text-tertiary);
	}

	.ds-demo__face-specimen {
		grid-column: 1 / -1;
		font-size: var(--font-size-7);
		line-height: var(--line-height-heading);
		color: var(--text-primary);
	}

	@media (max-width: 767px) {
		.ds-demo__face {
			grid-template-columns: 1fr;
		}
	}

	/* Grid demo cells — a visible box so columns + gutters read clearly. */
	.ds-cell {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: var(--space-9);
		padding: var(--space-2);
		background: var(--blue-400);
		border-radius: var(--border-radius-1);
		font-family: var(--font-ui);
		font-size: var(--font-size-1);
		color: var(--text-primary);
	}
	.ds-cell--head {
		min-height: var(--space-6);
		background: var(--gray-300);
		color: var(--text-tertiary);
	}

	/* Breakpoint grid: column count steps at the DS breakpoints. */
	.ds-bp-grid {
		grid-template-columns: 1fr;
	}
	@media (min-width: 640px) {
		.ds-bp-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 768px) {
		.ds-bp-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	@media (min-width: 1024px) {
		.ds-bp-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	/* Pure-CSS breakpoint readout (mirrors the media queries above). */
