// ── Token control panel ─────────────────────────────────────────────────────
// A three.js/lil-gui-style panel that live-edits the DS tokens driving every
// component below. Utility tokens (--space-*, --border-radius-*, --font-*) are
// defined on :root; color tokens are defined per-theme on .maximeheckel-*. The
// `scope` field tells the copy-config export (and the agent applying it) which
// selector each token belongs under in tokens.overrides.css.
type TokenControl = {
	var: string; // CSS custom property, e.g. "--accent"
	label: string;
	type: "color" | "length" | "number";
	min?: number;
	max?: number;
	step?: number;
	unit?: string; // appended to slider value, e.g. "px"
};
type TokenGroup = {
	title: string;
	scope: "root" | "themed"; // :root vs .maximeheckel-<theme>
	controls: TokenControl[];
};

