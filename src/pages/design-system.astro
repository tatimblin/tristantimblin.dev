	["--radius-box", "the one corner (2.5px): a card, a chip, a code block, an image"],
	["--shadow-panel", "the 1px tinted ring under a panel (--panel-outline)"],
	["--panel-header-bg", "a panel header's fill: the card fading into the first wash"],
