// A sixteen-step sequencer row, for the tile grid: which steps are on.
const steps = [1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0].map(Boolean);
const graphValues = [2, 3, 3, 4, 6, 5, 7, 9, 8, 11, 13, 12, 16, 18, 21, 25];

const textSizes = [0, 1, 3, 4, 5, 6, 7, 8, 9] as const;
const textVariants = ["default", "primary", "secondary", "tertiary"] as const;
const families = ["default", "ui", "heading", "body", "hero", "code"] as const;
const iconNames = [
	"chevron",
	"check",
	"arrow",
	"external",
	"info",
	"alert",
	"github",
	"play",
	"pause",
	"code",
	"copy",
	"command",
	"search",
] as const;
const iconVariants = ["default", "primary", "secondary", "tertiary"] as const;

// ── Token control panel ─────────────────────────────────────────────────────
// A three.js/lil-gui-style panel that live-edits the DS tokens driving every
// component below. Utility tokens (--space-*, --border-radius-*, --font-*) are
// defined on :root; color tokens are defined per-theme on [data-theme="…"]
// (tokens/themes/*.css). The `scope` field tells the copy-config export (and
// the agent applying it) which file and selector each token belongs under.
type TokenControl = {
	var: string; // CSS custom property, e.g. "--accent"
	label: string;
	type: "color" | "length" | "number" | "text"; // text: a keyword or a composite
	min?: number;
	max?: number;
	step?: number;
	unit?: string; // appended to slider value, e.g. "px"
};
type TokenGroup = {
	title: string;
	scope: "root" | "themed"; // :root vs [data-theme="<theme>"]
	controls: TokenControl[];
};

const px = { type: "length", unit: "px" } as const;
const TOKEN_GROUPS: TokenGroup[] = [
	{
		title: "Semantic (theme colors)",
		scope: "themed",
		controls: [
			{ var: "--accent", label: "accent", type: "color" },
			{ var: "--on-accent", label: "on-accent", type: "color" },
			{ var: "--background", label: "background", type: "color" },
			{ var: "--text-primary", label: "text-primary", type: "color" },
			{ var: "--text-secondary", label: "text-secondary", type: "color" },
			{ var: "--text-tertiary", label: "text-tertiary", type: "color" },
			{ var: "--border-color", label: "border-color", type: "color" },
			{ var: "--card-background", label: "card-background", type: "color" },
			{ var: "--danger", label: "danger", type: "color" },
			{ var: "--warning", label: "warning", type: "color" },
			{ var: "--success", label: "success", type: "color" },
			{ var: "--hyperlink", label: "hyperlink", type: "color" },
			{ var: "--text-subtle", label: "text-subtle", type: "color" },
			{ var: "--wash-1", label: "wash-1", type: "color" },
		],
	},
	{
		// The edge's colours: the dashed rule and the ring under a panel.
		title: "Edges (theme)",
		scope: "themed",
		controls: [
			{ var: "--border-color", label: "border-color", type: "color" },
			{ var: "--panel-outline", label: "panel-outline", type: "color" },
			{ var: "--panel-header-bg", label: "panel-header-bg", type: "text" },
		],
	},
	{
		// How every box is drawn: one width, one dash, one corner.
		title: "Edges",
		scope: "root",
		controls: [
			{ var: "--border-width", label: "border-width", min: 0, max: 4, step: 0.5, ...px },
			{ var: "--border-style", label: "border-style", type: "text" },
			{ var: "--radius-box", label: "radius-box", min: 0, max: 16, step: 0.5, ...px },
		],
	},
	{
		title: "Code",
		scope: "themed",
		controls: [
			{ var: "--code-bg", label: "code-bg", type: "color" },
			{ var: "--code-fg", label: "code-fg", type: "color" },
			{ var: "--code-snippet-background", label: "code-snippet-bg", type: "color" },
		],
	},
	{
		title: "Links",
		scope: "root",
		controls: [
			{ var: "--link-decoration", label: "link-decoration", type: "text" },
			{ var: "--link-decoration-hover", label: "link-decoration-hover", type: "text" },
			{ var: "--link-underline-offset", label: "underline-offset", min: 0, max: 8, step: 0.5, ...px },
			{ var: "--link-underline-thickness", label: "underline-thickness", min: 0, max: 4, step: 0.5, ...px },
			{ var: "--duration-standard", label: "duration-standard", type: "number", min: 0, max: 1000, step: 10, unit: "ms" },
			{ var: "--ease-standard", label: "ease-standard", type: "text" },
		],
	},
	{
		// The halftones' ink: <dotted-grid> re-reads its tone when <html>'s style
		// changes, so a drag here re-inks the grids live, paused ones included.
		title: "Halftone",
		scope: "themed",
		controls: [
			{ var: "--halftone-ink", label: "halftone-ink", type: "color" },
			{ var: "--halftone-ink-soft", label: "halftone-ink-soft", type: "color" },
		],
	},
	{
		title: "Spacing",
		scope: "root",
		controls: [
			{ var: "--space-2", label: "space-2", min: 0, max: 32, step: 1, ...px },
			{ var: "--space-3", label: "space-3", min: 0, max: 48, step: 1, ...px },
			{ var: "--space-4", label: "space-4", min: 0, max: 64, step: 1, ...px },
			{ var: "--space-5", label: "space-5", min: 0, max: 80, step: 1, ...px },
			{ var: "--space-6", label: "space-6", min: 0, max: 96, step: 1, ...px },
		],
	},
	{
		title: "Typography",
		scope: "root",
		controls: [
			{ var: "--font-size-0", label: "font-size-0", min: 8, max: 20, step: 1, ...px },
			{ var: "--font-size-1", label: "font-size-1", min: 10, max: 24, step: 1, ...px },
			{ var: "--font-size-3", label: "font-size-3", min: 12, max: 28, step: 1, ...px },
			{ var: "--font-size-4", label: "font-size-4", min: 12, max: 32, step: 1, ...px },
			{ var: "--font-size-5", label: "font-size-5", min: 14, max: 40, step: 1, ...px },
			{ var: "--font-size-6", label: "font-size-6", min: 16, max: 48, step: 1, ...px },
			{ var: "--font-size-7", label: "font-size-7", min: 20, max: 64, step: 1, ...px },
			{ var: "--font-size-8", label: "font-size-8", min: 24, max: 88, step: 1, ...px },
			{ var: "--font-size-9", label: "font-size-9", min: 44, max: 120, step: 1, ...px },
		],
	},
];

// The type roles, for the catalogue's faces block. Each specimen sets the
// family AND the weight, the way a call site should.
const faces = [
	{
		token: "--font-hero",
		name: "DM Sans Medium",
		use: "the hero lockup \u2014 the wordmark and \u201cother stories\u201d; the solid accent \u201c&\u201d",
		css: "font-family: var(--font-hero); font-weight: var(--font-hero-weight);",
	},
	{
		token: "--font-heading",
		name: "DM Sans Medium",
		use: "every heading \u2014 the post title, section heads, DS H1\u2013H4, a bare h2; the hero lede",
		css: "font-family: var(--font-heading); font-weight: var(--font-heading-weight);",
	},
	{
		token: "--font-ui",
		name: "DM Sans Regular \u00b7 Bold",
		use: "the interface \u2014 widget chrome, the label voice (Mono, caps), figures, the blog's chrome; a post row's title and a table head take the Bold",
		css: "font-family: var(--font-ui); font-weight: var(--font-weight-400);",
	},
	{
		token: "--font-display",
		name: "DM Sans Medium",
		use: "the big numeral \u2014 Stat\u2019s numeral variant: a count or an index set large",
		css: "font-family: var(--font-display); font-weight: var(--font-display-weight);",
	},
	{
		token: "--font-body",
		name: "Roboto Mono Regular",
		use: "reading text, at 14px on 1.33 (the --font-body-* tokens)",
		css: "font-family: var(--font-body); font-weight: var(--font-body-weight);",
	},
	{
		token: "--font-code",
		name: "Roboto Mono Regular",
		use: "code \u2014 fenced blocks and inline code: the body face, so code in a paragraph sits in its line",
		css: "font-family: var(--font-code);",
	},
];
---

<Layout
	title="Design System — Tristan Timblin"
	description="A living catalogue of the @whois design-system components, rendered in every variant, size, and state with a live token editor."
	noindex
>
	{/* Live token editor — a Knobs panel. Sliders/pickers write inline custom
	     properties onto <html> (which beats the class-scoped stylesheet), so
	     every component in the catalogue re-renders instantly. "Copy config"
	     exports the changed tokens as JSON for the agent to apply to
	     tokens.overrides.css. */}
	<Knobs title="tokens" floating data-token-controls aria-label="design token controls">
		<Mono slot="meta" tone="accent" data-theme-name />
		<Fragment slot="note">
			Colour edits apply to the current theme (data-theme on &lt;html&gt;) and
			re-seed when it flips. Drag to preview; Copy config exports changed
			tokens as JSON.
		</Fragment>
		{TOKEN_GROUPS.map((group) => (
			<KnobGroup legend={group.title} data-scope={group.scope}>
				{group.controls.map((c) =>
					c.type === "color" ? (
						<Knob label={c.label} type="color">
							<input type="color" data-var={c.var} data-role="swatch" />
							<input type="text" data-var={c.var} data-role="value" spellcheck="false" />
						</Knob>
					) : c.type === "text" ? (
						<Knob label={c.label} type="text" data-var={c.var} data-role="value" spellcheck="false" />
					) : (
						<Knob
							label={c.label}
							type="range"
							out={c.var}
							data-var={c.var}
							data-unit={c.unit ?? ""}
							min={c.min}
							max={c.max}
							step={c.step}
						/>
					)
				)}
			</KnobGroup>
		))}
		<Button slot="actions" variant="primary" type="button" data-copy>Copy config</Button>
		<Button slot="actions" variant="tertiary" type="button" data-reset>Reset</Button>
	</Knobs>

	<main class="ds-demo">
		<Heading as="h1" size={5} responsive class="ds-demo__title">@whois/design-system — component catalogue</Heading>

		{/* TYPOGRAPHY ----------------------------------------------------- */}
		<section class="ds-demo__section">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">Faces — two faces, six roles</Heading>
			<p class="ds-demo__note">
				DM Sans (400 / 500 / 700) and Roboto Mono (300 / 400 / 500), self-hosted from <code>/fonts</code> as latin and latin-ext woff2 (fetched by <code>tools/fonts/build.sh</code>, @font-face'd in <code>src/styles/fonts.css</code>,
				each with a metric-matched fallback so the swap does not reflow). Reach for the
				ROLE token, not the family name. Each family ships discrete cuts, one <code>@font-face</code> per cut at its real weight, so a role carries a weight
				companion — set both or the browser picks the cut for you.
			</p>
			<Flex direction="column" gap={3} alignItems="start">
				{faces.map((f) => (
					<div class="ds-demo__face">
						<span class="ds-demo__face-token">{f.token}</span>
						<span class="ds-demo__face-name">{f.name}</span>
						<span class="ds-demo__face-use">{f.use}</span>
						<span class="ds-demo__face-specimen" style={f.css}>
							Hamburgefonstiv 123
						</span>
					</div>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">Text — sizes</Heading>
			<p class="ds-demo__note">
				0–9, each <code>--font-size-N</code>: 12 / 14 / 16 / 18 / 20 / 24 / 32 / 44 / 72.
				There is no 2 — the scale has no such token. 8 and 9 are the display steps; <code>Heading</code> reaches them as sizes 5 and 6.
			</p>
			<Flex direction="column" gap={2} alignItems="start">
				{textSizes.map((s) => (
					<Text size={s}>size {s} — The quick brown fox</Text>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">Text — variants (color)</Heading>
			<Flex direction="column" gap={1} alignItems="start">
				{textVariants.map((v) => (
					<Text variant={v} size={4}>variant {v}</Text>
				))}
			</Flex>
		</section>


		<section class="ds-demo__section">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">Text — families</Heading>
			<Flex direction="column" gap={1} alignItems="start">
				{families.map((f) => (
					<Text family={f} size={4}>family {f} — AaBbCc 123</Text>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">Text — spaced / truncate / caps</Heading>
			<p class="ds-demo__note">
				<code>spaced</code> is off by default; on, it is the body role's leading and
				tracking for a run that should sit like a paragraph without being one. <code>caps</code> composes the caps role. <code>truncate</code> is one line,
				ellipsised.
			</p>
			<Flex direction="column" gap={2} alignItems="start">
				<Text spaced size={4}>spaced — the body role's leading and tracking</Text>
				<Text caps size={1} variant="secondary">caps — the uppercase label role</Text>
				<div style="width:220px; border: var(--border);">
					<Text truncate size={4}>truncate this very long line that overflows its container</Text>
				</div>
			</Flex>
		</section>

		<section class="ds-demo__section">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">Leading, tracking, and what the faces can actually do</Heading>
			<p class="ds-demo__note">
				Three leadings, because there are three jobs. <code>--line-height-heading</code> (1.1) holds a heading's lines together as one object; body leading on display
				type makes a two-line heading read as two unrelated lines. <code>--line-height-body</code> (1.33, the old site's mono setting) gives running
				text room to find the next line — a monospace's even colour needs less than a
				proportional face would. <code>--line-height-ui</code> (1.3) sits between them for
				label type, which wants to be tighter than prose without being display-tight. <code>--tracking-heading</code> is none at heading sizes; the hero pulls in at
				display size (<code>--tracking-hero</code>, -0.03em), where DM Sans's default
				spacing reads loose.
			</p>
			<p class="ds-demo__note">
				Uppercase always gets tracking: every letterform in a text face is fitted to sit
				beside lowercase, so capitals run together jam. That is most of why all-caps
				reads as hard. <code>--tracking-caps</code> (0.0625em, 0.75px at 12px) is the one
				step, for every small uppercase label; <code>--tracking-mono</code> (0.02em) is the
				small one for the label voice in sentence case. The site had been making that
				decision five times at 0.04 / 0.08 / 0.1 / 0.14 / 0.18em.
			</p>
			<p class="ds-demo__note">
				<strong>What the two faces support</strong>, measured in the browser against the
				files in <code>/fonts</code> rather than assumed — this is why some typographic
				advice does not apply here. Neither is shipped as a <em>variable</em> font, so
				weights cannot be nudged per theme; the cuts are DM Sans 400/500/700 and Roboto
				Mono 300/400/500 (300 holds no role: it read thin and grey in the narrow
				columns). Neither ships <code>smcp</code>, so small caps would be faked — resized
				capitals, far too light — which is why <code>font-synthesis-small-caps</code> is
				off in global.css, as is <code>font-synthesis-weight</code>: emphasis is a cut the
				family has. Neither has old-style figures (<code>onum</code>). DM Sans's figures
				are proportional and these subsets carry no <code>tnum</code>, so <code>tabular-nums</code> is a no-op on it — a column of figures that must align
				wants the mono. Roboto Mono sets every glyph on one advance already. DM Sans
				ships <code>liga</code> and <code>kern</code>; the mono needs neither.
			</p>
			<Flex direction="column" gap={2} alignItems="start">
				<Text caps family="ui" size={1}>ds-caps · section mark</Text>
				<span style="font-size: var(--font-size-0); color: var(--text-tertiary);">--font-size-0 · the caption step, below the scale's 14px floor</span>
			</Flex>
		</section>

		{/* INSTRUMENT UI: tokens + voices --------------------------------- */}
		<section class="ds-demo__section">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">Instrument UI — tokens</Heading>
			<p class="ds-demo__note">
				The vocabulary the cards, widgets and controls are drawn in (tokens.overrides.css
				→ INSTRUMENT UI): one blue accent used once per card; the ink at three
				washes; a five-step rank ramp for things ordered by importance; one hairline
				colour and its strong step; one bar width. <code>--lit</code> is what a step
				looks like when it is on — a quieter blue than the accent, so a lit grid reads
				as state, not a row of buttons. Declared on <code>[data-theme]</code>, so a <code>ThemePage</code> re-resolves them.
			</p>
			<div class="ds-demo__swatches">
				{instrumentTokens.map(([name, note]) => (
					<div class="ds-demo__swatch-row">
						{/* --on-accent is only ever seen ON the accent, so it is shown that way:
						    a glyph in the token over the accent square, i.e. the pair. */}
						{name === "--on-accent" ? (
							<span class="ds-demo__swatch ds-demo__swatch--on" style="background: var(--accent); color: var(--on-accent)">Aa</span>
						) : name === "--focus-ring" ? (
							<span class="ds-demo__swatch" style="outline: var(--focus-ring); outline-offset: var(--focus-ring-offset)" />
						) : name === "--bar-width" ? (
							<span class="ds-demo__swatch" style="border-inline-start: var(--bar-width) solid var(--accent)" />
						) : name === "--shadow-3" ? (
							<span class="ds-demo__swatch" style="box-shadow: var(--shadow-3); background: var(--card-background)" />
						) : (
							<span class="ds-demo__swatch" style={`background: var(${name})`} />
						)}
						<Mono variant="value">{name}</Mono>
						<Mono variant="text">{note}</Mono>
					</div>
				))}
			</div>
		</section>

		{/* EDGES: border, corner, panel, code, links, halftone ink ------------- */}
		<section class="ds-demo__section" id="edges">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">Edges — the border, the corner, the panel, code, links</Heading>
			<p class="ds-demo__note">
				How every box is drawn (tokens.overrides.css → EDGES): one 1px <strong>dashed</strong> rule in a warm grey (<code>--border</code>, composed from <code>--border-width</code>, <code>--border-style</code> and the theme's <code>--border-color</code>), one 2.5px corner (<code>--radius-box</code>; the
				generated <code>--border-radius-0…3</code> all alias it), a 1px tinted ring under a
				panel (<code>--shadow-panel</code>) and a header that fades into the first wash
				(<code>--panel-header-bg</code>). Compose the edge — <code>border-block-start:
				var(--border)</code> — rather than typing <code>1px solid</code>; a side that must
				stay invisible takes the parts with a transparent colour. <code>--radius-square</code> is a 0 on purpose. The width, dash and corner sit on <code>:root</code>; the
				composites read a theme's colours, so they sit on <code>[data-theme]</code> and
				re-resolve under any wrapper carrying one. The editor's Edges groups drive them live.
			</p>
			<div class="ds-demo__swatches">
				{edgeTokens.map(([name, note]) => (
					<div class="ds-demo__swatch-row">
						{name === "--border" ? (
							<span class="ds-demo__swatch" style="border: var(--border); background: none" />
						) : name === "--radius-box" ? (
							<span class="ds-demo__swatch" style="border: var(--border); border-radius: var(--radius-box); background: var(--card-background)" />
						) : name === "--shadow-panel" ? (
							<span class="ds-demo__swatch" style="box-shadow: var(--shadow-panel); background: var(--card-background); border: var(--border)" />
						) : name === "--code-bg" ? (
							<span class="ds-demo__swatch ds-demo__swatch--on" style="background: var(--code-bg); color: var(--code-fg); border: var(--code-border)">{"{}"}</span>
						) : name === "--link-color" ? (
							<span class="ds-demo__swatch ds-demo__swatch--on" style="background: none; color: var(--link-color); text-decoration: var(--link-decoration); text-underline-offset: var(--link-underline-offset)">Aa</span>
						) : (
							<span class="ds-demo__swatch" style={`background: var(${name})`} />
						)}
						<Mono variant="value">{name}</Mono>
						<Mono variant="text">{note}</Mono>
					</div>
				))}
			</div>
			<h2 class="ds-demo__h ds-demo__h--sub">Both themes — the same box on each page</h2>
			<p class="ds-demo__note">
				The theme is one attribute, <code>data-theme="light|dark"</code> on <code>&lt;html&gt;</code> (light by default, the footer toggle stores the choice
				in <code>localStorage.theme</code>); each palette is a file
				(<code>tokens/themes/light.css</code>, <code>dark.css</code>) naming the same set. <code>ThemePage</code> sets the attribute on a wrapper, so both pages show here
				whichever the site is on: cream with a near-black code slab, and the warm night
				with the slab sunk below the page and the dashed edge drawn round it.
			</p>
			<div class="ds-demo__art-themes">
				{(["light", "dark"] as const).map((t) => (
					<ThemePage theme={t}>
						<Card title={`panel · ${t}`} data-edge-demo={t}>
							<Mono slot="meta" tone="accent">--border</Mono>
							<CardBody>
								<div class="ds-prose ds-demo__edge-prose">
									<p>
										Body in the mono with a <a href="#edges">link in --link-color</a> and <code>inline code</code> on its wash.
									</p>
									<pre><code>const edge = "var(--border)";</code></pre>
								</div>
							</CardBody>
						</Card>
					</ThemePage>
				))}
			</div>
		</section>

		<section class="ds-demo__section">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">Mono — the label voice</Heading>
			<p class="ds-demo__note">
				Small type in the UI face that labels rather than says (the name is from when
				it was a monospace; the classes and the component keep it). <code>caps</code> is the panel
				label (the default), <code>text</code> the quiet sentence case, <code>value</code> a figure at label size. Sizes 0 / 1; tones override the variant's colour; <code>truncate</code> ellipsises. Inside a WidgetGrid the size follows the cell.
			</p>
			<Flex direction="column" gap={3} alignItems="start">
				<Mono>caps · the panel label</Mono>
				<Mono variant="text">text · sentence case, the quiet ink</Mono>
				<Mono variant="value">value · 1,457 / 90% / 12:04</Mono>
				<Mono size={1}>caps · size 1</Mono>
				<Mono truncate style="max-inline-size: 12rem;">truncate · a label that runs out of room and ellipsises</Mono>
				<Mono tone="primary">tone primary</Mono>
				<Mono tone="accent">tone accent</Mono>
				<Mono as="a" variant="text" href="#">as a link · @handle</Mono>
			</Flex>
		</section>

		<section class="ds-demo__section">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">Figure · Stat</Heading>
			<p class="ds-demo__note">
				<code>Figure</code>: the big regular-weight numeral with a caps unit on its
				baseline — one size, the figure voice's (the type token, or the cell's step
				inside a WidgetGrid). <code>Stat</code>: a value over a dim label, both in the
				mono, the value at the next step — the dashboard's stat pair; several sit in a
				row.
			</p>
			<Flex gap={6} wrap="wrap" alignItems="end">
				<Figure unit="contributions">1,457</Figure>
				<Figure unit="miles">1,551</Figure>
			</Flex>
			<Flex gap={6} wrap="wrap" alignItems="end" style="margin-top: var(--space-5);">
