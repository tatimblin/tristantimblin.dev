				<InlineCode>grid-column: span N</InlineCode>. Spans in each row sum to 12.
			</Text>
			<Grid templateColumns="repeat(12, 1fr)" gap={3} style="margin-top:12px;">
				{Array.from({ length: 12 }).map((_, i) => (
					<GridItem class="ds-cell ds-cell--head">{i + 1}</GridItem>
				))}
				<GridItem colSpan={6} class="ds-cell">6</GridItem>
				<GridItem colSpan={6} class="ds-cell">6</GridItem>
				<GridItem colSpan={4} class="ds-cell">4</GridItem>
				<GridItem colSpan={4} class="ds-cell">4</GridItem>
				<GridItem colSpan={4} class="ds-cell">4</GridItem>
				<GridItem colSpan={3} class="ds-cell">3</GridItem>
				<GridItem colSpan={3} class="ds-cell">3</GridItem>
				<GridItem colSpan={3} class="ds-cell">3</GridItem>
				<GridItem colSpan={3} class="ds-cell">3</GridItem>
				<GridItem colSpan={8} class="ds-cell">8</GridItem>
				<GridItem colSpan={4} class="ds-cell">4</GridItem>
