			{ var: "--border-radius-2", label: "radius-2", min: 0, max: 48, step: 1, ...px },
			{ var: "--border-radius-3", label: "radius-3", min: 0, max: 64, step: 1, ...px },
		],
	},
	{
		title: "Typography",
		scope: "root",
		controls: [
			{ var: "--font-size-1", label: "font-size-1", min: 10, max: 24, step: 1, ...px },
			{ var: "--font-size-3", label: "font-size-3", min: 12, max: 28, step: 1, ...px },
			{ var: "--font-size-4", label: "font-size-4", min: 12, max: 32, step: 1, ...px },
			{ var: "--font-size-5", label: "font-size-5", min: 14, max: 40, step: 1, ...px },
			{ var: "--font-size-6", label: "font-size-6", min: 16, max: 48, step: 1, ...px },
			{ var: "--font-size-7", label: "font-size-7", min: 20, max: 64, step: 1, ...px },
			{ var: "--font-size-8", label: "font-size-8", min: 24, max: 88, step: 1, ...px },
			{ var: "--font-weight-400", label: "weight-400", type: "number", min: 100, max: 900, step: 10 },
			{ var: "--font-weight-500", label: "weight-500", type: "number", min: 100, max: 900, step: 10 },
			{ var: "--font-weight-600", label: "weight-600", type: "number", min: 100, max: 900, step: 10 },
		],
	},
];

// The four type roles, for the catalogue's faces block. Each specimen sets the
// family AND the weight, the way a call site should.
const faces = [
	{
		token: "--font-hero",
		name: "Migra Bold",
		use: "the hero lockup — wordmark, \u201cother stories\u201d, the ampersand",
		css: "font-family: var(--font-hero); font-weight: var(--font-hero-weight);",
	},
	{
		token: "--font-heading",
		name: "Migra Medium",
		use: "h1\u2013h3, DS H1\u2013H3, bare headings",
		css: "font-family: var(--font-heading); font-weight: var(--font-heading-weight);",
	},
	{
		token: "--font-subheading",
		name: "FS Mondwest Bold",
		use: "small-type labels \u2014 hero lede, page subtitles, DS H4",
		css: "font-family: var(--font-subheading);",
	},
	{
		token: "--font-body",
		name: "PP Mondwest Light",
		use: "everything else; --font-sans and the DS --font-display alias it",
		css: "font-family: var(--font-body); font-weight: var(--font-body-weight);",
	},
];
---

<Layout
	title="Design System — Tristan Timblin"
	description="A living catalogue of the @whois design-system components, rendered in every variant, size, and state with a live token editor."
>
	<!-- Live token editor. Sliders/pickers write inline custom properties onto
	     <html> (which beats the class-scoped stylesheet), so every component in
	     the catalogue re-renders instantly. "Copy config" exports the changed
	     tokens as JSON for the agent to apply to tokens.overrides.css. -->
	<aside class="ds-controls" data-token-controls aria-label="design token controls">
		<header class="ds-controls__top">
			<h2 class="ds-controls__title">tokens</h2>
			<span class="ds-controls__theme" data-theme-name></span>
		</header>
		<p class="ds-controls__note">
			Color edits apply to the current theme. Drag to preview; Copy config
			exports changed tokens as JSON.
		</p>
		<div class="ds-controls__body">
			{TOKEN_GROUPS.map((group) => (
				<fieldset class="ds-controls__group" data-scope={group.scope}>
					<legend>{group.title}</legend>
					{group.controls.map((c) =>
						c.type === "color" ? (
							<label class="ds-controls__row ds-controls__row--color">
								<span class="ds-controls__label">{c.label}</span>
								<span class="ds-controls__colorwrap">
									<input type="color" data-var={c.var} data-role="swatch" />
									<input
										type="text"
										class="ds-controls__text"
										data-var={c.var}
										data-role="value"
										spellcheck="false"
									/>
								</span>
							</label>
						) : (
							<label class="ds-controls__row">
								<span class="ds-controls__label">
									{c.label}
									<output data-out={c.var}></output>
								</span>
								<input
									type="range"
									data-var={c.var}
									data-unit={c.unit ?? ""}
									min={c.min}
									max={c.max}
									step={c.step}
								/>
							</label>
						)
					)}
				</fieldset>
			))}
		</div>
		<footer class="ds-controls__actions">
			<button type="button" data-copy>Copy config</button>
			<button type="button" data-reset>Reset</button>
		</footer>
	</aside>

	<main class="ds-demo">
		<h1 class="ds-demo__title">@whois/design-system — component catalogue</h1>

		<!-- TYPOGRAPHY ----------------------------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Faces — the four roles</h2>
			<p class="ds-demo__note">
				Self-hosted from <code>/fonts</code> (built by <code>tools/fonts/build.sh</code>,
				@font-face'd in <code>src/styles/fonts.css</code>). Reach for the ROLE token, not
				the family name. Migra is one family with two cuts, so its roles carry a weight
				companion — set both or the browser picks the cut for you.
			</p>
			<Flex direction="column" gap={3} alignItems="start">
				{faces.map((f) => (
					<div class="ds-demo__face">
						<span class="ds-demo__face-token">{f.token}</span>
						<span class="ds-demo__face-name">{f.name}</span>
						<span class="ds-demo__face-use">{f.use}</span>
						<span class="ds-demo__face-specimen" style={f.css}>
							Hamburgefonstiv 123
						</span>
					</div>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Text — sizes</h2>
			<Flex direction="column" gap={2} alignItems="start">
				{textSizes.map((s) => (
					<Text size={s}>size {s} — The quick brown fox (14/14/16/18/20/24/32/44)</Text>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Text — variants (color)</h2>
			<Flex direction="column" gap={1} alignItems="start">
				{textVariants.map((v) => (
					<Text variant={v} size={4}>variant {v}</Text>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Text — weights</h2>
			<Flex direction="column" gap={1} alignItems="start">
				{textWeights.map((w) => (
					<Text weight={w} size={4}>weight {w}</Text>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Text — families</h2>
			<Flex direction="column" gap={1} alignItems="start">
				{families.map((f) => (
					<Text family={f} size={4}>family {f} — AaBbCc 123</Text>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Text — flags (outline / spaced / truncate)</h2>
			<Flex direction="column" gap={2} alignItems="start">
				<Text outline size={7}>outline face</Text>
				<Text spaced size={4}>spaced letter-spacing</Text>
				<div style="width:220px; border:1px dashed var(--border-color);">
					<Text truncate size={4}>truncate this very long line that overflows its container</Text>
				</div>
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Leading, tracking, and what the faces can actually do</h2>
			<p class="ds-demo__note">
				Three leadings, because there are three jobs. <code>--line-height-heading</code>
				(1.15) holds a heading's lines together as one object; body leading on display
				type makes a two-line heading read as two unrelated lines.
				<code>--line-height-body</code> (1.7) gives running text room to find the next
				line. <code>--line-height-ui</code> (1.3) sits between them for label type, which
				wants to be tighter than prose without being display-tight.
				<code>--tracking-heading</code> is negative and in <code>em</code>, because the
				space between letters grows with the type — display sizes need it pulled back.
			</p>
			<p class="ds-demo__note">
				Uppercase always gets tracking: every letterform in a text face is fitted to sit
				beside lowercase, so capitals run together jam. That is most of why all-caps
				reads as hard. <code>--tracking-caps</code> (0.14em) is the one step, for every
				small uppercase label. The site had been making that decision five times at
				0.04 / 0.08 / 0.1 / 0.14 / 0.18em.
			</p>
			<p class="ds-demo__note">
				<strong>What the four faces support</strong>, read out of the files in
				<code>/fonts</code> rather than assumed — this is why some typographic advice
				does not apply here. None of them is a <em>variable</em> font, so weights cannot
				be nudged per theme; the cuts are Migra 500/700, Neue Montreal 400/600, PP Mondwest
				200/300/400, and a single cut for FS Mondwest. None ships <code>smcp</code>, so
				small caps would be faked — resized capitals, far too light — which is why
				<code>font-synthesis-small-caps</code> is off in global.css. Old-style figures
				(<code>onum</code>) exist only on Migra, the heading face; the body face has no
				figure features at all, so old-style figures in prose are not available without a
				new face. Neue Montreal does ship <code>tnum</code>, which is what the numeric
				role below uses. All three text faces ship <code>liga</code> and
				<code>kern</code>.
				PP Mondwest’s 200 and 300 are not vendor cuts: they are thinned from its
				Regular in bitmap space — 2 px stems taken to 1.5 px and 1 px on the face’s own
				50-per-em grid — with cap height, x-height and every advance width held fixed.
				So they are drop-in: the same text sets to the same line length in all three, and
				one <code>size-adjust</code> and one metric fallback cover the family. Reading
				text is the 300; the 200 is served but holds no role, being close to a hairline
				at 16px.
			</p>
			<Flex direction="column" gap={2} alignItems="start">
				<Text class="ds-caps" family="mono" size={1}>ds-caps · section mark</Text>
				<span class="ds-numeric" style="font-size: var(--font-size-6);">ds-numeric&nbsp;·&nbsp;1034 / 1543 / 0158</span>
				<span style="font-size: var(--font-size-0); color: var(--text-tertiary);">--font-size-0 · the caption step, below the scale's 14px floor</span>
			</Flex>
		</section>

		<!-- INSTRUMENT UI: tokens + voices --------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Instrument UI — tokens</h2>
			<p class="ds-demo__note">
				The vocabulary the cards, widgets and controls are drawn in (tokens.overrides.css
				→ INSTRUMENT UI): one orange-red accent used once per card; the ink at three
				washes; a five-step rank ramp for things ordered by importance; one hairline
				colour. <code>--lit</code> is what a step looks like when it is on — the accent on
				the dark theme, the ink on the light one.
			</p>
			<div class="ds-demo__swatches">
				{instrumentTokens.map(([name, note]) => (
					<div class="ds-demo__swatch-row">
						{/* --on-accent is only ever seen ON the accent, so it is shown that way:
						    a glyph in the token over the accent square, i.e. the pair. */}
						{name === "--on-accent" ? (
							<span class="ds-demo__swatch ds-demo__swatch--on" style="background: var(--accent); color: var(--on-accent)">Aa</span>
						) : name === "--focus-ring" ? (
							<span class="ds-demo__swatch" style="outline: var(--focus-ring); outline-offset: var(--focus-ring-offset)" />
						) : (
							<span class="ds-demo__swatch" style={`background: var(${name})`} />
						)}
						<Mono variant="value">{name}</Mono>
						<Mono variant="text">{note}</Mono>
					</div>
				))}
			</div>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Mono — the structure voice</h2>
			<p class="ds-demo__note">
				Small mono type that labels rather than says. <code>caps</code> is the panel
				label (the default), <code>text</code> the quiet sentence case, <code>value</code>
				a figure at label size. Sizes 0 / 1 / 3; tones override the variant's colour.
				Inside a WidgetGrid the size follows the cell.
			</p>
			<Flex direction="column" gap={3} alignItems="start">
				<Mono>caps · the panel label</Mono>
				<Mono variant="text">text · sentence case, the quiet ink</Mono>
				<Mono variant="value">value · 1,457 / 90% / 12:04</Mono>
				<Mono size={1}>caps · size 1</Mono>
				<Mono size={3}>caps · size 3</Mono>
				<Mono tone="primary">tone primary</Mono>
				<Mono tone="accent">tone accent</Mono>
				<Mono as="a" variant="text" href="#">as a link · @handle</Mono>
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Figure · Stat</h2>
			<p class="ds-demo__note">
				<code>Figure</code>: the big regular-weight numeral with a caps unit on its
				baseline (sizes md / lg / xl). <code>Stat</code>: a value over a dim label — sm is
				mono at label size (the dashboard's stat pair), md the numeric face, lg the figure;
				<code>inline</code> puts the two on one baseline.
			</p>
			<Flex gap={6} wrap="wrap" alignItems="end">
				<Figure size="md" unit="rides">1,034</Figure>
				<Figure unit="contributions">1,457</Figure>
				<Figure size="xl" unit="bpm">120</Figure>
			</Flex>
			<Flex gap={6} wrap="wrap" alignItems="end" style="margin-top: var(--space-5);">
				<Stat size="sm" value="90%" label="Allocated" />
				<Stat size="sm" value="10%" label="Reserve" />
				<Stat value="1,034" label="rides" />
				<Stat size="lg" value="320" label="readers" />
				<Stat value="48" label="hours" inline />
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Hairline</h2>
			<Flex direction="column" gap={4} alignItems="stretch">
				<Hairline />
				<Hairline fade={false} />
				<Flex gap={4} alignItems="stretch" style="block-size: var(--space-8);">
					<Mono>left</Mono>
					<Hairline orientation="vertical" />
					<Mono>right</Mono>
				</Flex>
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Body — the reading role</h2>
			<p class="ds-demo__note">
				Takes no size: the whole setting (face, size, line-height, letter-spacing,
				reading colour) comes from the <code>--font-body-*</code> tokens, so reading
				text is one decision rather than a step picked off the Text scale. Compare
				the size-4 line below — that step is the smallest HEADING, and prose set in
				it reads a size too large.
			</p>
			<div style="max-width: 62ch; display: grid; gap: var(--space-4);">
				<Body>
					I am a craftsman, I create things to be used. Even if they often are not,
					it is for the love of the process. My creativite nature comes through in
					an empathetic design, where with a deep understanding of another I can
					build them worlds.
				</Body>
				<Body variant="tertiary">
					Body, variant tertiary — the same setting in the quieter ink.
				</Body>
				<Text size={4} variant="secondary">
					Text size 4 for contrast — this is the sub-heading step, not body.
				</Text>
			</div>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Heading + H1–H4 · EM · Strong</h2>
			<H1>H1 heading</H1>
			<H2>H2 heading</H2>
			<H3>H3 heading</H3>
			<H4>H4 heading</H4>
			<Heading as="p" size={2}>Heading as p, size 2</Heading>
			<Text size={4}>Body with <EM>emphasis</EM> and <Strong>strong</Strong>.</Text>
		</section>

		<!-- BUTTONS -------------------------------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Button — variants</h2>
			<p class="ds-demo__note">
				Flat: primary is the accent (the one action a card asks for), secondary an ink
				wash (the reference's <code>Deploy ▸</code>), tertiary nothing until pointed at.
				<code>rounded</code> makes a pill button.
			</p>
			<Flex gap={3} wrap="wrap">
				<Button variant="primary">Primary</Button>
				<Button variant="secondary">Secondary</Button>
				<Button variant="tertiary">Tertiary</Button>
				<Button variant="primary" inverted>Primary inverted</Button>
				<Button variant="primary" rounded>Next</Button>
				<Button variant="secondary" rounded>Tap</Button>
				<Button variant="secondary"><Icon name="chevron" slot="end-icon" />Deploy</Button>
				<Button variant="primary" disabled>Disabled</Button>
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">IconButton — variants / sizes / rounded</h2>
			<p class="ds-demo__note">
				<code>rounded</code> is the round button of the instrument UI; <code>xl</code> is the
				one big control a screen has (the metronome's pause), small the − / + beside it,
				and <code>xs</code> the pill-height one that fits a card header's meta slot.
			</p>
			<Flex gap={3} wrap="wrap" alignItems="center">
				<IconButton variant="primary" size="large" aria-label="a"><Icon name="check" /></IconButton>
				<IconButton variant="secondary" size="large" aria-label="b"><Icon name="copy" /></IconButton>
				<IconButton variant="tertiary" size="large" aria-label="c"><Icon name="command" /></IconButton>
				<IconButton variant="secondary" size="small" aria-label="d"><Icon name="chevron" /></IconButton>
				<IconButton variant="primary" size="xl" rounded aria-label="pause"><Icon name="pause" /></IconButton>
				<IconButton variant="secondary" size="small" rounded aria-label="minus"><Icon name="chevron" /></IconButton>
				<IconButton variant="secondary" size="small" rounded aria-label="plus"><Icon name="chevron" /></IconButton>
				<IconButton variant="secondary" size="large" rounded aria-label="play"><Icon name="play" /></IconButton>
				<IconButton variant="secondary" size="xs" rounded aria-label="previous"><Icon name="arrow" size={3} /></IconButton>
			</Flex>
			<p class="ds-demo__note" style="margin-top: var(--space-5);">
				<code>glyph</code> draws a character in place of an icon — the − and + that step
				the /txt instrument — aria-hidden, in the UI face, sized to the button; the
				caller names the button.
			</p>
			<Flex gap={3} wrap="wrap" alignItems="center">
				<IconButton variant="secondary" size="large" rounded glyph="−" aria-label="Previous post" />
				<IconButton variant="secondary" size="large" rounded glyph="+" aria-label="Next post" />
				<IconButton variant="tertiary" size="xl" rounded glyph="+" aria-label="Next post" />
				<IconButton variant="secondary" size="small" rounded glyph="−" aria-label="Previous post" />
				<IconButton variant="secondary" size="xs" glyph="+" aria-label="Add" />
			</Flex>
			<p class="ds-demo__note" style="margin-top: var(--space-5);">
				<code>variant="outline"</code> is a hairline and no fill (the wash comes up under
				the pointer), and <code>square</code> drops the corner: the ruled screen's small
				square button — the − / + stepper in the /txt search bar.
			</p>
			<Flex gap={3} wrap="wrap" alignItems="center">
				<IconButton variant="outline" square size="small" glyph="−" aria-label="Previous post" />
				<IconButton variant="outline" square size="small" glyph="+" aria-label="Next post" />
				<IconButton variant="outline" square size="large" aria-label="copy"><Icon name="copy" /></IconButton>
				<IconButton variant="outline" size="small" glyph="+" aria-label="Add" />
			</Flex>
		</section>

		<!-- CARD ----------------------------------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Card — the flat card / variants</h2>
			<p class="ds-demo__note">
				A surface a few percent off the page inside a 1px hairline; no shadow, so
				<code>depth</code> is accepted and ignored. The header is <code>CardHeader</code>:
				<code>title</code> (a prop, or a slot for a title a script rewrites) in the caps
				mono voice over a hairline that fades at both ends, with the <code>meta</code>
				slot on the right — Card and Widget both render it, and so can a page by hand.
				<code>squeeze="title"</code> leaves the meta unclipped and ellipsises the title
				instead. Secondary is an ink wash (it was the glass); tertiary is transparent;
				<code>chrome={"{false}"}</code> is no frame, fill or clip at all.
			</p>
			<Grid templateColumns="repeat(auto-fill, minmax(280px, 1fr))" gap={4}>
				<Card title="infra #1">
					<CardBody><Text size={3}>Body content.</Text></CardBody>
				</Card>
				<Card depth={3} title="depth 3 — still flat">
					<CardBody><Text size={3}>Body content.</Text></CardBody>
				</Card>
				<Card variant="secondary" title="Secondary (wash)">
					<CardBody><Text size={3}>An ink wash, not a fill.</Text></CardBody>
				</Card>
				<Card variant="tertiary" title="with meta">
					<Pill slot="meta">low risk</Pill>
					<CardBody><Text size={3}>Tertiary variant; the meta slot on the Card.</Text></CardBody>
				</Card>
				<Card variant="tertiary">
					<CardHeader title="Manual header">
						<Pill slot="meta">low risk</Pill>
					</CardHeader>
					<CardBody><Text size={3}>The same header, placed by hand.</Text></CardBody>
				</Card>
				<Card squeeze="title" style="max-inline-size: 320px;">
					<span slot="title">A long season heading that gives way first</span>
					<Fragment slot="meta">
						<Pill>5–0</Pill>
						<IconButton size="xs" rounded aria-label="next" style="margin-inline-start: var(--space-2);"><Icon name="arrow" size={3} /></IconButton>
					</Fragment>
					<CardBody><Text size={3}>squeeze="title": the title ellipsises, the meta holds.</Text></CardBody>
				</Card>
				<Card chrome={false} title="no chrome">
					<CardBody><Text size={3}>chrome={"{false}"}: straight on the page.</Text></CardBody>
				</Card>
			</Grid>
		</section>

		<!-- CALLOUT + PILL ------------------------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Callout — variants</h2>
			<Flex direction="column" gap={3} alignItems="stretch">
				<Callout variant="info">Info callout with default icon.</Callout>
				<Callout variant="danger">Danger callout with default icon.</Callout>
				<Callout variant="warning">Warning callout (no default icon per source).</Callout>
				<Callout variant="info" label="LABEL">Info with a text label instead of icon.</Callout>
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Pill — variants</h2>
			<p class="ds-demo__note">
				Caps mono in a capsule. <code>subtle</code> (the default) is the header pill,
				<code>outline</code> the poster badge, <code>accent</code> the one CTA; the four DS
				tints remain. As a <code>button</code> or <code>a</code> it is a pill button.
