---
// Living catalogue of the ported @whois/design-system components. Renders every
// component in its variants/sizes/states for visual QA and regression reference.
import Layout from "../layouts/Layout.astro";
import "@whois/design-system/styles.css";

import Box from "@whois/design-system/Box";
import Flex from "@whois/design-system/Flex";
import Grid from "@whois/design-system/Grid";
import GridItem from "@whois/design-system/GridItem";
import Text from "@whois/design-system/Text";
import Heading from "@whois/design-system/Heading";
import Body from "@whois/design-system/Body";
import H1 from "@whois/design-system/H1";
import H2 from "@whois/design-system/H2";
import H3 from "@whois/design-system/H3";
import H4 from "@whois/design-system/H4";
import EM from "@whois/design-system/EM";
import Strong from "@whois/design-system/Strong";
import Label from "@whois/design-system/Label";
import Button from "@whois/design-system/Button";
import IconButton from "@whois/design-system/IconButton";
import Card from "@whois/design-system/Card";
import CardHeader from "@whois/design-system/CardHeader";
import CardBody from "@whois/design-system/CardBody";
import Callout from "@whois/design-system/Callout";
import Pill from "@whois/design-system/Pill";
import Anchor from "@whois/design-system/Anchor";
import List from "@whois/design-system/List";
import ListItem from "@whois/design-system/ListItem";
import InlineCode from "@whois/design-system/InlineCode";
import Icon from "@whois/design-system/Icon";
import VisuallyHidden from "@whois/design-system/VisuallyHidden";

const textSizes = [1, 2, 3, 4, 5, 6, 7, 8] as const;
const textVariants = [
	"default",
	"primary",
	"secondary",
	"tertiary",
	"info",
	"success",
	"warning",
	"danger",
] as const;
const textWeights = [2, 3, 4] as const;
const families = ["default", "display", "serif", "mono", "code"] as const;
const iconNames = [
	"chevron",
	"check",
	"arrow",
	"external",
	"info",
	"alert",
	"github",
	"play",
	"pause",
	"code",
	"copy",
	"command",
] as const;
const iconVariants = [
	"default",
	"primary",
	"secondary",
	"tertiary",
	"info",
	"danger",
	"success",
	"warning",
] as const;

// ── Token control panel ─────────────────────────────────────────────────────
// A three.js/lil-gui-style panel that live-edits the DS tokens driving every
// component below. Utility tokens (--space-*, --border-radius-*, --font-*) are
// defined on :root; color tokens are defined per-theme on .maximeheckel-*. The
// `scope` field tells the copy-config export (and the agent applying it) which
// selector each token belongs under in tokens.overrides.css.
type TokenControl = {
	var: string; // CSS custom property, e.g. "--accent"
	label: string;
	type: "color" | "length" | "number";
	min?: number;
	max?: number;
	step?: number;
	unit?: string; // appended to slider value, e.g. "px"
};
type TokenGroup = {
	title: string;
	scope: "root" | "themed"; // :root vs .maximeheckel-<theme>
	controls: TokenControl[];
};

const px = { type: "length", unit: "px" } as const;
const TOKEN_GROUPS: TokenGroup[] = [
	{
		title: "Semantic (theme colors)",
		scope: "themed",
		controls: [
			{ var: "--accent", label: "accent", type: "color" },
			{ var: "--background", label: "background", type: "color" },
			{ var: "--text-primary", label: "text-primary", type: "color" },
			{ var: "--text-secondary", label: "text-secondary", type: "color" },
			{ var: "--text-tertiary", label: "text-tertiary", type: "color" },
			{ var: "--border-color", label: "border-color", type: "color" },
			{ var: "--card-background", label: "card-background", type: "color" },
			{ var: "--danger", label: "danger", type: "color" },
			{ var: "--warning", label: "warning", type: "color" },
			{ var: "--success", label: "success", type: "color" },
			{ var: "--hyperlink", label: "hyperlink", type: "color" },
		],
	},
	{
		title: "Color scales",
		scope: "themed",
		controls: [
			{ var: "--gray-100", label: "gray-100", type: "color" },
			{ var: "--gray-400", label: "gray-400", type: "color" },
			{ var: "--gray-900", label: "gray-900", type: "color" },
			{ var: "--gray-1200", label: "gray-1200", type: "color" },
			{ var: "--blue-400", label: "blue-400", type: "color" },
			{ var: "--blue-900", label: "blue-900", type: "color" },
			{ var: "--blue-1000", label: "blue-1000", type: "color" },
			{ var: "--green-900", label: "green-900", type: "color" },
			{ var: "--red-900", label: "red-900", type: "color" },
			{ var: "--orange-900", label: "orange-900", type: "color" },
			{ var: "--pink-900", label: "pink-900", type: "color" },
		],
	},
	{
		title: "Spacing",
		scope: "root",
		controls: [
			{ var: "--space-2", label: "space-2", min: 0, max: 32, step: 1, ...px },
			{ var: "--space-3", label: "space-3", min: 0, max: 48, step: 1, ...px },
			{ var: "--space-4", label: "space-4", min: 0, max: 64, step: 1, ...px },
			{ var: "--space-5", label: "space-5", min: 0, max: 80, step: 1, ...px },
			{ var: "--space-6", label: "space-6", min: 0, max: 96, step: 1, ...px },
		],
	},
	{
		title: "Radius",
		scope: "root",
		controls: [
			{ var: "--border-radius-0", label: "radius-0", min: 0, max: 32, step: 1, ...px },
			{ var: "--border-radius-1", label: "radius-1", min: 0, max: 40, step: 1, ...px },
			{ var: "--border-radius-2", label: "radius-2", min: 0, max: 48, step: 1, ...px },
			{ var: "--border-radius-3", label: "radius-3", min: 0, max: 64, step: 1, ...px },
		],
	},
	{
		title: "Typography",
		scope: "root",
		controls: [
			{ var: "--font-size-1", label: "font-size-1", min: 10, max: 24, step: 1, ...px },
			{ var: "--font-size-3", label: "font-size-3", min: 12, max: 28, step: 1, ...px },
			{ var: "--font-size-4", label: "font-size-4", min: 12, max: 32, step: 1, ...px },
			{ var: "--font-size-5", label: "font-size-5", min: 14, max: 40, step: 1, ...px },
			{ var: "--font-size-6", label: "font-size-6", min: 16, max: 48, step: 1, ...px },
			{ var: "--font-size-7", label: "font-size-7", min: 20, max: 64, step: 1, ...px },
			{ var: "--font-size-8", label: "font-size-8", min: 24, max: 88, step: 1, ...px },
			{ var: "--font-weight-400", label: "weight-400", type: "number", min: 100, max: 900, step: 10 },
			{ var: "--font-weight-500", label: "weight-500", type: "number", min: 100, max: 900, step: 10 },
			{ var: "--font-weight-600", label: "weight-600", type: "number", min: 100, max: 900, step: 10 },
		],
	},
];

// The four type roles, for the catalogue's faces block. Each specimen sets the
// family AND the weight, the way a call site should.
const faces = [
	{
		token: "--font-hero",
		name: "Migra Bold",
		use: "the hero lockup — wordmark, \u201cother stories\u201d, the ampersand",
		css: "font-family: var(--font-hero); font-weight: var(--font-hero-weight);",
	},
	{
		token: "--font-heading",
		name: "Migra Medium",
		use: "h1\u2013h3, DS H1\u2013H3, bare headings",
		css: "font-family: var(--font-heading); font-weight: var(--font-heading-weight);",
	},
	{
		token: "--font-subheading",
		name: "FS Mondwest Bold",
		use: "small-type labels \u2014 hero lede, page subtitles, DS H4",
		css: "font-family: var(--font-subheading);",
	},
	{
		token: "--font-body",
		name: "PP Mondwest",
		use: "everything else; --font-sans and the DS --font-display alias it",
		css: "font-family: var(--font-body);",
	},
];
---

<Layout
	title="Design System — Tristan Timblin"
	description="A living catalogue of the @whois design-system components, rendered in every variant, size, and state with a live token editor."
>
	<!-- Live token editor. Sliders/pickers write inline custom properties onto
	     <html> (which beats the class-scoped stylesheet), so every component in
	     the catalogue re-renders instantly. "Copy config" exports the changed
	     tokens as JSON for the agent to apply to tokens.overrides.css. -->
	<aside class="ds-controls" data-token-controls aria-label="design token controls">
		<header class="ds-controls__top">
			<h2 class="ds-controls__title">tokens</h2>
			<span class="ds-controls__theme" data-theme-name></span>
		</header>
		<p class="ds-controls__note">
			Color edits apply to the current theme. Drag to preview; Copy config
			exports changed tokens as JSON.
		</p>
		<div class="ds-controls__body">
			{TOKEN_GROUPS.map((group) => (
				<fieldset class="ds-controls__group" data-scope={group.scope}>
					<legend>{group.title}</legend>
					{group.controls.map((c) =>
						c.type === "color" ? (
							<label class="ds-controls__row ds-controls__row--color">
								<span class="ds-controls__label">{c.label}</span>
								<span class="ds-controls__colorwrap">
									<input type="color" data-var={c.var} data-role="swatch" />
									<input
										type="text"
										class="ds-controls__text"
										data-var={c.var}
										data-role="value"
										spellcheck="false"
									/>
								</span>
							</label>
						) : (
							<label class="ds-controls__row">
								<span class="ds-controls__label">
									{c.label}
									<output data-out={c.var}></output>
								</span>
								<input
									type="range"
									data-var={c.var}
									data-unit={c.unit ?? ""}
									min={c.min}
									max={c.max}
									step={c.step}
								/>
							</label>
						)
					)}
				</fieldset>
			))}
		</div>
		<footer class="ds-controls__actions">
			<button type="button" data-copy>Copy config</button>
			<button type="button" data-reset>Reset</button>
		</footer>
	</aside>

	<main class="ds-demo">
		<h1 class="ds-demo__title">@whois/design-system — component catalogue</h1>

		<!-- TYPOGRAPHY ----------------------------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Faces — the four roles</h2>
			<p class="ds-demo__note">
				Self-hosted from <code>/fonts</code> (built by <code>tools/fonts/build.sh</code>,
				@font-face'd in <code>src/styles/fonts.css</code>). Reach for the ROLE token, not
				the family name. Migra is one family with two cuts, so its roles carry a weight
				companion — set both or the browser picks the cut for you.
			</p>
			<Flex direction="column" gap={3} alignItems="start">
				{faces.map((f) => (
					<div class="ds-demo__face">
						<span class="ds-demo__face-token">{f.token}</span>
						<span class="ds-demo__face-name">{f.name}</span>
						<span class="ds-demo__face-use">{f.use}</span>
						<span class="ds-demo__face-specimen" style={f.css}>
							Hamburgefonstiv 123
						</span>
					</div>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Text — sizes</h2>
			<Flex direction="column" gap={2} alignItems="start">
				{textSizes.map((s) => (
					<Text size={s}>size {s} — The quick brown fox (14/14/16/18/20/24/32/44)</Text>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Text — variants (color)</h2>
			<Flex direction="column" gap={1} alignItems="start">
				{textVariants.map((v) => (
					<Text variant={v} size={4}>variant {v}</Text>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Text — weights</h2>
			<Flex direction="column" gap={1} alignItems="start">
				{textWeights.map((w) => (
					<Text weight={w} size={4}>weight {w}</Text>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Text — families</h2>
			<Flex direction="column" gap={1} alignItems="start">
				{families.map((f) => (
					<Text family={f} size={4}>family {f} — AaBbCc 123</Text>
				))}
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Text — flags (outline / spaced / truncate)</h2>
			<Flex direction="column" gap={2} alignItems="start">
				<Text outline size={7}>outline face</Text>
				<Text spaced size={4}>spaced letter-spacing</Text>
				<div style="width:220px; border:1px dashed var(--border-color);">
					<Text truncate size={4}>truncate this very long line that overflows its container</Text>
				</div>
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Leading, tracking, and what the faces can actually do</h2>
			<p class="ds-demo__note">
				Three leadings, because there are three jobs. <code>--line-height-heading</code>
				(1.15) holds a heading's lines together as one object; body leading on display
				type makes a two-line heading read as two unrelated lines.
				<code>--line-height-body</code> (1.7) gives running text room to find the next
				line. <code>--line-height-ui</code> (1.3) sits between them for label type, which
				wants to be tighter than prose without being display-tight.
				<code>--tracking-heading</code> is negative and in <code>em</code>, because the
				space between letters grows with the type — display sizes need it pulled back.
			</p>
			<p class="ds-demo__note">
				Uppercase always gets tracking: every letterform in a text face is fitted to sit
				beside lowercase, so capitals run together jam. That is most of why all-caps
				reads as hard. <code>--tracking-caps</code> (0.1em) is the workhorse;
				<code>--tracking-caps-display</code> (0.16em) is for masthead marks where the
				tracking is doing compositional work. The site had been making that decision
				five times at 0.04 / 0.08 / 0.1 / 0.14 / 0.18em.
			</p>
			<p class="ds-demo__note">
				<strong>What the four faces support</strong>, read out of the files in
				<code>/fonts</code> rather than assumed — this is why some typographic advice
				does not apply here. None of them is a <em>variable</em> font, so weights cannot
				be nudged per theme; the cuts are Migra 500/700, Neue Montreal 400/600, and a
				single cut each for FS Mondwest and PP Mondwest. None ships <code>smcp</code>, so
				small caps would be faked — resized capitals, far too light — which is why
				<code>font-synthesis-small-caps</code> is off in global.css. Old-style figures
				(<code>onum</code>) exist only on Migra, the heading face; the body face has no
				figure features at all, so old-style figures in prose are not available without a
				new face. Neue Montreal does ship <code>tnum</code>, which is what the numeric
				role below uses. All three text faces ship <code>liga</code> and
				<code>kern</code>.
			</p>
			<Flex direction="column" gap={2} alignItems="start">
				<Text class="ds-caps" family="mono" size={1}>ds-caps · section mark</Text>
				<Text class="ds-caps ds-caps--display" family="mono" size={1}>ds-caps--display · masthead mark</Text>
				<span class="ds-numeric" style="font-size: var(--font-size-6);">ds-numeric&nbsp;·&nbsp;1034 / 1543 / 0158</span>
				<span style="font-size: var(--font-size-0); color: var(--text-tertiary);">--font-size-0 · the caption step, below the scale's 14px floor</span>
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Body — the reading role</h2>
			<p class="ds-demo__note">
				Takes no size: the whole setting (face, size, line-height, letter-spacing,
				reading colour) comes from the <code>--font-body-*</code> tokens, so reading
				text is one decision rather than a step picked off the Text scale. Compare
				the size-4 line below — that step is the smallest HEADING, and prose set in
				it reads a size too large.
			</p>
			<div style="max-width: 62ch; display: grid; gap: var(--space-4);">
				<Body>
					I am a craftsman, I create things to be used. Even if they often are not,
					it is for the love of the process. My creativite nature comes through in
					an empathetic design, where with a deep understanding of another I can
					build them worlds.
				</Body>
				<Body variant="tertiary">
					Body, variant tertiary — the same setting in the quieter ink.
				</Body>
				<Text size={4} variant="secondary">
					Text size 4 for contrast — this is the sub-heading step, not body.
				</Text>
			</div>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Heading + H1–H4 · EM · Strong</h2>
			<H1>H1 heading</H1>
			<H2>H2 heading</H2>
			<H3>H3 heading</H3>
			<H4>H4 heading</H4>
			<Heading as="p" size={2}>Heading as p, size 2</Heading>
			<Text size={4}>Body with <EM>emphasis</EM> and <Strong>strong</Strong>.</Text>
		</section>

		<!-- BUTTONS -------------------------------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Button — variants</h2>
			<Flex gap={3} wrap="wrap">
				<Button variant="primary">Primary</Button>
				<Button variant="secondary">Secondary</Button>
				<Button variant="tertiary">Tertiary</Button>
				<Button variant="primary" inverted>Primary inverted</Button>
				<Button variant="primary" rounded>Rounded</Button>
				<Button variant="primary" disabled>Disabled</Button>
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">IconButton — variants / sizes</h2>
			<Flex gap={3} wrap="wrap" alignItems="center">
				<IconButton variant="primary" size="large" aria-label="a"><Icon name="check" slot="icon" /></IconButton>
				<IconButton variant="secondary" size="large" aria-label="b"><Icon name="copy" slot="icon" /></IconButton>
				<IconButton variant="tertiary" size="large" aria-label="c"><Icon name="command" slot="icon" /></IconButton>
				<IconButton variant="secondary" size="small" aria-label="d"><Icon name="x" slot="icon" /></IconButton>
				<IconButton variant="secondary" size="large" rounded aria-label="e"><Icon name="play" slot="icon" /></IconButton>
			</Flex>
		</section>

		<!-- CARD ----------------------------------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Card — depths / variants</h2>
			<Grid templateColumns="repeat(auto-fill, minmax(200px, 1fr))" gap={4}>
				{[0, 1, 2, 3].map((d) => (
					<Card depth={d as 0 | 1 | 2 | 3} title={`Card depth ${d}`}>
						<CardBody><Text size={3}>Body content.</Text></CardBody>
					</Card>
				))}
				<Card variant="secondary" title="Secondary (glass)">
					<CardBody><Text size={3}>Glass material.</Text></CardBody>
				</Card>
				<Card variant="tertiary">
					<CardHeader>Manual header</CardHeader>
					<CardBody><Text size={3}>Tertiary variant.</Text></CardBody>
				</Card>
			</Grid>
		</section>

		<!-- CALLOUT + PILL ------------------------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Callout — variants</h2>
			<Flex direction="column" gap={3} alignItems="stretch">
				<Callout variant="info">Info callout with default icon.</Callout>
				<Callout variant="danger">Danger callout with default icon.</Callout>
				<Callout variant="warning">Warning callout (no default icon per source).</Callout>
				<Callout variant="info" label="LABEL">Info with a text label instead of icon.</Callout>
			</Flex>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Pill — variants</h2>
			<Flex gap={2} wrap="wrap">
				<Pill variant="info">info</Pill>
				<Pill variant="success">success</Pill>
				<Pill variant="warning">warning</Pill>
				<Pill variant="danger">danger</Pill>
			</Flex>
		</section>

		<!-- ANCHOR --------------------------------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Anchor — variants</h2>
			<Flex direction="column" gap={2} alignItems="start">
				<Anchor href="#">plain anchor</Anchor>
				<Anchor href="#" underline>underline</Anchor>
				<Anchor href="#" discreet>discreet</Anchor>
				<Anchor href="#" arrow="right">arrow right</Anchor>
				<Anchor href="#" arrow="left">arrow left</Anchor>
				<Anchor href="https://example.com" external>external</Anchor>
				<Anchor href="https://github.com/x" favicon>github favicon</Anchor>
			</Flex>
		</section>

		<!-- LIST + INLINECODE ---------------------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">List — unordered / ordered</h2>
			<Grid templateColumns="1fr 1fr" gap={5}>
				<List variant="unordered">
					<ListItem>First item</ListItem>
					<ListItem>Second item</ListItem>
					<ListItem>Third item</ListItem>
				</List>
				<List variant="ordered">
					<ListItem>First item</ListItem>
					<ListItem>Second item</ListItem>
					<ListItem>Third item</ListItem>
				</List>
			</Grid>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">InlineCode</h2>
			<Text size={4}>Run <InlineCode>bun install</InlineCode> then <InlineCode>bun dev</InlineCode>.</Text>
		</section>

		<!-- ICON ----------------------------------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Icon — names</h2>
			<Flex gap={4} wrap="wrap" alignItems="center">
				{iconNames.map((n) => (
					<Flex direction="column" gap={1} alignItems="center">
						<Icon name={n} size={6} variant="primary" />
						<Text size={1} variant="tertiary">{n}</Text>
					</Flex>
				))}
			</Flex>
			<h2 class="ds-demo__h" style="margin-top:24px;">Icon — variants (colors)</h2>
			<Flex gap={4} wrap="wrap" alignItems="center">
				{iconVariants.map((v) => (
					<Icon name="info" size={6} variant={v} />
				))}
			</Flex>
		</section>

		<!-- LAYOUT + A11Y -------------------------------------------------- -->
		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Box / Flex (foundation)</h2>
			<Flex gap={2} justifyContent="space-between"
				style="border:1px solid var(--border-color); padding:8px;">
				<Box style="background:var(--blue-400); padding:8px;">flex a</Box>
				<Box style="background:var(--blue-500); padding:8px;">flex b</Box>
				<Box style="background:var(--blue-600); padding:8px;">flex c</Box>
			</Flex>
		</section>

		<!-- GRID: columns / gutters / breakpoints ------------------------- -->
