				<ReadoutStack values={["32.0k", "44.1k", "96.0k"]} active={1} aria-label="Sample rate" />
				<ReadoutStack values={["1/4", "1/8", "1/16"]} active={0} aria-label="Division" />
				<ReadoutStack values={["lo", "mid", "hi", "air"]} active={3} aria-label="Band" />
			</Flex>

			<h2 class="ds-demo__h ds-demo__h--sub">Formula — real superscripts and subscripts</h2>
			<p class="ds-demo__note">
				<code>&lt;Formula value&gt;</code>: <code>^</code> raises and <code>_</code> lowers the next run (a <code>{"{…}"}</code> group, or a sign and letters or digits); a hyphen is a minus. The drawing is aria-hidden and a visually hidden twin says <code>label</code>, or the formula spoken — "z to the minus 1".
			</p>
			<Flex gap={8} wrap="wrap" alignItems="baseline" data-formulas>
