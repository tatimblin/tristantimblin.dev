	.ds-demo__art-toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
		cursor: pointer;
	}
	.ds-demo__art-toggle input {
		accent-color: var(--accent);
	}
	.ds-demo__art-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
		gap: var(--space-4);
