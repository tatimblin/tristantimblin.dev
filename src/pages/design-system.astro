// Art tokens, for the swatch row: name → what it is for.
const artTokens = [
	["--art-plate", "the tile fill — near-black on dark, bone (--gray-300) on light"],
	["--art-edge", "the tile's 1px edge"],
	["--art-ink", "line work and white fills — near-white on dark, dark (--gray-1200) on light"],
	["--art-ink-2", "the ink at 45% — grids, dashed paths, ghost outlines"],
	["--art-lavender", "fill"],
	["--art-coral", "fill — the site accent"],
	["--art-cyan", "fill"],
	["--art-green", "fill"],
	["--art-radius", "the frame's corner (--border-radius-1)"],
	["--duration-loop", "one cycle of an art animation (6s; 0s under reduced motion)"],
] as const;

// Small drawings in the language, one per thing the frame owns. Written here
// rather than as files in the package. Each is the template's shape: viewBox 0 0 320 180, token
// colours only, non-scaling strokes, at most one data-motion group.
const line = 'fill="none" stroke="var(--art-ink)" class="art-line" vector-effect="non-scaling-stroke"';
const line2 = 'fill="none" stroke="var(--art-ink-2)" class="art-line" vector-effect="non-scaling-stroke"';
const open = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 180">';
// The two weights and the two dash patterns, top to bottom.
const artLines = `${open}
	<path d="M 20 40 H 300" ${line} />
	<path d="M 20 70 H 300" fill="none" stroke="var(--art-ink)" class="art-line--2" vector-effect="non-scaling-stroke" />
	<path d="M 20 100 H 300" ${line2} />
	<path d="M 20 130 H 300" ${line2} stroke-dasharray="4 4" />
	<path d="M 20 160 H 300" ${line2} stroke-dasharray="2 6" />
</svg>`;
// Ticks every 10 units from 0 to 360 — one period (40) past the right edge,
// since the slide moves the group left by exactly 40.
const tall = Array.from({ length: 10 }, (_, i) => `M ${i * 40} 120 v 16`).join(" ");
const short = Array.from({ length: 37 }, (_, i) => i * 10)
	.filter((x) => x % 40 !== 0)
	.map((x) => `M ${x} 120 v 8`)
	.join(" ");
const dots = [
	[150, 40, 3, "lavender"], [190, 70, 2, "ink"], [230, 30, 2.5, "lavender"],
	[270, 60, 1.5, "ink"], [300, 100, 3, "lavender"], [210, 110, 2, "lavender"],
	[250, 140, 1.5, "ink"], [170, 150, 2.5, "lavender"], [290, 150, 2, "ink"],
	[130, 100, 1.5, "lavender"], [320, 30, 2.5, "lavender"], [110, 60, 2, "ink"],
] as const;
const artMotions: Array<[string, string, string]> = [
	[
		"spin",
		`${open}
	<path d="M -10 90 H 200" ${line} />
	<circle cx="200" cy="90" r="2.5" fill="var(--art-ink)" />
	<circle cx="270" cy="90" r="60" ${line2} />
	<g data-motion="spin">
		<circle cx="270" cy="90" r="44" ${line} />
		<path d="M 270 46 V 134 M 226 90 H 314 M 238.9 58.9 L 301.1 121.1 M 301.1 58.9 L 238.9 121.1" ${line} />
		<circle cx="270" cy="58" r="3" fill="var(--art-cyan)" />
		<circle cx="270" cy="90" r="6" fill="var(--art-ink)" />
	</g>
</svg>`,
		"a reel turning about its own centre — one turn per loop",
	],
	[
		"drift",
		`${open}
	<path d="M 40 -10 V 190 M 80 -10 V 190" ${line2} stroke-dasharray="2 6" />
	<path d="M 40 130 H 80" ${line} />
	<circle cx="80" cy="130" r="2.5" fill="var(--art-ink)" />
	<g data-motion="drift">
		${dots.map(([x, y, r, c]) => `<circle cx="${x}" cy="${y}" r="${r}" fill="var(--art-${c})" />`).join("\n\t\t")}
	</g>
</svg>`,
		"a dot field easing out and back — a slow alternate translate",
	],
	[
		"slide",
		`${open}
	<path d="M -10 120 H 330" ${line} />
	<g data-motion="slide">
		<path d="${tall}" ${line} />
		<path d="${short}" ${line2} />
	</g>
	<rect x="158" y="96" width="4" height="40" rx="2" fill="var(--art-coral)" />
	<path d="M 160 -10 V 90" ${line2} stroke-dasharray="4 4" />
</svg>`,
		"a rule repeating every 40 units, moved left by 40 — seamless",
	],
	[
		"blink",
		`${open}
	<path d="M -10 100 H 60 V 60 H 140 M 140 60 H 220 V 100 H 330" ${line} />
	<circle cx="60" cy="100" r="2.5" fill="var(--art-ink)" />
	<circle cx="220" cy="100" r="2.5" fill="var(--art-ink)" />
	<circle cx="140" cy="60" r="14" ${line2} />
	<g data-motion="blink">
		<circle cx="140" cy="60" r="8" fill="var(--art-coral)" />
	</g>
</svg>`,
		"a node dimming and lighting — a hard step, four per loop",
	],
	[
		"dash",
		`${open}
	<path d="M -10 40 H 60 V 120 H 160 V 60 H 260 V 140 H 330" ${line} />
	<g data-motion="dash">
		<path d="M -10 60 H 40 V 140 H 140 V 80 H 240 V 160 H 330" fill="none" stroke="var(--art-green)" stroke-dasharray="4 4" class="art-line" vector-effect="non-scaling-stroke" />
	</g>
	<circle cx="60" cy="40" r="2.5" fill="var(--art-ink)" />
	<circle cx="260" cy="140" r="2.5" fill="var(--art-ink)" />
</svg>`,
		"a dashed trace advancing by one period — stroke-dashoffset, six per loop",
	],
];

// Instrument tokens, for the swatch row: name → what it is for.
const instrumentTokens = [
	["--accent", "the one accent"],
	["--accent-hover", "the accent under the pointer"],
	["--on-accent", "type on the accent — the ink, both themes"],
	["--lit", "a step that is on: a quieter blue (paler on cream, deeper at night)"],
	["--wash-1", "unlit tile · subtle pill"],
	["--wash-2", "ink, 2nd strength"],
	["--wash-3", "ink, 3rd strength · outline"],
	["--tone-1", "rank 1"],
	["--tone-2", "rank 2"],
	["--tone-3", "rank 3"],
	["--tone-4", "rank 4"],
	["--tone-5", "rank 5 / other"],
	["--hairline", "the edge's colour alone (--border-color): a stripe, a ring"],
