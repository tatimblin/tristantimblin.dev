const inBlock = (d: QuiltDemo, c: number, r: number) =>
	d.panel.mode !== "hidden" &&
	c >= d.panel.col && c < d.panel.col + 3 && r >= d.panel.row && r < d.panel.row + 2;
// A made-up scatter, deterministic per cell, standing in for the engine's.
const roll = (c: number, r: number, salt: number) => (((r * 5 + c) * 7919 + salt * 104729) % 97) / 97;
const cellState = (d: QuiltDemo, c: number, r: number, slug?: string): { state: QuiltCellState; delay: number } => {
	if (!d.lit) return { state: "lit", delay: 0 };
	if (inBlock(d, c, r)) return { state: "gone", delay: Math.round(roll(c, r, 1) * 240) };
	if (slug && d.lit.includes(slug)) return { state: "lit", delay: 0 };
	if (!slug && d.fillersFaint) return { state: "faint", delay: Math.round(roll(c, r, 1) * 240) };
	if (slug && d.fillersFaint) return { state: "lit", delay: 0 };
	return { state: roll(c, r, 2) < 0.5 ? "gone" : "faint", delay: Math.round(roll(c, r, 1) * 240) };
};

