		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Grid — gutters (gap → --space-* tokens)</h2>
			<Text size={2} variant="tertiary">
				Same 4-column grid at increasing gap tokens. The gutter is the only
				thing changing.
			</Text>
			{([2, 4, 6, 8] as const).map((g) => (
				<div style="margin-top:16px;">
					<Text size={1} variant="secondary">
						gap={g} → var(--space-{g})
					</Text>
					<Grid templateColumns="repeat(4, 1fr)" gap={g} style="margin-top:6px;">
						<GridItem class="ds-cell">1</GridItem>
						<GridItem class="ds-cell">2</GridItem>
						<GridItem class="ds-cell">3</GridItem>
						<GridItem class="ds-cell">4</GridItem>
					</Grid>
				</div>
			))}
			<div style="margin-top:16px;">
				<Text size={1} variant="secondary">
					asymmetric: gapX={8} (column) · gapY={2} (row)
				</Text>
				<Grid templateColumns="repeat(3, 1fr)" gapX={8} gapY={2}
					style="margin-top:6px;">
					{Array.from({ length: 6 }).map((_, i) => (
						<GridItem class="ds-cell">{i + 1}</GridItem>
					))}
				</Grid>
			</div>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">Grid — breakpoints</h2>
			<Text size={2} variant="tertiary">
				Resize the window. First row uses intrinsic
				<InlineCode>auto-fill / minmax()</InlineCode> (no media queries).
				Second row switches column count at the DS breakpoints (sm 640 · md
				768 · lg 1024).
			</Text>

			<Text size={1} variant="secondary" style="margin-top:16px; display:block;">
				auto-fill, minmax(120px, 1fr) — reflows continuously
			</Text>
			<Grid templateColumns="repeat(auto-fill, minmax(120px, 1fr))" gap={4}
				style="margin-top:6px;">
				{Array.from({ length: 8 }).map((_, i) => (
					<GridItem class="ds-cell">{i + 1}</GridItem>
				))}
			</Grid>

			<Text size={1} variant="secondary" style="margin-top:20px; display:block;">
				1 col → 2 (sm) → 3 (md) → 4 (lg), via CSS media queries
			</Text>
			<Grid class="ds-bp-grid" gap={4} style="margin-top:6px;">
				{Array.from({ length: 4 }).map((_, i) => (
					<GridItem class="ds-cell">{i + 1}</GridItem>
				))}
			</Grid>
			<Text size={1} variant="tertiary" style="margin-top:8px; display:block;">
				current: <span class="ds-bp-readout"></span>
			</Text>
		</section>

		<section class="ds-demo__section">
			<h2 class="ds-demo__h">VisuallyHidden</h2>
			<Text size={3}>There is a hidden label after this:</Text>
			<VisuallyHidden>screen-reader only text</VisuallyHidden>
		</section>
	</main>
</Layout>

<script>
	// Live token editor: reflect each control onto an inline custom property on
	// <html>, which overrides the class-scoped stylesheet so the catalogue below
	// updates instantly. "Copy config" exports only the changed tokens as JSON,
	// split into root/themed so the agent can drop them into tokens.overrides.css.
	function initTokenControls() {
		const panel = document.querySelector<HTMLElement>("[data-token-controls]");
		if (!panel || panel.dataset.bound === "true") return;
		panel.dataset.bound = "true";

		const root = document.documentElement;
		const scopeOf = (varName: string): "root" | "themed" => {
			const fs = panel
				.querySelector(`[data-var="${varName}"]`)
				?.closest<HTMLElement>("[data-scope]");
			return (fs?.dataset.scope as "root" | "themed") ?? "themed";
		};
		const currentTheme = () =>
			root.classList.contains("maximeheckel-light")
				? "maximeheckel-light"
				: "maximeheckel-dark";

		// Resolve any CSS color (incl. oklch) to #rrggbb by painting a pixel and
		// reading its bytes — canvas serializes oklch as "oklch(...)", not hex, so
		// we sample the rasterized RGB instead. Returns null on an unparseable value.
		const canvas = document.createElement("canvas");
		canvas.width = canvas.height = 1;
		const canvasCtx = canvas.getContext("2d", { willReadFrequently: true });
		const hex2 = (n: number) => n.toString(16).padStart(2, "0");
		const toHex = (color: string): string | null => {
			if (!canvasCtx) return null;
			// Reject values the canvas can't parse (it keeps the prior fillStyle).
			canvasCtx.fillStyle = "#000000";
			canvasCtx.fillStyle = color;
			if (canvasCtx.fillStyle === "#000000" && !/^(#000000|black)$/i.test(color.trim()))
				return null;
			canvasCtx.clearRect(0, 0, 1, 1);
			canvasCtx.fillRect(0, 0, 1, 1);
			const [r, g, b] = canvasCtx.getImageData(0, 0, 1, 1).data;
			return `#${hex2(r)}${hex2(g)}${hex2(b)}`;
		};

		// Changed tokens keyed by var name → { value, scope }. Empty = pristine.
		const changed = new Map<string, { value: string; scope: "root" | "themed" }>();
		const baselines = new Map<string, string>();

		const outputs = panel.querySelectorAll<HTMLOutputElement>("[data-out]");

		// Seed every control from the resolved baseline for the active theme.
		function seed() {
			// Drop any live-preview overrides we set (leave other inline styles alone).
			for (const varName of changed.keys()) root.style.removeProperty(varName);
			changed.clear();
			baselines.clear();
			const cs = getComputedStyle(root);

			panel.querySelectorAll<HTMLInputElement>("[data-var]").forEach((input) => {
				const varName = input.dataset.var!;
				const base = cs.getPropertyValue(varName).trim();
				baselines.set(varName, base);

				const role = input.dataset.role;
				if (input.type === "range") {
					input.value = parseFloat(base).toString();
					const out = panel.querySelector<HTMLElement>(`[data-out="${varName}"]`);
					if (out) out.textContent = base;
				} else if (role === "value") {
					input.value = base; // text field holds the true (maybe oklch) value
				} else if (role === "swatch") {
					const hex = toHex(base);
					if (hex) input.value = hex;
				}
			});

			const nameEl = panel.querySelector<HTMLElement>("[data-theme-name]");
			if (nameEl) nameEl.textContent = currentTheme().replace("maximeheckel-", "");
		}

		function apply(varName: string, value: string) {
			root.style.setProperty(varName, value);
			const base = baselines.get(varName);
			if (base !== undefined && value === base) changed.delete(varName);
			else changed.set(varName, { value, scope: scopeOf(varName) });
		}

		panel.querySelectorAll<HTMLInputElement>("[data-var]").forEach((input) => {
			const varName = input.dataset.var!;
			input.addEventListener("input", () => {
				if (input.type === "range") {
					const value = input.value + (input.dataset.unit || "");
					const out = panel.querySelector<HTMLElement>(`[data-out="${varName}"]`);
					if (out) out.textContent = value;
					apply(varName, value);
				} else if (input.dataset.role === "swatch") {
					// Mirror the picker into the paired text field (the source of truth).
					const text = panel.querySelector<HTMLInputElement>(
						`input[data-var="${varName}"][data-role="value"]`,
					);
					if (text) text.value = input.value;
					apply(varName, input.value);
				} else {
					// Text field: keep the swatch in sync when the value is hex-able.
					const swatch = panel.querySelector<HTMLInputElement>(
						`input[data-var="${varName}"][data-role="swatch"]`,
					);
					const hex = toHex(input.value);
					if (swatch && hex) swatch.value = hex;
					apply(varName, input.value);
				}
			});
		});

		const copyBtn = panel.querySelector<HTMLButtonElement>("[data-copy]");
		copyBtn?.addEventListener("click", async () => {
			const rootTokens: Record<string, string> = {};
			const themed: Record<string, string> = {};
			for (const [varName, { value, scope }] of changed) {
				(scope === "root" ? rootTokens : themed)[varName] = value;
			}
			const config = {
				target: "packages/design-system/src/tokens/tokens.overrides.css",
				theme: currentTheme(),
				root: rootTokens,
				themed,
			};
			const json = JSON.stringify(config, null, 2);
			try {
				await navigator.clipboard.writeText(json);
			} catch {
				// Clipboard blocked (e.g. insecure context): log so it's still grabbable.
				console.log(json);
			}
			const label = copyBtn.textContent;
			copyBtn.textContent = changed.size ? "Copied!" : "No changes";
			setTimeout(() => (copyBtn.textContent = label), 1200);
		});

		panel
			.querySelector<HTMLButtonElement>("[data-reset]")
			?.addEventListener("click", () => seed());

		seed();
		// Re-seed when the site theme toggles (SiteFooter dispatches themechange).
		document.addEventListener("themechange", () => seed());
	}

	document.addEventListener("astro:page-load", initTokenControls);
</script>

<style>
	.ds-demo {
		max-width: 1000px;
		margin-inline: auto;
		padding: var(--space-10) var(--space-6);
		color: var(--text-primary);
	}
	/* Keep the catalogue clear of the fixed panel on wide screens. */
	@media (min-width: 901px) {
		.ds-demo {
			margin-inline: 0 auto;
			padding-right: calc(280px + var(--space-8));
		}
	}

	/* ── Token control panel ─────────────────────────────────────────────── */
	.ds-controls {
		position: fixed;
		top: var(--space-4);
		right: var(--space-4);
		z-index: 20;
		width: 264px;
		max-height: calc(100vh - var(--space-8));
		display: flex;
		flex-direction: column;
		padding: var(--space-4);
		background: var(--card-background);
		border: 1px solid var(--border-color);
		border-radius: var(--border-radius-2);
		box-shadow: 0 8px 30px oklch(0% 0 0 / 35%);
		color: var(--text-primary);
		font-family: var(--font-mono);
		font-size: var(--font-size-1);
	}
	.ds-controls__top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2);
	}
	.ds-controls__title {
		margin: 0;
		font-size: var(--font-size-3);
		font-family: var(--font-mono);
	}
	.ds-controls__theme {
		font-size: var(--font-size-1);
		color: var(--accent);
	}
	.ds-controls__note {
		margin: var(--space-1) 0 var(--space-2);
		font-family: var(--font-display);
		font-size: 0.72rem;
		line-height: 1.35;
		color: var(--text-tertiary);
	}
	.ds-controls__body {
		flex: 1;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding-right: var(--space-1);
	}
	.ds-controls__group {
		margin: 0;
		padding: var(--space-2) 0 0;
		border: none;
		border-top: 1px solid var(--border-color);
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.ds-controls__group legend {
		padding: 0;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-secondary);
	}
	.ds-controls__row {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.ds-controls__label {
		display: flex;
		justify-content: space-between;
		gap: var(--space-2);
		color: var(--text-secondary);
	}
	.ds-controls__label output {
		font-variant-numeric: tabular-nums;
		color: var(--text-tertiary);
	}
	.ds-controls__row input[type="range"] {
		width: 100%;
		accent-color: var(--accent);
	}
	.ds-controls__colorwrap {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.ds-controls__colorwrap input[type="color"] {
		width: 28px;
		height: 24px;
		flex: none;
		padding: 0;
		border: 1px solid var(--border-color);
		border-radius: var(--border-radius-0);
		background: none;
		cursor: pointer;
	}
	.ds-controls__text {
		flex: 1;
		min-width: 0;
		padding: 0.25rem 0.4rem;
		border: 1px solid var(--input-border);
		border-radius: var(--border-radius-0);
		background: var(--input-background);
		color: var(--text-primary);
		font-family: var(--font-mono);
		font-size: 0.72rem;
	}
	.ds-controls__actions {
		display: flex;
		gap: var(--space-2);
		margin-top: var(--space-3);
		padding-top: var(--space-3);
		border-top: 1px solid var(--border-color);
	}
	.ds-controls__actions button {
		flex: 1;
		padding: 0.4rem 0.5rem;
		border: 1px solid var(--border-color);
		border-radius: var(--border-radius-1);
		background: var(--accent);
		color: var(--white, #fff);
		font: inherit;
		font-size: 0.78rem;
		cursor: pointer;
	}
	.ds-controls__actions button[data-reset] {
		background: transparent;
		color: var(--text-secondary);
	}

	/* On narrow screens: dock to a scrollable bottom sheet, don't cover content. */
	@media (max-width: 900px) {
		.ds-controls {
			top: auto;
			bottom: 0;
			left: 0;
			right: 0;
			width: auto;
			max-height: 45vh;
			border-radius: var(--border-radius-2) var(--border-radius-2) 0 0;
		}
	}
	/* The catalogue's own headings take the HEADING role, like every other heading
	   on the site. They used to set --font-display, which aliases --font-body — so
	   a page whose job is to show the type system off was setting its 26 section
	   headings in the body face, with no weight token, and demonstrating the exact
	   mistake it documents. Family and weight together, from the role. */
	.ds-demo__title {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: var(--font-size-8);
		margin-bottom: var(--space-8);
	}
	.ds-demo__section {
		padding-block: var(--space-6);
		border-top: 1px solid var(--border-color);
	}
	.ds-demo__h {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: var(--font-size-5);
		color: var(--text-secondary);
		margin-bottom: var(--space-4);
	}

	.ds-demo__note {
		max-width: 68ch;
		margin-block: calc(-1 * var(--space-3)) var(--space-5);
		font-size: var(--font-size-1);
		line-height: var(--line-height-ui);
		color: var(--text-tertiary);
	}

	.ds-demo__note code {
		font-family: var(--font-mono-code);
	}

	/* One row per face: the token that selects it, what it is, where it goes, and a
	   specimen set in it. The specimen is last so the four line up for comparison. */
	.ds-demo__face {
		display: grid;
		grid-template-columns: minmax(0, 18ch) minmax(0, 17ch) minmax(0, 1fr);
		gap: var(--space-2) var(--space-4);
		align-items: baseline;
		width: 100%;
	}

	.ds-demo__face-token {
		font-family: var(--font-mono-code);
		font-size: var(--font-size-1);
		color: var(--accent);
	}

	.ds-demo__face-name {
		font-size: var(--font-size-1);
		color: var(--text-secondary);
	}

	.ds-demo__face-use {
		font-size: var(--font-size-1);
		color: var(--text-tertiary);
	}

	.ds-demo__face-specimen {
		grid-column: 1 / -1;
		font-size: var(--font-size-7);
		line-height: 1.2;
		color: var(--text-primary);
	}

	@media (max-width: 700px) {
		.ds-demo__face {
			grid-template-columns: 1fr;
		}
	}

	/* Grid demo cells — a visible box so columns + gutters read clearly. */
	.ds-cell {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: var(--space-9);
		padding: var(--space-2);
		background: var(--blue-400);
		border-radius: var(--border-radius-1);
		font-family: var(--font-mono);
		font-size: var(--font-size-1);
		color: var(--text-primary);
	}
	.ds-cell--head {
		min-height: var(--space-6);
		background: var(--gray-300);
		color: var(--text-tertiary);
	}

	/* Breakpoint grid: column count steps at the DS breakpoints. */
	.ds-bp-grid {
		grid-template-columns: 1fr;
	}
	@media (min-width: 640px) {
		.ds-bp-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 768px) {
		.ds-bp-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	@media (min-width: 1024px) {
		.ds-bp-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	/* Pure-CSS breakpoint readout (mirrors the media queries above). */
	.ds-bp-readout::before {
		content: "base (<640) — 1 col";
		font-family: var(--font-mono);
		color: var(--accent);
	}
	@media (min-width: 640px) {
		.ds-bp-readout::before {
			content: "sm (≥640) — 2 cols";
		}
	}
	@media (min-width: 768px) {
		.ds-bp-readout::before {
			content: "md (≥768) — 3 cols";
		}
	}
	@media (min-width: 1024px) {
		.ds-bp-readout::before {
			content: "lg (≥1024) — 4 cols";
		}
	}
</style>
