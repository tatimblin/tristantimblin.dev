					<Fragment slot="label">Asserting on<br />agent behavior<br /><Mono tone="tertiary">Feb 2026 · 554 w</Mono></Fragment>
				</Stat>
			</Flex>
		</section>

		<section class="ds-demo__section">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">Hairline</Heading>
			<p class="ds-demo__note">A rule: the one edge (<code>--border</code>, dashed) drawn across its container. <code>variant="fade"</code> opts into the divider that fades out at both ends (<code>--hairline-fade</code>, a solid 1px gradient). An <code>hr</code>, or <code>as="span"</code> when decorative.</p>
			<Hairline />
			<Hairline variant="fade" style="margin-top: var(--space-4);" />
		</section>

		<section class="ds-demo__section" id="rule-label">
