		block-size: 60%;
		border-radius: var(--border-radius-tile);
		background: var(--swatch);
	}
	/* A quilt tile (~230px at the 1200px container, five across) beside a
	   hero-width frame: the same file, the same 1px line. */
	.ds-demo__art-sizes {
		display: grid;
		grid-template-columns: 230px minmax(0, 1fr);
		gap: var(--space-4);
		align-items: start;
	}
	/* The template on each theme's page, side by side: the wrapper's theme
	   class re-resolves every token in scope. */
	.ds-demo__art-themes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--space-4);
	}
	.ds-demo__art-page {
		display: grid;
		gap: var(--space-3);
		padding: var(--space-4);
		background: var(--background);
		color: var(--text-primary);
		border: 1px solid var(--hairline);
		border-radius: var(--border-radius-1);
