					<Fragment slot="meta">
						<Pill>5–0</Pill>
						<IconButton size="xs" rounded aria-label="next" style="margin-inline-start: var(--space-2);"><Icon name="arrow" size={3} /></IconButton>
					</Fragment>
					<CardBody><Text size={3}>squeeze="title": the title ellipsises, the meta holds.</Text></CardBody>
				</Card>
