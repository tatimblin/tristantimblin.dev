---
// Living catalogue of the ported @whois/design-system components. Renders every
// component in its variants/sizes/states for visual QA and regression reference.
import Layout from "../layouts/Layout.astro";
import "@whois/design-system/styles.css";

import Box from "@whois/design-system/Box";
import Flex from "@whois/design-system/Flex";
import Grid from "@whois/design-system/Grid";
import GridItem from "@whois/design-system/GridItem";
import Text from "@whois/design-system/Text";
import Heading from "@whois/design-system/Heading";
import Body from "@whois/design-system/Body";
import H1 from "@whois/design-system/H1";
import H2 from "@whois/design-system/H2";
import H3 from "@whois/design-system/H3";
import H4 from "@whois/design-system/H4";
import EM from "@whois/design-system/EM";
import Strong from "@whois/design-system/Strong";
import Label from "@whois/design-system/Label";
import Button from "@whois/design-system/Button";
import IconButton from "@whois/design-system/IconButton";
import Card from "@whois/design-system/Card";
