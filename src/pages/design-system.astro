		font-family: var(--font-mono);
		font-size: var(--font-size-0);
		line-height: 1;
	}

	/* Art swatches: the ink and the fills are only ever seen on the plate, so
	   each sits on a plate square. */
	.ds-demo__swatch--art {
		display: grid;
		place-items: center;
		background: var(--art-plate);
		border-color: var(--art-edge);
