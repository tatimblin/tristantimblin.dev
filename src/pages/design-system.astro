				</Card>
			</Grid>
		</section>

		{/* CALLOUT + PILL ------------------------------------------------- */}

		<section class="ds-demo__section">
			<Heading as="h2" size={2} variant="secondary" class="ds-demo__h">Pill — variants</Heading>
			<p class="ds-demo__note">
				Caps mono in a capsule. <code>subtle</code> (the default) is the header pill, <code>outline</code> the quiet link or toggle (its edge is the Chip's). As a <code>button</code> or <code>a</code> it is a pill button.
			</p>
			<Flex gap={2} wrap="wrap" alignItems="center">
				<Pill><Icon name="check" />low risk</Pill>
				<Pill variant="outline">0/360°</Pill>
				<Pill as="button" type="button">tap</Pill>
				<Pill as="button" type="button" variant="outline">skip</Pill>
				<Pill as="a" href="#" variant="outline">home</Pill>
