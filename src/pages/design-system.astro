	["--focus-ring", "the focus ring, at --focus-ring-offset (or --focus-ring-inset)"],
	["--bar-width", "every solid edge bar: the pull quote's"],
	["--shadow-3", "the deep shadow, for the few things that float (a control panel)"],
	["--card-background", "card surface"],
