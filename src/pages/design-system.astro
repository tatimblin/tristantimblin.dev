				</Card>
				<Card>
					<CardHeader title="Manual header">
						<Pill slot="meta">low risk</Pill>
					</CardHeader>
					<CardBody><Text size={3}>The same header, placed by hand.</Text></CardBody>
				</Card>
				<Card squeeze="title" style="max-inline-size: 320px;">
