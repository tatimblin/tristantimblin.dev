---
// /dotgrid-light — prototype: tuning <dotted-grid> for a light (cream) backdrop.
import Layout from "../layouts/Layout.astro";
import "@whois/dotted-grid/styles.css";

const FABRIC = { src: "/videos/fabric.web.mp4", "src-webm": "/videos/fabric.web.webm" };
const BASE = { ...FABRIC, invert: "", color: "#191918", background: "#fff8eb", "cell-size": "6", levels: "6", denoise: "0.3", bloom: "0", crosshatch: "0" };

// NOT inverted: the clip's shadows (most of the frame) stay bare cream, the folds print.
const N = { ...FABRIC, color: "#191918", background: "#fff8eb", "cell-size": "6", levels: "6", denoise: "0.3", bloom: "0", crosshatch: "0", "dot-shape": "1", cutoff: "0.06", feather: "0.2" };
const variants = [
	{ name: "A · gamma .5", attrs: { ...N, gamma: "0.5", contrast: "1.05", "dot-scale": "1.1" } },
	{ name: "B · gamma .4", attrs: { ...N, gamma: "0.4", contrast: "1.05", "dot-scale": "1.1" } },
	{ name: "C · gamma .3", attrs: { ...N, gamma: "0.3", contrast: "1.05", "dot-scale": "1.1" } },
	{ name: "D · gamma .3, contrast 1.3", attrs: { ...N, gamma: "0.3", contrast: "1.3", "dot-scale": "1.1" } },
	{ name: "E · B, morph dots", attrs: { ...N, "dot-shape": "2", gamma: "0.4", contrast: "1.05", "dot-scale": "1.1" } },
	{ name: "F · B, 8px cells", attrs: { ...N, "cell-size": "8", gamma: "0.4", contrast: "1.05", "dot-scale": "1.1" } },
	{ name: "G · B in warm gray", attrs: { ...N, color: "#6e6656", gamma: "0.4", contrast: "1.05", "dot-scale": "1.1" } },
	{ name: "H · B in blue", attrs: { ...N, color: "#0276fd", gamma: "0.4", contrast: "1.05", "dot-scale": "1.1" } },
	{ name: "I · B + light hatch", attrs: { ...N, crosshatch: "0.2", gamma: "0.4", contrast: "1.05", "dot-scale": "1.1" } },
	{ name: "J · dark reference (hero)", attrs: { ...FABRIC, color: "#e8eefc", background: "#0b0d12", "cell-size": "6", "dot-scale": "1.15", levels: "6", gamma: "0.55", contrast: "1.05", feather: "0.65", denoise: "0.1", bloom: "0.5", crosshatch: "0.3" } },
];
---

<Layout title="Dotted grid, light tuning" description="Prototype" noindex>
	<main class="dgv">
		<h1>dotted-grid, tuned for cream</h1>
		<p>Not inverted, bloom and hatch off, dark ink: the shadows stay bare cream and the folds print. J is the dark hero for reference.</p>
		<div class="dgv__grid">
			{variants.map((v) => (
				<section class="dgv__panel">
					<header><span>{v.name}</span></header>
					<dotted-grid {...v.attrs} max-dpr="1" />
				</section>
			))}
		</div>
	</main>
	<script>import "@whois/dotted-grid";</script>
</Layout>

<style>
	.dgv { max-width: 976px; margin: 0 auto; padding: 32px 16px; }
	.dgv h1 { font-family: "DM Sans", sans-serif; font-weight: 500; font-size: 24px; margin: 0 0 8px; }
	.dgv p { margin: 0 0 32px; }
	.dgv__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
	.dgv__panel { background: #fdfdfd; border: 1px dashed #aaa9a6; border-radius: 2.5px; box-shadow: 0 1px 0 1px #d1dbe4; overflow: hidden; }
	.dgv__panel header { padding: 8px 16px; border-bottom: 1px dashed #aaa9a6; background: linear-gradient(#fdfdfd 50%, #f1f4f7); font-family: "DM Sans", sans-serif; font-size: 14px; text-transform: uppercase; color: #525250; }
	.dgv__panel dotted-grid { --dotted-grid-height: 260px; }
</style>
