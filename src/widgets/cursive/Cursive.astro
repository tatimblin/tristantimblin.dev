---
// Cursive — a 2×2 card around the live agent from cursive.info: a
// <cursive-terminal> on the `tristan` profile, which searches Tristan's own
// records (meals, reviews, articles) and can open what his friends and the
// community wrote about the same places, each attributed to whoever wrote it.
// Visitors ask without signing in.
//
// The element is agent-web's (packages/cursive-terminal), loaded at runtime
// from the agent's host rather than bundled, so the card tracks the backend
// without a dependency bump; ./config.ts holds the bundle URL and decides, at
// build time, which agent this build talks to. ./client.ts imports the
// bundle the first time the card nears the viewport, and swaps in the DS
// empty state if the bundle fails or is slow, or the agent never answers.
// The header's meta reads today's shared model budget off the element's
// `cursive-usage` event: a short TickRuler and the figure in the label voice
// (a header row is one line, so not a stacked Stat). It stays hidden until
// the first reading, so the card never shows a made-up 0%.
//
// Props pass through to the <Widget> (a class, the page's data-reveal
// choreography): the page owns where the card sits and when it fades in.
import Widget from "@whois/design-system/Widget";
import CardBody from "@whois/design-system/CardBody";
import Mono from "@whois/design-system/Mono";
import TickRuler from "@whois/design-system/TickRuler";
import WidgetEmpty from "@whois/design-system/WidgetEmpty";
import VisuallyHidden from "@whois/design-system/VisuallyHidden";
import { agentEndpoint, CURSIVE_TERMINAL } from "./config";
import "./cursive.css";

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;

const endpoint = agentEndpoint({
	dev: import.meta.env.DEV,
	override: import.meta.env.PUBLIC_CURSIVE_AGENT,
});
const bundleOrigin = new URL(CURSIVE_TERMINAL).origin;
---

<Widget size="2x2" name="cursive" class:list={["wx-cursive", className]} data-state="idle" {...rest}>
	{/* The product's name, linked: the card is a window onto cursive.info. */}
	<a slot="title" href="https://cursive.info" target="_blank" rel="noopener">cursive.info</a>

	{/* Today's shared model budget: the demo runs on a free daily allocation,
	    so this is the honest "how much is left". About ten ticks, a tick a
	    tenth, and the figure; what the figure means is for screen readers
	    only. The script rewrites the ruler's shares and both texts on every
	    reading. */}
	<span slot="meta" class="wx-cs-usage" data-cursive-usage>
		<TickRuler
			class="wx-cs-ruler"
			segments={[
				{ share: 0, color: "var(--cs-used)" },
				{ share: 100, color: "var(--cs-left)" },
			]}
		/>
		<Mono variant="value" class="wx-cs-value" data-cursive-value>0%</Mono>
		<VisuallyHidden as="span" data-cursive-label>of today's free budget used</VisuallyHidden>
	</span>

	<CardBody class="wx-cs-body">
		<cursive-terminal
			endpoint={endpoint}
			profile="tristan"
			greeting="Ask about where I've eaten"
			prompts="Where have you eaten in Madrid?|Best steak you've had?|Anywhere you'd skip?"
		></cursive-terminal>
		<WidgetEmpty class="wx-cs-empty">The agent is offline right now.</WidgetEmpty>
	</CardBody>

	{/* Warm the two connections the card will open: the bundle (an anonymous
	    CORS fetch, hence crossorigin) and the agent (credentialed, so its own
	    pool). One host in production, two on staging. */}
	<link rel="preconnect" href={bundleOrigin} crossorigin />
	<link rel="preconnect" href={endpoint} />
</Widget>
