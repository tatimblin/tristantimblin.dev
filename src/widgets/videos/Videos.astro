---
// Videos — the video carousel adopted into the widget grid as a 1×2 cell on the
// grid's right edge, with the date ruler protruding into the page gutter. The
// carousel's true layout home is this cell; a scroll-driven lift (a CSS
// scroll-progress animation in ./videos.css, measured and — where scroll
// timelines are missing — driven by ./client.ts) makes it visually START high
// on the page and PARALLAX down to dock here as the grid scrolls into view. On
// mobile it goes full width and the lift is disabled. The generic carousel
// lives in ../../components; this module owns only its grid placement +
// docking behaviour.
//
// The runtime mounts it `eager`, at page load and before every other card:
// the lift parks the card on the fold at scroll 0, and that has to be in place
// before the page can be scrolled. `contain="layout"`: the ruler overhangs the
// cell, which paint containment (content-visibility) would clip.
//
// Props pass through to the <Widget> (a class, the page's data-reveal
// choreography — see index.astro for why this card reveals on its own). NB
// the reveal writes `translate` while the dock lift writes `transform`
// — two independent properties, so they compose instead of overwriting each
// other.
import Widget from "@whois/design-system/Widget";
import { WIDGET_WIDE_MQ } from "@whois/design-system/lib/breakpoints";
import Deferred from "../../components/Deferred.astro";
import VideoCarousel from "../../components/VideoCarousel.astro";
import "./videos.css";

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<Widget
	size="1x2"
	name="videos"
	load="eager"
	contain="layout"
	class:list={["wx-videos", className]}
	chrome={false}
	{...rest}
>
	{/* Clip changes get the threshold transition here too, so the carousel behaves the
	    same wherever it appears. No `intro` though: this cell is mid-page behind a
	    scroll-driven dock, so a develop-in entrance would play unseen. */}
	{/* The tone is tuned once per theme, in src/styles/halftone.css (.wx-videos). */}
	{/* No card chrome: the halftone sits straight on the page, filling the cell,
	    with its caption laid over the clip's corner as a TV caption. */}
	{/* Deferred to the widths that show the card (videos.css hides it at the
	    grid's compact step, where the carousel is the hero scene instead): at
	    the others it is never created, so it costs no WebGL context and no
	    video download. */}
	<Deferred media={WIDGET_WIDE_MQ}>
		<VideoCarousel
			fill
			rulerSide="right"
			captionOverlay
			xfade={1600}
			xfadeMode="threshold"
			xfadeLive
			cellSize={6}
		/>
	</Deferred>
</Widget>
