---
// Videos — the video carousel adopted into the widget grid as a 1×2 cell on the
// grid's right edge, with the date ruler protruding into the page gutter. The
// carousel's true layout home is this cell; a scroll-driven lift (see the
// <script> below) makes it visually START high on the page and PARALLAX down to
// dock here as the grid scrolls into view. On mobile it goes full width and the
// lift is disabled. The generic carousel lives in ../../components; this module
// owns only its grid placement + docking behaviour.
import Widget from "@whois/design-system/Widget";
import VideoCarousel from "../../components/VideoCarousel.astro";
import "./videos.css";
---

<!-- Its OWN reveal group, deliberately not the row's "widgets" one. A group waits
     for every member to be in view before it fades any of them in, and this card
     paints ~90vh above its slot (the dock lift) while its row-mates sit at their
     real grid position — so grouping it with them held it invisible until the ROW
     arrived, by which point it had already climbed most of the way up the page and
     the parallax played out unseen. On its own — and with `data-reveal-eager`, which
     trips the observer just BEFORE it reaches the viewport — it is already opaque
     when it crosses the fold, which is where its entrance is choreographed to start.
     NB the reveal writes `translate` while the dock lift below writes `transform`
     — two independent properties, so they compose instead of overwriting each
     other. -->
<Widget
	size="1x2"
	class="wx-videos"
	depth={0}
	variant="tertiary"
	data-reveal
	data-reveal-group="videos"
	data-reveal-eager
>
	{/* Clip changes get the threshold transition here too, so the carousel behaves the
	    same wherever it appears. No `intro` though: this cell is mid-page behind a
	    scroll-driven dock, so a develop-in entrance would play unseen. */}
	{/* Tone values are tuned once per theme: prepare-carousel.sh matches every
	    clip's luma distribution to Redwoods, so one set per theme fits all clips.
	    Dark keeps the clip's floor empty with sparse glowing dots. Light needs more
	    ink for the same image (dark specks on white read fainter than light dots
	    glowing on black), but not so much that the floor fills in and the tile
	    reads as mostly black. */}
	<VideoCarousel
		rulerSide="right"
		xfade={1600}
		xfadeMode="threshold"
		xfadeLive
		dotScale={0.8}
		cellSize={6}
		levels={12}
		gamma={0.6}
		contrast={1.1}
		crosshatch={0}
		cutoff={0.2}
		light={{ gamma: 0.5, cutoff: 0.15, dotScale: 1 }}
		denoise={1}
		feather={0.4}
	/>
</Widget>

<script>
	// Scroll dock via a transform (--vc-dock-lift) on the widget. Its true layout
	// home is the 1×2 grid cell at the foot of the page — the transform only shifts
	// where it PAINTS, so the grid keeps the cell reserved and the other widgets
	// flow around it throughout.
	//
	// The parallax spans the card's ENTIRE visible life: it starts the instant the
	// raised card's top edge crosses the fold and eases to 0 at the dock line, so
	// the card is drifting the whole way down the page rather than riding along
	// 1:1 for most of the scroll and only parallaxing at the end. (It used to hold
	// a constant lift until the card was COMPLETELY in view — with a cell this tall
	// that moment lands low on the page, which is why the effect only read as a
	// short hop right before docking.)
	//
	// Each frame:
	//   naturalTop = rect.top − currentLift          // slot's paint pos, transform-free
	//   enterLine  = vh + travel                     // naturalTop when the RAISED top is at the fold
	//   dockLine   = DOCK_VH · vh                     // naturalTop at which lift hits 0
	//   q          = clamp01((enterLine − naturalTop) / (enterLine − dockLine))
	//   lift       = −travel · (1 − ease(q))         // −travel at the fold → 0 at the dock
	// naturalTop is measured transform-invariantly (minus the lift we applied) so it
	// never feeds back; the whole thing self-calibrates across resize/layout shifts.
	// ease = smoothstep, whose slope is 0 at both ends and peaks at 1.5 in the
	// middle. The card therefore rises into view at roughly page speed, PINS hardest
	// once it is properly on screen, and eases back to 1:1 as it settles — no
	// velocity jump at either end. (easeOutQuad, whose slope peaks at entry, was
	// worse here despite parallaxing "sooner": the card is 2/3 of a viewport tall,
	// so lagging hardest at entry left it creeping as a sliver along the bottom edge
	// for hundreds of px of scroll, and the drift went unseen for the same reason
	// a constant phase-1 lift did.)
	// The pin depth is 1 − 1.5·travel/span (0.16 at the tuned travel: the card holds
	// near-still while the page runs past it). It stays positive — the card always
	// moves up the screen, never stalls or reverses — while travel < 1.4vh.
	// Docking completes at the fixed dockLine (independent of travel) so it always
	// fully settles as the grid frames, no matter how high it enters.
	//
	// `travel` (the raise / parallax distance) is set in CSS via --vc-travel on the
	// widget (default 55vh); larger = enters higher + more parallax. DOCK_VH is how
	// far down the viewport the cell is when it finishes settling into the grid.
	const TRAVEL_FALLBACK = 0.55; // --vc-travel fallback, fraction of viewport height
	const DOCK_VH = 0.3; // cell's viewport-top (vh) when fully docked
	const SELECTOR = ".wx-videos";

	const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
	const smoothstep = (t: number) => t * t * (3 - 2 * t);

	/** Resolve a CSS length custom property (vh or px) on el to pixels. */
	function cssPx(el: HTMLElement, prop: string, fallbackPx: number): number {
		const raw = getComputedStyle(el).getPropertyValue(prop).trim();
		if (!raw) return fallbackPx;
		if (raw.endsWith("vh")) return (parseFloat(raw) / 100) * window.innerHeight;
		const n = parseFloat(raw);
		return Number.isFinite(n) ? n : fallbackPx;
	}

	class DockLift {
		private el: HTMLElement;
		private lift = 0;
		private rafId: number | null = null;
		private mobileMQ = window.matchMedia("(max-width: 900px)");
		private reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
		private offs: Array<() => void> = [];

		constructor(el: HTMLElement) {
			this.el = el;
			const onScroll = () => this.schedule();
			const onResize = () => this.schedule();
			const onMQ = () => this.schedule();
			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", onResize, { passive: true });
			this.mobileMQ.addEventListener("change", onMQ);
			this.reduced.addEventListener("change", onMQ);
			this.offs.push(
				() => window.removeEventListener("scroll", onScroll),
				() => window.removeEventListener("resize", onResize),
				() => this.mobileMQ.removeEventListener("change", onMQ),
				() => this.reduced.removeEventListener("change", onMQ)
			);
			this.update();
		}

		private schedule() {
			if (this.rafId !== null) return;
			this.rafId = requestAnimationFrame(() => {
				this.rafId = null;
				this.update();
			});
		}

		private setLift(px: number) {
			this.lift = px;
			this.el.style.setProperty("--vc-dock-lift", `${px.toFixed(2)}px`);
		}

		private update() {
			// Mobile / reduced-motion: render docked, no lift.
			if (this.mobileMQ.matches || this.reduced.matches) {
				if (this.lift !== 0) this.setLift(0);
				return;
			}
			const vh = window.innerHeight;
			const rect = this.el.getBoundingClientRect();
			const naturalTop = rect.top - this.lift; // strip the applied transform
			const travel = cssPx(this.el, "--vc-travel", TRAVEL_FALLBACK * vh);

			// Start of the parallax: the raised card's top edge sits on the fold, i.e.
			// naturalTop − travel = vh. Independent of the cell's height, so a taller
			// carousel doesn't push the effect further down the page.
			const enterLine = vh + travel;
			// End: the lift reaches 0 at the fixed dock line, so it always fully
			// settles as the grid frames, regardless of travel.
			const dockLine = DOCK_VH * vh;
			const span = Math.max(1, enterLine - dockLine);
			const q = clamp01((enterLine - naturalTop) / span);
			this.setLift(-travel * (1 - smoothstep(q)));
		}

		destroy() {
			if (this.rafId !== null) cancelAnimationFrame(this.rafId);
			this.rafId = null;
			this.offs.forEach((off) => off());
			this.offs = [];
			this.el.style.removeProperty("--vc-dock-lift");
		}
	}

	// Bind on every page load (initial + after each ClientRouter view transition),
	// and tear down before a swap so listeners don't accumulate across navigations.
	let instance: DockLift | null = null;
	function init() {
		const el = document.querySelector<HTMLElement>(SELECTOR);
		if (!el || instance) return;
		instance = new DockLift(el);
	}
	function teardown() {
		instance?.destroy();
		instance = null;
	}
	document.addEventListener("astro:page-load", init);
	document.addEventListener("astro:before-swap", teardown);
</script>
