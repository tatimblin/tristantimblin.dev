---
// VideoChrome — the card the clip wears once docked, laid over the stage as one
// layer: the frame, a CardHeader whose title is the clip's label, and a footer.
// A figcaption, in the carousel's `caption` slot, so the clip is named once, by
// its own figure, at every opacity. Nothing here takes a place in the stage's
// flow: the stage holds its header and footer bands empty for it, so the clip
// is the same box floating and docked, and only opacity ever changes
// (./videos.css). If the header or footer changes height, update their bands
// there (--vc-head-h, --vc-foot-h); tests/video-card.spec.ts compares them.
//
// Server-rendered with the first clip; the element rewrites the [data-vc-*]
// fields on every selection, so the hooks go on the elements that hold the
// text. The title is a plain span: the header's own Mono sets the title voice.
import CardHeader from "@whois/design-system/CardHeader";
import Mono from "@whois/design-system/Mono";
import clips from "../../data/video-clips.json";

interface Props {
	/** The footer is the compact variant's scrubber: a band for the ticks (the
	 *  carousel's ruler, placed over it in ./videos.css) and one line that
	 *  swaps between the date and the location (./client.ts). */
	scrub?: boolean;
}

const { scrub = false } = Astro.props;
const first = clips[0];
---

<figcaption class="wx-videos__chrome">
	<CardHeader squeeze="title">
		<span slot="title" class="wx-videos__label" data-vc-desc>{first?.description}</span>
	</CardHeader>
	{
		scrub ? (
			<div class="wx-videos__foot wx-videos__foot--scrub">
				<span class="wx-videos__band" />
				<span class="wx-videos__line">
					<Mono variant="text" tone="secondary" truncate data-vc-date>{first?.date}</Mono>
					<Mono variant="text" tone="secondary" truncate data-vc-loc>{first?.location}</Mono>
				</span>
			</div>
		) : (
			<div class="wx-videos__foot">
				<Mono class="wx-videos__loc" variant="text" tone="secondary" truncate data-vc-loc>{first?.location}</Mono>
				<Mono class="wx-videos__date" variant="value" data-vc-date>{first?.date}</Mono>
			</div>
		)
	}
</figcaption>
