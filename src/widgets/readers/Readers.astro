---
// Readers widget — a 1×1 tile for how many real people visit this site, in the
// instrument UI (packages/design-system/CONVENTIONS.md → Instrument UI).
//
// The shape: a caps header (VISITORS, and the range as a pill in its meta
// slot), a mono readout, a graph of vertical hairlines — one per reading, the
// busiest one lit in the accent — and the total as the big numeral. The figure
// is a plain COUNT of visitors over the range — not a percentage. At figures
// Cloudflare rounds to the nearest ten, a percentage turns one sampled event
// into "50%", which is precision the data does not have; a count says exactly
// as much as is known.
//
// WHAT IT PLOTS, and why it is not the obvious thing. The tile reads Cloudflare
// Web Analytics (RUM), which only records pageloads that ran its JavaScript
// beacon — so every bar is browsers. The zone's own request counts were the
// tempting source (they are dense, and they make a lovely graph) and they are
// ~98% crawlers and vulnerability scanners: the top paths after `/` are
// /wp-login.php, /.env and /.git/config. A graph drawn from those is a graph
// about bots.
//
// The cost of choosing the honest source is that it is thin: the figures are
// sampled and arrive quantized to tens, and about half of all days are zero. So
// every bar is a TRAILING SUM rather than a day — see buildView() in
// ./readers.ts for the full argument, and for why the window widens with the
// range.
//
// POINTING AT THE GRAPH reads it: the bar under the pointer takes the accent
// from the peak and the readout above names its value and dates. With the
// script running the graph is also a keyboard slider (arrows / Home / End)
// whose value text says the same thing; without it, the graph is hidden from
// assistive tech and a sentence per range carries the peak instead.
//
// THE PILL CYCLES the range: 30d → 1y → all. Every range is rendered
// server-side as its own face and swapped by an attribute on the card, the
// same mechanism Github.astro flips with — so the pill fetches nothing and the
// tile still works with the script blocked (it shows the first range and an
// inert pill).
//
// Data is read at build time from readers.json (see ./readers.ts), which the
// readers Action regenerates daily.
import Widget from "@whois/design-system/Widget";
import CardBody from "@whois/design-system/CardBody";
import Mono from "@whois/design-system/Mono";
import Figure from "@whois/design-system/Figure";
import BarGraph from "@whois/design-system/BarGraph";
import Pill from "@whois/design-system/Pill";
import VisuallyHidden from "@whois/design-system/VisuallyHidden";
import {
	buildViews,
	formatCount,
	formatSpan,
	getReaderStats,
	isDrawable,
} from "./readers";
import "./readers.css";

const stats = getReaderStats();

// Only the ranges with something in them. A range is unusable either because
// the ledger is too young to fill it or because it genuinely recorded nobody,
// and the second is not hypothetical here: most days on this site are zero, so
// a quiet month makes the 30-day face empty while the all-time face still has
// hundreds of visitors in it. Judging each range and offering only what exists
// keeps the tile honest and the pill useful.
const views = buildViews(stats.days).filter(isDrawable);
const hasSeries = views.length > 0;
// Optional: with nothing drawable there is no initial range, and the card is
// still rendered (as the empty state).
const initial = views[0];
// With one range there is nothing to cycle to, so the pill stays a label
// rather than becoming a button that does nothing.
const cycles = views.length > 1;

const sampledNote = stats.sampled
	? "Cloudflare Web Analytics samples traffic, so these are estimates, rounded to the nearest ten."
	: "";

// What the script needs to read a bar back: its value and its dates, in bar
// order. Compact keys — this is inlined once per range.
const readings = (view: (typeof views)[number]) =>
	JSON.stringify(
		view.points.map((p) => ({ v: p.value, s: formatSpan(p.from, p.date) })),
	);
---

<Widget
	size="1x1"
	title="visitors"
	class="wx-readers"
	data-range={initial?.key}
	data-reveal
	data-reveal-group="widgets"
	data-reveal-order="4"
>
	{
		hasSeries && (
			<Fragment slot="meta">
				{/* TWO PILLS, one of which is always hidden. Without the script the
				    static one shows and nothing pretends to be interactive; the
				    script swaps them. A <button disabled> would have done it in one
				    element, but "disabled" announces a control that is temporarily
				    unavailable, which is not what a page without JavaScript has. */}
				<Pill class="wx-rd-range wx-rd-range--static">{initial?.key}</Pill>
				{cycles && (
					<Pill as="button" class="wx-rd-range wx-rd-cycle" type="button" hidden>
						{views.map((view) => (
							<span data-face={view.key}>{view.key}</span>
						))}
					</Pill>
				)}
			</Fragment>
		)
	}

	<CardBody class="wx-rd-body">
		{
			hasSeries ? (
				views.map((view) => (
					<div
						class="wx-rd-face"
						data-face={view.key}
						data-readings={readings(view)}
						data-peak={view.peakIndex}
						data-label={view.label}
						data-window={view.window}
					>
						{/* The readout: the lit bar's value and dates. At rest that is
						    the peak, so it says so; the script rewrites it as the
						    pointer or the keyboard moves the lit bar. aria-hidden —
						    the slider's value text (or, without the script, the
						    sentence below) says it for assistive tech. */}
						<Mono class="wx-rd-readout" tone="tertiary" aria-hidden="true">
							<span class="wx-rd-read-tag">peak </span>
							<Mono as="span" variant="value" class="wx-rd-read-value">
								{view.peak?.value}
							</Mono>
							{" · "}
							<span class="wx-rd-read-span">
								{formatSpan(view.peak?.from ?? "", view.peak?.date ?? "")}
							</span>
						</Mono>

						<BarGraph
							class="wx-rd-bars"
							values={view.points.map((p) => p.value)}
							lit={view.peakIndex}
							aria-hidden="true"
							title={sampledNote || undefined}
						/>

						<Figure unit="total" title={sampledNote || undefined}>
							{formatCount(view.total)}
						</Figure>

						<VisuallyHidden class="wx-rd-say">
							{formatCount(view.total)} visitors over {view.label.toLowerCase()}
							{view.covered < view.span ? ` (${view.covered} days on record)` : ""}.
							{" "}Busiest {view.window} days{" "}
							{formatSpan(view.peak?.from ?? "", view.peak?.date ?? "")}, with{" "}
							{view.peak?.value}. {sampledNote}
						</VisuallyHidden>
					</div>
				))
			) : (
				/* The data file is generated and the fetch script refuses to write
				   an empty one — but no visitors yet is a state the tile can
				   legitimately be in on a fresh site, and it should say so rather
				   than draw a row of empty bars. */
				<Mono variant="text" class="wx-rd-empty">No visitors yet.</Mono>
			)
		}
	</CardBody>
</Widget>

<script>
	// Two behaviours, both over markup that is already in the DOM: the pill
	// cycles the range (an attribute on the card), and each range's graph reads
	// back the bar under the pointer / keyboard. No network, no persisted state.
	// Bound per page-load and torn down before a view-transition swap so
	// handlers don't accumulate (the lifecycle idiom from Github.astro).
	interface Reading {
		v: number;
		s: string;
	}

	function bindGraph(face: HTMLElement): () => void {
		const graph = face.querySelector<HTMLElement>(".wx-rd-bars");
		const bars = [...(graph?.querySelectorAll<HTMLElement>(".ds-bars__bar") ?? [])];
		const tag = face.querySelector<HTMLElement>(".wx-rd-read-tag");
		const value = face.querySelector<HTMLElement>(".wx-rd-read-value");
		const span = face.querySelector<HTMLElement>(".wx-rd-read-span");
		let readings: Reading[] = [];
		try {
			readings = JSON.parse(face.dataset.readings ?? "[]");
		} catch {}
		if (!graph || bars.length === 0 || readings.length !== bars.length) {
			return () => {};
		}

		const peak = Number(face.dataset.peak);
		const last = bars.length - 1;
		let at = peak;
		let settle = 0;

		// Light bar i — and only bar i, so the card keeps its one accent — and
		// say what it is, to the eye (the readout) and to assistive tech (the
		// slider's value text).
		const show = (i: number) => {
			at = Math.min(Math.max(i, 0), last);
			bars.forEach((bar, j) => bar.toggleAttribute("data-lit", j === at));
			const r = readings[at];
			if (tag) tag.hidden = at !== peak;
			if (value) value.textContent = String(r.v);
			if (span) span.textContent = r.s;
			graph.setAttribute("aria-valuenow", String(at));
			graph.setAttribute(
				"aria-valuetext",
				`${r.v} visitors, ${r.s}${at === peak ? ", the busiest" : ""}`,
			);
		};

		// Upgrade the hidden picture into a slider over the readings.
		graph.removeAttribute("aria-hidden");
		graph.setAttribute("role", "slider");
		graph.tabIndex = 0;
		graph.setAttribute(
			"aria-label",
			`Visitors per ${face.dataset.window ?? "7"} days, ${(face.dataset.label ?? "").toLowerCase()}`,
		);
		graph.setAttribute("aria-valuemin", "0");
		graph.setAttribute("aria-valuemax", String(last));
		show(peak);

		// Bars are spread edge to edge (space-between), so bar i sits at
		// i / last of the width — the nearest one is a rounding away.
		const fromPointer = (event: PointerEvent) => {
			const rect = graph.getBoundingClientRect();
			const x = (event.clientX - rect.left) / Math.max(1, rect.width);
			window.clearTimeout(settle);
			show(Math.round(x * last));
		};
		const onLeave = (event: PointerEvent) => {
			if (document.activeElement === graph) return;
			// A touch lifts as it leaves; hold its reading a moment so it can be
			// read, then hand the accent back to the peak.
			window.clearTimeout(settle);
			if (event.pointerType === "mouse") show(peak);
			else settle = window.setTimeout(() => show(peak), 2000);
		};
		const onKey = (event: KeyboardEvent) => {
			const step: Record<string, number> = {
				ArrowLeft: at - 1,
				ArrowDown: at - 1,
				ArrowRight: at + 1,
				ArrowUp: at + 1,
				Home: 0,
				End: last,
			};
			if (!(event.key in step)) return;
			event.preventDefault();
			show(step[event.key]);
		};
		const onBlur = () => show(peak);

		graph.addEventListener("pointermove", fromPointer);
		graph.addEventListener("pointerdown", fromPointer);
		graph.addEventListener("pointerleave", onLeave);
		graph.addEventListener("keydown", onKey);
		graph.addEventListener("blur", onBlur);
		return () => {
			window.clearTimeout(settle);
			graph.removeEventListener("pointermove", fromPointer);
			graph.removeEventListener("pointerdown", fromPointer);
			graph.removeEventListener("pointerleave", onLeave);
			graph.removeEventListener("keydown", onKey);
			graph.removeEventListener("blur", onBlur);
		};
	}

	function bindRange(widget: HTMLElement): () => void {
		const button = widget.querySelector<HTMLButtonElement>(".wx-rd-cycle");
		const staticPill = widget.querySelector<HTMLElement>(".wx-rd-range--static");
		if (!button) return () => {};

		// Hand over from the inert pill only now that the handler is about to be
		// attached, so there is never a frame where a live-looking control does
		// nothing.
		staticPill?.setAttribute("hidden", "");
		button.hidden = false;

		const keys = [...button.querySelectorAll<HTMLElement>("[data-face]")].map(
			(el) => el.dataset.face ?? "",
		);

		const apply = (key: string) => {
			widget.dataset.range = key;
			const face = widget.querySelector<HTMLElement>(`.wx-rd-face[data-face="${key}"]`);
			// The pill's own text is the current range, so the accessible name has
			// to say what pressing it DOES rather than repeating that text.
			button.setAttribute(
				"aria-label",
				`Showing ${(face?.dataset.label ?? key).toLowerCase()}. Change range.`,
			);
		};

		const onClick = () => {
			const at = keys.indexOf(widget.dataset.range ?? "");
			apply(keys[(at + 1) % keys.length]);
		};

		apply(widget.dataset.range ?? keys[0]);
		button.addEventListener("click", onClick);
		return () => button.removeEventListener("click", onClick);
	}

	function bind() {
		const widget = document.querySelector<HTMLElement>(".wx-readers");
		if (!widget) return () => {};
		const teardowns = [
			bindRange(widget),
			...[...widget.querySelectorAll<HTMLElement>(".wx-rd-face")].map(bindGraph),
		];
		return () => teardowns.forEach((fn) => fn());
	}

	let teardown: (() => void) | null = null;
	document.addEventListener("astro:page-load", () => {
		teardown = bind();
	});
	document.addEventListener("astro:before-swap", () => {
		teardown?.();
		teardown = null;
	});
</script>
