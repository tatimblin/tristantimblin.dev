---
// Readers widget — a 1×1 tile of how many real people visit this site: a bar
// per reading (the busiest lit), the total as a count, and a pill that cycles
// the range (30d → 1y → all) between server-rendered DS Faces, so it fetches
// nothing and works with the script blocked.
//
// It reads GoatCounter's visitors per day (counted in real browsers, exact, not
// sampled). At this site's volume a day is a handful of people, so every bar
// is a TRAILING SUM rather than a day; see buildView() in ./readers.ts.
//
// Data is read at build time from pageviews.json (./readers.ts), which the
// nightly workflow refreshes. Before its first read the ledger is empty and
// the tile says so. Props pass through to the <Widget>.
import Widget from "@whois/design-system/Widget";
import CardBody from "@whois/design-system/CardBody";
import Faces from "@whois/design-system/Faces";
import Face from "@whois/design-system/Face";
import Mono from "@whois/design-system/Mono";
import Figure from "@whois/design-system/Figure";
import BarGraph from "@whois/design-system/BarGraph";
import Pill from "@whois/design-system/Pill";
import VisuallyHidden from "@whois/design-system/VisuallyHidden";
import WidgetEmpty from "@whois/design-system/WidgetEmpty";
import {
	buildViews,
	emptyNote,
	formatCount,
	formatSpan,
	getReaderStats,
	isDrawable,
} from "./readers";

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;

const stats = getReaderStats();

// Only the ranges with something in them: a quiet month leaves the 30-day face
// empty while all-time still has hundreds of visitors.
const views = buildViews(stats.days).filter(isDrawable);
const hasSeries = views.length > 0;
const initial = views[0];
// With one range the pill stays a label rather than a button that does nothing.
const cycles = views.length > 1;

// What the figures are, on hover and to assistive tech.
const sourceNote = "Exact counts of visitors per day, from GoatCounter.";

// What the script needs to read a bar back, inlined once per range.
const readings = (view: (typeof views)[number]) =>
	JSON.stringify(
		view.points.map((p) => ({ v: p.value, s: formatSpan(p.from, p.date) })),
	);
---

<Widget size="1x1" title="visitors" name="readers" class:list={["wx-readers", className]} {...rest}>
	{
		hasSeries && (
			<Fragment slot="meta">
				{/* Two pills, one always hidden: without the script the static one
				    shows and nothing pretends to be interactive. Not one <button
				    disabled>: "disabled" announces a control that is temporarily
				    unavailable, which is not what a page without JavaScript has. */}
				<Pill class="wx-rd-range wx-rd-range--static">{initial?.key}</Pill>
				{cycles && (
					<Pill as="button" class="wx-rd-range wx-rd-cycle" type="button" hidden>
						{views.map((view, i) => (
							<span data-face={view.key} hidden={i !== 0}>{view.key}</span>
						))}
					</Pill>
				)}
			</Fragment>
		)
	}

	<CardBody class="wx-rd-body">
		{
			hasSeries ? (
				<Faces fill data-rd-faces>
				{views.map((view, i) => (
					<Face
						class="wx-rd-face"
						inactive={i !== 0}
						data-face={view.key}
						data-readings={readings(view)}
						data-peak={view.peakIndex}
						data-label={view.label}
						data-window={view.window}
					>
						{/* The lit bar's value and dates; aria-hidden because the slider's
						    value text (or, without the script, the sentence below) says
						    it for assistive tech. */}
						<Mono class="wx-rd-readout" tone="tertiary" truncate aria-hidden="true">
							<span class="wx-rd-read-tag">peak </span>
							<Mono as="span" variant="value" class="wx-rd-read-value">
								{view.peak?.value}
							</Mono>
							{" · "}
							<span class="wx-rd-read-span">
								{formatSpan(view.peak?.from ?? "", view.peak?.date ?? "")}
							</span>
						</Mono>

						{/* Hidden from the tree until bindGraph() upgrades it into the
						    slider; the sentence below carries the peak without the script. */}
						<BarGraph
							class="wx-rd-bars"
							values={view.points.map((p) => p.value)}
							mark={view.peakIndex}
							interactive
							title={sourceNote}
						/>

						<Figure unit="total" title={sourceNote}>
							{formatCount(view.total)}
						</Figure>

						<VisuallyHidden class="wx-rd-say">
							{formatCount(view.total)} visitors over {view.label.toLowerCase()}
							{view.covered < view.span ? ` (${view.covered} days on record)` : ""}.
							{" "}Busiest {view.window} days{" "}
							{formatSpan(view.peak?.from ?? "", view.peak?.date ?? "")}, with{" "}
							{view.peak?.value}. {sourceNote}
						</VisuallyHidden>
					</Face>
				))}
				</Faces>
			) : (
				<WidgetEmpty data-rd-empty>{emptyNote(stats.days)}</WidgetEmpty>
			)
		}
	</CardBody>
</Widget>

<style>
	/* Everything else is DS components; this is the graph's share of the body. */
	.wx-rd-readout {
		display: block;
	}

	/* The graph takes whatever height the readout and the figure leave it. */
	.wx-rd-bars {
		flex: 1 1 0;
		min-block-size: 0;
		block-size: auto;
	}

	/* Compact tiles lose the "peak" tag rather than the dates; the lit bar
	   already says which one it is. */
	@container widget (max-width: 624px) {
		.wx-rd-read-tag {
			display: none;
		}
	}
</style>
