---
// Readers widget — a 1×1 tile of how many real people visit this site: a bar
// per reading (the busiest lit), the total as a count, and a pill that cycles
// the range (30d → 1y → all) between server-rendered DS Faces, so it fetches
// nothing and works with the script blocked.
//
// It reads Cloudflare Web Analytics (RUM, so every bar is browsers), not the
// zone's request counts, which are ~98% crawlers and scanners. That source is
// thin — sampled, quantized to tens, half the days zero — so every bar is a
// TRAILING SUM rather than a day; see buildView() in ./readers.ts. A count,
// not a percentage: at figures rounded to tens a percentage claims precision
// the data does not have.
//
// Data is read at build time from readers.json (./readers.ts), which the
// readers Action regenerates daily. Props pass through to the <Widget>.
import Widget from "@whois/design-system/Widget";
import CardBody from "@whois/design-system/CardBody";
import Faces from "@whois/design-system/Faces";
import Face from "@whois/design-system/Face";
import Mono from "@whois/design-system/Mono";
import Figure from "@whois/design-system/Figure";
import BarGraph from "@whois/design-system/BarGraph";
import Pill from "@whois/design-system/Pill";
import VisuallyHidden from "@whois/design-system/VisuallyHidden";
import WidgetEmpty from "@whois/design-system/WidgetEmpty";
import {
	buildViews,
	formatCount,
	formatSpan,
	getReaderStats,
	isDrawable,
} from "./readers";

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;

const stats = getReaderStats();

// Only the ranges with something in them: a quiet month leaves the 30-day face
// empty while all-time still has hundreds of visitors.
const views = buildViews(stats.days).filter(isDrawable);
const hasSeries = views.length > 0;
const initial = views[0];
// With one range the pill stays a label rather than a button that does nothing.
const cycles = views.length > 1;

const sampledNote = stats.sampled
	? "Cloudflare Web Analytics samples traffic, so these are estimates, rounded to the nearest ten."
	: "";

// What the script needs to read a bar back, inlined once per range.
const readings = (view: (typeof views)[number]) =>
	JSON.stringify(
		view.points.map((p) => ({ v: p.value, s: formatSpan(p.from, p.date) })),
	);
---

<Widget size="1x1" title="visitors" class:list={["wx-readers", className]} {...rest}>
	{
		hasSeries && (
			<Fragment slot="meta">
				{/* Two pills, one always hidden: without the script the static one
				    shows and nothing pretends to be interactive. Not one <button
				    disabled>: "disabled" announces a control that is temporarily
				    unavailable, which is not what a page without JavaScript has. */}
				<Pill class="wx-rd-range wx-rd-range--static">{initial?.key}</Pill>
				{cycles && (
					<Pill as="button" class="wx-rd-range wx-rd-cycle" type="button" hidden>
						{views.map((view, i) => (
							<span data-face={view.key} hidden={i !== 0}>{view.key}</span>
						))}
					</Pill>
				)}
			</Fragment>
		)
	}

	<CardBody class="wx-rd-body">
		{
			hasSeries ? (
				<Faces fill data-rd-faces>
				{views.map((view, i) => (
					<Face
						class="wx-rd-face"
						inactive={i !== 0}
						data-face={view.key}
						data-readings={readings(view)}
						data-peak={view.peakIndex}
						data-label={view.label}
						data-window={view.window}
					>
						{/* The lit bar's value and dates; aria-hidden because the slider's
						    value text (or, without the script, the sentence below) says
						    it for assistive tech. */}
						<Mono class="wx-rd-readout" tone="tertiary" truncate aria-hidden="true">
							<span class="wx-rd-read-tag">peak </span>
							<Mono as="span" variant="value" class="wx-rd-read-value">
								{view.peak?.value}
							</Mono>
							{" · "}
							<span class="wx-rd-read-span">
								{formatSpan(view.peak?.from ?? "", view.peak?.date ?? "")}
							</span>
						</Mono>

						{/* Hidden from the tree until bindGraph() upgrades it into the
						    slider; the sentence below carries the peak without the script. */}
						<BarGraph
							class="wx-rd-bars"
							values={view.points.map((p) => p.value)}
							mark={view.peakIndex}
							interactive
							title={sampledNote || undefined}
						/>

						<Figure unit="total" title={sampledNote || undefined}>
							{formatCount(view.total)}
						</Figure>

						<VisuallyHidden class="wx-rd-say">
							{formatCount(view.total)} visitors over {view.label.toLowerCase()}
							{view.covered < view.span ? ` (${view.covered} days on record)` : ""}.
							{" "}Busiest {view.window} days{" "}
							{formatSpan(view.peak?.from ?? "", view.peak?.date ?? "")}, with{" "}
							{view.peak?.value}. {sampledNote}
						</VisuallyHidden>
					</Face>
				))}
				</Faces>
			) : (
				<WidgetEmpty>No visitors yet.</WidgetEmpty>
			)
		}
	</CardBody>
</Widget>

<script>
	import { markBar } from "@whois/design-system/lib/bar-graph";
	import { showFace } from "@whois/design-system/lib/faces";
	import { stepFromKey } from "@whois/design-system/lib/keys";
	import { onPage } from "@whois/design-system/lib/lifecycle";

	interface Reading {
		v: number;
		s: string;
	}

	function bindGraph(face: HTMLElement): () => void {
		const graph = face.querySelector<HTMLElement>(".wx-rd-bars");
		const tag = face.querySelector<HTMLElement>(".wx-rd-read-tag");
		const value = face.querySelector<HTMLElement>(".wx-rd-read-value");
		const span = face.querySelector<HTMLElement>(".wx-rd-read-span");
		let readings: Reading[] = [];
		try {
			readings = JSON.parse(face.dataset.readings ?? "[]");
		} catch {}
		if (!graph || readings.length === 0) return () => {};

		const peak = Number(face.dataset.peak);
		const last = readings.length - 1;
		let at = peak;
		let settle = 0;

		// Light bar i and say what it is, to the eye and to assistive tech. A graph
		// whose bar count disagrees with the readings stays a picture.
		const show = (i: number) => {
			const lit = markBar(graph, i);
			if (lit < 0 || lit > last) return;
			at = lit;
			const r = readings[at];
			if (tag) tag.hidden = at !== peak;
			if (value) value.textContent = String(r.v);
			if (span) span.textContent = r.s;
			graph.setAttribute("aria-valuenow", String(at));
			graph.setAttribute(
				"aria-valuetext",
				`${r.v} visitors, ${r.s}${at === peak ? ", the busiest" : ""}`,
			);
		};

		// Upgrade the hidden picture into a slider over the readings.
		graph.removeAttribute("aria-hidden");
		graph.setAttribute("role", "slider");
		graph.tabIndex = 0;
		graph.setAttribute(
			"aria-label",
			`Visitors per ${face.dataset.window ?? "7"} days, ${(face.dataset.label ?? "").toLowerCase()}`,
		);
		graph.setAttribute("aria-valuemin", "0");
		graph.setAttribute("aria-valuemax", String(last));
		show(peak);

		// Bars are spread edge to edge, so bar i sits at i / last of the width.
		const fromPointer = (event: PointerEvent) => {
			const rect = graph.getBoundingClientRect();
			const x = (event.clientX - rect.left) / Math.max(1, rect.width);
			window.clearTimeout(settle);
			show(Math.round(x * last));
		};
		const onLeave = (event: PointerEvent) => {
			if (document.activeElement === graph) return;
			// A touch lifts as it leaves; hold its reading a moment so it can be
			// read, then hand the accent back to the peak.
			window.clearTimeout(settle);
			if (event.pointerType === "mouse") show(peak);
			else settle = window.setTimeout(() => show(peak), 2000);
		};
		const onKey = (event: KeyboardEvent) => {
			const step = stepFromKey(event, at, last);
			if (step === null) return;
			event.preventDefault();
			show(step);
		};
		const onBlur = () => show(peak);

		graph.addEventListener("pointermove", fromPointer);
		graph.addEventListener("pointerdown", fromPointer);
		graph.addEventListener("pointerleave", onLeave);
		graph.addEventListener("keydown", onKey);
		graph.addEventListener("blur", onBlur);
		return () => {
			window.clearTimeout(settle);
			graph.removeEventListener("pointermove", fromPointer);
			graph.removeEventListener("pointerdown", fromPointer);
			graph.removeEventListener("pointerleave", onLeave);
			graph.removeEventListener("keydown", onKey);
			graph.removeEventListener("blur", onBlur);
		};
	}

	function bindRange(widget: HTMLElement): () => void {
		const button = widget.querySelector<HTMLButtonElement>(".wx-rd-cycle");
		const staticPill = widget.querySelector<HTMLElement>(".wx-rd-range--static");
		if (!button) return () => {};

		// Hand over from the inert pill only now, so a live-looking control never
		// does nothing.
		staticPill?.setAttribute("hidden", "");
		button.hidden = false;

		const stack = widget.querySelector<HTMLElement>("[data-rd-faces]");
		const labels = [...button.querySelectorAll<HTMLElement>("[data-face]")];
		const keys = labels.map((el) => el.dataset.face ?? "");
		if (!stack || keys.length === 0) return () => {};
		let at = 0;

		const apply = (index: number) => {
			at = index;
			const key = keys[at];
			const face = showFace(stack, key);
			for (const label of labels) label.hidden = label.dataset.face !== key;
			// The pill's own text is the current range, so the accessible name has
			// to say what pressing it DOES rather than repeating that text.
			button.setAttribute(
				"aria-label",
				`Showing ${(face?.dataset.label ?? key).toLowerCase()}. Change range.`,
			);
		};

		const onClick = () => apply((at + 1) % keys.length);

		apply(at);
		button.addEventListener("click", onClick);
		return () => button.removeEventListener("click", onClick);
	}

	onPage(() => {
		const widget = document.querySelector<HTMLElement>(".wx-readers");
		if (!widget) return;
		const teardowns = [
			bindRange(widget),
			...[...widget.querySelectorAll<HTMLElement>(".wx-rd-face")].map(bindGraph),
		];
		return () => teardowns.forEach((fn) => fn());
	});
</script>

<style>
	/* Everything else is DS components; this is the graph's share of the body. */
	.wx-rd-readout {
		display: block;
	}

	/* The graph takes whatever height the readout and the figure leave it. */
	.wx-rd-bars {
		flex: 1 1 0;
		min-block-size: 0;
		block-size: auto;
	}

	/* Compact tiles lose the "peak" tag rather than the dates; the lit bar
	   already says which one it is. */
	@container widget (max-width: 624px) {
		.wx-rd-read-tag {
			display: none;
		}
	}
</style>
