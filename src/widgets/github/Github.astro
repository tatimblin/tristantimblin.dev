---
// GitHub widget — a 1×1 card in the mono widget family (widgets.css → MONO
// WIDGET FAMILY). A label row (`github` + the @handle, which links out to the
// profile) sits over a toggle: tap the card to cross-fade the contribution grid
// out and the language breakdown in (tap again to flip back). Data is read at
// build time from github.json (see ./github.ts); only the flip is client-side.
import Widget from "@whois/design-system/Widget";
import Anchor from "@whois/design-system/Anchor";
import List from "@whois/design-system/List";
import { getGithubStats } from "./github";
import "./github.css";

const gh = getGithubStats();

// Every week in the data file. The grid sizes its squares off the height it's
// given and anchors the newest week to the right edge, so whatever doesn't fit
// clips off the left — narrow tiles show fewer weeks, not smaller squares.
const weeks = gh.weeks;

// Each day sits at its weekday row (Sun=1 … Sat=7) so partial weeks (the current
// one) stay aligned to the correct rows. Parse as UTC to match the API dates.
const weekday = (date: string): number =>
	(new Date(`${date}T00:00:00Z`).getUTCDay() ?? 0) + 1;

const total = gh.totalContributions.toLocaleString("en-US");

// Four named languages plus the rest summed as "other", so the list fits a 1×1
// and still accounts for 100%. Each row takes a dither step (solid → sparse) in
// rank order; the bar uses the same steps, so the legend needs no colour key.
// Shown as whole percents: the decimals cost the width a phone tile doesn't have.
const NAMED = 4;
const named = gh.languages.slice(0, NAMED);
const rest = gh.languages.slice(NAMED).reduce((sum, l) => sum + l.percent, 0);
const langs = [
	...named.map((l) => ({ name: l.name, percent: l.percent })),
	...(rest > 0 ? [{ name: "other", percent: rest }] : []),
].map((l, i) => ({ ...l, ink: Math.max(0, 4 - i) }));
---

<Widget
	size="1x1"
	class="wx-github wx-mono"
	data-reveal
	data-reveal-group="widgets"
	data-reveal-order="2"
>
	<!-- Label row. Outside the toggle button, so tapping the handle never flips (and
	     so there's no <a> inside a <button>). The handle is a variantless <Anchor>:
	     the link reset + the DS colour transition, no added marks. -->
	<div class="wx-head">
		<span class="wx-head-label">github</span>
		<Anchor
			class="wx-head-meta"
			href={gh.profileUrl}
			target="_blank"
			rel="noopener noreferrer"
			aria-label={`@${gh.username} on GitHub`}
		>
			@{gh.username}
		</Anchor>
	</div>

	<!-- RAW <button>, not the DS <Button>: this is the card INTERIOR, not a control
	     drawn on top of it. It is a real <button> only so the flip is keyboard- and
	     focus-reachable; every piece of native button chrome is stripped in github.css
	     so the surface reads as the tile itself. -->
	<button
		class="wx-gh-body"
		type="button"
		aria-pressed="false"
		aria-label="Show language breakdown"
	>
		<!-- Face A: contribution grid as a halftone — one ink, the square grows with
		     the day's level (0 is a single dot). -->
		<div class="wx-gh-face wx-gh-face--grid">
			<div class="wx-gh-grid-box">
				<div class="wx-gh-grid" style={`--gh-cols:${weeks.length}`}>
					{
						weeks.map((week, wi) =>
							week.map((day) => (
								<span
									class="wx-gh-cell"
									data-level={day.level}
									style={`grid-column:${wi + 1};grid-row:${weekday(day.date)}`}
									title={`${day.count} contribution${day.count === 1 ? "" : "s"} on ${day.date}`}
								/>
							)),
						)
					}
				</div>
			</div>
			<div class="wx-figure">
				<span class="wx-figure-num">{total}</span>
				<span class="wx-figure-unit">contributions / yr</span>
			</div>
		</div>

		<!-- Face B: language breakdown — a dithered share bar over a leadered list. -->
		<div class="wx-gh-face wx-gh-face--langs" aria-hidden="true">
			<div class="wx-gh-bar">
				{
					langs.map((l) => (
						<span class={`wx-gh-bar-seg wx-ink-${l.ink}`} style={`flex-grow:${l.percent}`} />
					))
				}
			</div>
			<!-- <List> for the markerless reset; the rows stay raw <li> because
			     ListItem wraps its children in an arrow + a second <div>, which breaks
			     this swatch · name · leader · percent flex row. -->
			<List class="wx-gh-lang-list">
				{
					langs.map((l) => (
						<li class="wx-gh-lang">
							<span class={`wx-gh-swatch wx-ink-${l.ink}`} />
							<span class="wx-gh-lang-name">{l.name}</span>
							<span class="wx-gh-leader wx-rule" />
							<span class="wx-gh-lang-pct">{Math.round(l.percent)}%</span>
						</li>
					))
				}
			</List>
		</div>
	</button>
</Widget>

<script>
	// Flip the card between the contribution grid and the language breakdown.
	// Pure class toggle — no network, no persisted state. Bound per page-load and
	// torn down before a view-transition swap so handlers don't accumulate (the
	// same lifecycle idiom as videos/Videos.astro).
	function bind() {
		const widget = document.querySelector<HTMLElement>(".wx-github");
		const button = widget?.querySelector<HTMLButtonElement>(".wx-gh-body");
		if (!widget || !button) return () => {};

		const gridFace = widget.querySelector(".wx-gh-face--grid");
		const langFace = widget.querySelector(".wx-gh-face--langs");

		const onClick = () => {
			const flipped = widget.classList.toggle("is-flipped");
			button.setAttribute("aria-pressed", String(flipped));
			button.setAttribute(
				"aria-label",
				flipped ? "Show contribution graph" : "Show language breakdown",
			);
			gridFace?.setAttribute("aria-hidden", String(flipped));
			langFace?.setAttribute("aria-hidden", String(!flipped));
		};

		button.addEventListener("click", onClick);
		return () => button.removeEventListener("click", onClick);
	}

	let teardown: (() => void) | null = null;
	document.addEventListener("astro:page-load", () => {
		teardown = bind();
	});
	document.addEventListener("astro:before-swap", () => {
		teardown?.();
		teardown = null;
	});
</script>
