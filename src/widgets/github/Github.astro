---
// GitHub widget — a 1×1 card in the instrument UI, built from the design
// system's pieces (packages/design-system/CONVENTIONS.md → Instrument UI). The
// card header (`github` + the @handle, which links out to the profile) sits
// over a toggle: tap the body to cross-fade the contribution grid out and the
// language breakdown in (tap again to flip back). The toggle is a transparent
// <button> laid over the body — not a <button> AROUND it, which would flatten
// the grid, the ruler and the legend into one control's name — with a fixed
// accessible name and aria-pressed carrying the state. Data is read at build
// time from github.json (see ./github.ts); only the flip is client-side.
//
// Props pass through to the <Widget> (a class, the page's data-reveal
// choreography): the page owns where the card sits and when it fades in.
import Widget from "@whois/design-system/Widget";
import CardBody from "@whois/design-system/CardBody";
import Faces from "@whois/design-system/Faces";
import Face from "@whois/design-system/Face";
import Mono from "@whois/design-system/Mono";
import Figure from "@whois/design-system/Figure";
import TileGrid from "@whois/design-system/TileGrid";
import Tile from "@whois/design-system/Tile";
import TickRuler from "@whois/design-system/TickRuler";
import Legend from "@whois/design-system/Legend";
import HitArea from "@whois/design-system/HitArea";
import { getGithubStats } from "./github";

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;

const gh = getGithubStats();

// Every week in the data file. The grid sizes its squares off the height it's
// given and anchors the newest week to the right edge, so whatever doesn't fit
// clips off the left — narrow tiles show fewer weeks, not smaller squares.
const weeks = gh.weeks;

// Each day sits at its weekday row (Sun=1 … Sat=7) so partial weeks (the current
// one) stay aligned to the correct rows. Parse as UTC to match the API dates. A
// date the API mangled parses to NaN, which would land as `grid-row: NaN` and
// auto-place the tile; Sunday is the honest default.
const weekday = (date: string): number => {
	const day = new Date(`${date}T00:00:00Z`).getUTCDay();
	return (Number.isNaN(day) ? 0 : day) + 1;
};

const total = gh.totalContributions.toLocaleString("en-US");

// Four named languages plus the rest summed as "other", so the list fits a 1×1
// and still accounts for 100%. Ranked, so the ruler's segments and the legend's
// dots take the family's tone ramp in the same order — the accent for the top
// language, then the ink stepping down — and share one key without either
// being told a colour. Whole percents: decimals cost width a phone lacks.
const NAMED = 4;
const named = gh.languages.slice(0, NAMED);
const remainder = gh.languages.slice(NAMED).reduce((sum, l) => sum + l.percent, 0);
const langs = [
	...named.map((l) => ({ name: l.name, percent: l.percent })),
	...(remainder > 0 ? [{ name: "other", percent: remainder }] : []),
];
---

<Widget size="1x1" title="github" class:list={["wx-github", className]} {...rest}>
	{/* The handle, in the header's meta slot: outside the body the toggle
	     covers, so tapping it never flips. */}
	<Mono
		slot="meta"
		as="a"
		variant="text"
		href={gh.profileUrl}
		target="_blank"
		rel="noopener noreferrer"
		aria-label={`@${gh.username} on GitHub`}
	>
		@{gh.username}
	</Mono>

	<CardBody class="wx-gh-body">
		<Faces fill data-gh-faces>
		{/* Face A: the contribution grid as tiles in GitHub's greens, light to
		     dark by the day's count — over the yearly total. */}
		<Face data-face="grid">
			<TileGrid cols={weeks.length} rows={7} fit="height">
				{
					weeks.map((week, wi) =>
						week.map((day) => (
							<Tile
								level={day.level}
								style={`grid-column:${wi + 1};grid-row:${weekday(day.date)}`}
							/>
						)),
					)
				}
			</TileGrid>
			<Figure unit="contributions">{total}</Figure>
		</Face>

		{/* Face B: language breakdown — a tick ruler split by share over the
		     legend, both ranked (see `langs`). */}
		<Face class="wx-gh-face--langs" data-face="langs" inactive>
			<TickRuler
				class="wx-gh-ruler"
				segments={langs.map((l) => ({ share: l.percent }))}
			/>
			<Legend
				items={langs.map((l) => ({
					label: l.name,
					value: `${Math.round(l.percent)}%`,
				}))}
			/>
		</Face>
		</Faces>

		{/* The flip surface: a DS HitArea — a transparent <button> over the whole
		     body, ringed inside the clipping card — last in the DOM so the faces
		     read before the control that swaps them. One name for both states —
		     it always offers the languages; aria-pressed says whether they are
		     showing. */}
		<HitArea data-gh-flip aria-pressed="false" aria-label="Show language breakdown" />
	</CardBody>
</Widget>

<script>
	// Flip the card between the contribution grid and the language breakdown:
	// showFace moves aria-hidden from one face to the other (which is what
	// Faces fades on) — no network, no persisted state. onPage binds per
	// page-load and tears down before a view-transition swap.
	import { showFace } from "@whois/design-system/lib/faces";
	import { onPage } from "@whois/design-system/lib/lifecycle";

	onPage(() => {
		const widget = document.querySelector<HTMLElement>(".wx-github");
		const button = widget?.querySelector<HTMLButtonElement>("[data-gh-flip]");
		const stack = widget?.querySelector<HTMLElement>("[data-gh-faces]");
		if (!widget || !button || !stack) return;

		let flipped = false;
		const onClick = () => {
			flipped = !flipped;
			button.setAttribute("aria-pressed", String(flipped));
			showFace(stack, flipped ? "langs" : "grid");
		};

		button.addEventListener("click", onClick);
		return () => button.removeEventListener("click", onClick);
	});
</script>

<style>
	/* The card chrome, the header, the two faces and their cross-fade, the
	   tiles, the figure, the ruler, the legend and the flip surface are all
	   design-system components; only the faces' own layout is here. Scoped:
	   the DS spreads the scope attribute onto each component's root, and its
	   CSS sits in a cascade layer under this, so a plain class here wins. */

	/* GitHub's own greens on the contribution grid, so it reads as the chart it
	   mirrors; the empty days keep the theme's wash. */
	.wx-gh-body {
		--tile-1: var(--contrib-1);
		--tile-2: var(--contrib-2);
		--tile-3: var(--contrib-3);
		--tile-4: var(--contrib-4);
	}

	/* The languages face: the ruler at the top, the legend at the foot. */
	.wx-gh-face--langs {
		justify-content: space-between;
	}
	/* The language ruler takes a share of the face; the legend takes the rest. */
	.wx-gh-ruler {
		flex: 0 1 30%;
		min-block-size: var(--space-6);
	}
</style>
