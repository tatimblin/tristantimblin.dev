---
// Volo widget — a 2×2 card in the instrument UI, built from the design
// system's pieces (packages/design-system/CONVENTIONS.md → Instrument UI).
//
// The header is the team, in caps, with its standing in a pill (the team's own
// Volo colour as the pill's dot). Below it, ONE season: a month row with small
// round buttons stepping through the seasons, then every fixture as a mono
// table on hairlines — result letter in ink (win) or dim ink (loss), score over
// a zero-anchored margin tick, the bracket round set on the rule it opens. The
// accent lands once in the list: the next game, or a finished season's last
// result.
//
// The bottom is ALL the seasons — a hairline step chart of where each ENDED,
// after the playoffs, that does NOT move when the arrows do; the season in
// progress is the accent, with a playhead dot. One season is a number,
// thirteen is a shape.
//
// Data is read at build time from volo.json (see ./volo.ts), which the
// volo-seasons Action regenerates daily. Every season is rendered server-side
// as its own stacked panel and cross-faded by class — the same face-swap
// mechanism Github.astro uses, and the reason the arrows fetch nothing.
import Widget from "@whois/design-system/Widget";
import CardBody from "@whois/design-system/CardBody";
import Mono from "@whois/design-system/Mono";
import Pill from "@whois/design-system/Pill";
import IconButton from "@whois/design-system/IconButton";
import Hairline from "@whois/design-system/Hairline";
import Icon from "@whois/design-system/Icon";
import {
	currentSeasonIndex,
	formatGameDate,
	formatGameTime,
	formatRecord,
	formatRound,
	formatSeasonLabel,
	getVoloSeasons,
	marginRatio,
	opponentStanding,
	ordinal,
	rankSeries,
} from "./volo";
import "./volo.css";

const seasons = getVoloSeasons();
const current = currentSeasonIndex(seasons);
const rank = rankSeries(seasons);

// The plot is drawn in an abstract 100-unit box and stretched to whatever width
// the tile gives it (preserveAspectRatio="none"), so the geometry below is pure
// arithmetic with no layout in it. Strokes opt out of that stretch — see the
// vector-effect in volo.css — or they would smear horizontally.
// The x axis is TIME, not season count: every year gets an equal slot and the
// seasons inside it divide that slot between them. So 2021's single season is
// one wide step and each of 2026's three is a third as wide — which is what
// lets the year labels sit evenly without lying about where a year falls. An
// ordinal axis (one slot per season) spaced them by how busy a year happened to
// be, bunching 2021–2023 into the left third.
const years = [...new Set(rank.points.map((point) => point.year))];
const seasonsPerYear = new Map<string, number>();
for (const point of rank.points) {
	seasonsPerYear.set(point.year, (seasonsPerYear.get(point.year) ?? 0) + 1);
}
const placed = new Map<string, number>();
const spans = rank.points.map((point) => {
	const nth = placed.get(point.year) ?? 0;
	placed.set(point.year, nth + 1);
	const slot = years.indexOf(point.year) * 10;
	const share = 10 / (seasonsPerYear.get(point.year) as number);
	return { x0: slot + nth * share, x1: slot + (nth + 1) * share };
});

const PLOT = { w: Math.max(1, years.length) * 10, h: 100, pad: 7 };
const plotY = (placing: number) => PLOT.pad + (1 - placing) * (PLOT.h - PLOT.pad * 2);

// A step, not a slope: a season holds one placing for its whole run and then
// jumps. Drawing it as a diagonal would imply a team drifting between finishes
// it never actually held.
//
// A season with no value breaks the line rather than being bridged — `M` starts
// a fresh subpath. Bridging would draw a segment across a season whose finish
// is not known, which is exactly the fiction to avoid: the newest season is
// still being played.
const stepPath = (key: "placing" | "seedPlacing") => {
	let open = false;
	return rank.points
		.map((point) => {
			const value = point[key];
			if (value === null) {
				open = false;
				return "";
			}
			const { x0, x1 } = spans[point.index];
			const y = plotY(value);
			const move = open ? `L${x0},${y}` : `M${x0},${y}`;
			open = true;
			return `${move}L${x1},${y}`;
		})
		.join("");
};

const finishPath = stepPath("placing");
const seedPath = stepPath("seedPlacing");

// The accent's one job in the chart: NOW. The season in progress (the one the
// tile opens on) is drawn in the accent — its step, and a dot at its end like
// the metronome's playhead — and every other season is ink. It sits at
// whichever value that season has: its finish once it is decided, its seed
// while it is still being played.
const nowPoint = rank.points[current];
const nowValue = nowPoint ? (nowPoint.placing ?? nowPoint.seedPlacing) : null;
const nowSpan = nowPoint ? spans[nowPoint.index] : null;
const now =
	nowPoint && nowSpan && nowValue !== null
		? {
				path: `M${nowSpan.x0},${plotY(nowValue)}L${nowSpan.x1},${plotY(nowValue)}`,
				left: (nowSpan.x1 / PLOT.w) * 100,
				top: (plotY(nowValue) / PLOT.h) * 100,
				dashed: nowPoint.placing === null,
			}
		: null;

// The one row in a season's list that takes the accent: the next game if there
// is one (what a reader looks this tile up for), else the last result.
const accentRow = (season: (typeof seasons)[number]) => {
	const next = season.games.findIndex((game) => !game.result);
	return next >= 0 ? next : season.games.length - 1;
};

const opening = seasons[current];
---

<Widget
	size="2x2"
	class="wx-volo"
	title={opening?.team.name ?? "volo"}
	data-reveal
	data-reveal-group="widgets"
	data-reveal-order="3"
>
	{/* The standing, in the header's meta slot: the team's own Volo colour as
	    the pill's glyph (brand art — the one colour that is not the family's),
	    then placing and record. The header sits outside the panel stack, so the
	    script swaps the title and this pill's text when the season changes; the
	    server renders the season the tile opens on. */}
	{opening && (
		<Pill slot="meta" class="wx-vl-standing" data-volo-standing>
			<span
				class="wx-vl-dot"
				data-volo-dot
				style={opening.team.color ? `background:${opening.team.color}` : undefined}
			/>
			<span class="wx-vl-star" data-volo-star hidden={!opening.champion} title="Won the league">★</span>
			<span data-volo-record>{formatRecord(opening)}</span>
		</Pill>
	)}

	<CardBody class="wx-vl-body">
	{
		seasons.length === 0 ? (
			/* The data file is generated, and the fetch script refuses to write an
			   empty one — but a widget that renders nothing beats a build that dies
			   if that ever changes. */
			<Mono variant="text" class="wx-vl-empty">No seasons yet.</Mono>
		) : (
			<>
				{/* SEASON NAV — the metronome's small round buttons. Rendered
				    `hidden` and unhidden by the script below, so a reader without JS
				    gets one clean season rather than two dead arrows. */}
				<nav class="wx-vl-nav" aria-label="Season" hidden>
					<IconButton
						class="wx-vl-arrow wx-vl-arrow--prev"
						size="small"
						rounded
						type="button"
						data-volo-prev
						aria-label="Previous season"
					>
						<Icon name="arrow" size={3} />
					</IconButton>
					<IconButton
						class="wx-vl-arrow"
						size="small"
						rounded
						type="button"
						data-volo-next
						aria-label="Next season"
					>
						<Icon name="arrow" size={3} />
					</IconButton>
				</nav>

				<div class="wx-vl-panels" data-volo-panels>
					{seasons.map((season, i) => {
						const lit = accentRow(season);
						return (
						<section
							class:list={["wx-vl-panel", i === current && "is-active"]}
							data-volo-panel={i}
							data-team={season.team.name}
							data-color={season.team.color ?? ""}
							data-record={formatRecord(season)}
							data-champion={season.champion ? "true" : undefined}
							aria-hidden={String(i !== current)}
							aria-label={`${formatSeasonLabel(season)} — ${season.sport}`}
						>
							{/* The month row: the season's start and its sport, left of
							    the round buttons that page through them. The team and
							    record live in the card header; they are repeated here
							    for a screen reader, which reads the panel, not the
							    header the script rewrites. */}
							<header class="wx-vl-head">
								<Mono class="wx-vl-season">{formatSeasonLabel(season)}</Mono>
								<Mono variant="text" class="wx-vl-sport">{season.sport}</Mono>
								<span class="wx-vl-vh">
									{season.team.name}, {formatRecord(season)}
									{season.champion ? ". League champions." : "."}
								</span>
							</header>

							<ol class="wx-vl-games">
								{season.games.map((game, gameIndex) => (
									<li
										class="wx-vl-game"
										data-result={game.result ?? "upcoming"}
										data-playoff={game.playoff ? "true" : undefined}
										data-lit={gameIndex === lit ? "true" : undefined}
									>
										{/* First, so it reads before the fixture it heads. It is
										    positioned out of flow against the grid (see volo.css),
										    so DOM order costs it nothing — and --vl-i is the row it
										    sits above. */}
										{game.playoff && (
											<Mono
												class="wx-vl-round"
												style={`--vl-i:${gameIndex}`}
											>
												{formatRound(game.round) ?? "PLAYOFF"}
											</Mono>
										)}
										<Mono variant="value" class="wx-vl-date" title={game.playoff ? "Playoff game" : undefined}>
											{formatGameDate(game.startTime, season.timezone)}
										</Mono>
										<Mono variant="value" class="wx-vl-opp">
											{/* Inner span so the name has a block container to
											    ellipsize against — these run to 44 characters. */}
											<span class="wx-vl-opp-name">{game.opponent}</span>
											{/* Their standing, set small after the name. A bracket
											    game names their SEED; anything else names where they
											    finished, which is a fact from after the fact. */}
											{(() => {
												const standing = opponentStanding(game);
												return standing ? (
													<span
														class="wx-vl-rank"
														title={
															standing.kind === "seed"
																? `${ordinal(standing.value)} seed`
																: `Finished ${ordinal(standing.value)} in the league`
														}
													>
														{standing.value}
													</span>
												) : null;
											})()}
										</Mono>
										{/* Always rendered, even when empty: the rows are
										    `display: contents` over one shared grid, so a row that
										    skipped a cell would shift every column after it. */}
										<Mono class="wx-vl-pill">{game.result}</Mono>
										{game.result ? (
											game.forfeit && !game.for && !game.against ? (
												/* A forfeit recorded as 0–0 is not a 0–0 game. */
												<Mono class="wx-vl-score wx-vl-score--ff">FF</Mono>
											) : (
												<Mono
													variant="value"
													class="wx-vl-score"
													style={`--m:${marginRatio(game, season.sport).toFixed(3)}`}
													data-forfeit={game.forfeit ? "true" : undefined}
												>
													{game.for}<span class="wx-vl-dash">–</span>{game.against}
													{/* The margin, as a tick on the divider beneath. */}
													<span class="wx-vl-bar" />
												</Mono>
											)
										) : (
											<Mono variant="value" class="wx-vl-time">
												{formatGameTime(game.startTime, season.timezone)}
											</Mono>
										)}
									</li>
								))}
							</ol>
						</section>
						);
					})}
				</div>

				{/* RANK BY SEASON — fixed. It deliberately does not respond to the
				    arrows: it is the constant the seasons are read against. */}
				<figure class="wx-vl-career">
					<Hairline as="span" />
					<figcaption class="wx-vl-career-cap">
						<Mono class="wx-vl-career-label">Rank by season</Mono>
						<span class="wx-vl-legend">
							<Mono class="wx-vl-key wx-vl-key--seed">Seed</Mono>
							<Mono class="wx-vl-key wx-vl-key--finish">Finish</Mono>
						</span>
						<Mono variant="value" class="wx-vl-career-stats">
							{rank.record.wins}–{rank.record.losses}
							{rank.record.ties > 0 && <>–{rank.record.ties}</>}
							{" · "}{rank.titles} title{rank.titles === 1 ? "" : "s"}
						</Mono>
					</figcaption>

					<div class="wx-vl-chart">
						<div class="wx-vl-axis">
							<Mono>1st</Mono>
							<Mono>Last</Mono>
						</div>

						<div class="wx-vl-plotwrap">
						<svg
							class="wx-vl-plot"
							viewBox={`0 0 ${PLOT.w} ${PLOT.h}`}
							preserveAspectRatio="none"
							role="img"
							aria-label={
								`Playoff seed and final finish across ${rank.points.length} seasons, oldest first. ` +
								`Top of the chart is winning the league. ` +
								`All-time record ${rank.record.wins}–${rank.record.losses}` +
								`${rank.record.ties ? `–${rank.record.ties}` : ""}. ` +
								rank.points
									.map(
										(p) =>
											`${p.label}: seeded ${p.seed ? ordinal(p.seed) : "unseeded"}, ` +
											`${p.rank ? `finished ${ordinal(p.rank)} of ${p.teams}` : "still playing"}`,
									)
									.join(". ")
							}
						>
							{/* Hairline rules at the two ends of the axis — the chart's
							    frame, drawn as the instrument's quietest line. */}
							<path class="wx-vl-rule" d={`M0,${plotY(1)}H${PLOT.w}M0,${plotY(0)}H${PLOT.w}`} />
							<path class="wx-vl-seed" d={seedPath} />
							<path class="wx-vl-line" d={finishPath} />
							{now && <path class:list={["wx-vl-now-line", now.dashed && "is-seed"]} d={now.path} />}
						</svg>

						{now && (
							<span
								class="wx-vl-now"
								style={`left:${now.left.toFixed(2)}%;top:${now.top.toFixed(2)}%`}
								aria-hidden="true"
							/>
						)}

						{/* One hit area per season, laid over the plot at exactly the span
						    that season's steps occupy — same x maths, expressed as a
						    percentage so it tracks the SVG however wide it stretches.
						    RENDERED DISABLED: bind() enables them, and only above 900px
						    (see syncBands() for why they stay off on a phone). */}
						<div class="wx-vl-hits">
							{rank.points.map((point, i) => (
								<button
									type="button"
									class:list={["wx-vl-hit", i === current && "is-active"]}
									data-volo-jump={i}
									disabled
									aria-current={i === current ? "true" : undefined}
									style={`left:${(spans[i].x0 / PLOT.w) * 100}%;width:${((spans[i].x1 - spans[i].x0) / PLOT.w) * 100}%`}
								>
									<span class="wx-vl-vh">
										{point.label}:{" "}
										{point.rank
											? `finished ${ordinal(point.rank)} of ${point.teams}`
											: "still playing"}
									</span>
								</button>
							))}
						</div>
						</div>

						<ol class="wx-vl-years" style={`--vl-cols:${years.length}`}>
							{years.map((year) => (
								<li class="wx-vl-year"><Mono>'{year.slice(2)}</Mono></li>
							))}
						</ol>
					</div>
				</figure>
			</>
		)
	}
	</CardBody>
</Widget>

<script>
	// Step between season panels. Pure class toggle over markup that is already
	// in the DOM — no network, no persisted state. Bound per page-load and torn
	// down before a view-transition swap so handlers don't accumulate (the same
	// lifecycle idiom as github/Github.astro and videos/Videos.astro).
	function bind() {
		const widget = document.querySelector<HTMLElement>(".wx-volo");
		const nav = widget?.querySelector<HTMLElement>(".wx-vl-nav");
		const stack = widget?.querySelector<HTMLElement>("[data-volo-panels]");
		if (!widget || !nav || !stack) return () => {};

		const panels = Array.from(
			stack.querySelectorAll<HTMLElement>("[data-volo-panel]"),
		);
		const hits = Array.from(
			widget.querySelectorAll<HTMLButtonElement>("[data-volo-jump]"),
		);
		// The card header sits outside the panel stack, so it is rewritten from
		// the panel's data when the season changes (see the meta Pill).
		const title = widget.querySelector<HTMLElement>(".ds-card-header__title");
		const dot = widget.querySelector<HTMLElement>("[data-volo-dot]");
		const star = widget.querySelector<HTMLElement>("[data-volo-star]");
		const record = widget.querySelector<HTMLElement>("[data-volo-record]");
		const prev = nav.querySelector<HTMLButtonElement>("[data-volo-prev]");
		const next = nav.querySelector<HTMLButtonElement>("[data-volo-next]");
		if (panels.length === 0 || !prev || !next) return () => {};

		let index = panels.findIndex((p) => p.classList.contains("is-active"));
		if (index < 0) index = panels.length - 1;

		const select = (to: number) => {
			const clamped = Math.min(panels.length - 1, Math.max(0, to));
			if (clamped === index) return;
			index = clamped;
			panels.forEach((panel, i) => {
				panel.classList.toggle("is-active", i === index);
				panel.setAttribute("aria-hidden", String(i !== index));
			});
			const { team, color, record: standing, champion } = panels[index].dataset;
			if (title && team) title.textContent = team;
			if (dot) dot.style.background = color ?? "";
			if (star) star.hidden = champion !== "true";
			if (record && standing) record.textContent = standing;
			hits.forEach((hit, i) => {
				hit.classList.toggle("is-active", i === index);
				if (i === index) hit.setAttribute("aria-current", "true");
				else hit.removeAttribute("aria-current");
			});
			sync();
		};

		// No wrap, and the ends are disabled rather than inert — the same slider
		// semantics as packages/video-carousel.
		const sync = () => {
			prev.disabled = index === 0;
			next.disabled = index === panels.length - 1;
		};

		const onPrev = () => select(index - 1);
		const onNext = () => select(index + 1);
		// Bound on the WIDGET, not the panel stack. The arrows are the only
		// focusable things here and they are siblings of the stack, so a keydown
		// while one is focused never reaches it — the shortcuts were unreachable
		// for exactly the reader who needs them.
		const onKey = (event: KeyboardEvent) => {
			const step =
				event.key === "ArrowLeft" || event.key === "ArrowUp" ? index - 1
				: event.key === "ArrowRight" || event.key === "ArrowDown" ? index + 1
				: event.key === "Home" ? 0
				: event.key === "End" ? panels.length - 1
				: null;
			if (step === null) return;
			event.preventDefault();
			select(step);
		};

		const onJump = (event: Event) => {
			const target = (event.currentTarget as HTMLElement).dataset.voloJump;
			if (target !== undefined) select(Number(target));
		};

		// The bands are a DESKTOP affordance. Below 900px the grid drops to two
		// columns and a year with four seasons divides its slot four ways, which
		// leaves the narrowest band about 11px — well under any touch target. So
		// they stay disabled at that size: no tap target that cannot be hit
		// reliably, no tab stop that does nothing useful, and no pointer cursor
		// promising something. The arrows are the control there. The breakpoint
		// matches the one in volo.css; keep them in step.
		const wide = window.matchMedia("(min-width: 901px)");
		const syncBands = () => {
			for (const hit of hits) hit.disabled = !wide.matches;
		};

		prev.addEventListener("click", onPrev);
		next.addEventListener("click", onNext);
		widget.addEventListener("keydown", onKey);
		for (const hit of hits) hit.addEventListener("click", onJump);
		// Re-evaluated on resize and rotation, not just at load.
		wide.addEventListener("change", syncBands);
		syncBands();

		// The arrows only work once this ran, so this is where they earn their place.
		nav.hidden = false;
		sync();

		return () => {
			prev.removeEventListener("click", onPrev);
			next.removeEventListener("click", onNext);
			widget.removeEventListener("keydown", onKey);
			wide.removeEventListener("change", syncBands);
			for (const hit of hits) {
				hit.removeEventListener("click", onJump);
				hit.disabled = true;
			}
		};
	}

	let teardown: (() => void) | null = null;
	document.addEventListener("astro:page-load", () => {
		teardown = bind();
	});
	document.addEventListener("astro:before-swap", () => {
		teardown?.();
		teardown = null;
	});
</script>
