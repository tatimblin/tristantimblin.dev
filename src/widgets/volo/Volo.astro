---
// Volo widget — a 2×2 card: every season as a stacked bar (one segment per
// game: the regular season's wins, ties and losses, then the playoff games
// stacked apart above them) on an accent band, the selected season's schedule
// in a tray under it, and the career record as the headline at the foot.
// A bar picks its season; the header's arrows page the chart when there are
// more seasons than fit; the tray's heading slides it up over the chart to
// show every game. Data is read at build time from volo.json (./volo.ts,
// which the volo-seasons Action regenerates weekly); every season is rendered
// server-side as a panel in a DS Faces stack, so nothing is fetched.
// Props pass through to the <Widget> (a class, the page's data-reveal choreography).
import Widget from "@whois/design-system/Widget";
import CardBody from "@whois/design-system/CardBody";
import Faces from "@whois/design-system/Faces";
import Face from "@whois/design-system/Face";
import Figure from "@whois/design-system/Figure";
import HitArea from "@whois/design-system/HitArea";
import Mono from "@whois/design-system/Mono";
import IconButton from "@whois/design-system/IconButton";
import Icon from "@whois/design-system/Icon";
import VisuallyHidden from "@whois/design-system/VisuallyHidden";
import WidgetEmpty from "@whois/design-system/WidgetEmpty";
import {
	careerSummary,
	currentSeasonIndex,
	formatGameDate,
	formatGameTime,
	formatRecord,
	formatRound,
	formatTally,
	getVoloSeasons,
	marginRatio,
	nextGameIndex,
	opponentStanding,
	ordinal,
	peekStart,
	PENDING_BRACKET,
	PEEK_ROWS,
	placeMark,
	seasonName,
	seasonOutcome,
	seasonStack,
	seasonYear,
	stackHeight,
} from "./volo";
import "./volo.css";

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;

let seasons = getVoloSeasons();
// DEV ONLY: `?volo-seasons=30` pads the history with copies of the real
// seasons, to see the chart page. (Never read in a build: DEV is false there.)
const demo = import.meta.env.DEV ? Number(Astro.url.searchParams.get("volo-seasons")) : 0;
if (demo > seasons.length) {
	const extra = Array.from({ length: demo - seasons.length }, (_, i) => {
		const source = seasons[i % (seasons.length - 1)];
		const start = new Date(seasons[0].startDate);
		start.setMonth(start.getMonth() - 4 * (demo - seasons.length - i));
		return { ...source, id: `demo-${i}`, startDate: start.toISOString(), seasonLabel: null };
	});
	seasons = [...extra, ...seasons];
}

const current = currentSeasonIndex(seasons);
const career = careerSummary(seasons);
const stacks = seasons.map(seasonStack);
// Every bar is scaled against the tallest season, so a game is the same
// height in every column.
const tallest = Math.max(1, ...stacks.map(stackHeight));

// Seasons on show at once. More than this and the header's arrows page.
const PAGE = 12;
const paged = seasons.length > PAGE;
// The chart opens on the latest page.
const firstShown = Math.max(0, seasons.length - PAGE);
// A year is labelled on its first season on the page.
const yearShown = (i: number) =>
	i === 0 || i === firstShown || seasonYear(seasons[i]) !== seasonYear(seasons[i - 1]);
---

<Widget
	size="2x2"
	class:list={["wx-volo", className]}
	squeeze="title"
	data-expanded="false"
	style={`--vl-page:${Math.min(PAGE, seasons.length)};--vl-tallest:${tallest};--vl-peek-rows:${PEEK_ROWS}`}
	{...rest}
>
	{/* The selected season's sport; the script rewrites it. */}
	<span slot="title">Volo <span data-volo-sport>{seasons[current]?.sport ?? ""}</span></span>
	{paged && (
		/* Rendered `hidden` and unhidden by the script: without it the chart
		   shows its latest page and two dead arrows would only mislead. */
		<span slot="meta" class="wx-vl-nav" role="group" aria-label="Seasons" hidden>
			<IconButton class="wx-vl-arrow wx-vl-arrow--prev" size="xs" rounded type="button" data-volo-prev aria-label="Earlier seasons">
				<Icon name="arrow" size={3} />
			</IconButton>
			<IconButton class="wx-vl-arrow" size="xs" rounded type="button" data-volo-next aria-label="Later seasons">
				<Icon name="arrow" size={3} />
			</IconButton>
		</span>
	)}

	<CardBody class="wx-vl-body">
	{
		seasons.length === 0 ? (
			<WidgetEmpty>No seasons yet.</WidgetEmpty>
		) : (
			<>
				{/* The chart and the schedule tray share this box: the tray rests at
				    its foot and slides up over the chart. */}
				<div class="wx-vl-main">
					{/* A window PAGE seasons wide over a track of all of them. Each
					    bar is a picture with a HitArea laid over it, so the bar's
					    segments stay out of the control's name. */}
					<div class="wx-vl-chart" data-volo-chart>
						<div class="wx-vl-window">
							<ol class="wx-vl-track" data-volo-track style={`--vl-start:${firstShown}`}>
								{seasons.map((season, i) => {
									const stack = stacks[i];
									const mark = placeMark(season);
									const seg = (k: number, kind: string) =>
										k > 0 && <span class="wx-vl-seg" data-kind={kind} style={`--k:${k}`} />;
									return (
										<li class="wx-vl-season">
											<span class="wx-vl-stack" aria-hidden="true">
												{seg(stack.wins, "W")}
												{seg(stack.ties, "T")}
												{seg(stack.losses, "L")}
												{seg(stack.unplayed, "upcoming")}
												{(stack.playoffs.length > 0 || stack.bracketPending) && <span class="wx-vl-break" />}
												{stack.bracketPending
													? seg(PENDING_BRACKET, "bracket")
													: stack.playoffs.map((result) => seg(1, `P${result}`))}
											</span>
											<Mono
												variant="value"
												tone="tertiary"
												class:list={["wx-vl-year", season.champion && "is-title", (season.champion || yearShown(i)) && "is-shown"]}
												data-year={seasonYear(season)}
												aria-hidden="true"
											>
												{/* A title wears its trophy in place of the year, always;
												    the selected bar says where its season finished. */}
												<span class="wx-vl-yr">
													{season.champion ? <span class="wx-vl-medal">🏆</span> : `'${seasonYear(season)}`}
												</span>
												<span class="wx-vl-place">
													{mark.medal ? <span class="wx-vl-medal">{mark.text}</span> : mark.text}
												</span>
											</Mono>
											{/* Disabled until the script runs; the selected bar is the
											    one tab stop (the arrow keys walk the rest). */}
											<HitArea
												class="wx-vl-pick"
												data-volo-season={i}
												aria-current={i === current ? "true" : undefined}
												aria-label={`${seasonName(season)} ${season.sport}: ${formatTally(season)}, ${seasonOutcome(season)}`}
												tabindex={i === current ? 0 : -1}
												disabled
											/>
										</li>
									);
								})}
							</ol>
						</div>
					</div>

					{/* The selected season's schedule, as a tray. Resting, it shows
					    PEEK_ROWS rows — the last result and what is next, or how a
					    finished season ended — and its heading pulls it up over the
					    chart to show every game. */}
					<div class="wx-vl-slot" />
					<section class="wx-vl-sched" aria-label="Schedule">
						<div class="wx-vl-sched-head">
							<Mono variant="title" truncate data-volo-heading>{seasonName(seasons[current])} season</Mono>
							<Icon name="chevron" size={3} class="wx-vl-chevron" />
							<Mono variant="value" tone="tertiary" class="wx-vl-sched-tally" data-volo-tally>{formatTally(seasons[current])}</Mono>
							{/* The whole row is the handle. Enabled by the script; without it
							    the tray rests. */}
							<HitArea data-volo-expand aria-expanded="false" disabled>
								<VisuallyHidden as="span" data-volo-expand-label>Show every game</VisuallyHidden>
							</HitArea>
						</div>
						<Faces fill class="wx-vl-panels" data-volo-panels>
							{seasons.map((season, i) => {
								const next = nextGameIndex(season);
								const peek = peekStart(season);
								return (
									<Face
										as="div"
										class="wx-vl-panel"
										inactive={i !== current}
										data-volo-panel={i}
										data-heading={`${seasonName(season)} season`}
										data-sport={season.sport}
										data-tally={formatTally(season)}
										style={`--vl-peek:${peek}`}
									>
										<VisuallyHidden>
											{season.sport} • {seasonName(season)}: {season.team.name}, {formatRecord(season)}
											{season.champion ? ". League champions." : "."}
										</VisuallyHidden>
										<ol class="wx-vl-games">
											{season.games.map((game, gameIndex) => (
												<li
													class="wx-vl-game"
													data-result={game.result ?? "upcoming"}
													data-playoff={game.playoff ? "true" : undefined}
													data-lit={gameIndex === next ? "true" : undefined}
													data-above={gameIndex < peek ? "true" : undefined}
													data-peek-first={gameIndex === peek ? "true" : undefined}
												>
													{game.playoff && (
														<Mono tone="tertiary" class="wx-vl-round" style={`--vl-i:${gameIndex}`}>
															{formatRound(game.round) ?? "PLAYOFF"}
														</Mono>
													)}
													<Mono variant="value" tone="tertiary">
														{formatGameDate(game.startTime, season.timezone)}
													</Mono>
													<Mono variant="value" class="wx-vl-opp">
														<Mono as="span" variant="value" truncate class="wx-vl-opp-name">{game.opponent}</Mono>
														{(() => {
															const standing = opponentStanding(game);
															return standing ? (
																<Mono
																	as="span"
																	variant="value"
																	tone="tertiary"
																	class="wx-vl-rank"
																	title={standing.kind === "seed" ? `${ordinal(standing.value)} seed` : `Finished ${ordinal(standing.value)} in the league`}
																>
																	{standing.value}
																</Mono>
															) : null;
														})()}
													</Mono>
													{/* Always rendered: the rows are `display: contents` over one
													    grid, so a skipped cell would shift every column after it. */}
													<Mono tone="tertiary" class="wx-vl-result">{game.result}</Mono>
													{game.result ? (
														game.forfeit && !game.for && !game.against ? (
															/* A forfeit recorded as 0–0 is not a 0–0 game. */
															<Mono tone="tertiary" class="wx-vl-score">FF</Mono>
														) : (
															<Mono
																variant="value"
																class="wx-vl-score"
																style={`--m:${marginRatio(game, season.sport).toFixed(3)}`}
																data-forfeit={game.forfeit ? "true" : undefined}
															>
																{game.for}<span class="wx-vl-dash">–</span>{game.against}
																<span class="wx-vl-bar" />
															</Mono>
														)
													) : (
														<Mono variant="value" tone="secondary" class="wx-vl-time">
															{formatGameTime(game.startTime, season.timezone)}
														</Mono>
													)}
												</li>
											))}
										</ol>
									</Face>
								);
							})}
						</Faces>
					</section>
				</div>

				{/* The headline, at the foot like the other tiles' big figures. */}
				<Figure class="wx-vl-career">
					{career.wins}–{career.losses}{career.ties > 0 && <>–{career.ties}</>}
					<Fragment slot="unit">
						{career.finals} final{career.finals === 1 ? "" : "s"} · {career.titles} title{career.titles === 1 ? "" : "s"}
					</Fragment>
				</Figure>
			</>
		)
	}
	</CardBody>
</Widget>

<script>
	import { showFace } from "@whois/design-system/lib/faces";
	import { stepFromKey } from "@whois/design-system/lib/keys";
	import { onPage } from "@whois/design-system/lib/lifecycle";

	onPage(() => {
		const widget = document.querySelector<HTMLElement>(".wx-volo");
		const chart = widget?.querySelector<HTMLElement>("[data-volo-chart]");
		const track = widget?.querySelector<HTMLElement>("[data-volo-track]");
		const stack = widget?.querySelector<HTMLElement>("[data-volo-panels]");
		const expand = widget?.querySelector<HTMLButtonElement>("[data-volo-expand]");
		if (!widget || !chart || !track || !stack || !expand) return;

		const bars = Array.from(track.querySelectorAll<HTMLButtonElement>("[data-volo-season]"));
		const panels = Array.from(stack.querySelectorAll<HTMLElement>("[data-volo-panel]"));
		const years = Array.from(track.querySelectorAll<HTMLElement>("[data-year]"));
		const title = widget.querySelector<HTMLElement>("[data-volo-heading]");
		const tally = widget.querySelector<HTMLElement>("[data-volo-tally]");
		const sport = widget.querySelector<HTMLElement>("[data-volo-sport]");
		const expandLabel = widget.querySelector<HTMLElement>("[data-volo-expand-label]");
		const nav = widget.querySelector<HTMLElement>(".wx-vl-nav");
		const prev = nav?.querySelector<HTMLButtonElement>("[data-volo-prev]");
		const next = nav?.querySelector<HTMLButtonElement>("[data-volo-next]");

		const page = Number(getComputedStyle(widget).getPropertyValue("--vl-page")) || bars.length;
		const lastStart = Math.max(0, bars.length - page);
		let start = lastStart;
		let index = Math.max(0, bars.findIndex((bar) => bar.hasAttribute("aria-current")));

		const onShownPage = (i: number) => i >= start && i < start + page;

		// One tab stop: the selected bar, or the page's first when the selected
		// one has been paged out of view.
		const rove = () => {
			const stop = onShownPage(index) ? index : start;
			bars.forEach((bar, i) => (bar.tabIndex = i === stop ? 0 : -1));
		};

		// A year is labelled on its first season ON THE PAGE, so a page that
		// opens mid-year still says which year it is. A title's trophy always
		// shows.
		const label = () => {
			years.forEach((el, i) => {
				const first = i === start || el.dataset.year !== years[i - 1]?.dataset.year;
				el.classList.toggle("is-shown", first || el.classList.contains("is-title"));
			});
		};

		const pageTo = (to: number) => {
			start = Math.min(lastStart, Math.max(0, to));
			track.style.setProperty("--vl-start", String(start));
			if (prev && next) {
				// A disabled arrow cannot hold focus: hand it to the sibling
				// rather than drop it to <body>.
				const focused = document.activeElement;
				prev.disabled = start === 0;
				next.disabled = start === lastStart;
				if (focused === next && next.disabled) prev.focus();
				else if (focused === prev && prev.disabled) next.focus();
			}
			label();
			rove();
		};

		const select = (to: number) => {
			index = Math.min(bars.length - 1, Math.max(0, to));
			bars.forEach((bar, i) => {
				if (i === index) bar.setAttribute("aria-current", "true");
				else bar.removeAttribute("aria-current");
			});
			showFace(stack, index);
			const { heading, sport: game, tally: wl } = panels[index].dataset;
			if (title && heading) title.textContent = heading;
			if (sport && game) sport.textContent = game;
			if (tally && wl) tally.textContent = wl;
			// Keep the selection on the page.
			if (index < start) pageTo(index);
			else if (index >= start + page) pageTo(index - page + 1);
			else rove();
		};

		// Open, the tray covers the chart: the bars go inert so focus cannot
		// land under it.
		const setExpanded = (open: boolean) => {
			widget.dataset.expanded = String(open);
			expand.setAttribute("aria-expanded", String(open));
			chart.inert = open;
			if (expandLabel) expandLabel.textContent = open ? "Show less" : "Show every game";
		};

		const onBar = (event: Event) => select(Number((event.currentTarget as HTMLElement).dataset.voloSeason));
		const onPrev = () => pageTo(start - page);
		const onNext = () => pageTo(start + page);
		const onExpand = () => setExpanded(widget.dataset.expanded !== "true");
		const onKey = (event: KeyboardEvent) => {
			if (event.key === "Escape" && widget.dataset.expanded === "true") {
				setExpanded(false);
				expand.focus();
				return;
			}
			if (!(event.target as HTMLElement).closest("[data-volo-season]")) return;
			const step = stepFromKey(event, index, bars.length - 1);
			if (step === null) return;
			event.preventDefault();
			select(step);
			bars[index].focus();
		};

		for (const bar of bars) {
			bar.addEventListener("click", onBar);
			bar.disabled = false;
		}
		prev?.addEventListener("click", onPrev);
		next?.addEventListener("click", onNext);
		expand.addEventListener("click", onExpand);
		widget.addEventListener("keydown", onKey);

		pageTo(start);
		if (nav) nav.hidden = false;
		expand.disabled = false;

		return () => {
			for (const bar of bars) {
				bar.removeEventListener("click", onBar);
				bar.disabled = true;
			}
			prev?.removeEventListener("click", onPrev);
			next?.removeEventListener("click", onNext);
			expand.removeEventListener("click", onExpand);
			expand.disabled = true;
			widget.removeEventListener("keydown", onKey);
		};
	});
</script>
