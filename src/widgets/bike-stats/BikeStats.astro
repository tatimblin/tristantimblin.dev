---
// Bike Stats (Bay Wheels) — a 1×1 card in the instrument UI, built from the
// design system's pieces (packages/design-system/CONVENTIONS.md → Instrument
// UI). The header names the service and dates the reading; the body is the
// running ride total drawn as a hairline graph (the latest bar lit), the total
// as the big figure, and miles / hours as the stat pairs under it. Everything
// is read at build time from bike-stats.csv (see ./bike-stats.ts), which the
// baywheels-stats GitHub Action appends to daily — nothing runs client-side.
import Widget from "@whois/design-system/Widget";
import CardBody from "@whois/design-system/CardBody";
import Mono from "@whois/design-system/Mono";
import Figure from "@whois/design-system/Figure";
import Stat from "@whois/design-system/Stat";
import BarGraph from "@whois/design-system/BarGraph";
import { getBikeStats } from "./bike-stats";
import "./bike-stats.css";

const bike = getBikeStats();

const fmt = (n: number) => n.toLocaleString("en-US");

// "Sep 14" — the day of the latest snapshot, parsed as UTC so the build
// machine's zone can't shift it a day.
const monthDay = (date: string) =>
	new Date(`${date}T00:00:00Z`).toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	});
const monthYear = (date: string) =>
	new Date(`${date}T00:00:00Z`).toLocaleDateString("en-US", {
		month: "long",
		year: "numeric",
		timeZone: "UTC",
	});
---

<Widget
	size="1x1"
	title="bay wheels"
	class="wx-baywheels"
	data-reveal
	data-reveal-group="widgets"
	data-reveal-order="1"
>
	<Mono
		slot="meta"
		as="time"
		variant="text"
		datetime={bike.date}
		title={bike.relativeDate}
	>
		{monthDay(bike.date)}
	</Mono>

	<CardBody class="wx-bw-body">
		<!-- The running total since the first snapshot, bottom-anchored to zero so
		     the heights are the real proportions; the latest bar is the one lit. -->
		<BarGraph
			class="wx-bw-graph"
			values={bike.history}
			lit="last"
			aria-label={`Total rides, ${monthYear(bike.since)} to ${monthYear(bike.date)}: ${fmt(bike.history[0] ?? 0)} to ${fmt(bike.rides)}`}
		/>
		<Figure unit="rides">{fmt(bike.rides)}</Figure>
		<div class="wx-bw-stats">
			<Stat size="sm" value={fmt(bike.miles)} label="miles" />
			<Stat size="sm" value={fmt(bike.hours)} label="hours" />
		</div>
	</CardBody>
</Widget>
