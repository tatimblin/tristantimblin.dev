---
// Bike Stats (Bay Wheels) — a 1×1 card in the instrument UI, built from the
// design system's pieces (packages/design-system/CONVENTIONS.md → Instrument
// UI). The header names the service and dates the reading; the body is the
// rides / hours as stat pairs at the top with the miles ridden as the big
// figure at the foot (where every widget's headline figure sits — Github's
// total, the visitors' — so the row reads on one line), and the Lyft e-bike
// drawn in ink on the right, cropped off the card's edge like the posters'
// cropped type. Everything is read at build time from bike-stats.csv (see
// ./bike-stats.ts), which the baywheels-stats GitHub Action appends to daily;
// the only client-side code is the date's tooltip. The bike's slide-in rides
// the page's reveal (src/lib/reveal.ts): the coordinator marks the card
// `data-reveal-state="in"` when its row fades in, and the bike's CSS keys on
// that, so there is no second observer here and nothing to re-arm.
//
// Props pass through to the <Widget> (a class, the page's data-reveal
// choreography): the page owns where the card sits and when it fades in.
import Widget from "@whois/design-system/Widget";
import CardBody from "@whois/design-system/CardBody";
import Mono from "@whois/design-system/Mono";
import Figure from "@whois/design-system/Figure";
import Stat from "@whois/design-system/Stat";
import Flex from "@whois/design-system/Flex";
import { getBikeStats } from "./bike-stats";

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;

const bike = getBikeStats();

const fmt = (n: number) => n.toLocaleString("en-US");

// "Sep 14" — the day of the latest snapshot, parsed as UTC so the build
// machine's zone can't shift it a day.
const monthDay = (date: string) =>
	new Date(`${date}T00:00:00Z`).toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	});
---

<script>
	// The date's tooltip says how long ago the reading was ("Today", "3 days
	// ago"), computed here against the visitor's today rather than at build,
	// where it would go stale. Both days are UTC calendar days, as the label's
	// monthDay() is. onPage runs it on every page load, since ClientRouter
	// replaces the DOM on each navigation (tests/reveal.spec.ts test 7 guards
	// the bike's own reveal across that round trip).
	import { onPage } from "@whois/design-system/lib/lifecycle";

	function ago(date: string): string {
		const then = Date.parse(`${date}T00:00:00Z`);
		if (Number.isNaN(then)) return "";
		const now = new Date();
		const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
		const diff = Math.round((today - then) / 86_400_000);
		if (diff <= 0) return "Today";
		if (diff === 1) return "Yesterday";
		return `${diff} days ago`;
	}

	onPage(() => {
		const time = document.querySelector<HTMLTimeElement>(".wx-baywheels time[datetime]");
		if (time) time.title = ago(time.dateTime);
	});
</script>

{bike && (
	<Widget size="1x1" title="bay wheels" class:list={["wx-baywheels", className]} {...rest}>
		<Mono
			slot="meta"
			as="time"
			variant="text"
			datetime={bike.date}
		>
			{monthDay(bike.date)}
		</Mono>

		<CardBody class="wx-bw-body">
			<Flex direction="column" alignItems="flex-start" gap={2} class="wx-bw-reading">
				<Stat value={fmt(bike.rides)} label="rides" />
				<Stat value={fmt(bike.hours)} label="hours" />
			</Flex>
			<Figure unit="miles" class="wx-bw-reading">{fmt(bike.miles)}</Figure>
			{/* Decoration: the figures above carry the content. A masked box, not an
			     <img>, so the drawing takes its colour from the ink token. */}
			<div class="wx-bw-bike" aria-hidden="true"></div>
		</CardBody>
	</Widget>
)}

<style>
	/* The card chrome, header, figure and stat pairs are design-system
	   components; this lays them down the left and draws the bike on the right.
	   Scoped: the DS spreads the scope attribute onto each component's root,
	   and its CSS sits in a layer under this. */

	/* The stat pairs at the top, the figure at the foot: a left column of
	   readings, with the bike filling the space to their right. The readings
	   are positioned so they paint OVER the bike where the two meet (the
	   figure's unit runs onto its front wheel, type over the picture as on the
	   posters) — an absolutely positioned box would otherwise paint above
	   in-flow text whatever the DOM order. */
	.wx-bw-body {
		justify-content: space-between;
	}
	.wx-bw-reading {
		position: relative;
		z-index: 1;
	}

	/* The Lyft e-bike, drawn in ink. /images/lyft-ebike-ink.png is an alpha mask
	   derived from the product render (tools/bike-stats/lyft-ebike-sideview.png,
	   kept out of public/ because only the mask ships): tonal darkness plus
	   traced edges, cropped to the bike, floor shadow removed. As a mask it has
	   no colour of its own; the box's fill gives it one, so it is the ink token
	   in either theme (dark on bone, light on the dark card) with no blend-mode
	   guesswork. It sits on the body's bottom padding line, level with the
	   figure, and runs off the card's right edge: the front wheel, basket and bars
	   stay in view and the rear wheel is cropped, like the posters' cropped
	   type. It is absolutely positioned so it never takes layout space from the
	   readings; the left inset keeps it clear of the stat column. */
	.wx-bw-bike {
		position: absolute;
		inset-inline-start: 44%;
		inset-block-end: var(--widget-pad);
		block-size: 62%;
		aspect-ratio: 1000 / 607;
		background: var(--text-secondary);
		mask: url("/images/lyft-ebike-ink.png") no-repeat left bottom / contain;
		pointer-events: none;
		transition:
			transform var(--duration-reveal) var(--ease-reveal),
			opacity var(--duration-reveal) var(--ease-reveal);
	}
	/* THE SLIDE-IN rides the page's reveal (src/styles/reveal.css, the same
	   two conditions): hidden and offset only while the document is ARMED
	   and the card has not been marked in. The coordinator sets
	   data-reveal-state="in" on the card as its row fades up, and the bike
	   rolls in from the right with it. Every failure path lands on visible —
	   no JS never arms, a broken bundle disarms on the head script's backstop,
	   reduced motion never arms (and the durations are 0s there anyway). */
	@media (prefers-reduced-motion: no-preference) {
		:global(html.reveal-armed) .wx-baywheels:not([data-reveal-state="in"]) .wx-bw-bike {
			opacity: 0;
			transform: translateX(var(--space-8));
		}
	}
</style>
