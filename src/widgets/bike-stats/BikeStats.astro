---
// Bike Stats (Bay Wheels) — a 1×1 card in the instrument UI, built from the
// design system's pieces (theme/design-system/CONVENTIONS.md → Instrument UI).
//
// The body is a gauge: a ring of hairline ticks round the card, lit in the
// Bay Wheels violet for how far the lifetime miles would take you — across the
// US by default, round the Earth when the card is tapped (the header's glyph
// says which). The month's average speed sits top-left as a Stat, the lifetime
// miles bottom-left as the Figure (where every widget's headline figure sits),
// and the Lyft e-bike is drawn in ink, facing right, its tail fading out under
// the readings. The ring and the bike's box are laid out client-side against
// the card as drawn (./ring.ts); everything else is read at build time from
// bike-stats.csv (./bike-stats.ts).
//
// The flip follows the GitHub card: a DS HitArea over the body, with
// aria-pressed carrying the state; the header glyph and the share's text
// follow the widget's data-mode in CSS. The bike's slide-in rides the page's
// reveal (src/lib/reveal.ts): the coordinator marks the card
// `data-reveal-state="in"` and the bike's CSS keys on that.
//
// Props pass through to the <Widget> (a class, the page's data-reveal
// choreography): the page owns where the card sits and when it fades in.
import Widget from "@whois/design-system/Widget";
import CardBody from "@whois/design-system/CardBody";
import Figure from "@whois/design-system/Figure";
import Stat from "@whois/design-system/Stat";
import HitArea from "@whois/design-system/HitArea";
import VisuallyHidden from "@whois/design-system/VisuallyHidden";
import usGlyph from "./icons/us.svg?raw";
import globeGlyph from "./icons/globe.svg?raw";
import { COAST_TO_COAST_MILES, EARTH_MILES, getBikeStats } from "./bike-stats";

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;

const bike = getBikeStats();

// The ring's two readings: lifetime miles as a share of each distance.
const share = bike && {
	us: Math.min(1, bike.miles / COAST_TO_COAST_MILES),
	earth: Math.min(1, bike.miles / EARTH_MILES),
};
// "57%", "6.6%": a decimal only where a whole percent would round it away.
const percent = (s: number) => `${(s * 100).toFixed(s < 0.1 ? 1 : 0)}%`;
---

<script>
	// Flip the gauge between the US crossing and the lap of the Earth. onPage
	// runs on every page load (ClientRouter replaces the DOM each navigation)
	// and tears the ring's resize observer down before the next swap.
	import { onPage } from "@whois/design-system/lib/lifecycle";
	import { mountRing } from "./ring";

	onPage(() => {
		const widget = document.querySelector<HTMLElement>(".wx-baywheels");
		const flip = widget?.querySelector<HTMLButtonElement>("[data-bw-flip]");
		if (!widget || !flip) return;

		const shares = { us: Number(widget.dataset.shareUs), earth: Number(widget.dataset.shareEarth) };
		const ring = mountRing(widget, shares.us);
		if (!ring) return;

		const onClick = () => {
			const earth = widget.dataset.mode !== "earth";
			widget.dataset.mode = earth ? "earth" : "us";
			flip.setAttribute("aria-pressed", String(earth));
			ring.setShare(earth ? shares.earth : shares.us);
		};

		flip.addEventListener("click", onClick);
		return () => {
			flip.removeEventListener("click", onClick);
			ring.destroy();
		};
	});
</script>

{bike && share && (
	<Widget
		size="1x1"
		title="bay wheels"
		class:list={["wx-baywheels", className]}
		data-mode="us"
		data-share-us={share.us}
		data-share-earth={share.earth}
		{...rest}
	>
		{/* Which distance the ring is measuring: the map of the US, or the globe. */}
		<span slot="meta" class="wx-bw-glyph" aria-hidden="true">
			<span class="wx-bw-glyph--us" set:html={usGlyph} />
			<span class="wx-bw-glyph--earth" set:html={globeGlyph} />
		</span>

		<CardBody class="wx-bw-body">
			{/* Decoration, laid out by ./ring.ts; the share is in the text below. */}
			<svg class="wx-bw-ring" aria-hidden="true"></svg>
			<div class="wx-bw-bike" aria-hidden="true"></div>

			<Stat value={bike.mph.toFixed(1)} label="mph" class="wx-bw-reading wx-bw-speed" />
			<Figure unit="miles" class="wx-bw-reading wx-bw-miles">
				{bike.miles.toLocaleString("en-US")}
			</Figure>
			<VisuallyHidden class="wx-bw-share--us">{percent(share.us)} of the way across the US</VisuallyHidden>
			<VisuallyHidden class="wx-bw-share--earth">{percent(share.earth)} of the way around the Earth</VisuallyHidden>

			{/* The flip surface, last so the readings come first. */}
			<HitArea data-bw-flip aria-pressed="false" aria-label="Measure against a lap of the Earth" />
		</CardBody>
	</Widget>
)}

<style>
	/* The card chrome, header, Stat, Figure and flip surface are design-system
	   components; this lays out the gauge behind the readings. Scoped: the DS
	   spreads the scope attribute onto each component's root, and its CSS sits
	   in a layer under this. */

	.wx-bw-body {
		justify-content: space-between;
	}
	/* The readings paint over the ring and the bike. */
	.wx-bw-reading {
		position: relative;
		z-index: 1;
	}
	/* The speed sits inside the ring's corner. */
	.wx-bw-speed {
		margin: var(--space-3) 0 0 var(--space-3);
	}
	/* The number gets the card's own surface, padded and feathered, so the
	   bike's back wheel fades out behind it as its tail does before the ticks.
	   The negative margin keeps the digits where they were. */
	.wx-bw-miles :global(.ds-figure__num) {
		background: var(--card-background);
		box-shadow: 0 0 10px 8px var(--card-background);
		border-radius: var(--space-2);
		padding-inline: var(--space-2);
		margin-inline: calc(-1 * var(--space-2));
	}

	/* The ring: 1px hairlines, the unlit ones half-way to the card so the lit
	   run carries it. The ticks are drawn by ./ring.ts, hence :global. */
	.wx-bw-ring {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		pointer-events: none;
	}
	.wx-bw-ring :global(line) {
		stroke: color-mix(in srgb, var(--hairline) 50%, var(--card-background));
		stroke-width: 1;
	}
	.wx-bw-ring :global(line.is-lit) {
		stroke: var(--baywheels);
		stroke-width: 1.25;
	}

	/* The Lyft e-bike, drawn in ink. /images/lyft-ebike-ink.png is an alpha mask
	   built from the product render by tools/bike-stats/ink-mask.mjs; as a mask
	   it takes the box's fill, so it's the ink token in either theme. Flipped to
	   face right; ./ring.ts sizes it from the card (until then it has no size)
	   and sets where its tail fades out, measured from the front wheel. */
	.wx-bw-bike {
		position: absolute;
		inset-block-start: var(--bw-bike-top);
		inset-inline-start: var(--bw-bike-left);
		inline-size: var(--bw-bike-width, 0);
		block-size: var(--bw-bike-height, 0);
		background: var(--text-secondary);
		mask:
			url("/images/lyft-ebike-ink.png") no-repeat left bottom / contain,
			linear-gradient(to right, black var(--bw-fade-from), transparent var(--bw-fade-to));
		mask-composite: intersect;
		scale: -1 1;
		pointer-events: none;
		transition:
			translate var(--duration-reveal) var(--ease-reveal),
			opacity var(--duration-reveal) var(--ease-reveal);
	}
	/* THE SLIDE-IN rides the page's reveal (src/styles/reveal.css, the same
	   two conditions): hidden and offset only while the document is ARMED and
	   the card has not been marked in, so every failure path lands on visible.
	   It rolls in forward, from the left. */
	@media (prefers-reduced-motion: no-preference) {
		:global(html.reveal-armed) .wx-baywheels:not([data-reveal-state="in"]) .wx-bw-bike {
			opacity: 0;
			translate: calc(-1 * var(--space-8)) 0;
		}
	}

	/* The header glyph, sized to the title: the solid map reads heavier than
	   the globe, so it is set a little smaller. */
	.wx-bw-glyph {
		display: flex;
		align-items: center;
		color: var(--text-tertiary);
	}
	.wx-bw-glyph :global(svg) {
		display: block;
		inline-size: auto;
	}
	.wx-bw-glyph--us :global(svg) {
		block-size: 1.05em;
	}
	.wx-bw-glyph--earth :global(svg) {
		block-size: 1.25em;
	}

	/* One mode at a time: the glyph and the share's text follow data-mode. */
	.wx-baywheels[data-mode="us"] :is(.wx-bw-glyph--earth, .wx-bw-share--earth),
	.wx-baywheels[data-mode="earth"] :is(.wx-bw-glyph--us, .wx-bw-share--us) {
		display: none;
	}
</style>
