---
// Bike Stats (Bay Wheels) — a 1×1 card in the instrument UI, built from the
// design system's pieces (packages/design-system/CONVENTIONS.md → Instrument
// UI). The header names the service and dates the reading; the body is the
// miles ridden as the big figure with rides / hours as stat pairs down the left,
// and the Lyft e-bike drawn in ink on the right, cropped off the card's edge
// like the posters' cropped type. Everything is read at build time from
// bike-stats.csv (see ./bike-stats.ts), which the baywheels-stats GitHub
// Action appends to daily; the only client-side code is the bike's slide-in.
import Widget from "@whois/design-system/Widget";
import CardBody from "@whois/design-system/CardBody";
import Mono from "@whois/design-system/Mono";
import Figure from "@whois/design-system/Figure";
import Stat from "@whois/design-system/Stat";
import { getBikeStats } from "./bike-stats";

const bike = getBikeStats();

const fmt = (n: number) => n.toLocaleString("en-US");

// "Sep 14" — the day of the latest snapshot, parsed as UTC so the build
// machine's zone can't shift it a day.
const monthDay = (date: string) =>
	new Date(`${date}T00:00:00Z`).toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	});
---

<script>
	// Slide the bike in from the right the first time the widget scrolls into
	// view; one-shot. Bound per page-load and torn down before a view-transition
	// swap (the lifecycle idiom of the other widgets): ClientRouter replaces the
	// DOM on every navigation, so an observer bound once at module scope would
	// watch a detached node while the fresh card never got .is-in — and its
	// resting state is opacity 0. tests/reveal.spec.ts test 7 guards this.
	//
	// The date's tooltip says how long ago the reading was ("Today", "3 days
	// ago"), computed here against the visitor's today rather than at build,
	// where it would go stale. Both days are UTC calendar days, as the label's
	// monthDay() is.
	function ago(date: string): string {
		const then = Date.parse(`${date}T00:00:00Z`);
		if (Number.isNaN(then)) return "";
		const now = new Date();
		const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
		const diff = Math.round((today - then) / 86_400_000);
		if (diff <= 0) return "Today";
		if (diff === 1) return "Yesterday";
		return `${diff} days ago`;
	}

	function bind() {
		const bw = document.querySelector<HTMLElement>(".wx-baywheels");
		if (!bw) return () => {};
		const time = bw.querySelector<HTMLTimeElement>("time[datetime]");
		if (time) time.title = ago(time.dateTime);
		const io = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				bw.classList.add("is-in");
				io.disconnect();
			},
			{ threshold: 0.35 },
		);
		io.observe(bw);
		return () => io.disconnect();
	}

	let teardown: (() => void) | null = null;
	document.addEventListener("astro:page-load", () => {
		teardown = bind();
	});
	document.addEventListener("astro:before-swap", () => {
		teardown?.();
		teardown = null;
	});
</script>

{bike && (
	<Widget
		size="1x1"
		title="bay wheels"
		class="wx-baywheels"
		data-reveal
		data-reveal-group="widgets"
		data-reveal-order="1"
	>
		<Mono
			slot="meta"
			as="time"
			variant="text"
			datetime={bike.date}
		>
			{monthDay(bike.date)}
		</Mono>

		<CardBody class="wx-bw-body">
			<Figure unit="miles">{fmt(bike.miles)}</Figure>
			<div class="wx-bw-stats">
				<Stat value={fmt(bike.rides)} label="rides" />
				<Stat value={fmt(bike.hours)} label="hours" />
			</div>
			{/* Decoration: the figures above carry the content. A masked box, not an
			     <img>, so the drawing takes its colour from the ink token. */}
			<div class="wx-bw-bike" aria-hidden="true"></div>
		</CardBody>
	</Widget>
)}

<style>
	/* The card chrome, header, figure and stat pairs are design-system
	   components; this lays them down the left and draws the bike on the right.
	   Scoped: the DS spreads the scope attribute onto each component's root,
	   and its CSS sits in a layer under this. */

	/* The figure at the top, the stat pairs at the bottom: a left column of
	   readings, with the bike filling the space to their right. */
	.wx-bw-body {
		justify-content: space-between;
	}
	.wx-bw-stats {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	/* The Lyft e-bike, drawn in ink. /images/lyft-ebike-ink.png is an alpha mask
	   derived from the product render (tools/bike-stats/lyft-ebike-sideview.png,
	   kept out of public/ because only the mask ships): tonal darkness plus
	   traced edges, cropped to the bike, floor shadow removed. As a mask it has
	   no colour of its own; the box's fill gives it one, so it is the ink token
	   in either theme (dark on bone, light on the dark card) with no blend-mode
	   guesswork. It sits on the body's bottom padding line, level with the last
	   stat, and runs off the card's right edge: the front wheel, basket and bars
	   stay in view and the rear wheel is cropped, like the posters' cropped
	   type. It is absolutely positioned so it never takes layout space from the
	   readings; the left inset keeps it clear of the stat column. */
	.wx-bw-bike {
		position: absolute;
		inset-inline-start: 44%;
		inset-block-end: var(--widget-pad);
		block-size: 62%;
		aspect-ratio: 1000 / 607;
		background: var(--text-secondary);
		mask: url("/images/lyft-ebike-ink.png") no-repeat left bottom / contain;
		pointer-events: none;

		/* Hidden and offset at rest. The script above adds .is-in to the card
		   on first scroll-into-view, which rolls the bike in from the right and
		   fades it up. */
		opacity: 0;
		transform: translateX(var(--space-8));
		transition:
			transform var(--duration-reveal) var(--ease-reveal),
			opacity var(--duration-reveal) var(--ease-reveal);
	}
	.wx-baywheels.is-in .wx-bw-bike {
		opacity: 1;
		transform: none;
	}
	/* Reduced motion: simply present, not waiting on the scroll-into-view. (The
	   transition itself needs no rule here — --duration-reveal is 0s under the
	   preference, tokens.overrides.css.) */
	@media (prefers-reduced-motion: reduce) {
		.wx-bw-bike {
			transform: none;
			opacity: 1;
		}
	}
</style>
