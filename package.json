{
  "name": "tristantimblin.dev",
  "type": "module",
  "version": "0.0.1",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bunx --bun astro dev",
    "build": "bun run build:fleet-demo && bunx --bun astro build",
    "build:fleet-demo": "bun run --cwd packages/fleet-extension build:web && bun run --cwd packages/vscode-fleet-demo build",
    "build:site": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "astro": "bunx --bun astro",
    "test": "playwright test",
    "validate:art": "bun packages/design-system/scripts/validate-art.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tristimb/spotify-stream-player": "^0.5.2",
    "@whois/design-system": "workspace:*",
    "@whois/dotted-grid": "workspace:*",
    "@whois/gallery-carousel": "workspace:*",
    "@whois/sticky-heading": "workspace:*",
    "@whois/stories-heading": "workspace:*",
    "@whois/video-carousel": "workspace:*",
    "@whois/wobble-text": "workspace:*",
    "astro": "^7.1.6",
    "astro-seo": "^1.1.0",
    "lenis": "^1.3.25"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@maximeheckel/design-system": "4.2.3",
    "@playwright/test": "^1.62.1",
    "react": "^19",
    "react-dom": "^19",
    "schema-dts": "^2.0.0"
  }
}
