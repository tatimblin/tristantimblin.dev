{
  "name": "tristantimblin.dev",
  "type": "module",
  "version": "0.0.1",
  "workspaces": ["theme/*"],
  "scripts": {
    "dev": "bun run copy:fleet-demo && bunx astro dev",
    "build": "bun run copy:fleet-demo && bunx --bun astro build",
    "copy:fleet-demo": "rm -rf public/fleet-demo && cp -R node_modules/@tristimb/fleet-demo/dist public/fleet-demo",
    "preview": "bunx --bun astro preview",
    "astro": "bunx --bun astro",
    "check": "astro check",
    "test": "playwright test",
    "test:unit": "bun test ./src ./theme ./tools",
    "media:push": "bun tools/media/push.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tristimb/dotted-grid": "https://github.com/tatimblin/dotgrid/releases/download/v0.1.2/tristimb-dotted-grid-0.1.2.tgz",
    "@tristimb/fleet-demo": "https://github.com/tatimblin/vscode-fleet/releases/download/v0.1.0/tristimb-fleet-demo-0.1.0.tgz",
    "@tristimb/spotify-stream-player": "^0.5.2",
    "@tristimb/video-carousel": "https://github.com/tatimblin/dotgrid/releases/download/v0.1.2/tristimb-video-carousel-0.1.2.tgz",
    "@whois/design-system": "workspace:*",
    "@whois/stories-heading": "workspace:*",
    "@whois/wobble-text": "workspace:*",
    "astro": "^7.1.6",
    "astro-seo": "^1.1.0",
    "lenis": "^1.3.25"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@playwright/test": "^1.62.1",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "schema-dts": "^2.0.0",
    "sharp": "^0.34.5",
    "typescript": "5.9.3",
    "vfile": "^6.0.3"
  },
  "patchedDependencies": {
    "@tristimb/spotify-stream-player@0.5.2": "patches/@tristimb%2Fspotify-stream-player@0.5.2.patch"
  }
}
