{
  "name": "tristantimblin.dev",
  "type": "module",
  "version": "0.0.1",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bunx astro dev",
    "build": "bun run build:fleet-demo && bunx --bun astro build",
    "build:fleet-demo": "bun run --cwd packages/fleet-extension build:web && bun run --cwd packages/vscode-fleet-demo build",
    "build:site": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "astro": "bunx --bun astro",
    "check": "astro check",
    "test": "playwright test",
    "test:unit": "bun test ./src ./packages",
    "validate:art": "bun packages/design-system/scripts/validate-art.mjs",
    "validate:glyph": "bun packages/design-system/scripts/validate-art.mjs --profile glyph",
    "glyphs:bake": "bun packages/design-system/scripts/bake-glyphs.ts",
    "glyphs:check": "bun packages/design-system/scripts/bake-glyphs.ts --check"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tristimb/spotify-stream-player": "^0.5.2",
    "@whois/design-system": "workspace:*",
    "@whois/dotted-grid": "workspace:*",
    "@whois/stories-heading": "workspace:*",
    "@whois/video-carousel": "workspace:*",
    "@whois/wobble-text": "workspace:*",
    "astro": "^7.1.6",
    "astro-seo": "^1.1.0",
    "lenis": "^1.3.25"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@playwright/test": "^1.62.1",
    "schema-dts": "^2.0.0",
    "typescript": "5.9.3"
  }
}
