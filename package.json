{
  "name": "tristantimblin.dev",
  "type": "module",
  "version": "0.0.1",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run copy:fleet-demo && bunx astro dev",
    "build": "bun run copy:fleet-demo && bunx --bun astro build",
    "copy:fleet-demo": "rm -rf public/fleet-demo && cp -R node_modules/@tristimb/fleet-demo/dist public/fleet-demo",
    "preview": "bunx --bun astro preview",
    "astro": "bunx --bun astro",
    "check": "astro check",
    "test": "playwright test",
    "test:unit": "bun test ./src ./packages ./tools",
    "validate:art": "bun packages/design-system/scripts/validate-art.mjs",
    "validate:glyph": "bun packages/design-system/scripts/validate-art.mjs --profile glyph",
    "glyphs:bake": "bun packages/design-system/scripts/bake-glyphs.ts",
    "glyphs:check": "bun packages/design-system/scripts/bake-glyphs.ts --check",
    "validate:scene": "bun packages/design-system/scripts/validate-art.mjs --profile scene",
    "scenes:bake": "bun packages/design-system/scripts/bake-scenes.ts",
    "scenes:check": "bun packages/design-system/scripts/bake-scenes.ts --check"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tristimb/dotted-grid": "https://github.com/tatimblin/dotgrid/releases/download/v0.1.0/tristimb-dotted-grid-0.1.0.tgz",
    "@tristimb/fleet-demo": "https://github.com/tatimblin/vscode-fleet/releases/download/v0.1.0/tristimb-fleet-demo-0.1.0.tgz",
    "@tristimb/spotify-stream-player": "^0.5.2",
    "@tristimb/video-carousel": "https://github.com/tatimblin/dotgrid/releases/download/v0.1.0/tristimb-video-carousel-0.1.0.tgz",
    "@whois/design-system": "workspace:*",
    "@whois/stories-heading": "workspace:*",
    "@whois/wobble-text": "workspace:*",
    "astro": "^7.1.6",
    "astro-seo": "^1.1.0",
    "lenis": "^1.3.25"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@playwright/test": "^1.62.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "schema-dts": "^2.0.0",
    "topojson-client": "^3.1.0",
    "typescript": "5.9.3",
    "world-atlas": "^2.0.2"
  }
}
